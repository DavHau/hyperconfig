diff --git a/tests/hermes_cli/test_session_messages_etag.py b/tests/hermes_cli/test_session_messages_etag.py
new file mode 100644
index 0000000..483ff1c
--- /dev/null
+++ b/tests/hermes_cli/test_session_messages_etag.py
@@ -0,0 +1,134 @@
+"""``GET /api/sessions/{id}/messages`` revalidates: an ETag of the page, 304 when unchanged.
+
+Clients re-read an open chat's history page on every sessions.changed tick of
+the profile, mostly getting the same bytes again. The page carries a weak ETag
+hashed from its own body and answers ``If-None-Match`` with a bodiless 304, so
+any change the page would show (append, tool row, edit, rewind, compaction)
+changes the tag and nothing else does.
+"""
+
+from pathlib import Path
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+URL = "/api/sessions/chat/messages?limit=120&order=latest&include_compacted=true"
+
+
+@pytest.fixture
+def env(tmp_path, monkeypatch):
+    from hermes_state import SessionDB
+
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    home = tmp_path / ".hermes"
+    home.mkdir(parents=True)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr("hermes_state.DEFAULT_DB_PATH", home / "state.db")
+
+    db = SessionDB(home / "state.db")
+    db.create_session(session_id="chat", source="desktop")
+    db.create_session(session_id="other", source="desktop")
+    db.append_messages_batch("chat", [
+        {"role": "user", "content": "hello"},
+        {"role": "assistant", "content": "hi there"},
+    ])
+
+    from hermes_cli.web_routers.sessions import manage_router
+
+    app = FastAPI()
+    app.include_router(manage_router)
+    with TestClient(app) as client:
+        yield client, db
+    db.close()
+
+
+def _tag(client, url=URL):
+    response = client.get(url)
+    assert response.status_code == 200
+    tag = response.headers["etag"]
+    assert tag.startswith('W/"') and tag.endswith('"')
+    assert "no-cache" in response.headers["cache-control"]
+    return tag, response.json()
+
+
+def _revalidate(client, tag, url=URL):
+    return client.get(url, headers={"If-None-Match": tag})
+
+
+def test_unchanged_page_is_a_bodiless_304(env):
+    client, _db = env
+    tag, page = _tag(client)
+    assert [m["content"] for m in page["messages"]] == ["hello", "hi there"]
+    response = _revalidate(client, tag)
+    assert response.status_code == 304
+    assert response.content == b""
+    assert response.headers["etag"] == tag
+
+
+def test_strong_spelling_and_lists_match_weakly(env):
+    # nginx's gzip weakens a strong tag, a client may echo either form.
+    client, _db = env
+    tag, _ = _tag(client)
+    strong = tag[2:]
+    assert _revalidate(client, strong).status_code == 304
+    assert _revalidate(client, f'W/"nope", {tag}').status_code == 304
+    assert _revalidate(client, "*").status_code == 304
+    assert _revalidate(client, 'W/"nope"').status_code == 200
+
+
+def test_another_sessions_write_keeps_the_tag(env):
+    client, db = env
+    tag, _ = _tag(client)
+    db.append_message("other", role="user", content="elsewhere")
+    assert _revalidate(client, tag).status_code == 304
+
+
+def test_append_and_tool_only_rows_change_the_tag(env):
+    client, db = env
+    tag, _ = _tag(client)
+    db.append_message("chat", role="assistant", content=None,
+                      tool_calls=[{"id": "c1", "type": "function",
+                                   "function": {"name": "terminal", "arguments": "{}"}}])
+    response = _revalidate(client, tag)
+    assert response.status_code == 200
+    tag2 = response.headers["etag"]
+    assert tag2 != tag
+    db.append_message("chat", role="tool", content="ok", tool_call_id="c1")
+    response = _revalidate(client, tag2)
+    assert response.status_code == 200
+    assert response.json()["messages"][-1]["role"] == "tool"
+
+
+def test_in_place_edit_changes_the_tag(env):
+    # Same row count and timestamps: only the content moved.
+    client, db = env
+    tag, page = _tag(client)
+    user_id = next(m["id"] for m in page["messages"] if m["role"] == "user")
+    db.set_user_message_content("chat", user_id, "hello, edited")
+    response = _revalidate(client, tag)
+    assert response.status_code == 200
+    assert "hello, edited" in [m["content"] for m in response.json()["messages"]]
+
+
+def test_rewrite_of_the_history_changes_the_tag(env):
+    # Compaction and rewinds replace the stored rows.
+    client, db = env
+    tag, _ = _tag(client)
+    db.replace_messages("chat", [{"role": "user", "content": "summary"}])
+    response = _revalidate(client, tag)
+    assert response.status_code == 200
+    assert [m["content"] for m in response.json()["messages"]] == ["summary"]
+
+
+def test_tag_depends_on_the_page_asked_for(env):
+    client, _db = env
+    tag, _ = _tag(client)
+    other_page = URL.replace("limit=120", "limit=1")
+    assert _revalidate(client, tag, other_page).status_code == 200
+
+
+def test_missing_session_is_still_404(env):
+    client, _db = env
+    response = client.get("/api/sessions/nope/messages", headers={"If-None-Match": "*"})
+    assert response.status_code == 404
