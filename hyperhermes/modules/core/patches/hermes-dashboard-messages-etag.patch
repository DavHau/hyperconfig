+def _revalidated_json(payload: dict, request: Request) -> Response:
+    """*payload* as JSON with a validator; 304 without a body when the client holds it.
+
+    Clients re-read an open chat's history page whenever any session of the
+    profile changes, mostly getting the same bytes again (~380 KB for a long
+    chat). The ETag is a hash of the body itself, so it changes with every
+    change the page shows (appends, edits, rewinds, compaction, a rewritten
+    notice) and with nothing else; no stored marker can miss a write. Weak
+    (W/): a compressing proxy re-encodes the bytes and would weaken a strong
+    tag anyway (nginx's gzip does), and weak comparison is what
+    If-None-Match uses. ``no-cache``: every read revalidates here.
+    """
+    response = JSONResponse(jsonable_encoder(payload))
+    etag = 'W/"' + hashlib.sha256(response.body).hexdigest()[:32] + '"'
+    validators = {"ETag": etag, "Cache-Control": "private, no-cache"}
+    if _etag_matches(request.headers.get("if-none-match", ""), etag):
+        return Response(status_code=304, headers=validators)
+    response.headers.update(validators)
+    return response
+
+
+def _etag_matches(if_none_match: str, etag: str) -> bool:
+    """RFC 9110 weak comparison of an If-None-Match list against *etag*."""
+    def opaque(tag: str) -> str:
+        tag = tag.strip()
+        return tag[2:] if tag.startswith("W/") else tag
+    tags = [opaque(tag) for tag in if_none_match.split(",") if tag.strip()]
+    return "*" in tags or opaque(etag) in tags
 
 
