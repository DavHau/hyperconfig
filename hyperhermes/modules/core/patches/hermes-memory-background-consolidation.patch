+# --- Unattended consolidation (hyperhermes: memory.background_consolidation) ---
+# "stage" (upstream): the review fork's patch/remove waits in the pending store for /memory approve.
+# "auto": it applies at once, to exactly the entries it pinned, after a snapshot of the store file
+# into memories/.history/ and a log line, unless it would remove more than half of the entries or
+# shrink the file by more than 40% of its characters (then it is staged as under "stage"). The
+# foreground approval gate (memory.write_approval) still wins: with it on, background writes stage.
+# Restore: consolidations.jsonl's "backup" is the file as it was before that consolidation; copy
+# it over memories/MEMORY.md (or USER.md). Running sessions keep their prompt until the next one.
+BACKGROUND_CONSOLIDATION_MODES = ("stage", "auto")
+HISTORY_KEEP = 50                    # newest snapshots per store file always kept ...
+HISTORY_KEEP_SECONDS = 30 * 86400    # ... plus every snapshot of the last 30 days
+MAX_REMOVED_ENTRIES = 0.5            # share of the store's entries one consolidation may remove
+MAX_SHRINK_CHARS = 0.4               # share of the store's characters it may take away
+
+
+def background_consolidation_mode(config: Optional[dict[str, Any]] = None) -> str:
+    """``auto`` only for an explicit ``memory.background_consolidation: auto`` with the approval
+    gate off; anything else (unset, unknown, unreadable config) is upstream's ``stage``."""
+    section = get_builtin_memory_config(config)
+    value = section.get("background_consolidation", "stage")
+    if not (isinstance(value, str) and value.strip().lower() == "auto"):
+        return "stage"
+    try:
+        from tools import write_approval as wa
+        if wa._normalize_enabled(section.get(wa.CONFIG_KEY, False)):
+            return "stage"
+    except Exception:
+        return "stage"
+    return "auto"
+
+
+def history_dir() -> Path:
+    return get_memory_dir() / ".history"
+
+
+def _private_dir(path: Path) -> Path:
+    import os
+    path.mkdir(mode=0o700, parents=True, exist_ok=True)
+    os.chmod(path, 0o700)
+    return path
+
+
+def _snapshot_time(path: Path) -> float:
+    """UTC time encoded in a snapshot's name (<YYYYmmddTHHMMSS>.<ns>Z-FILE.md), else its mtime."""
+    import calendar
+    import time
+    try:
+        return float(calendar.timegm(time.strptime(path.name[:15], "%Y%m%dT%H%M%S")))
+    except ValueError:
+        return path.stat().st_mtime
+
+
+def backup_memory_file(target: str) -> Path:
+    """Copy the store file *target* writes to into memories/.history/<utc-timestamp>-<FILE>.md
+    (0600, directory 0700) and return it. When the newest snapshot already holds exactly these
+    bytes, no new one is made and that one is returned. Retention per store file: every
+    snapshot of the last HISTORY_KEEP_SECONDS plus the newest HISTORY_KEEP. Raises on failure:
+    no snapshot, no unattended edit."""
+    import os
+    import time
+    path = MemoryStore._path_for(target)
+    hist = _private_dir(history_dir())
+    raw = path.read_bytes() if path.exists() else b""
+    existing = sorted(hist.glob(f"*-{path.name}"))
+    if existing and existing[-1].read_bytes() == raw:
+        return existing[-1]
+    stamp = time.strftime("%Y%m%dT%H%M%S", time.gmtime()) + f".{time.time_ns() % 1_000_000_000:09d}Z"
+    dest = hist / f"{stamp}-{path.name}"
+    fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, "wb") as fh:
+        fh.write(raw)
+    cutoff = time.time() - HISTORY_KEEP_SECONDS
+    for old in sorted(hist.glob(f"*-{path.name}"))[:-HISTORY_KEEP]:
+        try:
+            if _snapshot_time(old) < cutoff:
+                old.unlink()
+        except OSError:
+            logger.debug("Could not prune memory snapshot %s", old, exc_info=True)
+    return dest
+
+
+def _log_consolidation(event: dict[str, Any]) -> None:
+    """One JSON line per unattended consolidation in memories/.history/consolidations.jsonl,
+    plus the agent log. Best-effort."""
+    import time
+    event = {"ts": time.time(), **event}
+    logger.info("memory: unattended consolidation %s (%s on %s, backup %s%s)", event.get("result"),
+                event.get("action"), event.get("target"), event.get("backup"),
+                f", {event['reason']}" if event.get("reason") else "")
+    try:
+        log = _private_dir(history_dir()) / "consolidations.jsonl"
+        lines = log.read_text(encoding="utf-8").splitlines()[-(HISTORY_KEEP * 20 - 1):] if log.exists() else []
+        lines.append(json.dumps(event, ensure_ascii=False))
+        from utils import atomic_write_text
+        atomic_write_text(log, "\n".join(lines) + "\n", mode=0o600)
+    except Exception:
+        logger.debug("Could not append to the consolidation log", exc_info=True)
+
+
+def _removal_cap_reason(payload: dict[str, Any]) -> Optional[str]:
+    """Why a pinned consolidation is too large to apply unattended, or None. Projects the
+    payload onto the store file as it is now: over the cap when it removes more than
+    MAX_REMOVED_ENTRIES of the entries or shrinks the file by more than MAX_SHRINK_CHARS of its
+    characters. An op that no longer applies is left to the real write to report (None)."""
+    from tools.memory_tool_store import ENTRY_DELIMITER as delim
+    target = payload.get("target", "memory")
+    raw, read_ok = MemoryStore._read_raw_checked(MemoryStore._path_for(target))
+    if not read_ok:
