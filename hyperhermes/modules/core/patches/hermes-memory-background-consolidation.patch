+    chars_before, chars_after = len(delim.join(before)), len(delim.join(working))
+    if before and removed > MAX_REMOVED_ENTRIES * len(before):
+        return f"removes {removed} of {len(before)} entries (cap {int(MAX_REMOVED_ENTRIES * 100)}%)"
+    if chars_before and chars_before - chars_after > MAX_SHRINK_CHARS * chars_before:
+        return (f"shrinks the file from {chars_before} to {chars_after} chars "
+                f"(cap {int(MAX_SHRINK_CHARS * 100)}%)")
+    return None
+
