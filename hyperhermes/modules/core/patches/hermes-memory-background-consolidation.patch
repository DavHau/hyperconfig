+                            f"{target}); {reason}"[:200], origin=wa.current_origin())
+    return json.dumps({"success": True, "staged": True, "proposal_staged": True, "pending_id": record["id"],
+                       "message": f"The consolidation was staged for approval ({reason}); review it with "
+                                  "/memory pending."}, ensure_ascii=False)
+
