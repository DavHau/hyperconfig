@@ -0,0 +1,289 @@
+"""hyperhermes: memory.background_consolidation. Under "auto" an unattended background-review
+patch/remove applies at once (pinned entries only) with a snapshot in memories/.history/ and a
+log line, unless it removes more than half the entries or 40% of the characters (then staged);
+under "stage" (upstream default) it is staged for /memory approve as before. Start-up replay
+keeps a dropped record whole in memories/.history/dropped/ and a store read failure pending."""
+
+import json
+import time
+
+import pytest
+
+from tools import memory_tool as mt
+from tools.memory_tool import MemoryStore, memory_tool, replay_background_pending
+from tools.skill_provenance import reset_current_write_origin, set_current_write_origin
+
+
+@pytest.fixture()
+def store(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    mem = tmp_path / "memories"
+    mem.mkdir()
+    monkeypatch.setattr("tools.memory_tool.get_memory_dir", lambda: mem)
+    s = MemoryStore(memory_char_limit=500, user_char_limit=300)
+    s.load_from_disk()
+    return s
+
+
+def _mode(monkeypatch, value, write_approval=False):
+    cfg = {"memory": {"write_approval": write_approval}}
+    if value is not None:
+        cfg["memory"]["background_consolidation"] = value
+    monkeypatch.setattr(mt, "get_builtin_memory_config", lambda config=None: cfg["memory"])
+    monkeypatch.setattr("tools.write_approval.write_approval_enabled", lambda sub: write_approval)
+
+
+def _bg(**kwargs):
+    token = set_current_write_origin("background_review")
+    try:
+        return json.loads(memory_tool(**kwargs))
+    finally:
+        reset_current_write_origin(token)
+
+
+def _pending():
+    from tools.write_approval import MEMORY, list_pending
+    return list_pending(MEMORY)
+
+
+def test_default_is_stage(store, monkeypatch):
+    _mode(monkeypatch, None)
+    assert mt.background_consolidation_mode() == "stage"
+    store.add("memory", "old fact to drop")
+    result = _bg(action="remove", old_text="old fact", store=store)
+    assert result["staged"] is True and result["proposal_staged"] is True
+    assert "old fact to drop" in store._entries_for("memory")
+    assert len(_pending()) == 1
+    assert not mt.history_dir().exists()
+
+
+def test_stage_mode_stages_patch(store, monkeypatch):
+    _mode(monkeypatch, "stage")
+    store.add("memory", "entry to rewrite")
+    result = _bg(action="patch", old_text="to rewrite", content="rewritten", store=store)
+    assert result["staged"] is True
+    assert "entry to rewrite" in store._entries_for("memory")
+
+
+FILLER = ["a long standing fact about the environment", "another durable convention to keep",
+          "a third entry that nobody touches"]
+
+
+def _fill(store, target="memory"):
+    for entry in FILLER:
+        store.add(target, entry)
+
+
+def test_auto_applies_remove_with_backup(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    store.add("memory", "old fact to drop")
+    store.add("memory", "fact to keep")
+    _fill(store)
+    before = mt.MemoryStore._path_for("memory").read_text()
+    result = _bg(action="remove", old_text="old fact", store=store)
+    assert result["success"] is True and not result.get("staged")
+    assert result["background_consolidation"] == "applied"
+    assert store._entries_for("memory") == ["fact to keep", *FILLER]
+    assert _pending() == []
+    snaps = sorted(mt.history_dir().glob("*-MEMORY.md"))
+    assert len(snaps) == 1 and snaps[0].read_text() == before
+    assert (snaps[0].stat().st_mode & 0o777) == 0o600
+    log = [json.loads(l) for l in (mt.history_dir() / "consolidations.jsonl").read_text().splitlines()]
+    assert log[-1]["result"] == "applied" and log[-1]["backup"] == str(snaps[0])
+
+
+def test_auto_applies_batch_patch_and_add(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    store.add("user", "Name: Alice, likes tea")
+    result = _bg(target="user", operations=[
+        {"action": "patch", "old_text": "likes tea", "content": "likes coffee"},
+        {"action": "add", "content": "Works nights"}], store=store)
+    assert result["success"] is True, result
+    assert store._entries_for("user") == ["Name: Alice, likes coffee", "Works nights"]
+    assert len(list(mt.history_dir().glob("*-USER.md"))) == 1
+
+
+def test_auto_unmatched_errors_without_backup(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    store.add("memory", "something")
+    result = _bg(action="remove", old_text="not there", store=store)
+    assert result["success"] is False
+    assert store._entries_for("memory") == ["something"]
+    assert not list(mt.history_dir().glob("*.md")) if mt.history_dir().exists() else True
+    assert _pending() == []
+
+
+def test_write_approval_on_keeps_staging(store, monkeypatch):
+    _mode(monkeypatch, "auto", write_approval=True)
+    assert mt.background_consolidation_mode() == "stage"
+
+
+def test_foreground_unaffected(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    store.add("memory", "entry a user removes")
+    result = json.loads(memory_tool(action="remove", old_text="user removes", store=store))
+    assert result["success"] is True and "background_consolidation" not in result
+    assert not mt.history_dir().exists()
+
+
+def test_history_keeps_last_n_beyond_30_days(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    _fill(store)
+    monkeypatch.setattr(mt, "HISTORY_KEEP", 3)
+    hist = mt.history_dir()
+    hist.mkdir(parents=True)
+    for day in range(1, 6):  # five snapshots from 2001: older than 30 days
+        (hist / f"200101{day:02d}T000000.000000000Z-MEMORY.md").write_text(f"old {day}")
+    recent = time.strftime("%Y%m%dT%H%M%S", time.gmtime(time.time() - 86400))
+    (hist / f"{recent}.000000000Z-MEMORY.md").write_text("recent")
+    for i in range(3):
+        store.add("memory", f"fact number {i}")
+        assert _bg(action="remove", old_text=f"fact number {i}", store=store)["success"] is True
+    names = sorted(p.name for p in hist.glob("*-MEMORY.md"))
+    # newest 3 (all made now) + every snapshot of the last 30 days (the one from yesterday)
+    assert len(names) == 4 and names[0].startswith(recent)
+    assert not any(n.startswith("2001") for n in names)
+
+
+def test_identical_snapshot_skipped(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    _fill(store)
+    first = mt.backup_memory_file("memory")
+    assert mt.backup_memory_file("memory") == first
+    assert len(list(mt.history_dir().glob("*-MEMORY.md"))) == 1
+    store.add("memory", "something new")
+    assert mt.backup_memory_file("memory") != first
+    assert len(list(mt.history_dir().glob("*-MEMORY.md"))) == 2
+
+
+def test_history_permissions(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    store.add("memory", "old fact to drop")
+    _fill(store)
+    assert _bg(action="remove", old_text="old fact", store=store)["success"] is True
+    hist = mt.history_dir()
+    assert (hist.stat().st_mode & 0o777) == 0o700
+    files = list(hist.iterdir())
+    assert files and all((f.stat().st_mode & 0o777) == 0o600 for f in files if f.is_file())
+
+
+def test_snapshot_failure_stages(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    store.add("memory", "old fact to drop")
+    _fill(store)
+
+    def boom(target):
+        raise OSError("disk full")
+    monkeypatch.setattr(mt, "backup_memory_file", boom)
+    result = _bg(action="remove", old_text="old fact", store=store)
+    assert result["staged"] is True and "snapshot failed" in result["message"]
+    assert "old fact to drop" in store._entries_for("memory")
+    pend = _pending()
+    assert len(pend) == 1 and pend[0]["payload"]["matched_entry"] == "old fact to drop"
+
+
+def test_cap_too_many_entries_stages(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    for e in ("aa", "bb", "cc", "dd"):
+        store.add("memory", e)
+    # 3 of 4 entries: over the 50% cap -> staged, file unchanged, logged.
+    result = _bg(operations=[{"action": "remove", "old_text": e} for e in ("aa", "bb", "cc")], store=store)
+    assert result["staged"] is True and "removes 3 of 4" in result["message"]
+    assert store._entries_for("memory") == ["aa", "bb", "cc", "dd"]
+    assert len(_pending()) == 1
+    log = [json.loads(l) for l in (mt.history_dir() / "consolidations.jsonl").read_text().splitlines()]
+    assert log[-1]["result"] == "staged" and "removes 3 of 4" in log[-1]["reason"]
+
+
+def test_cap_boundaries(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    entries = ["x" * 40, "y" * 40, "z" * 100, "w" * 100]  # 289 chars with delimiters
+    for e in entries:
+        store.add("memory", e)
+    # 2 of 4 entries (50%, allowed), 289 -> 203 chars (30% shrink, allowed): applied.
+    result = _bg(operations=[{"action": "remove", "old_text": "x" * 40}, {"action": "remove", "old_text": "y" * 40}],
+                 store=store)
+    assert result.get("background_consolidation") == "applied", result
+    # 1 of 2 (50%) but 203 -> 100 chars (51% shrink): staged.
+    result = _bg(action="remove", old_text="z" * 100, store=store)
+    assert result["staged"] is True and "shrinks the file" in result["message"]
+    assert store._entries_for("memory") == ["z" * 100, "w" * 100]
+
+
+def test_cap_counts_patch_shrink(store, monkeypatch):
+    _mode(monkeypatch, "auto")
+    store.add("memory", "k" * 100)
+    store.add("memory", "short")
+    result = _bg(action="patch", old_text="k" * 100, content="k", store=store)
+    assert result["staged"] is True and "shrinks the file" in result["message"]
+    assert store._entries_for("memory") == ["k" * 100, "short"]
+
+
+def test_replay_applies_matching_and_drops_stale(store, monkeypatch):
+    _mode(monkeypatch, "stage")
+    store.add("memory", "stale A")
+    store.add("memory", "stale B")
+    store.add("memory", "kept C")
+    _bg(action="remove", old_text="stale A", store=store)
+    _bg(action="patch", old_text="stale B", content="fresh B", store=store)
+    from tools.write_approval import MEMORY, stage_write
+    stage_write(MEMORY, {"action": "add", "target": "memory", "content": "fg"}, summary="fg", origin="foreground")
+    # B changes before the replay: its pinned entry no longer matches.
+    store.patch("memory", "stale B", "edited B")
+    assert len(_pending()) == 3
+    # Nothing happens while the mode is still stage.
+    assert replay_background_pending(store) == {"applied": 0, "dropped": 0, "kept": 0}
+    _mode(monkeypatch, "auto")
+    counts = replay_background_pending(store)
+    assert counts == {"applied": 1, "dropped": 1, "kept": 1}
+    assert store._entries_for("memory") == ["edited B", "kept C"]
+    left = _pending()
+    assert len(left) == 1 and left[0]["origin"] == "foreground"
+    assert len(list(mt.history_dir().glob("*-MEMORY.md"))) == 2
+
+
+def test_replay_keeps_full_dropped_record(store, monkeypatch):
+    _mode(monkeypatch, "stage")
+    store.add("memory", "stale B")
+    _fill(store)
+    _bg(operations=[{"action": "patch", "old_text": "stale B", "content": "fresh B"},
+                    {"action": "add", "content": "a new fact from the review"}], store=store)
+    (rec,) = _pending()
+    store.patch("memory", "stale B", "edited B")
+    _mode(monkeypatch, "auto")
+    assert replay_background_pending(store) == {"applied": 0, "dropped": 1, "kept": 0}
+    kept = mt.history_dir() / "dropped" / f"{rec['id']}.json"
+    assert (kept.stat().st_mode & 0o777) == 0o600
+    assert ((mt.history_dir() / "dropped").stat().st_mode & 0o777) == 0o700
+    saved = json.loads(kept.read_text())
+    assert saved["payload"]["operations"][1]["content"] == "a new fact from the review"
+    log = [json.loads(l) for l in (mt.history_dir() / "consolidations.jsonl").read_text().splitlines()]
+    assert log[-1]["result"] == "dropped" and log[-1]["dropped_record"] == str(kept)
+    assert _pending() == []
+
+
+def test_replay_read_failure_keeps_pending(store, monkeypatch):
+    _mode(monkeypatch, "stage")
+    store.add("memory", "stale A")
+    _fill(store)
+    _bg(action="remove", old_text="stale A", store=store)
+    _mode(monkeypatch, "auto")
+    monkeypatch.setattr(mt.MemoryStore, "_read_raw_checked", staticmethod(lambda path: ("", False)))
+    assert replay_background_pending(store) == {"applied": 0, "dropped": 0, "kept": 1}
+    assert len(_pending()) == 1
+    assert not (mt.history_dir() / "dropped").exists()
+
+
+def test_replay_dropped_copy_failure_keeps_pending(store, monkeypatch):
+    _mode(monkeypatch, "stage")
+    store.add("memory", "stale A")
+    _fill(store)
+    _bg(action="remove", old_text="stale A", store=store)
+    store.patch("memory", "stale A", "edited A")
+    _mode(monkeypatch, "auto")
+
+    def boom(rec):
+        raise OSError("disk full")
+    monkeypatch.setattr(mt, "_keep_dropped", boom)
+    assert replay_background_pending(store) == {"applied": 0, "dropped": 0, "kept": 1}
+    assert len(_pending()) == 1
