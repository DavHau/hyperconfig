+def _apply_background_consolidation(store: MemoryStore, payload: dict[str, Any], action: str,
+                                    target: str) -> str:
+    """Apply an unattended patch/remove (single or batch) directly: pin it to the entries it
+    selects now (no match = the same error the direct write returns), check the removal cap,
+    snapshot the store file, then replay through ``apply_memory_pending`` so only those exact
+    entries change. Over the cap, or with a failed snapshot, it is staged as upstream does."""
+    if (unmatched := _pin_matched_entries(store, payload)) is not None:
+        return unmatched
+    ops = [_batch_op_line(op) for op in destructive_ops(payload)]
+    if (reason := _removal_cap_reason(payload)) is not None:
+        _log_consolidation({"result": "staged", "action": action, "target": target, "reason": reason, "ops": ops})
+        return _stage_background(payload, action, target, reason)
+    try:
+        backup = backup_memory_file(target)
+    except Exception:
+        logger.warning("Memory snapshot failed; staging the background consolidation instead", exc_info=True)
+        return _stage_background(payload, action, target, "snapshot failed")
+    result = apply_memory_pending(payload, store)
+    _log_consolidation({"result": "applied" if result.get("success") else "failed", "action": action,
+                        "target": target, "backup": str(backup), "ops": ops,
+                        **({} if result.get("success") else {"error": result.get("error", "")})})
+    if result.get("success"):
+        result["background_consolidation"] = "applied"
+        result["backup"] = str(backup)
+    return json.dumps(result, ensure_ascii=False)
+
+
+def _keep_dropped(rec: dict[str, Any]) -> Path:
+    """Write a pending record about to be dropped, payload and all (its adds included), to
+    memories/.history/dropped/<id>.json, 0600. Raises on failure: no copy, no drop."""
+    import os
+    import re
+    rid = re.sub(r"[^A-Za-z0-9_-]", "_", str(rec.get("id") or "")) or "noid"
+    dest = _private_dir(history_dir() / "dropped") / f"{rid}.json"
+    tmp = dest.with_name(f".{dest.name}.tmp")
+    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    with os.fdopen(fd, "w", encoding="utf-8") as fh:
+        json.dump(rec, fh, ensure_ascii=False, indent=2)
+    os.replace(tmp, dest)
+    return dest
+
+
+def replay_background_pending(store: Optional[MemoryStore] = None) -> dict[str, int]:
+    """Settle memory writes the background review staged before ``auto`` was on: oldest first,
+    each through the /memory approve path (pinned entries only) after a snapshot. Applied
+    records are removed; ones that no longer match are copied whole to
+    memories/.history/dropped/<id>.json, then removed. Kept for the next start or /memory
+    pending: foreground records, records over the removal cap, and any whose snapshot,
+    store read or write failed (an I/O error is not a mismatch). No-op unless ``auto``."""
+    counts = {"applied": 0, "dropped": 0, "kept": 0}
+    if background_consolidation_mode() != "auto":
+        return counts
+    from tools import write_approval as wa
+    store = store or load_on_disk_store()
+    for rec in wa.list_pending(wa.MEMORY):
+        payload = rec.get("payload") or {}
+        if rec.get("origin") != "background_review" or not isinstance(payload, dict):
+            counts["kept"] += 1
+            continue
+        target = payload.get("target", "memory")
+        event = {"action": payload.get("action"), "target": target, "pending_id": rec.get("id"),
+                 "ops": [_batch_op_line(op) for op in destructive_ops(payload)]}
+        if target in ("memory", "user") and (reason := _removal_cap_reason(payload)) is not None:
+            counts["kept"] += 1
+            _log_consolidation({"result": "kept", "reason": reason, **event})
+            continue
+        try:
+            backup = str(backup_memory_file(target)) if target in ("memory", "user") else ""
+            FAILURE_CLASS.set("other")
+            result = apply_memory_pending(payload, store)
+        except Exception as exc:
+            counts["kept"] += 1
+            _log_consolidation({"result": "kept", "reason": f"error: {exc}", **event})
+            continue
+        if result.get("success"):
+            counts["applied"] += 1
+            _log_consolidation({"result": "replayed", "backup": backup, **event})
+            wa.discard_pending(wa.MEMORY, rec.get("id", ""))
+            continue
+        if FAILURE_CLASS.get() == "read_failed":
+            counts["kept"] += 1
+            _log_consolidation({"result": "kept", "reason": "store unreadable", "backup": backup,
+                                "error": result.get("error", ""), **event})
+            continue
+        try:
+            kept_at = str(_keep_dropped(rec))
+        except Exception as exc:
+            counts["kept"] += 1
+            _log_consolidation({"result": "kept", "reason": f"could not save the dropped record: {exc}", **event})
+            continue
+        counts["dropped"] += 1
+        _log_consolidation({"result": "dropped", "backup": backup, "dropped_record": kept_at,
+                            "error": result.get("error", ""), **event})
+        wa.discard_pending(wa.MEMORY, rec.get("id", ""))
+    return counts
+
