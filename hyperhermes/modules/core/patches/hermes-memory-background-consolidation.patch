+    ops = (payload.get("operations") or []) if payload.get("action") == "batch" else [payload]
+    working = list(before)
+    for op in ops:
+        op = op or {}
+        act = op.get("action")
+        content, old_text = op.get("content") or op.get("new_text") or "", op.get("old_text") or ""
+        if act != "patch":
