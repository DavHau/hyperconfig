+def _sudo_prompt_disabled() -> bool:
+    """HERMES_SUDO_PROMPT=0 (hyperhermes): never ask a human for a sudo password, on any surface
+    (TUI/desktop/dashboard card, CLI panel, /dev/tty). sudo then runs unchanged, without -S or
+    any password attempt, and fails with "sudo: a password is required"."""
+    value = os.environ.get("HERMES_SUDO_PROMPT")
+    return value is not None and value.strip().lower() in ("0", "false", "no", "off")
