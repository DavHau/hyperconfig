+def test_an_unanswered_confirmation_says_how_to_ask_again(card):
+    """hyperhermes: a timeout is not a refusal: the agent is told nothing was written, that the user must
+    approve, and to call fill again with the same handle (which asks anew); a refusal still says do not retry."""
+    page = _FakePage("https://shop.example/checkout", _CARD_CONTROLS)
+    out = _fill(card, page, decision="cancel")
+    assert "Nothing was written" in out["error"] and "action=fill" in out["error"] and "again" in out["error"]
+    assert "Do not retry" not in out["error"]
+    out = _fill(card, page, decision="decline")
+    assert "Do not retry" in out["error"]
+    assert _fill(card, page)["success"] is True and len(page.writes) == 1
 
 
