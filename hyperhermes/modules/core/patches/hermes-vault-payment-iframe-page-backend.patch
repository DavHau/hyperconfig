+"""hyperhermes: hosted card-field frames on a plugin page backend (Camofox has no CDP).
+
+The frame list comes from the backend's ``child_frames`` (direct children of the page only); which frame may
+take the card is still decided inside the frame: a known processor origin whose only ancestor is the bound
+merchant origin, re-checked in the same script as the write.
+"""
+
+from __future__ import annotations
+
+import json
+from unittest.mock import patch
+
+import pytest
+
+from agent import redact
+from agent.vault_store import VaultStore
+from tools import browser_vault_tool as vault
+
+_CARD = {"card_number": "4242424242424242", "cardholder_name": "A User", "exp_month": "12", "exp_year": "2034",
+         "cvc": "123", "billing_postal_code": "10115"}
+PAGE = "https://shop.test"
+STRIPE = "https://js.stripe.com"
+CARD_CONTROLS = [
+    {"autocomplete": "cc-number", "name": "number", "index": 0, "type": "text"},
+    {"autocomplete": "cc-exp", "name": "expiry", "index": 1, "type": "text"},
+    {"autocomplete": "cc-csc", "name": "cvc", "index": 2, "type": "text"},
+]
+
+
+class FakeCamofox:
+    """A plugin page backend: the merchant page plus child frames, each with its own origin and ancestry.
+    ``frames``: frame_id -> (url, origin, ancestors, controls)."""
+
+    name = "camofox"
+    display_name = "Camofox"
+
+    def __init__(self, frames, *, page_controls=(), page_origin=PAGE, list_error=None):
+        self.frames, self.page_controls, self.page_origin = frames, list(page_controls), page_origin
+        self.list_error = list_error
+        self.writes: list[tuple[str | None, str]] = []
+        self.secret_flags: list[bool] = []
+
+    def has_page(self, task_id):
+        return True
+
+    def evaluate(self, task_id, expression, *, secret):
+        if "location.href" in expression:
+            return self.page_origin + "/checkout"
+        if secret:
+            self.writes.append((None, expression))
+            self.secret_flags.append(secret)
+            return json.dumps({"filled": expression.count('"index"')})
+        return json.dumps(self.page_controls)
+
+    def child_frames(self, task_id):
+        if self.list_error:
+            raise self.list_error
+        return [{"frame_id": fid, "url": url} for fid, (url, *_rest) in self.frames.items()]
+
+    def evaluate_in_frame(self, task_id, frame_id, expression, *, secret):
+        url, origin, ancestors, controls = self.frames[frame_id]
+        if expression == vault._FRAME_CONTEXT_JS:
+            return json.dumps({"origin": origin, "ancestors": ancestors})
+        if secret:
+            self.writes.append((frame_id, expression))
+            self.secret_flags.append(secret)
+            return json.dumps({"filled": expression.count('"index"')})
+        return json.dumps(controls)
+
+
+@pytest.fixture()
+def store(tmp_path):
+    yield VaultStore(base_dir=tmp_path / "vault")
+    redact.clear_vault_redaction_values()
+
+
+def _fill(store, page, consent="accept"):
+    meta = store.add_item(kind="payment", label="Test card", origin=PAGE, secret=_CARD)
+    prompts = []
+
+    def ask(*args, **kwargs):
+        prompts.append(args)
+        return consent
+
+    with patch("agent.vault_store.get_vault_store", return_value=store), \
+         patch.object(vault, "_page_backend", return_value=page), \
+         patch.object(vault, "_ensure_supervisor", side_effect=AssertionError("no CDP on a plugin page")), \
+         patch.object(vault, "_bot_desktop_browser_session", return_value=False), \
+         patch("tools.approval_prompt.request_elicitation_consent", side_effect=ask):
+        raw = vault.browser_vault_fill(meta.id, task_id="t")
+    return raw, json.loads(raw), prompts
+
+
+def test_card_is_filled_into_a_processor_frame_embedded_directly_in_the_merchant_page(store):
+    page = FakeCamofox({"f": (STRIPE + "/v3/inner.html", STRIPE, [PAGE], CARD_CONTROLS)})
+    raw, out, prompts = _fill(store, page)
+    assert out["success"] is True and out["frames"] == [STRIPE], out
+    assert out["fields"] == ["cc-csc", "cc-exp", "cc-number"]
+    assert len(prompts) == 1
+    assert [w[0] for w in page.writes] == ["f"] and page.secret_flags == [True]
+    write = page.writes[0][1]
+    assert _CARD["card_number"] in write and json.dumps(STRIPE) in write and "ancestorOrigins" in write
+    for value in (_CARD["card_number"], _CARD["cvc"], "4242 4242 4242 4242"):
+        assert value not in raw
+
+
+@pytest.mark.parametrize("frame", [
+    # an origin the merchant page (or an attacker) controls, labelled like a card frame
+    ("https://shop.test/card-frame", "https://shop.test", [PAGE], CARD_CONTROLS),
+    ("https://evil.test/v3/inner.html", "https://evil.test", [PAGE], CARD_CONTROLS),
+    # a processor URL whose document is not the processor's (navigated away / spoofed listing)
+    (STRIPE + "/v3/inner.html", "https://evil.test", [PAGE], CARD_CONTROLS),
+    # srcdoc / about:blank / data: frames: the merchant's own or an opaque origin
+    ("about:srcdoc", "null", [PAGE], CARD_CONTROLS),
+    ("about:blank", PAGE, [PAGE], CARD_CONTROLS),
+    ("data:text/html,<input>", "null", [PAGE], CARD_CONTROLS),
+    # a processor frame nested under another origin, or embedded by a page on another origin
+    (STRIPE + "/v3/inner.html", STRIPE, ["https://evil.test", PAGE], CARD_CONTROLS),
+    (STRIPE + "/v3/inner.html", STRIPE, ["https://evil.test"], CARD_CONTROLS),
+])
+def test_no_card_reaches_a_frame_that_is_not_a_direct_processor_child(store, frame):
+    page = FakeCamofox({"f": frame})
+    raw, out, prompts = _fill(store, page)
+    assert out["success"] is False and out["error_type"] == "no_payment_fields", out
+    assert prompts == [] and page.writes == []
+
+
+def test_only_the_processor_frame_gets_the_card_next_to_a_lookalike(store):
+    page = FakeCamofox({
+        "evil": ("https://evil.test/card", "https://evil.test", [PAGE], CARD_CONTROLS),
+        "stripe": (STRIPE + "/v3/inner.html", STRIPE, [PAGE], CARD_CONTROLS),
+    })
+    _raw, out, _prompts = _fill(store, page)
+    assert out["success"] is True
+    assert [w[0] for w in page.writes] == ["stripe"]
+
+
+def test_a_backend_that_cannot_list_frames_fills_nothing(store):
+    page = FakeCamofox({}, list_error=RuntimeError("404 vault-frames"))
+    _raw, out, prompts = _fill(store, page)
+    assert out["error_type"] == "no_payment_fields" and prompts == [] and page.writes == []
+
+
+def test_declined_consent_writes_nothing_into_the_frame(store):
+    page = FakeCamofox({"f": (STRIPE + "/v3/inner.html", STRIPE, [PAGE], CARD_CONTROLS)})
+    _raw, out, prompts = _fill(store, page, consent="decline")
+    assert out["error_type"] == "payment_declined" and len(prompts) == 1 and page.writes == []
+
+
+def test_a_frame_failure_on_the_secret_path_has_fixed_text(store):
+    class Failing(FakeCamofox):
+        def evaluate_in_frame(self, task_id, frame_id, expression, *, secret):
+            if secret:
+                raise RuntimeError("boom " + expression)  # an error that quotes the script (and the card)
+            return super().evaluate_in_frame(task_id, frame_id, expression, secret=secret)
+
+    page = Failing({"f": (STRIPE + "/v3/inner.html", STRIPE, [PAGE], CARD_CONTROLS)})
+    raw, out, _prompts = _fill(store, page)
+    assert out["success"] is False and out["error_type"] == "eval_failed"
+    assert _CARD["card_number"] not in raw and "boom" not in raw
+
+
+def test_grouped_card_numbers_are_redacted(store):
+    page = FakeCamofox({"f": (STRIPE + "/v3/inner.html", STRIPE, [PAGE], CARD_CONTROLS)})
+    _fill(store, page)
+    text = redact.redact_registered_vault_values("field shows 4242 4242 4242 4242 / 4242-4242-4242-4242")
+    assert "4242" not in text
+    assert vault._grouped_card_numbers("378282246310005") == [
+        "3782 8224 6310 005", "3782-8224-6310-005", "3782 822463 10005", "3782-822463-10005"]
+    assert vault._grouped_card_numbers("123") == []
