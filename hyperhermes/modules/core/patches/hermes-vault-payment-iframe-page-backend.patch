+def _grouped_card_numbers(number: Any) -> list[str]:
+    """The forms a card field displays the number in (4-4-4-4, Amex 4-6-5; spaces or dashes), so a later
+    browser result that reads the field back is scrubbed like the bare digits."""
+    digits = "".join(ch for ch in str(number or "") if ch.isdigit())
+    if len(digits) < 12:
+        return []
+    groups = [[digits[i:i + 4] for i in range(0, len(digits), 4)]]
+    if len(digits) == 15:
+        groups.append([digits[:4], digits[4:10], digits[10:]])
+    return [sep.join(g) for g in groups for sep in (" ", "-")]
+
