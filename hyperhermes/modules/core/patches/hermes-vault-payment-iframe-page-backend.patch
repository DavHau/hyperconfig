+def _page_frame_eval(backend: Any, task_id: str, frame_id: str, expression: str, *, secret: bool) -> dict[str, Any]:
+    """Evaluate inside one iframe of a plugin page backend's page (``child_frames``); same secret contract as
+    :func:`_page_eval`: page errors stay in-page and any failure on the secret path gets fixed text."""
+    if secret:
