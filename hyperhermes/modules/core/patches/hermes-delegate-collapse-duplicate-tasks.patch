         return None, f"tasks must be a JSON array of task objects; parsed {type(parsed).__name__} instead."
     return parsed, None
 
+def _task_goal_key(task: Any) -> str:
+    """Normalized goal of a model-supplied task entry ('' when missing, blank or not a string)."""
+    goal = task.get("goal") if isinstance(task, dict) else None
+    return " ".join(goal.split()) if isinstance(goal, str) else ""
+
+
+def _is_empty_value(value: Any) -> bool:
+    return value is None or value in ([], {}) or (isinstance(value, str) and not value.strip())
+
+
+def _is_empty_task(task: Any) -> bool:
+    """An entirely empty entry: null, "", {} or an object whose values are all empty (a goal-less entry with any
+    non-empty field is NOT empty: validation must still reject it)."""
+    if isinstance(task, dict):
+        return all(_is_empty_value(v) for v in task.values())
+    return _is_empty_value(task)
+
+
+# Fields that may differ between copies of one entry: `group` only changes how results are delivered; `context` is
+# reconciled separately (identical after whitespace normalization, or empty in all but one copy).
+_COLLAPSE_IGNORED_FIELDS = frozenset({"goal", "group", "context"})
+
+
+def _task_identity(task: dict) -> str:
+    """Normalized goal + canonical JSON of every other model-supplied field except group/context (null = absent)."""
+    rest = {k: v for k, v in task.items() if k not in _COLLAPSE_IGNORED_FIELDS and v is not None}
+    return json.dumps([_task_goal_key(task), rest], sort_keys=True, ensure_ascii=False, default=repr)
+
+
+def _context_key(context: Any) -> str:
+    if _is_empty_value(context):
+        return ""
+    if isinstance(context, str):
+        return " ".join(context.split())
+    return json.dumps(context, sort_keys=True, ensure_ascii=False, default=repr)
+
+
+def _labels(indexes: list[int]) -> str:
+    return ("Task " if len(indexes) == 1 else "Tasks ") + ", ".join(map(str, indexes))
+
+
+def _collapse_duplicate_tasks(tasks: Any) -> tuple[Any, Optional[str], Optional[list[int]]]:
+    """``(tasks, note, origin)``: a model-supplied ``tasks`` array with repeated entries collapsed and entirely
+    empty strays dropped. Copies are the same task when the normalized goal (stripped, whitespace collapsed; case
+    kept) AND every other field except ``group`` and ``context`` are equal as canonical JSON. Copies whose contexts
+    are equal after whitespace normalization collapse to one; copies with different non-empty contexts all stay; a
+    bare copy (empty context) folds into the first copy carrying context, or, when no copy carries context, into
+    the first bare copy. The kept entry sits at the first copy's position. Entirely empty entries (null, "", {},
+    all values empty) are dropped while one other entry remains. ``note`` numbers tasks 0-based like the errors
+    (``Task <i>`` = index in the model's array); ``origin[i]`` is the original index of kept entry ``i`` (map error
+    indexes back with ``_map_task_indexes``). Nothing changed: ``(tasks, None, None)`` with ``tasks`` as passed.
+    Identical runs on purpose stay possible with distinct goals."""
+    recovered, error = _recover_tasks_from_json_string(tasks)
+    items = recovered if recovered is not None and not error else tasks
+    if not isinstance(items, list) or len(items) < 2:
+        return tasks, None, None
+    empty = [i for i, t in enumerate(items) if _is_empty_task(t)]
+    if len(empty) == len(items):
+        return tasks, None, None  # nothing to run: the normal validation reports it
+
+    # Bucket identical entries: identity -> {context key -> [original indexes]}.
+    buckets: dict[str, dict[str, list[int]]] = {}
+    for i, task in enumerate(items):
+        if i not in empty and isinstance(task, dict) and _task_goal_key(task):
+            buckets.setdefault(_task_identity(task), {}).setdefault(_context_key(task.get("context")), []).append(i)
+    survivor: dict[int, int] = {}  # first copy's index -> index of the copy kept there
+    dropped: dict[int, list[int]] = {}  # index of the copy kept -> indexes of the copies dropped
+    for by_context in buckets.values():
+        bare = by_context.pop("", [])
+        groups = sorted((sorted(g) for g in by_context.values()), key=lambda g: g[0])
+        if groups:  # bare copies fold into the first copy carrying context (the first context group's head)
+            groups[0] = [groups[0][0], *sorted(groups[0][1:] + bare)]
+        elif bare:
+            groups = [bare]
+        for group in groups:
+            if len(group) < 2:
+                continue
+            keep = group[0]  # the first context copy (or, all bare, the first copy)
+            survivor[min(group)] = keep
+            dropped[keep] = [i for i in group if i != keep]
+    if not dropped and not empty:
+        return tasks, None, None
+
+    skip = set(empty) | {i for keep, copies in dropped.items() for i in (keep, *copies)}  # copies sit at survivor
+    kept: list[Any] = []
+    origin: list[int] = []
+    for i, task in enumerate(items):
+        if i in survivor:  # the first copy's slot holds the copy kept
+            kept.append(items[survivor[i]])
+            origin.append(survivor[i])
+        elif i not in skip:
+            kept.append(task)
+            origin.append(i)
+    parts = [f"dropped {_labels(copies)} (same task as Task {keep})"
+             for keep, copies in sorted(dropped.items(), key=lambda kv: min(kv[0], *kv[1]))]
+    if empty:
+        parts.append(f"dropped empty {_labels(empty)}")
+    note = (f"{'; '.join(parts)}; {len(kept)} of {len(items)} kept (Task <i> = 0-based index in your tasks array, "
+            f"as in errors).")
+    if dropped:
+        note += " To run identical copies on purpose, number the goals (e.g. 'Attempt 2: ...')."
+    return kept, note, origin
+
+
+_TASK_INDEX_RE = re.compile(r"\ATask (\d+)(?=[ :])")
+
+
+def _map_task_indexes(message: str, origin: Optional[list[int]]) -> str:
+    """One error string with its leading ``Task <i>`` (index into the collapsed list) mapped back to the model's
+    original array. Only the label opening the string is rewritten, never a ``Task <i>`` later in it (quoted from a
+    goal or a backend's message): map every error separately BEFORE joining several."""
+    if not origin or not isinstance(message, str):
+        return message
+    def _sub(m: re.Match) -> str:
+        i = int(m.group(1))
+        return f"Task {origin[i]}" if 0 <= i < len(origin) else m.group(0)
+    return _TASK_INDEX_RE.sub(_sub, message, count=1)
+
+
