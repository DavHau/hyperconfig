+def _with_dedup_note(result: str, note: Optional[str]) -> str:
+    """*result* (tool result JSON) with *note* prepended to its ``note`` (unchanged when there is none)."""
+    if not note:
+        return result
+    try:
+        payload = json.loads(result)
+    except (TypeError, ValueError):
+        return result
+    if not isinstance(payload, dict):
+        return result
+    payload["note"] = f"{note} {payload['note']}" if payload.get("note") else note
+    return json.dumps(payload, ensure_ascii=False)
 
 
