@@ -0,0 +1,196 @@
+"""delegate_task collapses repeated task entries (same normalized goal and every other field but group/context) and
+drops entirely empty strays before anything spawns, and tells the model in the result's ``note`` (hyperhermes patch)."""
+
+import json
+import threading
+from unittest.mock import MagicMock, patch
+
+from tools.delegate_tool_tasks import _collapse_duplicate_tasks, _map_task_indexes
+
+GOAL = "Make a TV panel show a full-screen, correctly scaled image from our GOP graphics layer"
+OTHER = "Write regression tests for the session expiry watcher"
+
+
+def _parent():
+    parent = MagicMock()
+    parent.base_url, parent.api_key, parent.provider = "https://openrouter.ai/api/v1", "k", "openrouter"
+    parent.api_mode, parent.model, parent.platform = "chat_completions", "anthropic/claude-sonnet-4", "cli"
+    parent.providers_allowed = parent.providers_ignored = parent.providers_order = parent.provider_sort = None
+    parent._session_db, parent._delegate_depth, parent._active_children = None, 0, []
+    parent._active_children_lock = threading.Lock()
+    parent._print_fn = parent.tool_progress_callback = parent.thinking_callback = None
+    return parent
+
+
+def _spawn(tasks, run_result=None):
+    """``(tool result, task_list the batch was built with)``; nothing runs."""
+    batches = []
+    with patch("tools.delegate_tool._run_batch",
+               side_effect=lambda batch, background: batches.append(batch) or json.dumps(run_result or {"status": "built"})):
+        from tools.delegate_tool import delegate_task
+        result = json.loads(delegate_task(tasks=tasks, parent_agent=_parent()))
+    return result, (batches[0].task_list if batches else None)
+
+
+def test_twenty_identical_entries_spawn_one_child():
+    result, task_list = _spawn([{"goal": GOAL} for _ in range(20)])
+    assert task_list == [{"goal": GOAL}]
+    assert result["status"] == "built"
+    assert result["note"].startswith(
+        "dropped Tasks " + ", ".join(str(i) for i in range(1, 20)) + " (same task as Task 0); 1 of 20 kept")
+    assert "number the goals" in result["note"]
+
+
+def test_goal_only_copies_collapse_into_the_copy_with_context_whatever_its_position():
+    with_ctx = {"goal": "  " + GOAL.replace(" ", "  ") + "\n", "context": "5 KB of findings"}
+    result, task_list = _spawn([{"goal": GOAL}, {"goal": GOAL, "context": ""}, with_ctx])
+    assert task_list == [with_ctx]
+    assert result["note"].startswith("dropped Tasks 0, 1 (same task as Task 2); 1 of 3 kept")
+
+
+def test_contexts_equal_after_whitespace_normalization_collapse():
+    tasks = [{"goal": GOAL, "context": "line one\nline two"}, {"goal": GOAL, "context": "  line one line   two "}]
+    assert _collapse_duplicate_tasks(tasks)[0] == [tasks[0]]
+
+
+def test_different_contexts_stay_separate():
+    tasks = [{"goal": GOAL, "context": "TV in the living room"}, {"goal": GOAL, "context": "TV in the bedroom"}]
+    assert _collapse_duplicate_tasks(tasks) == (tasks, None, None)
+    # bare copies fold into the first context copy; copies with different contexts all stay
+    tasks = [{"goal": GOAL}, {"goal": GOAL, "context": "ctx A"}, {"goal": GOAL, "context": "ctx B"}]
+    kept, note, origin = _collapse_duplicate_tasks(tasks)
+    assert kept == tasks[1:] and origin == [1, 2] and note.startswith("dropped Task 0 (same task as Task 1); 2 of 3")
+    tasks = [{"goal": GOAL, "context": "A"}, {"goal": GOAL}, {"goal": GOAL, "context": "A"},
+             {"goal": GOAL, "context": "B"}, {"goal": GOAL, "context": None}]
+    kept, note, origin = _collapse_duplicate_tasks(tasks)
+    assert kept == [tasks[0], tasks[3]] and origin == [0, 3]
+    assert note.startswith("dropped Tasks 1, 2, 4 (same task as Task 0); 2 of 5 kept")
+    # the first context copy is the context group appearing first, not the bigger one
+    tasks = [{"goal": GOAL, "context": "B"}, {"goal": GOAL, "context": "A"}, {"goal": GOAL, "context": "A"}, {"goal": GOAL}]
+    kept, note, origin = _collapse_duplicate_tasks(tasks)
+    assert origin == [0, 1] and "dropped Task 3 (same task as Task 0); dropped Task 2 (same task as Task 1)" in note
+
+
+def test_entries_differing_in_any_other_field_stay_separate():
+    for a, b in [
+        ({"toolsets": ["terminal"]}, {"toolsets": ["web"]}),
+        ({"output_schema": {"type": "object"}}, {"images": ["/tmp/a.png"]}),
+        ({"model": "a"}, {"model": "b"}),
+        ({"model": "a"}, {}),
+        ({"provider": "x"}, {"provider": "y"}),
+        ({"role": "leaf"}, {"role": "orchestrator"}),
+        ({"reasoning_effort": "low"}, {"reasoning_effort": "high"}),
+        ({"anything_else": 1}, {"anything_else": 2}),
+    ]:
+        tasks = [{"goal": GOAL, **a}, {"goal": GOAL, **b}]
+        assert _collapse_duplicate_tasks(tasks) == (tasks, None, None), (a, b)
+
+
+def test_group_and_key_order_do_not_prevent_a_collapse():
+    a = {"goal": GOAL, "group": "g1", "toolsets": ["web", "terminal"], "output_schema": {"a": 1, "b": 2}}
+    b = {"output_schema": {"b": 2, "a": 1}, "toolsets": ["web", "terminal"], "goal": GOAL, "group": "g2"}
+    assert _collapse_duplicate_tasks([a, b])[0] == [a]
+
+
+def test_empty_strays_are_dropped_instead_of_failing_the_batch():
+    result, task_list = _spawn([{"goal": GOAL}, {}, None, {"goal": "   ", "context": ""}, "", {"goal": OTHER}])
+    assert "error" not in result
+    assert task_list == [{"goal": GOAL}, {"goal": OTHER}]
+    assert result["note"] == "dropped empty Tasks 1, 2, 3, 4; 2 of 6 kept (Task <i> = 0-based index in your tasks array, as in errors)."
+
+
+def test_a_goalless_entry_with_content_still_fails_the_batch():
+    result, task_list = _spawn([{"goal": GOAL}, {"context": "x"}])
+    assert task_list is None and result["error"] == "Task 1 is missing a 'goal'."
+
+
+def test_error_indexes_refer_to_the_original_array_and_carry_the_note():
+    result, task_list = _spawn([{"goal": GOAL}, {"goal": GOAL}, {}, {"goal": OTHER}, {"goal": "TODO"}])
+    assert task_list is None
+    assert result["error"].startswith("Task 4 has a placeholder goal")
+    assert result["note"].startswith("dropped Task 1 (same task as Task 0); dropped empty Task 2; 3 of 5 kept")
+    result, _ = _spawn([{}, {"goal": GOAL}, {"context": "x"}])
+    assert result["error"] == "Task 2 is missing a 'goal'." and result["note"].startswith("dropped empty Task 0;")
+
+
+def test_map_task_indexes_rewrites_only_sentence_leading_labels():
+    origin = [0, 3, 7]
+    assert _map_task_indexes("Task 1: bad effort.", origin) == "Task 3: bad effort."
+    assert _map_task_indexes("Task 2 is missing a 'goal'.", origin) == "Task 7 is missing a 'goal'."
+    # only the label opening the string: never one inside a backend's message or a quoted goal
+    assert _map_task_indexes("Task 1: backend x failed: boom Task 2: other", origin) == \
+        "Task 3: backend x failed: boom Task 2: other"
+    assert _map_task_indexes("Task 2 has a placeholder goal ('a. Task 1 b'). Replace", origin) == \
+        "Task 7 has a placeholder goal ('a. Task 1 b'). Replace"
+    assert _map_task_indexes("x. Task 1: later", origin) == "x. Task 1: later"
+    assert _map_task_indexes("Task 10: out of range", origin) == "Task 10: out of range"
+    assert _map_task_indexes("Task 1: x", None) == "Task 1: x"
+
+
+def _routes(errors):
+    from tools.delegate_tool_routes import TaskRoute
+    return [TaskRoute({}, {}, backend="b", error=e) for e in errors]
+
+
+def test_all_routes_refused_maps_each_error_before_joining():
+    """Every route refused: each error is mapped on its own, so a 'Task <i>' inside one backend message is never
+    taken for a label once the errors are joined."""
+    tasks = [{"goal": GOAL}, {"goal": GOAL}, {"goal": OTHER}, {"goal": OTHER + " twice"}]
+    errors = ["Task 0: backend b failed: boom Task 2", "Task 1: backend b failed: a. Task 0 b", "Task 2: no"]
+    with patch("tools.delegate_tool._routes_for", return_value=(_routes(errors), None)):
+        result, task_list = _spawn(tasks)
+    assert task_list is None
+    assert result["error"] == ("Task 0: backend b failed: boom Task 2 Task 2: backend b failed: a. Task 0 b "
+                               "Task 3: no")
+    assert result["note"].startswith("dropped Task 1 (same task as Task 0); 3 of 4 kept")
+
+
+def test_partially_refused_entry_names_the_original_task():
+    from tools.delegate_tool_routes import TaskRoute
+    tasks = [{"goal": GOAL}, {"goal": GOAL}, {"goal": OTHER}]
+    ok = TaskRoute({}, {}, backend="b")
+    routes = [ok, *_routes(["Task 1: backend b failed: boom Task 0"])]
+    with patch("tools.delegate_tool._routes_for", return_value=(routes, None)), \
+         patch("tools.delegate_tool._build_children", return_value=([], None), create=True):
+        batches = []
+        with patch("tools.delegate_tool._run_batch", side_effect=lambda b, bg: batches.append(b) or json.dumps({})):
+            from tools.delegate_tool import delegate_task
+            delegate_task(tasks=tasks, parent_agent=_parent())
+    [entry] = batches[0].refused
+    # task_index indexes this run's (collapsed) task list like every result entry; the error names the model's task
+    assert entry["task_index"] == 1 and entry["error"] == "Task 2: backend b failed: boom Task 0"
+
+
+def test_distinct_goals_are_untouched_and_get_no_note():
+    tasks = [{"goal": f"Attempt {i}: {GOAL}"} for i in range(1, 4)] + [{"goal": OTHER, "context": "c"}]
+    result, task_list = _spawn(tasks)
+    assert task_list == tasks and "note" not in result
+    assert _collapse_duplicate_tasks(tasks) == (tasks, None, None)
+
+
+def test_the_note_is_prepended_to_an_existing_note():
+    result, _ = _spawn([{"goal": GOAL}, {"goal": GOAL}], run_result={"status": "dispatched", "note": "Running in background."})
+    assert result["note"] == ("dropped Task 1 (same task as Task 0); 1 of 2 kept (Task <i> = 0-based index in your tasks "
+                              "array, as in errors). To run identical copies on purpose, number the goals (e.g. 'Attempt 2: ...'). "
+                              "Running in background.")
+
+
+def test_only_strays_still_fail_with_the_usual_error():
+    result, task_list = _spawn([{}, {"goal": ""}])
+    assert task_list is None and "missing a 'goal'" in result["error"] and "note" not in result
+
+
+def test_a_restart_re_dispatch_is_not_collapsed():
+    from tools.async_delegation import _RESUME_META
+    tasks = [{"goal": GOAL}, {"goal": GOAL}, {"goal": OTHER}]
+    token = _RESUME_META.set({"indexes": [0, 2, 5], "carried": []})
+    try:
+        result, task_list = _spawn(tasks)
+    finally:
+        _RESUME_META.reset(token)
+    assert task_list == tasks and "note" not in result
+
+
+def test_json_string_tasks_are_collapsed_too():
+    kept, note, origin = _collapse_duplicate_tasks(json.dumps([{"goal": GOAL}, {"goal": GOAL}]))
+    assert kept == [{"goal": GOAL}] and origin == [0] and note.startswith("dropped Task 1 (same task as Task 0)")
