+
+def _turns_still_working() -> bool:
+    """A running in-process turn is mid tool call (a running turn without one is between steps or in a
+    model call, which the resumed turn repeats at no loss)."""
+    from tui_gateway.server import _sessions, _sessions_lock
+    with _sessions_lock:
+        running = [s for s in _sessions.values() if isinstance(s, dict) and s.get("running")]
+    return any(getattr(s.get("agent"), "_executing_tools", False) or s.get("_compute_host_turn_id") for s in running)
+
+
+_DRAIN_IDLE_S = 1.0
+
+
+def _install_shutdown_drain(server, dash_cfg: dict) -> None:
+    """Bounded drain on SIGTERM (``dashboard.shutdown_drain_seconds``, default 0 = off): while a turn is
+    in the middle of a tool call, keep serving until the call returns or the budget runs out, then shut
+    down as before (the exit path interrupts the turns, which keep their restart markers and continue in
+    the next process). A tool call cut in half is the one piece of a turn a resume cannot redo safely; a
+    model call can simply be repeated. A second SIGTERM (or SIGINT) skips the rest of the drain. Keep the
+    service manager's stop timeout above the budget, and let it signal only the main process (systemd
+    KillMode=mixed): a group-wide SIGTERM would end the tool's own process anyway."""
+    import signal as _signal
+    try:
+        budget = max(0.0, float(dash_cfg.get("shutdown_drain_seconds", 0) or 0))
+    except (TypeError, ValueError):
+        budget = 0.0
+    if budget <= 0:
+        return
+    original = server.handle_exit
+    draining = threading.Event()
+
+    def handle_exit(sig, frame):
+        if sig != _signal.SIGTERM or draining.is_set() or server.should_exit:
+            return original(sig, frame)
+        try:
+            busy = _turns_still_working()
+        except Exception:
+            busy = False
+        if not busy:
+            return original(sig, frame)
+        draining.set()
+        _log.warning("SIGTERM: draining for up to %.0fs while a turn finishes its tool call", budget)
+
+        def wait() -> None:
+            # Done once no turn has been in a tool call for a full second: between two tool batches of
+            # one turn the flag drops only for the model call in between, which may last less.
+            deadline = time.monotonic() + budget
+            idle_since = None
+            while time.monotonic() < deadline:
+                try:
+                    busy = _turns_still_working()
+                except Exception:
+                    break
+                if busy:
+                    idle_since = None
+                elif idle_since is None:
+                    idle_since = time.monotonic()
+                elif time.monotonic() - idle_since >= _DRAIN_IDLE_S:
+                    break
+                time.sleep(0.2)
+            else:
+                _log.warning("shutdown drain budget (%.0fs) exhausted; interrupting running turns", budget)
+            original(sig, None)
+
+        threading.Thread(target=wait, name="hermes-shutdown-drain", daemon=True).start()
+
+    server.handle_exit = handle_exit
 
 
