+# ── Server-side resume at backend start ─────────────────────────────────
+# A marker or an undelivered subagent result used to wait for a client to reopen its session
+# (session.resume above, the per-session notification poller); a session nobody reopened inside the
+# freshness window lost its turn. With ``desktop.auto_continue.on_startup`` the backend reopens those
+# sessions itself, unattached (the parked-client transport), so the existing auto-continue and the
+# notification poller run without a client; a client that opens the session later attaches to it.
+_STARTUP_RESUME_DELAY_S = 3.0
+_STARTUP_RESUME_MAX_SESSIONS = 16
+
+
+def _startup_resume_enabled() -> bool:
+    desktop = _load_cfg().get("desktop")
+    cfg = desktop.get("auto_continue") if isinstance(desktop, dict) else None
+    return isinstance(cfg, dict) and is_truthy_value(cfg.get("on_startup"), default=False)
+
+
+def _startup_resume_homes() -> list:
+    """``(profile name or None, home)`` for the launch home and every named profile under it."""
+    homes = [(None, Path(_hermes_home))]
+    with contextlib.suppress(Exception):
+        from hermes_cli.profiles import _get_profiles_root
+        root = Path(_get_profiles_root())
+        if root.resolve() != Path(_hermes_home).resolve() and root.is_dir():
+            homes += [(d.name, d) for d in sorted(root.iterdir()) if d.is_dir() and (d / "state.db").exists()]
+    return homes
+
+
+def _startup_resume_targets(home) -> list:
+    """Stored session ids in ``home`` with an unfinished turn (a crash marker whose writer is gone)
+    or an undelivered subagent result."""
+    from tui_gateway import turn_marker as tm
+    enabled, freshness_secs, max_attempts = _auto_continue_config()
+    now, targets = time.time(), []
+    if enabled:
+        with contextlib.suppress(Exception):
+            for key, entry in tm._load(tm._marker_path(home)).items():
+                if (entry.get("auto_continue", True) and int(entry.get("attempts") or 0) < max_attempts
+                        and now - float(entry.get("started_at") or 0) <= freshness_secs
+                        and marker_writer_state(entry) != "alive"):
+                    targets.append(key)
+    db_path = Path(home) / "state.db"
+    if db_path.exists():
+        token = set_hermes_home_override(str(home))
+        try:
+            from tools.async_delegation import recover_abandoned_delegations
+            recover_abandoned_delegations()  # an owner that died with the old process: state -> unknown
+        except Exception:
+            logger.debug("startup resume: delegation recovery failed for %s", home, exc_info=True)
+        finally:
+            reset_hermes_home_override(token)
+        import sqlite3
+        with contextlib.suppress(Exception), contextlib.closing(
+                sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=5)) as conn:
+            rows = conn.execute(
+                "SELECT DISTINCT origin_session FROM async_delegations WHERE delivery_state='pending' "
+                "AND state NOT IN ('running','finalizing') AND event_json IS NOT NULL AND completed_at > ?",
+                (now - max(freshness_secs, 3600.0),)).fetchall()
+            targets += [r[0] for r in rows if r[0]]
+    return list(dict.fromkeys(targets))
+
+
+# The dashboard's own chat surfaces (tui_gateway/agent_factory.py _resolve_session_source): the Desktop
+# app / Webapp chat sends "desktop", a backend without HERMES_DESKTOP (or its embedded terminal) "tui".
+# Anything else (a messaging platform, cron, a one-shot CLI run, the dashboard's "tool" sidecar, a hosted
+# room) has its own owner or none that wants an unattended continuation.
+_STARTUP_RESUME_SOURCES = frozenset({"desktop", "tui"})
+
+
+def _startup_resume_session(profile, home, key: str) -> bool:
+    """Reopen one stored session server-side; True when it was actually reopened here."""
+    profile_home = None if profile is None else Path(home)
+    if _find_live_session_by_key(key, profile_home) is not None:
+        return False
+    row = None
+    with contextlib.suppress(Exception):
+        import sqlite3
+        with contextlib.closing(sqlite3.connect(f"file:{Path(home) / 'state.db'}?mode=ro", uri=True, timeout=5)) as conn:
+            row = conn.execute("SELECT source FROM sessions WHERE id=?", (key,)).fetchone()
+    source = (row[0] or "").strip().lower() if row else ""
+    # No stored row (a messaging-gateway session key) or not a dashboard chat: left to its own owner
+    # (the messaging gateway recovers and delivers its sessions itself).
+    if source not in _STARTUP_RESUME_SOURCES:
+        logger.debug("startup resume: session %s skipped (source %r)", key, source or None)
+        return False
+    params = {"session_id": key, "source": source, **({"profile": profile} if profile else {})}
+    token = bind_transport(_detached_ws_transport)  # unattached: emits are dropped until a client attaches
+    try:
+        resp = handle_request({"jsonrpc": "2.0", "id": f"startup-resume-{key}", "method": "session.resume",
+                               "params": params}) or {}
+    finally:
+        reset_transport(token)
+    result = resp.get("result") if isinstance(resp, dict) else None
+    if not isinstance(result, dict):
+        logger.warning("startup resume of session %s failed: %s", key, (resp or {}).get("error"))
+        return False
+    if (session := _sessions.get(str(result.get("session_id") or ""))) is not None:
+        session["_server_resumed"] = True
+    logger.info("startup resume: reopened session %s (profile %s) server-side; auto_continue=%s",
+                key, profile or "default", result.get("auto_continue"))
+    return True
+
+
+def _startup_auto_continue() -> int:
+    if not _startup_resume_enabled():
+        return 0
+    resumed = 0
+    for profile, home in _startup_resume_homes():
+        for key in _startup_resume_targets(home):
+            if resumed >= _STARTUP_RESUME_MAX_SESSIONS:
+                logger.warning("startup resume: more than %d sessions pending; the rest wait for a client",
+                               _STARTUP_RESUME_MAX_SESSIONS)
+                return resumed
+            try:
+                # Only sessions actually reopened count toward the cap; skipped ones are free.
+                if _startup_resume_session(profile, home, key):
+                    resumed += 1
+            except Exception:
+                logger.warning("startup resume of session %s failed", key, exc_info=True)
+    return resumed
+
+
+def _schedule_startup_auto_continue(delay_s: float | None = None) -> None:
+    """Once per backend process, shortly after it started serving (the dashboard calls this)."""
+    def run() -> None:
+        try:
+            if count := _startup_auto_continue():
+                logger.info("startup resume: %d session(s) reopened server-side", count)
+        except Exception:
+            logger.warning("startup resume failed", exc_info=True)
+    timer = threading.Timer(_STARTUP_RESUME_DELAY_S if delay_s is None else delay_s, run)
+    timer.daemon = True
+    timer.start()
+
+
