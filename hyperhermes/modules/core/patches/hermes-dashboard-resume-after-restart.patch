+def _shutdown_keeps_marker(session: dict, status: str | None = None) -> bool:
+    """True when a backend shutdown (SIGTERM, not a user Stop) interrupted this session's turn and the
+    turn did not complete: its crash marker must survive so the next process auto-continues it. Without
+    this the interrupt the exit path sends made the turn conclude as ``interrupted`` and retire its own
+    marker, so whether a restart resumed the turn depended on whether the process died first."""
+    return bool(session.get("_shutdown_interrupted")) and status != "complete"
+
