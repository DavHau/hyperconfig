diff --git a/tools/process_registry_restart.py b/tools/process_registry_restart.py
new file mode 100644
index 00000000..683fda3c
--- /dev/null
+++ b/tools/process_registry_restart.py
@@ -0,0 +1,263 @@
+"""Background processes that survive a restart of the backend that started them (hyperhermes).
+
+The dashboard (desktop/web chat backend) ran ``terminal(background=true)`` jobs as plain children: in its
+service cgroup (a systemd stop SIGKILLs what is left there), registered with the owner-death supervisor
+(``process_supervisor.sh`` TERMs them when the backend exits), killed by ``agent.close`` on the way out, their
+output on a pipe the backend held, and their checkpoint in ``processes.json``, which only the messaging gateway
+ever re-reads (``recover_from_checkpoint``) and which it rewrites from its own table at boot. So every restart
+killed the dashboard's jobs, nothing told the agent, and ``process_manage`` said "No process with ID".
+
+With ``terminal.background_restart_safe`` the dashboard instead runs a non-PTY local background job:
+
+- in a transient ``systemd-run --user --scope`` of its own (``hermes-bg-<id>.scope``, under the user manager,
+  outside the backend's cgroup; no MemoryMax, as it had none in the backend's cgroup either),
+- not registered with the owner-death supervisor, and spared by ``agent.close`` while the backend shuts down
+  (and, once re-adopted by the next process, for good: see ``survives_host_exit``),
+- writing to a log file with its exit status recorded beside it (the managed-worker contract,
+  ``process_registry_output_log``), so no pipe dies with the backend,
+- checkpointed in ``processes-dashboard.json`` (the gateway keeps ``processes.json``).
+
+At the next start the dashboard re-adopts what still runs (or finished meanwhile: the recorded exit), and
+reports what the restart killed: a completion notice per job that asked for one (``notify_on_complete``), a
+retained result for ``process_manage poll``, and a note on the owning session's next turn listing both kinds.
+A PTY job keeps its terminal and so still dies with the backend: it is reported as killed by the restart.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import threading
+import time
+from contextlib import suppress
+from pathlib import Path
+from typing import Any
+
+logger = logging.getLogger("tools.process_registry")
+
+DASHBOARD_CHECKPOINT = "processes-dashboard.json"
+RESTART_SOURCE = "the Hermes restart"
+_report_lock = threading.Lock()
+# One entry per job the previous process left: {"id", "command", "state": "running"|"killed", "keys": set}.
+_report: list[dict[str, Any]] = []
+
+
+def enabled_in_config() -> bool:
+    try:
+        from hermes_cli.config import cfg_get, load_config
+        from utils import is_truthy_value
+        return is_truthy_value(cfg_get(load_config(), "terminal", "background_restart_safe"), default=False)
+    except Exception:
+        return False
+
+
+def enable(registry) -> bool:
+    """Called once by the dashboard after it serves. True when restart-safe jobs are on in this process."""
+    import tools.process_registry as pr
+    if not (pr._IS_LINUX and enabled_in_config()):
+        return False
+    pr._CHECKPOINT_NAME = DASHBOARD_CHECKPOINT
+    registry._restart_safe_host = True
+    return True
+
+
+def spawn_is_restart_safe(registry, use_pty: bool) -> bool:
+    import tools.process_registry as pr
+    return (bool(getattr(registry, "_restart_safe_host", False)) and not use_pty
+            and pr._systemd_run_user_scope_available())
+
+
+def scope_argv(session, argv: list[str]) -> list[str]:
+    """``systemd-run --user --scope`` around a job's shell; sets ``session.systemd_unit``."""
+    import shutil
+    import tools.process_registry as pr
+    binary = shutil.which("systemd-run")
+    if binary is None:
+        logger.warning("systemd-run vanished: background job %s runs in the backend's cgroup and dies with it",
+                       session.id)
+        session.restart_safe = False
+        return argv
+    unit = f"hermes-bg-{session.id.removeprefix('proc_')}"
+    session.systemd_unit = f"{unit}.scope"
+    no_expand = ["--expand-environment=no"] if pr._SYSTEMD_RUN_NO_EXPAND else []
+    return [binary, "--user", "--scope", "--quiet", *no_expand, "--unit", unit, "--collect",
+            "--property", "MemoryAccounting=yes", "--", *argv]
+
+
+def begin_host_shutdown(registry) -> None:
+    """The backend is exiting: restart-safe jobs stay, and every job that still finishes from here on is kept in
+    the checkpoint so the next process can report it."""
+    if getattr(registry, "_restart_safe_host", False):
+        registry._host_shutting_down = True
+
+
+def survives_host_exit(registry, process: dict) -> bool:
+    """Whether ``agent.close`` spares this job: every restart-safe job once the backend shuts down, and one this
+    process re-adopted from its predecessor at any time (closing the session the startup resume reopened must not
+    kill the job that just survived the restart; ``process_manage kill`` still stops it)."""
+    if not process.get("restart_safe"):
+        return False
+    return bool(getattr(registry, "_host_shutting_down", False) or process.get("detached"))
+
+
+def record_casualty(registry, session) -> bool:
+    """A job ended while the backend shuts down. Its notice is not queued here (a turn it started would be cut
+    short by the same shutdown, and the next process would report it again): the job stays in the checkpoint
+    for the next process instead. A restart-safe job as it is (the next process reads its recorded exit from
+    the log); any other one with its outcome (``lost_in_shutdown``, ``shutdown_killed`` when it was stopped
+    rather than exiting on its own). True when it was kept, i.e. this process must not notify."""
+    if not getattr(registry, "_host_shutting_down", False):
+        return False
+    # Stopped on purpose (process_manage kill, /stop) during the drain: an ordinary result, not a restart casualty.
+    if session.termination_source and session.termination_source not in registry._LIFECYCLE_KILL_SOURCES:
+        return False
+    from agent.redact import redact_sensitive_text
+    from tools.process_registry import _CHECKPOINT_FIELDS
+    entry = {"session_id": session.id, **{f: getattr(session, f) for f in _CHECKPOINT_FIELDS}}
+    entry["command"] = redact_sensitive_text(session.command, code_file=True)
+    entry["owner_task_id"] = session.owner_task_id or session.task_id
+    if not session.restart_safe:
+        entry.update(lost_in_shutdown=True, exit_code=session.exit_code,
+                     shutdown_killed=session.completion_reason == "killed")
+    with registry._lock:
+        registry._shutdown_casualties[session.id] = entry
+    return True
+
+
+def _retained_output(session_id: str) -> str:
+    from hermes_constants import get_hermes_home
+    with suppress(OSError, ValueError, TypeError):
+        record = json.loads((get_hermes_home() / "logs" / "process-results" / f"{session_id}.json")
+                            .read_text(encoding="utf-8-sig"))
+        return str(record.get("output") or "")
+    return ""
+
+
+def _keys(entry: dict) -> set:
+    return {str(entry.get(k) or "") for k in ("session_key", "parent_session_id", "owner_task_id")} - {""}
+
+
+def recover(registry) -> tuple[int, int]:
+    """Re-adopt and report the previous process's jobs from the current scope's checkpoint.
+    Returns ``(re-adopted, killed)``."""
+    from tools.process_registry import (
+        ProcessSession, _CHECKPOINT_DEFAULTS, _CHECKPOINT_FIELDS, _checkpoint_path, _stop_systemd_unit)
+    from hermes_cli.active_sessions import _FileLock
+    from utils import atomic_json_write
+    from tools.process_registry_output_log import _exit_path, adoptable_log
+    path = _checkpoint_path()
+    try:
+        entries = json.loads(path.read_text(encoding="utf-8-sig"))
+    except (OSError, ValueError):
+        return 0, 0
+    entries = [e for e in entries if isinstance(e, dict) and e.get("session_id")] if isinstance(entries, list) else []
+    with registry._lock:
+        tracked = set(registry._running) | set(registry._finished)
+    adoptable, killed, finished = [], [], set()
+    for entry in entries:
+        if entry["session_id"] in tracked or entry.get("pid_scope", "host") != "host":
+            continue
+        if entry.get("lost_in_shutdown"):
+            killed.append(entry)
+            continue
+        # The same verdicts recover_from_checkpoint reaches: a log-backed job is adopted with its log (alive, or
+        # its exit recorded beside it), any other one only while its PID is still ours.
+        log = adoptable_log(entry.get("output_log"))
+        fate = registry._detached_host_fate(entry.get("pid"), entry.get("host_start_time"))
+        if log:
+            # No recorded exit and no process: it died without its shell's EXIT trap (SIGKILL, a user manager
+            # restart). Report it killed rather than "kept running".
+            if _exit_path(log).exists():
+                finished.add(entry["session_id"])
+            alive = entry["session_id"] in finished or fate == "running"
+            (adoptable if Path(log).exists() and alive else killed).append(entry)
+        elif fate == "running":
+            adoptable.append(entry)
+        elif fate == "gone":
+            killed.append(entry)
+    # The upstream recovery adopts the live (or meanwhile finished) log-backed jobs; the ones reported killed
+    # below leave the file first, so it never adopts or signals them. It must not flag every later job of this
+    # process as outliving it (PTY jobs keep their owner-death supervisor).
+    if killed:
+        # What a killed job's shell left behind in its scope goes with it (upstream stops a dead wrapper's
+        # scope in recover_from_checkpoint, which never sees these entries).
+        for entry in killed:
+            if entry.get("systemd_unit") and not _stop_systemd_unit(entry["systemd_unit"]):
+                logger.warning("could not stop scope %s of killed background job %s",
+                               entry["systemd_unit"], entry["session_id"])
+        gone = {e["session_id"] for e in killed}
+        with _FileLock(path.with_name(path.name + ".lock")):
+            atomic_json_write(path, [e for e in entries if e["session_id"] not in gone])
+    outlive = registry._jobs_outlive_host
+    try:
+        adopted = registry.recover_from_checkpoint()
+    finally:
+        registry._jobs_outlive_host = outlive
+    with registry._lock:
+        tracked = set(registry._running) | set(registry._finished)
+    killed = [e for e in killed if e["session_id"] not in tracked]
+    for entry in killed:
+        fields = {f: entry.get(f, _CHECKPOINT_DEFAULTS[f]) for f in _CHECKPOINT_FIELDS}
+        # notify_on_complete: a job the restart killed always reports back, so the agent learns of it at once.
+        fields.update(command=entry.get("command", "unknown"), output_log="", notify_on_complete=True,
+                      owner_task_id=entry.get("owner_task_id", "") or entry.get("task_id", ""),
+                      started_at=entry.get("started_at", time.time()))
+        session = ProcessSession(id=entry["session_id"], detached=True, **fields)
+        session.output_buffer = _retained_output(session.id)
+        with registry._lock:
+            registry._running[session.id] = session
+        code = entry.get("exit_code")
+        code = code if isinstance(code, int) else -1
+        if entry.get("lost_in_shutdown") and not entry.get("shutdown_killed"):
+            registry._finish_exited(session, code)  # it exited on its own while the backend shut down
+            finished.add(entry["session_id"])
+        else:
+            registry._finish_exited(session, code, reason="killed", source=RESTART_SOURCE)
+    with _report_lock:
+        for entry in adoptable:
+            state = "finished" if entry["session_id"] in finished else "running"
+            _report.append({"id": entry["session_id"], "command": entry.get("command", ""), "state": state,
+                            "notify": bool(entry.get("notify_on_complete")), "keys": _keys(entry)})
+        for entry in killed:
+            state = "finished" if entry["session_id"] in finished else "killed"
+            _report.append({"id": entry["session_id"], "command": entry.get("command", ""), "state": state,
+                            "notify": bool(entry.get("notify_on_complete")), "keys": _keys(entry)})
+    if adoptable or killed:
+        logger.info("restart-safe background jobs: %d re-adopted, %d killed by the restart (%s)",
+                    len(adoptable), len(killed), path)
+    return adopted, len(killed)
+
+
+def owner_keys() -> set:
+    """Session keys that own a reported job with a notice on its way (the startup resume reopens them so the
+    notices reach them). Every killed job notifies; a running one only when it asked to."""
+    with _report_lock:
+        return set().union(*(e["keys"] for e in _report if e["state"] != "running" or e["notify"]))
+
+
+def _short(command: str) -> str:
+    text = " ".join(str(command or "").split())
+    return text[:117] + "..." if len(text) > 120 else text
+
+
+def take_note(keys: set) -> str:
+    """The one-time note for the first turn of a session that owns reported jobs."""
+    keys = {k for k in keys if k}
+    if not keys:
+        return ""
+    with _report_lock:
+        mine = [e for e in _report if e["keys"] & keys]
+        _report[:] = [e for e in _report if not e["keys"] & keys]
+    if not mine:
+        return ""
+    lines = []
+    for e in mine:
+        if e["state"] in ("running", "finished"):
+            tail = "you will be notified when it exits" if e["notify"] else "check it with process_manage poll"
+            what = "kept running through the restart" if e["state"] == "running" else "finished during the restart"
+            lines.append(f"- {e['id']} {what} and is tracked again ({tail}): {_short(e['command'])}")
+        else:
+            lines.append(f"- {e['id']} was KILLED by the restart and did not finish; check what it already did "
+                         f"before running it again: {_short(e['command'])}")
+    return ("[System note: Hermes restarted. Your background processes from before the restart:\n"
+            + "\n".join(lines) + "]")
