 import json
 import logging
+import contextlib
 import os
 import sys
 import time
@@ -663,6 +664,71 @@ def _lookup_active_env(effective_task_id: str, task_id: Optional[str]):
     return None
 
 
+# hyperhermes (hermes-subagent-own-shell.patch): on the local backend a delegate_task child shared
+# its parent's LocalEnvironment, i.e. ONE bash snapshot that every command re-dumps with `export -p`
+# when it ends. Parallel children (and the parent) clobbered each other's shell state: an `export` or
+# `unset` in one landed in, or was undone by, a sibling's command finishing later. A child now runs
+# in an environment of its own, keyed ``<parent key>::child::<task id>``, whose snapshot starts as a
+# copy of the top-level session's (same env, functions, aliases; a grandchild's too); cwd was already
+# per task. Released with the child (``release_child_env``) and otherwise by the idle reaper.
+# Container backends keep sharing the parent's sandbox (#16177): only the local shell state is split.
+# File tools (read_file, patch, search) still run in the parent's environment: paths resolve from the
+# child's own cwd record, but they do not see the child's exports.
+_CHILD_ENV_MARK = "::child::"
+
+
+def _child_env_key(effective_task_id: str, task_id: Optional[str], env_type: str) -> str:
+    if env_type != "local" or not task_id or _CHILD_ENV_MARK in effective_task_id:
+        return effective_task_id
+    try:
+        from agent.delegation_context import is_delegated_child_context
+        if not is_delegated_child_context():
+            return effective_task_id
+    except Exception:
+        return effective_task_id
+    if task_id == effective_task_id:  # an isolation-override key (RL rollouts): already its own env
+        return effective_task_id
+    return f"{effective_task_id}{_CHILD_ENV_MARK}{task_id}"
+
+
+def _seed_child_env(new_env: Any, parent_key: str) -> None:
+    """Start the child's shell snapshot from the parent's, when the parent has one."""
+    with _env_lock:
+        parent = _active_environments.get(parent_key)
+    src = getattr(parent, "_snapshot_path", None)
+    dst = getattr(new_env, "_snapshot_path", None)
+    if not (src and dst and getattr(parent, "_snapshot_ready", False) and os.path.isfile(src)):
+        return
+    tmp = f"{dst}.tmp.seed{os.getpid()}"  # .tmp.*: LocalEnvironment.cleanup sweeps leftovers
+    try:
+        with open(src, "rb") as f_in:
+            data = f_in.read()
+        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
+        with os.fdopen(fd, "wb") as f_out:
+            f_out.write(data)
+        os.replace(tmp, dst)
+        new_env._snapshot_ready = True
+    except OSError:
+        logger.debug("Could not seed child shell snapshot from %s", src, exc_info=True)
+        with contextlib.suppress(OSError):
+            os.unlink(tmp)
+
+
+def release_child_env(task_id: Optional[str]) -> None:
+    """Drop the child environments created for *task_id* (``::child::<task_id>`` keys)."""
+    if not task_id:
+        return
+    suffix = f"{_CHILD_ENV_MARK}{task_id}"
+    with _env_lock:
+        keys = [k for k in _active_environments if k.endswith(suffix)]
+    from tools.terminal_tool_lifecycle import cleanup_vm
+    for key in keys:
+        try:
+            cleanup_vm(key)
+        except Exception:
+            logger.debug("child env release failed for %s", key, exc_info=True)
+
+
