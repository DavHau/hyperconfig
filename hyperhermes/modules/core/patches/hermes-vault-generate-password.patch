+def select_new_password_controls(classified: list[ClassifiedLoginControl]) -> list[ClassifiedLoginControl]:
+    """Every control of ONE form that takes a new password, in DOM order: a signup or set-password form's
+    password and its confirmation. That is the new-password controls plus the password inputs not marked as
+    the current one (signup forms often label the first field just "Password"); a field marked current
+    (autocomplete ``current-password``, or labelled current/old password) holds a change-password form's
+    old secret and is left alone. The form is the one holding the first new-password control, else the
+    first candidate's, so a page with both a sign-in and a sign-up form fills only one of them."""
+
+    def marked_current(c: ClassifiedLoginControl) -> bool:
+        return ("current-password" in c.control.autocomplete.lower().split()
+                or bool(_RE_CURRENT_PASSWORD.search(
+                    _normalize_text(" ".join(p for p in (c.control.name, c.control.label) if p)))))
+
+    candidates = sorted(
+        (c for c in classified
+         if c.token == "new-password"
+         or (c.token == "current-password" and c.control.type == "password" and not marked_current(c))),
+        key=lambda c: c.control.index,
+    )
+    if not candidates:
+        return []
+    anchor = next((c for c in candidates if c.token == "new-password"), candidates[0])
+    return [c for c in candidates if c.control.form_index == anchor.control.form_index]
+
