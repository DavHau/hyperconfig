@@ -0,0 +1,122 @@
+"""browser_vault action=create_login: a generated password is saved for the page's origin and filled into
+the signup form's password and confirmation fields; it never comes back in the tool result."""
+
+import json
+import re
+from unittest.mock import patch
+
+import pytest
+
+from agent.vault_login_classifier import (
+    ClassifiedLoginControl,
+    LoginControl,
+    classify_login_control,
+    classify_new_password_control,
+    select_new_password_controls,
+    select_password_fill,
+)
+from agent.vault_store import VaultStore
+from tools import browser_vault_tool as bv
+
+SIGNUP = [
+    {"autocomplete": "email", "formIndex": 0, "index": 0, "label": "Email", "name": "email", "type": "email"},
+    {"autocomplete": "", "formIndex": 0, "index": 1, "label": "Password", "name": "password", "type": "password"},
+    {"autocomplete": "", "formIndex": 0, "index": 2, "label": "Confirm password", "name": "confirm", "type": "password"},
+]
+
+
+class Page:
+    def __init__(self, controls, filled=None):
+        self.controls = controls
+        self.filled = filled
+        self.secret_exprs = []
+
+    def eval(self, task_id, expression):
+        if expression == "window.location.href":
+            return {"success": True, "result": "https://resend.example/signup"}
+        return {"success": True, "result": json.dumps(self.controls)}
+
+    def eval_secret(self, task_id, expression):
+        self.secret_exprs.append(expression)
+        fills = json.loads(re.search(r"const fills = (\[.*?\]);", expression).group(1))
+        self.fills = fills
+        return {"success": True, "result": json.dumps({"filled": len(fills) if self.filled is None else self.filled})}
+
+
+@pytest.fixture
+def store(tmp_path):
+    return VaultStore(base_dir=tmp_path / "vault")
+
+
+def _run(store, page, **args):
+    with patch("agent.vault_store.get_vault_store", return_value=store), \
+         patch.object(bv, "_eval_js", side_effect=page.eval), \
+         patch.object(bv, "_eval_js_secret", side_effect=page.eval_secret), \
+         patch.object(bv, "_fenced_page_op", lambda tid, fn: fn()):
+        return bv._handle_vault({"action": "create_login", **args}, task_id="t")
+
+
+def _ctrl(**kw):
+    base = dict(autocomplete="", form_index=0, index=0, label="", name="", type="password")
+    base.update(kw)
+    return LoginControl(**base)
+
+
+def test_generates_saves_and_fills_password_and_confirmation(store):
+    page = Page(SIGNUP)
+    raw = _run(store, page, identifier="agent@example.com", label="Resend")
+    out = json.loads(raw)
+    assert out["success"] is True and out["filled_fields"] == 2
+    assert out["origin"] == "https://resend.example" and out["identifier"] == "agent@example.com"
+    [meta] = store.list_items()
+    assert (meta.id, meta.origin, meta.identifier, meta.label) == (out["handle"], "https://resend.example",
+                                                                   "agent@example.com", "Resend")
+    password = store.resolve_secret(meta.id)["password"]
+    assert password not in raw
+    assert len(password) == 24 and all(any(ch in cls for ch in password) for cls in (
+        "abcdefghijklmnopqrstuvwxyz", "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "0123456789", bv._GENERATED_PASSWORD_SYMBOLS))
+    assert [(f["index"], f["value"]) for f in page.fills] == [(1, password), (2, password)]
+
+
+def test_respects_maxlength_and_generates_fresh_passwords(store):
+    controls = [dict(c, maxLength=16) if c["type"] == "password" else c for c in SIGNUP]
+    _run(store, Page(controls), identifier="a@example.com")
+    _run(store, Page(controls), identifier="b@example.com")
+    first, second = (store.resolve_secret(m.id)["password"] for m in store.list_items())
+    assert len(first) == len(second) == 16 and first != second
+
+
+def test_no_password_field_stores_nothing(store):
+    page = Page(SIGNUP[:1])
+    out = json.loads(_run(store, page, identifier="agent@example.com"))
+    assert out["error_type"] == "no_password_field"
+    assert store.list_items() == [] and page.secret_exprs == []
+
+
+def test_a_fill_that_wrote_nothing_keeps_nothing(store):
+    out = json.loads(_run(store, Page(SIGNUP, filled=0), identifier="agent@example.com"))
+    assert out["success"] is False and store.list_items() == []
+
+
+def test_identifier_is_required(store):
+    page = Page(SIGNUP)
+    assert json.loads(_run(store, page, identifier=" "))["success"] is False
+    assert store.list_items() == [] and page.secret_exprs == []
+
+
+def test_new_password_targets_one_form_and_skip_the_current_password():
+    classify = lambda c: classify_login_control(c) or classify_new_password_control(c)  # noqa: E731
+    signin = _ctrl(index=0, form_index=0, label="Password")
+    current = _ctrl(index=1, form_index=1, label="Current password")
+    new = _ctrl(index=2, form_index=1, autocomplete="new-password")
+    confirm = _ctrl(index=3, form_index=1, label="Repeat password")
+    picked = select_new_password_controls([classify(c) for c in (signin, current, new, confirm)])
+    assert [c.control.index for c in picked] == [2, 3]
+    # A saved login's fill keeps choosing the current password where there is one ...
+    fills = select_password_fill([classify(c) for c in (current, new, confirm)], "p")
+    assert [(f["index"], f["token"]) for f in fills] == [(1, "current-password")]
+    # ... and on a create-password step fills the new password and its confirmation.
+    fills = select_password_fill([classify(c) for c in (new, confirm)], "p")
+    assert [(f["index"], f["token"]) for f in fills] == [(2, "new-password"), (3, "new-password")]
+    assert classify_new_password_control(_ctrl(type="text", autocomplete="new-password")) is None
+    assert select_password_fill([ClassifiedLoginControl(_ctrl(type="email"), 85, "email")], "p") == []
