+def classify_new_password_control(control: LoginControl) -> Optional[ClassifiedLoginControl]:
+    """A password input that takes a NEW password: autocomplete ``new-password`` (100), or labelled
+    new/confirm/create/repeat password (80). classify_login_control excludes these, so a saved login is
+    never typed into the new field of a change-password form; signup and set-password steps fill them."""
+    if control.type != "password":
+        return None
+    if "new-password" in control.autocomplete.lower().split():
+        return ClassifiedLoginControl(control, 100, "new-password")
+    if _RE_EXCLUDED_PASSWORD.search(_normalize_text(" ".join(p for p in (control.name, control.label) if p))):
+        return ClassifiedLoginControl(control, 80, "new-password")
+    return None
+
