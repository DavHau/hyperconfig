+# create_login's password: long enough to need no policy-specific tuning, one of each class every policy
+# asks for, symbols from a set that sign-up forms accept (no quotes, spaces, backslash, < > &).
+_GENERATED_PASSWORD_LENGTH = 24
+_GENERATED_PASSWORD_MIN_LENGTH = 12
+_GENERATED_PASSWORD_SYMBOLS = "-_.!@#%+="
+
+
+def _generate_password(length: int) -> str:
+    classes = (string.ascii_lowercase, string.ascii_uppercase, string.digits, _GENERATED_PASSWORD_SYMBOLS)
+    alphabet = "".join(classes)
+    chars = [secrets.choice(c) for c in classes] + [secrets.choice(alphabet) for _ in range(length - len(classes))]
+    secrets.SystemRandom().shuffle(chars)
+    return "".join(chars)
+
+
