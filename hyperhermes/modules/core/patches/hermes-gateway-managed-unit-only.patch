diff -ruN a/hermes_cli/gateway_managed_unit.py b/hermes_cli/gateway_managed_unit.py
--- a/hermes_cli/gateway_managed_unit.py
+++ b/hermes_cli/gateway_managed_unit.py
@@ -0,0 +1,170 @@
+"""A gateway that a host service manager owns under a unit name hermes does not know.
+
+hyperhermes runs each agent's gateway as ``hermes-agent-<user>.service`` (a system unit, the agent's
+account as ``User=``) and exports ``HERMES_GATEWAY_MANAGED_UNIT=<that unit>`` to every process of the
+agent: the gateway, the dashboard, cron workers, the ``hermes`` CLI shim. Hermes' own service probe
+(``gateway_runtime_service._systemd``) only knows ``hermes-gateway*`` units, so while that unit was
+restarting a client (a cron worker's ``connect_gateway``, the TUI, Desktop's ``gateway ensure``) found
+no owner and started its own ``gateway run --idle-exit``. With a messaging adapter connected it never
+idles out, and the unit then attaches to it and exits 75 on every restart, forever.
+
+The unit runs the gateway of the managed root, ``HERMES_GATEWAY_MANAGED_HOME`` (the unit's
+HERMES_HOME; without it, the install root ``get_default_hermes_root()``), and serves the named
+profiles under it that it multiplexes, so a ``-p <name>`` client waits for the unit too. For those
+homes only the unit's own main process may run a gateway: clients wait for the unit to bring it back
+(or hear at once that it stays stopped), and nothing else starts one. A standalone profile and every
+other home keep upstream's behaviour.
+"""
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+MANAGED_UNIT_ENV = "HERMES_GATEWAY_MANAGED_UNIT"
+MANAGED_HOME_ENV = "HERMES_GATEWAY_MANAGED_HOME"
+# hyperhermes' agent units are system units in the default slice: a user unit of the same name
+# (systemd-run --user --unit=...) sits under user.slice and is not it.
+UNIT_SLICE = "/system.slice/"
+
+
+def managed_unit() -> str | None:
+    unit = os.environ.get(MANAGED_UNIT_ENV, "").strip()
+    return unit or None
+
+
+def _same_path(left: str | Path, right: str | Path) -> bool:
+    try:
+        return Path(left).expanduser().resolve() == Path(right).expanduser().resolve()
+    except (OSError, RuntimeError):
+        return False
+
+
+def managed_root() -> Path | None:
+    """The home whose gateway the unit runs: HERMES_GATEWAY_MANAGED_HOME (exported beside the unit
+    name, so a process that moved HERMES_HOME elsewhere does not carry the claim along), else the
+    install root of the process's HERMES_HOME."""
+    pinned = os.environ.get(MANAGED_HOME_ENV, "").strip()
+    if pinned:
+        return Path(pinned)
+    if not os.environ.get("HERMES_HOME", "").strip():
+        return None
+    from hermes_constants import get_default_hermes_root
+    return get_default_hermes_root()
+
+
+def unit_managing_home(home: str | Path) -> str | None:
+    """The unit whose gateway is *home*'s own (*home* is the managed root), or None."""
+    unit = managed_unit()
+    root = managed_root() if unit is not None else None
+    return unit if root is not None and _same_path(home, root) else None
+
+
+def unit_serving_home(home: str | Path) -> str | None:
+    """The unit whose gateway serves *home*: its own (the managed root), or the root's multiplexer
+    for a named profile under it that is not standalone. None for every other home."""
+    unit = unit_managing_home(home)
+    if unit is not None:
+        return unit
+    from hermes_cli.gateway_runtime_multiplex import implied_host_root, multiplexer_serves_home
+    path = Path(home)
+    try:
+        target = multiplexer_serves_home(path) or implied_host_root(path)
+    except Exception:
+        return None
+    return unit_managing_home(target) if target is not None else None
+
+
+def _own_cgroup() -> str | None:
+    try:
+        for line in Path("/proc/self/cgroup").read_text(encoding="utf-8").splitlines():
+            if line.startswith("0::"):
+                return line[3:].rstrip("/")
+    except OSError:
+        return None
+    return None
+
+
+def is_managed_unit_main_process() -> bool:
+    """True for the unit's main process itself: systemd stamps its PID into SYSTEMD_EXEC_PID, which
+    the children (tool commands, cron workers) inherit with a different PID of their own, and it
+    runs in the system unit's own cgroup."""
+    unit = managed_unit()
+    if unit is None:
+        return False
+    return os.environ.get("SYSTEMD_EXEC_PID") == str(os.getpid()) and _own_cgroup() == UNIT_SLICE + unit
+
+
+def unit_state(unit: str) -> tuple[str, bool] | None:
+    """(ActiveState, a job is queued) of the system unit, or None when systemd cannot be asked."""
+    systemctl = shutil.which("systemctl") or "/run/current-system/sw/bin/systemctl"
+    try:
+        out = subprocess.run([systemctl, "show", "--property=ActiveState,Job", "--", unit],
+                             capture_output=True, text=True, timeout=5, check=True).stdout
+    except (OSError, subprocess.SubprocessError):
+        return None
+    props = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
+    state = props.get("ActiveState", "").strip()
+    if not state:
+        return None
+    return state, props.get("Job", "").strip() not in ("", "0")
+
+
+def unit_stopped(unit: str) -> str | None:
+    """"inactive" or "failed" when the unit is down and nothing is queued to bring it back (a client
+    would wait for nothing), else None: running, (auto-)restarting, or systemd unreachable."""
+    st = unit_state(unit)
+    if st is None:
+        return None
+    state, queued = st
+    return state if state in ("inactive", "failed") and not queued else None
+
+
+def refusal_message(unit: str, stopped: str | None = None) -> str:
+    lines = [f"✗ This agent's gateway is managed by the systemd unit {unit}; nothing else may start one."]
+    if stopped == "failed":
+        lines.append(f"  The unit has failed. As root: systemctl reset-failed {unit} && systemctl start {unit}")
+    elif stopped == "inactive":
+        lines.append(f"  The unit is stopped. As root: systemctl start {unit}")
+    lines += [f"  Status: systemctl status {unit}",
+              "  Restart it from the chat (/restart) or the dashboard, or ask the host admin."]
+    return "\n".join(lines)
+
+
+def refuse_gateway_run() -> str | None:
+    """For every gateway launcher: the unit, after printing the refusal, when this process may not
+    run the process home's gateway; None when it may."""
+    from hermes_constants import get_process_hermes_home
+    unit = unit_serving_home(get_process_hermes_home())
+    if unit is None or is_managed_unit_main_process():
+        return None
+    print(refusal_message(unit, unit_stopped(unit)), file=sys.stderr)
+    return unit
+
+
+class StoppedUnitWatch:
+    """For a client waiting on the unit: reports the unit as stopped once it has been down, with
+    nothing queued, for ``grace`` seconds (a deploy's stop-then-start gap is not a stop), asking
+    systemd at most every ``interval`` seconds."""
+
+    def __init__(self, grace: float = 10.0, interval: float = 1.0):
+        self.grace, self.interval = grace, interval
+        self._since: float | None = None
+        self._next = 0.0
+        self._state: str | None = None
+
+    def stopped(self, unit: str) -> str | None:
+        import time
+        now = time.monotonic()
+        if now >= self._next:
+            self._next = now + self.interval
+            self._state = unit_stopped(unit)
+            if self._state is None:
+                self._since = None
+            elif self._since is None:
+                self._since = now
+        if self._state is not None and self._since is not None and now - self._since >= self.grace:
+            return self._state
+        return None
