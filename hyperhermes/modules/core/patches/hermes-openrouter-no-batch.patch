diff --git a/hermes_cli/openrouter_batch.py b/hermes_cli/openrouter_batch.py
new file mode 100644
index 0000000..bfc75d8
--- /dev/null
+++ b/hermes_cli/openrouter_batch.py
@@ -0,0 +1,57 @@
+"""OpenRouter ``:batch`` models are never offered or used for chat (hyperhermes).
+
+``<model>:batch`` ids are OpenRouter's asynchronous Batch API (results within a 24 h window, no
+streaming): unusable for an interactive agent. They are:
+
+- dropped from the OpenRouter catalog (``hermes_cli.models.fetch_openrouter_models``) and from every
+  OpenRouter-routed picker row (``drop_unofferable_model_ids``: desktop/dashboard ``model.options``,
+  Hermes One, TUI and messaging ``/model``, ``hermes model``);
+- mapped to the same id without ``:batch`` wherever an OpenRouter provider+model pair is used: the
+  agent constructor (every AIAgent, delegated children and fallback chains included), live model
+  switches, ``/model``, fallback activation and auxiliary clients. Each mapping logs a warning.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+BATCH_SUFFIX = ":batch"
+
+
+def is_batch_id(model: Any) -> bool:
+    return isinstance(model, str) and model.strip().lower().endswith(BATCH_SUFFIX)
+
+
+def drop_batch(rows: list) -> list:
+    """Catalog rows (ids or ``(id, desc)`` tuples) without ``:batch`` ids."""
+    if not isinstance(rows, list):
+        return rows
+    out = [row for row in rows if not is_batch_id(row[0] if isinstance(row, (tuple, list)) else row)]
+    return rows if len(out) == len(rows) else out
+
+
+def unbatched(provider: Any, model: Any, base_url: Any = None, where: str = "") -> Optional[str]:
+    """The id without ``:batch`` for an OpenRouter-routed ``:batch`` model (logged), else None."""
+    if not is_batch_id(model):
+        return None
+    from hermes_cli.openrouter_native import is_openrouter_route
+    if not is_openrouter_route(provider, base_url):
+        return None
+    plain = model.strip()[: -len(BATCH_SUFFIX)]
+    logger.warning(
+        "openrouter_no_batch: %s asked for %r (OpenRouter's async Batch API, unusable for chat); "
+        "running %r instead", where or "request", model, plain)
+    return plain
+
+
+def unbatch_entries(entries: Any) -> Any:
+    """Fallback chain (dict or list of dicts) with OpenRouter ``:batch`` models mapped."""
+    if isinstance(entries, dict):
+        plain = unbatched(entries.get("provider"), entries.get("model"), entries.get("base_url"), "fallback entry")
+        return entries if plain is None else {**entries, "model": plain}
+    if isinstance(entries, list):
+        return [unbatch_entries(e) if isinstance(e, dict) else e for e in entries]
+    return entries
