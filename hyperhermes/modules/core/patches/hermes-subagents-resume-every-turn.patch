+"""hyperhermes: subagents a restart killed are re-dispatched by whichever turn of their session runs first, a model
+copy of them is dropped, and the re-dispatched child learns which of its background processes died."""
+
+import json
+import time
+
+import pytest
+
+from tools import async_delegation as ad
+
+
+@pytest.fixture(autouse=True)
+def _clean_state():
+    ad._reset_for_tests()
+    yield
+    ad._reset_for_tests()
+
+
+def _park(conn, delegation_id, goals, parent="sess-1", dead=None, attempt=None):
+    task = {"goals": goals, "is_batch": True, "task_specs": [{"goal": g} for g in goals]}
+    if dead:
+        task["dead_processes"] = dead
+    conn.execute("""INSERT INTO async_delegations (delegation_id, origin_session, origin_ui_session_id,
+                    parent_session_id, state, dispatched_at, updated_at, delivery_state, delivery_attempts,
+                    task_json, origin_session_id) VALUES (?, 'key-1', '', ?, 'resuming', ?, ?, 'pending', 0, ?, '')""",
+                 (delegation_id, parent, time.time(), time.time(), json.dumps(task)))
+
+
+def test_resuming_goals_lists_parked_unfinished_tasks_of_the_session():
+    with ad._DB_LOCK, ad._transaction() as conn:
+        _park(conn, "deleg_a", ["goal one", "goal two"])
+        _park(conn, "deleg_b", ["other session"], parent="sess-2")
+    goals = ad.resuming_goals("sess-1")
+    assert goals == {"goal one": "deleg_a", "goal two": "deleg_a"}
+    assert ad.resuming_goals("sess-3") == {}
+
+
+def test_resume_plan_tells_the_child_which_background_processes_died():
+    dead = {"1": [{"command": "nix build .#x", "cwd": "/work", "started_at": 1.0}]}
+    with ad._DB_LOCK, ad._transaction() as conn:
+        _park(conn, "deleg_c", ["first", "second"], dead=dead)
+    plans = ad.take_resuming_delegations(lambda origin, parent: parent == "sess-1")
+    assert len(plans) == 1
+    first, second = plans[0]["tasks"]
+    assert "nix build .#x" not in (first.get("context") or "")
+    assert "background processes of yours" in second["context"] and "'nix build .#x' (cwd /work)" in second["context"]
+
+
+def test_shutdown_records_the_running_processes_of_each_child():
+    with ad._DB_LOCK, ad._transaction() as conn:
+        conn.execute("""INSERT INTO async_delegations (delegation_id, origin_session, origin_ui_session_id,
+                        parent_session_id, state, dispatched_at, updated_at, delivery_state, delivery_attempts,
+                        task_json, origin_session_id) VALUES ('deleg_d', 'k', '', 's', 'running', 1, 1, 'pending', 0,
+                        '{}', '')""")
+    ad._record_dead_processes({"delegation_id": "deleg_d"},
+                              lambda: {"0": [{"command": "sleep 300", "cwd": "/w", "started_at": 1.0}]})
+    with ad._DB_LOCK, ad._transaction() as conn:
+        task = json.loads(conn.execute("SELECT task_json FROM async_delegations WHERE delegation_id='deleg_d'")
+                          .fetchone()[0])
+    assert task["dead_processes"]["0"][0]["command"] == "sleep 300"
+
+
+def test_delegate_task_drops_copies_of_resuming_subagents(monkeypatch):
+    from tools import delegate_tool
+
+    class Parent:
+        session_id = "sess-1"
+
+    monkeypatch.setattr(ad, "resuming_goals", lambda *a, **k: {"goal one": "deleg_a"})
+    tasks, goal, note = delegate_tool._drop_resuming_copies(
+        [{"goal": "goal one"}, {"goal": "new goal"}], None, Parent())
+    assert tasks == [{"goal": "new goal"}] and goal is None
+    assert "goal one" in note and "deleg_a" in note and "Not dispatched again" in note
+    tasks, goal, note = delegate_tool._drop_resuming_copies([{"goal": "new goal"}], None, Parent())
+    assert note is None and tasks == [{"goal": "new goal"}]
+    out = json.loads(delegate_tool.delegate_task(tasks=[{"goal": "goal one"}], parent_agent=Parent()))
+    assert out["status"] == "already_running" and "deleg_a" in out["note"]
+
+
+def test_a_turn_that_wins_the_race_re_dispatches_and_tells_the_model(monkeypatch):
+    """The fpv incident: a delivered subagent result started a turn right after the restart, ahead of the
+    auto-continue kickoff and the idle poller, which then could not claim the busy session. That turn must
+    re-dispatch the parked units itself and carry the note, so the model does not dispatch them again."""
+    from tui_gateway import server
+    calls = []
+
+    def fake_resume(sid, session, *, in_turn=False):
+        calls.append(in_turn)
+        session.setdefault("_resumed_delegations", []).append({"of": "deleg_x", "as": "deleg_y", "tasks": [1, 2]})
+        return 1
+
+    monkeypatch.setattr(server, "_resume_session_delegations", fake_resume)
+    session = {"running": True}
+    note = server._resume_delegations_for_turn("sid", session)
+    assert calls == [True]
+    assert "deleg_x (task(s) 1, 2) now runs as deleg_y" in note and "Do not dispatch them again" in note
+    assert server._resume_delegations_for_turn("sid", session) == "" or calls == [True, True]
+
+
+def test_in_turn_resume_does_not_need_the_idle_claim(monkeypatch):
+    from tui_gateway import server
+    from tools import async_delegation
+
+    class Agent:
+        session_id = "sess-1"
+
+    session = {"running": True, "agent": Agent(), "session_key": "key-1", "history_lock": __import__("threading").Lock()}
+    monkeypatch.setattr(async_delegation, "has_resuming_delegations", lambda home: True)
+    monkeypatch.setattr(async_delegation, "async_pool_full", lambda n: False)
+    taken = []
+    monkeypatch.setattr(async_delegation, "take_resuming_delegations", lambda m: taken.append(m) or [])
+    monkeypatch.setattr(server, "_session_home", lambda s: "/nonexistent")
+    monkeypatch.setattr(server, "_session_uses_compute_host", lambda s: False)
+    assert server._resume_session_delegations("sid", session) == 0 and taken == []  # busy: the poller backs off
+    server._resume_session_delegations("sid", session, in_turn=True)
+    assert len(taken) == 1  # the running turn itself claims the parked units
+    assert session["running"] is True  # and leaves its own turn's claim alone
+
+
+def test_in_turn_resume_keeps_the_running_turns_session_context(monkeypatch):
+    """Review finding: _redispatch_delegation binds the session context and then CLEARS it (every var set to ""),
+    which wiped the running turn's source / session key / UI session id / runtime cwd for the rest of the first turn
+    after a restart. The in-turn resume runs in a copy of the context: the turn's binding is unchanged afterwards,
+    and a delegate_task later in that turn still records the right source and origin UI session."""
+    from gateway.session_context import clear_session_vars, get_session_env, set_session_vars
+    from agent import runtime_cwd
+    from tools import delegate_tool, delegate_tool_dispatch
+    from tui_gateway import server
+
+    class Agent:
+        session_id = "sess-1"
+
+    session = {"running": True, "agent": Agent(), "session_key": "key-1", "history_lock": __import__("threading").Lock()}
+    plan = {"delegation_id": "deleg_old", "tasks": [{"goal": "g"}],
+            "meta": {"indexes": [0], "attempt": 1, "steers": {}}}
+    monkeypatch.setattr(ad, "has_resuming_delegations", lambda home: True)
+    monkeypatch.setattr(ad, "async_pool_full", lambda n: False)
+    monkeypatch.setattr(ad, "take_resuming_delegations", lambda m: [plan])
+    monkeypatch.setattr(ad, "finish_resume", lambda old, new: None)
+    monkeypatch.setattr(ad, "late_steers", lambda *a: {})
+    monkeypatch.setattr(server, "_session_home", lambda s: "/nonexistent")
+    monkeypatch.setattr(server, "_session_uses_compute_host", lambda s: False)
+    seen = {}
+
+    def fake_delegate(**kw):
+        seen["key"] = get_session_env("HERMES_SESSION_KEY")
+        return json.dumps({"status": "dispatched", "delegation_id": "deleg_new"})
+
+    monkeypatch.setattr(delegate_tool, "delegate_task", fake_delegate)
+    names = ("HERMES_SESSION_SOURCE", "HERMES_SESSION_KEY", "HERMES_UI_SESSION_ID", "HERMES_SESSION_ID")
+    tokens = set_session_vars(source="desktop", session_key="key-1", session_id="sess-1", ui_session_id="ui-7",
+                              cwd="/work/turn")
+    try:
+        before = {n: get_session_env(n) for n in names}
+        assert before["HERMES_SESSION_SOURCE"] == "desktop" and before["HERMES_UI_SESSION_ID"] == "ui-7"
+        note = server._resume_delegations_for_turn("ui-7", session)
+        assert "deleg_old" in note and "deleg_new" in note and seen["key"] == "key-1"
+        assert {n: get_session_env(n) for n in names} == before
+        assert runtime_cwd.scoped_session_cwd() == "/work/turn"
+        # A delegate_task the model makes later in this turn captures the turn's own origin.
+        assert delegate_tool_dispatch._capture_origin()[1] == "ui-7"
+        assert get_session_env("HERMES_SESSION_SOURCE") == "desktop"
+    finally:
+        clear_session_vars(tokens)
