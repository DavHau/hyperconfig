+++ b/tests/tools/test_subagents_resume_steer_restarts.py
@@ -0,0 +1,239 @@
+"""hyperhermes: a task keeps ONE live child and its steers across repeated restarts.
+
+Two consecutive restarts of the backend that runs a delegated unit, a manual re-dispatch attempt by the model in
+between, and steers sent to the task's ORIGINAL subagent id while the unit is parked and while its first
+re-dispatch runs: every steer reaches the task's current child (live, or in its resume context), the resume of a
+resume keeps the original identity, and exactly one child per task is live at the end."""
+
+import json
+import threading
+import time
+
+import pytest
+
+from tools import async_delegation as ad
+from tools import delegate_tool, delegate_tool_registry as reg
+
+DEAD_PID = 2 ** 22 + 12345  # beyond pid_max on test hosts: never alive
+GOALS = ["build the thing", "migrate the data"]
+
+
+@pytest.fixture(autouse=True)
+def _clean_state(monkeypatch):
+    ad._reset_for_tests()
+    monkeypatch.setattr(ad, "_resume_config", lambda: (True, 3))
+    yield
+    ad._reset_for_tests()
+    with reg._active_subagents_lock:
+        reg._active_subagents.clear()
+
+
+class Parent:
+    session_id = "sess-1"
+
+
+class FakeChild:
+    def __init__(self):
+        self.steers = []
+
+    def steer(self, text):
+        self.steers.append(text)
+        return True
+
+
+def _sql(query, args=()):
+    with ad._DB_LOCK, ad._transaction() as conn:
+        return conn.execute(query, args).fetchall()
+
+
+def _seed():
+    with ad._DB_LOCK, ad._transaction() as conn:
+        cols = {r[1]: r for r in conn.execute("PRAGMA table_info(sessions)")}
+        need = [c for c, r in cols.items() if r[3] and r[4] is None and c not in ("id", "source")]
+        conn.execute(f"INSERT INTO sessions (id, source{''.join(', ' + c for c in need)}) VALUES "
+                     f"('sess-1', 'desktop'{', 0' * len(need)})")
+        task = {"goals": GOALS, "is_batch": True, "task_specs": [{"goal": g} for g in GOALS],
+                "task_subagents": {"0": "sa-0-a", "1": "sa-1-a"}}
+        conn.execute("""INSERT INTO async_delegations (delegation_id, origin_session, origin_ui_session_id,
+                        parent_session_id, state, dispatched_at, updated_at, delivery_state, delivery_attempts,
+                        owner_pid, task_json, origin_session_id)
+                        VALUES ('deleg_A', 'key-1', '', 'sess-1', 'running', 1, 1, 'pending', 0, ?, ?, '')""",
+                     (DEAD_PID, json.dumps(task)))
+
+
+def _redispatch(plan, suffix, release):
+    """What tui_gateway's _redispatch_delegation does, with registered fake children instead of real agents."""
+    children = {}
+    for row_i, orig in enumerate(plan["meta"]["indexes"]):
+        sid = f"sa-{orig}-{suffix}"
+        children[str(row_i)] = sid
+        reg._register_subagent({"subagent_id": sid, "agent": FakeChild(), "owner_agent_session_id": "sess-1",
+                                "goal": GOALS[orig], "delegation_id": f"deleg_{suffix}"})
+    token = ad._RESUME_META.set(plan["meta"])
+    try:
+        out = ad.dispatch_async_delegation_batch(
+            goals=[t["goal"] for t in plan["tasks"]], context=None, toolsets=None, role="leaf", model=None,
+            session_key="key-1", parent_session_id="sess-1", runner=lambda: release.wait(30) and {"results": []},
+            delegation_id=f"deleg_{suffix}", task_specs=plan["tasks"], task_subagents=children)
+    finally:
+        ad._RESUME_META.reset(token)
+    assert out["status"] == "dispatched"
+    ad.finish_resume(plan["delegation_id"], out["delegation_id"])
+    return out["delegation_id"]
+
+
+def _restart(delegation_id):
+    """The backend dies: its in-memory units and children are gone, the row's owner is dead."""
+    _sql("UPDATE async_delegations SET owner_pid=? WHERE delegation_id=?", (DEAD_PID, delegation_id))
+    with ad._records_lock:
+        ad._records.clear()
+    with reg._active_subagents_lock:
+        reg._active_subagents.clear()
+    ad.recover_abandoned_delegations()
+
+
+def _steer(sid, text):
+    return json.loads(reg._handle_control_action("steer", sid, text, Parent()))
+
+
+def _live_runs(task):
+    rows = _sql("SELECT delegation_id, state, task_json FROM async_delegations WHERE state IN "
+                "('running','resuming','resume_claimed')")
+    return [d for d, _s, t in rows if task in ad._row_indexes(json.loads(t))]
+
+
+def test_two_restarts_one_child_per_task_and_steers_survive():
+    release = threading.Event()
+    try:
+        _seed()
+        # Restart 1 kills deleg_A: parked, visible in action='list'.
+        ad.recover_abandoned_delegations()
+        assert _sql("SELECT state FROM async_delegations WHERE delegation_id='deleg_A'") == [("resuming",)]
+        listed = json.loads(reg._handle_control_action("list", None, None, Parent()))
+        assert [p["delegation_id"] for p in listed["parked"]] == ["deleg_A"]
+        assert [t["previous_subagent_id"] for t in listed["parked"][0]["tasks"]] == ["sa-0-a", "sa-1-a"]
+
+        # A steer to the dead child (old id) while parked: kept, not "No live subagent".
+        out = _steer("sa-1-a", "STEER-ONE use the staging db")
+        assert out["status"] == "stored_for_resume", out
+
+        plan = ad.take_resuming_delegations(lambda origin, parent: parent == "sess-1")[0]
+        ctx = plan["tasks"][1]["context"]
+        assert "STEER-ONE use the staging db" in ctx and "binding" in ctx
+        assert "STEER-ONE" not in (plan["tasks"][0].get("context") or "")
+        b = _redispatch(plan, "B", release)
+
+        # The model dispatches the task again by hand: dropped, no second child.
+        tasks, goal, note = delegate_tool._drop_resuming_copies([{"goal": GOALS[1]}], None, Parent())
+        assert tasks == [] and b in note
+        listed = json.loads(reg._handle_control_action("list", None, None, Parent()))
+        assert "parked" not in listed
+        assert {e["subagent_id"]: e.get("resumed") for e in listed["subagents"]} == {
+            "sa-0-B": "resumed from deleg_A (attempt 1)", "sa-1-B": "resumed from deleg_A (attempt 1)"}
+
+        # A steer to the ORIGINAL id between the restarts reaches the re-dispatched child live.
+        out = _steer("sa-1-a", "STEER-TWO skip the backfill")
+        assert out["status"] == "queued" and out["routed_to"] == "sa-1-B", out
+        assert reg._active_subagents["sa-1-B"]["agent"].steers == ["STEER-TWO skip the backfill"]
+
+        # Restart 2 kills deleg_B (a resume of a resume).
+        _restart(b)
+        assert _sql("SELECT state FROM async_delegations WHERE delegation_id=?", (b,)) == [("resuming",)]
+        listed = json.loads(reg._handle_control_action("list", None, None, Parent()))
+        assert [(p["delegation_id"], p["original_delegation_id"], p["next_attempt"]) for p in listed["parked"]] == [
+            (b, "deleg_A", 2)]
+        out = _steer("sa-1-B", "STEER-THREE keep the old index")
+        assert out["status"] == "stored_for_resume", out
+        plan = ad.take_resuming_delegations(lambda origin, parent: parent == "sess-1")[0]
+        assert plan["meta"]["root"] == "deleg_A" and plan["meta"]["attempt"] == 2
+        ctx = plan["tasks"][1]["context"]
+        assert all(s in ctx for s in ("STEER-ONE", "STEER-TWO", "STEER-THREE")), ctx
+        assert ctx.index("STEER-ONE") < ctx.index("STEER-TWO") < ctx.index("STEER-THREE")
+        c = _redispatch(plan, "C", release)
+
+        # Second manual re-dispatch attempt: still dropped.
+        tasks, goal, note = delegate_tool._drop_resuming_copies(
+            [{"goal": GOALS[0]}, {"goal": GOALS[1]}], None, Parent())
+        assert tasks == [] and c in note
+        # The very first id still reaches the current child.
+        out = _steer("sa-1-a", "STEER-FOUR done soon?")
+        assert out["routed_to"] == "sa-1-C" and out["now_runs_as"] == c, out
+
+        # Exactly one live child per task, one live unit, original identity kept.
+        assert _live_runs(0) == [c] and _live_runs(1) == [c]
+        assert [r for r in ad._records.values() if r.get("status") in ad._LIVE_STATES] == [ad._records[c]]
+        assert ad._records[c]["resume"]["root"] == "deleg_A"
+        live = [e["subagent_id"] for e in json.loads(
+            reg._handle_control_action("list", None, None, Parent()))["subagents"]]
+        assert sorted(live) == ["sa-0-C", "sa-1-C"]
+    finally:
+        release.set()
+
+
+def test_steer_to_a_finished_task_says_so():
+    _seed()
+    _sql("UPDATE async_delegations SET state='completed' WHERE delegation_id='deleg_A'")
+    out = json.loads(reg._handle_control_action("steer", "sa-1-a", "late", Parent()))
+    assert "finished" in out["error"]
+
+
+def test_late_steer_reaches_the_new_unit():
+    _seed()
+    ad.recover_abandoned_delegations()
+    plan = ad.take_resuming_delegations(lambda origin, parent: parent == "sess-1")[0]
+    # Sent after the plan was built, before the new unit exists.
+    ad.persist_steer("deleg_A", 1, "LATE one")
+    assert ad.late_steers("deleg_A", plan["meta"]["steers"]) == {"1": ["LATE one"]}
+
+
+def test_orchestrator_child_cannot_steer_a_siblings_task():
