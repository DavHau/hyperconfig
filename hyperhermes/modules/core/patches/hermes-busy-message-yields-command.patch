+def yield_tool_commands(agent, wait: float = 0.0) -> bool:
+    """Ask ``agent``'s tool workers to YIELD: a foreground terminal command is handed, still
+    running, to the background registry (notify on completion) instead of being killed. Only
+    while the agent executes tools; True when at least one worker was asked. ``wait`` > 0 blocks
+    (bounded) until every worker took the request, so an interrupt that follows can no longer
+    kill the command: the terminal wait loop checks the interrupt bit before the yield.
+    For any user message that arrives mid-command (with attachments too); explicit stops
+    (/stop, Esc, the Stop button) keep killing."""
+    if not getattr(agent, "_executing_tools", False):
+        return False
+    tracker = getattr(agent, "_tool_worker_threads", None)
+    tracker_lock = getattr(agent, "_tool_worker_threads_lock", None)
+    if tracker is None or tracker_lock is None:
+        return False
+    with tracker_lock:
+        worker_tids = list(tracker)
+    for tid in worker_tids:
+        _request_yield(tid)
+    if wait > 0 and worker_tids:
+        import time
+        deadline = time.monotonic() + wait
+        # Consumed by the terminal poll loop (<= 200 ms); a tool that never yields keeps the
+        # bit until its worker exits, so the wait is bounded.
+        while time.monotonic() < deadline and any(_is_thread_yield_requested(t) for t in worker_tids):
+            time.sleep(0.02)
+    return bool(worker_tids)
+
+
 class InterruptControlMixin:
     """interrupt()/hard_interrupt()/clear_interrupt()/steer()/redirect() (see module docstring)."""
 
