diff --git a/tests/tools/test_busy_message_yields_command.py b/tests/tools/test_busy_message_yields_command.py
new file mode 100644
index 0000000000..25f5cbbda4
--- /dev/null
+++ b/tests/tools/test_busy_message_yields_command.py
@@ -0,0 +1,125 @@
+"""A user message sent while a foreground terminal command runs hands the command to the
+background (still running, notify on completion) on EVERY busy path, not only for a
+text-only redirect: a message with an image, the hard-interrupt fallback of the TUI/desktop
+busy submit, and the messaging gateway's interrupt. An explicit stop still kills it.
+"""
+import json
+import os
+import threading
+import time
+
+import pytest
+
+from agent.interrupt_control import InterruptControlMixin, yield_tool_commands
+from tools import interrupt as interrupt_mod
+from tools.process_registry import process_registry
+from tools.terminal_tool import terminal_tool
+
+pytestmark = pytest.mark.platforms("linux")
+
+
+class _Agent(InterruptControlMixin):
+    _executing_tools = True
+    _interrupt_requested = False
+    _pending_steer = None
+    _pending_redirect = None
+    _tool_interrupt_reason = None
+    _interrupt_message = None
+    api_mode = "chat_completions"
+    quiet_mode = True
+
+    def __init__(self):
+        self._pending_steer_lock = threading.Lock()
+        self._pending_redirect_lock = threading.Lock()
+        self._tool_worker_threads = set()
+        self._tool_worker_threads_lock = threading.Lock()
+        self._active_children = []
+        self._active_children_lock = threading.Lock()
+        self._execution_thread_id = None
+
+
+def _start_command(agent, res, command="echo started; sleep 60; echo done"):
+    def worker():
+        with agent._tool_worker_threads_lock:
+            agent._tool_worker_threads.add(threading.current_thread().ident)
+        try:
+            res["result"] = json.loads(terminal_tool(command, task_id="busy-yield-test", timeout=90))
+        finally:
+            with agent._tool_worker_threads_lock:
+                agent._tool_worker_threads.discard(threading.current_thread().ident)
+            interrupt_mod.set_interrupt(False, threading.current_thread().ident)
+
+    t = threading.Thread(target=worker, daemon=True)
+    t.start()
+    time.sleep(1.5)
+    return t
+
+
+def _assert_yielded_and_cleanup(t, res):
+    t.join(timeout=15)
+    assert not t.is_alive(), "terminal tool still blocked on the command"
+    r = res["result"]
+    try:
+        assert r["status"] == "yielded_to_background", r
+        assert r["exit_code"] is None and "started" in r["output"]
+        assert os.path.exists(f"/proc/{r['pid']}")
+        assert process_registry.poll(r["session_id"])["status"] == "running"
+    finally:
+        if r.get("session_id"):
+            process_registry.kill_process(r["session_id"])
+
+
+@pytest.mark.live_system_guard_bypass
+def test_yield_then_interrupt_moves_command_to_background(tmp_path, monkeypatch):
+    """The interrupt that follows a user message (media payload, older runtime, gateway
+    interrupt mode) no longer kills the command: yield_tool_commands(wait=...) returns only
+    once the terminal handed it off."""
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    agent, res = _Agent(), {}
+    t = _start_command(agent, res)
+    assert yield_tool_commands(agent, wait=2.0) is True
+    agent.interrupt("look at this screenshot")
+    _assert_yielded_and_cleanup(t, res)
+
+
+@pytest.mark.live_system_guard_bypass
+def test_busy_submit_with_image_yields_command(tmp_path, monkeypatch):
+    """The desktop/TUI entry point: prompt.submit while busy with an attached image queues the
+    message and yields the running command instead of leaving the turn parked behind it."""
+    from tui_gateway import server
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(server, "_load_busy_input_mode", lambda: "interrupt")
+    agent, res = _Agent(), {}
+    t = _start_command(agent, res)
+    session = {"agent": agent, "session_key": "k", "history": [], "history_lock": threading.Lock(),
+               "history_version": 0, "running": True, "transport": None,
+               "attached_images": ["/tmp/screenshot.png"]}
+    server._sessions["sid"] = session
+    try:
+        resp = server._methods["prompt.submit"]("r1", {"session_id": "sid", "text": "what is this?"})
+    finally:
+        server._sessions.pop("sid", None)
+    assert resp["result"]["status"] == "queued"
+    assert session["queued_prompt"]["image_paths"] == ["/tmp/screenshot.png"]
+    assert not agent._interrupt_requested  # the turn goes on to the queued message, not killed
+    _assert_yielded_and_cleanup(t, res)
+
+
+@pytest.mark.live_system_guard_bypass
+def test_explicit_stop_still_kills_command(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    agent, res = _Agent(), {}
+    t = _start_command(agent, res)
+    agent.hard_interrupt()
+    t.join(timeout=15)
+    assert not t.is_alive()
+    assert res["result"]["exit_code"] == 130
+
+
+def test_no_yield_outside_tool_execution():
+    agent = _Agent()
+    agent._executing_tools = False
+    agent._tool_worker_threads.add(12345)
+    assert yield_tool_commands(agent) is False
+    assert not interrupt_mod.is_thread_yield_requested(12345)
