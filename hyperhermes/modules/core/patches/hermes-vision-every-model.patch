+def main_runtime_cache_key() -> tuple[str, str]:
+    """hyperhermes: the main provider+model the current context runs (``set_runtime_main``, else
+    config.yaml). Availability checks such as ``check_vision_requirements`` answer per main model,
+    so one gateway session's verdict (a text-only model without a vision backend) must not leak
+    into another session's tool list. ("", "") until the auxiliary client is loaded."""
+    aux = sys.modules.get("agent.auxiliary_client")
+    if aux is None:
+        return ("", "")
+    try:
+        return (str(aux._read_main_provider() or ""), str(aux._read_main_model() or ""))
+    except Exception:
+        return ("", "")
+
