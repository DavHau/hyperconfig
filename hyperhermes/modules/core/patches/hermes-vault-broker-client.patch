+# -- vault broker (hyperhermes: hermes-vault-broker-client.patch) ------------------------------
+
+BROKER_DIR = "/run/hermes-vault"
+_BROKER_TIMEOUT = 30.0
+_BROKER_MAX_REPLY = 4 * 1024 * 1024
+
+
+def broker_socket_path() -> Optional[str]:
+    """This account's vault broker socket, or None when the host runs none for it (file vault).
+
+    Fails closed: a broker directory that is not root's and closed to others is a host fault, not a
+    reason to fall back to files the agent could read."""
+    if os.name != "posix" or not hasattr(os, "getuid"):
+        return None
+    try:
+        st = os.stat(BROKER_DIR)
+    except OSError:
+        return None
+    if st.st_uid != 0 or st.st_mode & 0o022:
+        raise VaultError(f"{BROKER_DIR} is not root's and closed to others; the vault is not used")
+    try:
+        import pwd
+
+        name = pwd.getpwuid(os.getuid()).pw_name
+    except (ImportError, KeyError):
+        # the host runs brokers: an account it cannot name must not fall back to the files
+        raise VaultError("cannot tell whether this account's vault is held by the vault broker; "
+                         "the vault is not used") from None
+    try:
+        marker = os.lstat(os.path.join(BROKER_DIR, f"{name}.on"))
+    except OSError:
+        return None
+    if marker.st_uid != 0:
+        return None
+    return os.path.join(BROKER_DIR, f"{name}.sock")
+
+
+def _broker_call(path: str, op: str, **args: Any) -> Any:
+    """One request, one connection (close-on-exec, closed before returning: no connection a forked
+    child could inherit). Never falls back to the files."""
+    payload = json.dumps({"op": op, **args}).encode("utf-8") + b"\n"
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | getattr(socket, "SOCK_CLOEXEC", 0))
+    try:
+        sock.settimeout(_BROKER_TIMEOUT)
+        sock.connect(path)
+        # The listening socket is the host's (systemd's): a server running as this uid is an impostor.
+        _pid, uid, _gid = struct.unpack("3i", sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
+                                                              struct.calcsize("3i")))
+        if uid == os.getuid():
+            raise VaultError("the vault broker socket is not the host's; the vault is not used")
+        sock.sendall(payload)
+        sock.shutdown(socket.SHUT_WR)
+        chunks, size = [], 0
+        while True:
+            chunk = sock.recv(65536)
+            if not chunk:
+                break
+            size += len(chunk)
+            if size > _BROKER_MAX_REPLY:
+                raise VaultError("the vault broker's reply is too large")
+            chunks.append(chunk)
+    except OSError as exc:
+        raise VaultError(f"the vault broker is not reachable ({type(exc).__name__})") from None
+    finally:
+        sock.close()
+    try:
+        reply = json.loads(b"".join(chunks).decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        raise VaultError("the vault broker sent no valid reply") from None
+    if not isinstance(reply, dict) or not reply.get("ok"):
+        raise VaultError(str((reply or {}).get("error") or "the vault broker refused the request")[:300])
+    return reply.get("result")
+
