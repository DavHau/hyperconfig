+"""hyperhermes hermes-vault-broker-client.patch: VaultStore through the host's vault broker."""
+import json
+import os
+import socket
+import threading
+
+import pytest
+
+from agent import vault_store as vs
+
+
+def _serve(path, handler, uid_ok=True):
+    srv = socket.socket(socket.AF_UNIX)
+    srv.bind(str(path))
+    srv.listen(4)
+    seen = []
+
+    def loop():
+        while True:
+            try:
+                conn, _ = srv.accept()
+            except OSError:
+                return
+            data = b""
+            while not data.endswith(b"\n"):
+                chunk = conn.recv(65536)
+                if not chunk:
+                    break
+                data += chunk
+            if not data:  # the client hung up before sending (refused the server)
+                conn.close()
+                continue
+            req = json.loads(data)
+            seen.append(req)
+            conn.sendall(json.dumps(handler(req)).encode())
+            conn.close()
+
+    threading.Thread(target=loop, daemon=True).start()
+    return srv, seen
+
+
+@pytest.fixture
+def broker(tmp_path, monkeypatch):
+    sock = tmp_path / "me.sock"
+    monkeypatch.setattr(vs, "broker_socket_path", lambda: str(sock))
+    return sock
+
+
+def test_no_marker_means_files(tmp_path, monkeypatch):
+    monkeypatch.setattr(vs, "BROKER_DIR", str(tmp_path / "absent"))
+    assert vs.broker_socket_path() is None
+    store = vs.VaultStore(tmp_path / "vault")
+    meta = store.add_item("payment", "c", {"card_number": "4111", "exp_month": "1", "exp_year": "2030", "cvc": "1"})
+    assert (tmp_path / "vault" / "vault.json.enc").exists() and store.get_meta(meta.id)
+
+
+def test_marker_not_root_is_ignored(tmp_path, monkeypatch):
+    if os.getuid() == 0:
+        pytest.skip("runs as root")
+    d = tmp_path / "run"
+    d.mkdir(mode=0o755)
+    monkeypatch.setattr(vs, "BROKER_DIR", str(d))
+    with pytest.raises(vs.VaultError):  # the directory itself is not root's: fail, never the files
+        vs.broker_socket_path()
+
+
+def test_impostor_server_of_own_uid_is_refused(broker, tmp_path):
+    srv, seen = _serve(broker, lambda req: {"ok": True, "result": []})
+    try:
+        store = vs.VaultStore(tmp_path / "home" / "vault")
+        with pytest.raises(vs.VaultError, match="not the host's"):
+            store.list_items()
+        assert seen == []  # nothing was sent
+    finally:
+        srv.close()
+
+
+def test_unreachable_broker_fails_closed(broker, tmp_path):
+    store = vs.VaultStore(tmp_path / "home" / "vault")
+    with pytest.raises(vs.VaultError, match="not reachable"):
+        store.add_item("payment", "c", {"card_number": "4111", "exp_month": "1", "exp_year": "2030", "cvc": "1"})
+    assert not (tmp_path / "home" / "vault").exists()  # no local vault minted
+
+
+def test_requests_name_the_home_and_map_replies(broker, tmp_path, monkeypatch):
+    monkeypatch.setattr(vs, "_broker_call", lambda path, op, **a: _fake(op, a))
+    calls = []
+
+    def _fake(op, a):
+        calls.append((op, a))
+        if op == "list_items":
+            return [{"id": "vault_1", "kind": "login", "label": "x", "origin": "https://a.example",
+                     "created_at": "t", "identifier": "me", "identifier_type": "email"}]
+        if op == "resolve_secret":
+            return {"password": "pw"}
+        if op == "get_meta":
+            return None
+        return True
+
+    store = vs.VaultStore(tmp_path / "home" / "vault")
+    [meta] = store.list_items()
+    assert meta.identifier_type == "email" and meta.origin == "https://a.example"
+    assert store.resolve_secret("vault_1") == {"password": "pw"}
+    assert store.get_meta("nope") is None
+    assert calls[0] == ("list_items", {"home": str(tmp_path / "home")})
+    assert store.key_location()["storage"] == "broker"
+    with pytest.raises(vs.VaultError):
+        store.migrate_key("file")
+    assert store.own_copied_key(tmp_path / "x") is None
+
+
+def test_unnamed_account_with_brokers_fails_closed(tmp_path, monkeypatch):
+    import pwd
+
+    d = tmp_path / "run"
+    d.mkdir(mode=0o755)
+    real_stat = os.stat
+    monkeypatch.setattr(vs, "BROKER_DIR", str(d))
+    monkeypatch.setattr(vs.os, "stat", lambda p, *a, **k: os.stat_result((0o40755, 0, 0, 0, 0, 0, 0, 0, 0, 0))
+                        if str(p) == str(d) else real_stat(p, *a, **k))
+    monkeypatch.setattr(pwd, "getpwuid", lambda uid: (_ for _ in ()).throw(KeyError(uid)))
+    with pytest.raises(vs.VaultError, match="cannot tell"):
+        vs.broker_socket_path()
