+def _native_instead_of_openrouter(runtime: dict[str, Any], target_model: Optional[str], requested: Optional[str],
+                                  explicit_api_key: Optional[str], explicit_base_url: Optional[str]) -> dict[str, Any]:
+    """``model_catalog.openrouter_exclude_native``: an OpenRouter runtime for a model whose vendor
+    serves it natively here resolves to the native provider instead (``runtime["model"]`` carries
+    the native id). Main model, ``delegation.provider`` and cron jobs all resolve through here.
+    Only with a model to run: ``target_model``, or ``model.default`` for the main runtime
+    (``requested`` unset/``auto``) when the configured main provider is OpenRouter. Returned as
+    is: a model-less named request (``requested="openrouter"``: image/video gen, the credits
+    display) and any call with an explicit key or base_url (account_usage): they want exactly
+    that provider's key and URL. Agents built from such a runtime are still rewritten by the
+    ``init_agent`` backstop."""
+    if explicit_api_key or explicit_base_url:
+        return runtime
+    from hermes_cli.openrouter_native import is_openrouter_route, log_rewrite, native_runtime, native_target_full
+    model = target_model
+    if not model:
+        if str(requested or "").strip().lower() not in {"", "auto"}:
+            return runtime
+        cfg = _get_model_config()
+        if not is_openrouter_route(cfg.get("provider"), cfg.get("base_url")):
+            return runtime
+        model = cfg.get("default") or ""
+    target = native_target_full(runtime.get("provider"), model, runtime.get("base_url"))
+    if target is None:
+        return runtime
+    vendor, native_model, overrides = target
+    native = native_runtime(vendor, native_model)
+    log_rewrite("runtime resolution", model, vendor, native_model)
+    out = {**native, "model": native_model, "requested_provider": vendor}
+    if overrides:
+        out["request_overrides"] = {**(native.get("request_overrides") or {}), **overrides}
+    return out
 
 
