diff --git a/hermes_cli/openrouter_native.py b/hermes_cli/openrouter_native.py
new file mode 100644
index 0000000..3fe1d9f
--- /dev/null
+++ b/hermes_cli/openrouter_native.py
@@ -0,0 +1,348 @@
+"""``model_catalog.openrouter_exclude_native``: OpenRouter never serves a model the agent can reach natively.
+
+A list of vendor ids (e.g. ``[anthropic]``). For each listed vendor that has a working native provider
+of the same name (a credential ``resolve_runtime_provider(requested=<vendor>)`` accepts), OpenRouter's
+``<vendor>/*`` models are:
+
+- dropped from the OpenRouter catalog (``hermes_cli.models.fetch_openrouter_models`` and so every
+  picker: desktop/dashboard model options, TUI and messaging ``/model``, ``hermes model``);
+- rewritten to the native provider wherever a provider+model pair is resolved: the runtime
+  resolver (main model, ``delegation.provider``, cron jobs), the agent constructor (delegated
+  children, fallback chains), live model switches, fallback activation and auxiliary clients.
+
+The rewrite keeps the work running on the same model and logs a warning; it is never silently
+billed to OpenRouter. An agent without the native credential keeps OpenRouter's models.
+Empty or unset (upstream default): nothing changes.
+
+Model ids (``native_model``): an OpenRouter ``:<variant>`` suffix (``:thinking``, ``:beta``,
+``:nitro``, ``:floor``, ``:extended``) is dropped; a ``-fast`` id is the base model with fast mode
+on (``{"speed": "fast"}`` request overrides, only where the base model accepts it);
+``~vendor/...-latest`` aliases and undated short ids resolve through the vendor's curated model
+list (``_PROVIDER_MODELS``): the exact id, else its (newest) dated snapshot, else (``-latest``) the
+newest listed id of that family; anything else keeps the plain normalized id, logged.
+
+Only provider+model pairs are rewritten: a model-less ``resolve_runtime_provider(requested=
+"openrouter")`` (image/video generation, the credits display) and any resolution with an explicit
+key or base_url want OpenRouter's own key and URL and are left alone.
+
+An agent already on the native provider whose model string is still an OpenRouter id (the gateway,
+cron and CLI build the main agent from the configured ``model.default`` after the runtime was
+rewritten) gets the same id mapping (``native_id_fixup``).
+
+Fast mode from a ``-fast`` id belongs to that one model: ``agent._native_fast_route`` records
+``(model, overrides)`` and ``agent.fast_mode.effective_request_overrides`` drops those keys while
+the agent runs any other model (fallback activation, ``/model``); a later switch replaces them.
+
+Availability is cached 60 s per profile: after the native key is removed, OpenRouter requests for
+the vendor's models still go native (and fail with an auth error) for up to 60 s; after it is
+added, they stay on OpenRouter for up to 60 s.
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+import threading
+import time
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+_AVAILABLE_TTL_SECONDS = 60.0
+_available_cache: dict[tuple[str, str], tuple[float, bool]] = {}
+_available_lock = threading.Lock()
+_in_probe = threading.local()
+
+
+def excluded_vendors() -> frozenset[str]:
+    """Vendor ids listed in ``model_catalog.openrouter_exclude_native`` (lower-case)."""
+    try:
+        from hermes_cli.config import load_config_readonly
+        raw = (load_config_readonly() or {}).get("model_catalog")
+    except Exception:
+        return frozenset()
+    value = raw.get("openrouter_exclude_native") if isinstance(raw, dict) else None
+    if isinstance(value, str):
+        value = [value]
+    if not isinstance(value, (list, tuple)):
+        return frozenset()
+    return frozenset(str(v).strip().lower() for v in value if str(v or "").strip())
+
+
+def is_openrouter_route(provider: Any, base_url: Any = None) -> bool:
+    """True for provider ``openrouter``, any route whose base_url is at openrouter.ai, and a named
+    custom provider (``providers:`` / ``custom_providers:``) whose configured base_url is."""
+    from utils import base_url_host_matches
+    name = str(provider or "").strip().lower()
+    if name == "openrouter":
+        return True
+    if base_url:
+        return base_url_host_matches(str(base_url), "openrouter.ai")
+    if name in {"", "auto", "custom"}:
+        return False
+    try:
+        from hermes_cli.runtime_provider_custom import _get_named_custom_provider
+        entry = _get_named_custom_provider(name, resolve_credentials=False) or {}
+    except Exception:
+        return False
+    url = str(entry.get("base_url") or "").strip()
+    return bool(url) and base_url_host_matches(url, "openrouter.ai")
+
+
+def model_vendor(model: Any) -> Optional[str]:
+    """``anthropic`` for ``anthropic/claude-…`` / ``~anthropic/…`` / bare ``claude-…``; else the slug prefix."""
+    name = str(model or "").strip().lstrip("~")
+    if not name:
+        return None
+    if "/" in name:
+        return name.split("/", 1)[0].strip().lower() or None
+    try:
+        from hermes_cli.model_normalize import detect_vendor
+        return detect_vendor(name)
+    except Exception:
+        return None
+
+
+def _profile_key() -> str:
+    try:
+        from hermes_constants import get_hermes_home
+        return str(get_hermes_home())
+    except Exception:
+        return ""
+
+
+def native_available(vendor: str) -> bool:
+    """Whether the native provider ``vendor`` resolves with a credential (cached ~60 s per profile)."""
+    key = (vendor, _profile_key())
+    now = time.monotonic()
+    with _available_lock:
+        hit = _available_cache.get(key)
+        if hit is not None and now - hit[0] < _AVAILABLE_TTL_SECONDS:
+            return hit[1]
+    if getattr(_in_probe, "active", False):
+        return False
+    _in_probe.active = True
+    try:
+        from hermes_cli.runtime_provider import resolve_runtime_provider
+        runtime = resolve_runtime_provider(requested=vendor)
+        ok = (str(runtime.get("provider") or "").lower() == vendor and bool(runtime.get("api_key")))
+    except Exception as exc:
+        logger.debug("openrouter_exclude_native: native provider %s unavailable: %s", vendor, exc)
+        ok = False
+    finally:
+        _in_probe.active = False
+    with _available_lock:
+        _available_cache[key] = (now, ok)
+    return ok
+
+
+def reset_cache() -> None:
+    with _available_lock:
+        _available_cache.clear()
+
+
+_VARIANT_SUFFIX = re.compile(r":[A-Za-z0-9._-]+$")
+_DATED = re.compile(r"-\d{8}$")
+
+
+def _canon(model_id: str) -> str:
+    return model_id.strip().lower().replace(".", "-")
+
+
+def _curated_ids(vendor: str) -> list[str]:
+    try:
+        from hermes_cli.models_catalog_static import _PROVIDER_MODELS
+        return [str(m) for m in (_PROVIDER_MODELS.get(vendor) or [])]
+    except Exception:
+        return []
+
+
+def native_model(vendor: str, model: Any) -> tuple[str, dict[str, Any]]:
+    """``(native id, request overrides)`` for an OpenRouter id of ``vendor`` (see module doc)."""
+    raw = str(model or "").strip()
+    alias = raw.startswith("~")
+    name = raw.lstrip("~")
+    head, sep, tail = name.rpartition("/")
+    name = head + sep + _VARIANT_SUFFIX.sub("", tail)
+    overrides: dict[str, Any] = {}
+    fast = name.lower().endswith("-fast")
+    if fast:
+        name = name[: -len("-fast")]
+    latest = name.lower().endswith("-latest")
+    if latest:
+        name = name[: -len("-latest")]
+    try:
+        from hermes_cli.model_normalize import normalize_model_for_provider
+        base = normalize_model_for_provider(name, vendor)
+    except Exception:
+        base = name.split("/", 1)[-1]
+    curated = _curated_ids(vendor)
+    key = _canon(base)
+    exact = [m for m in curated if _canon(m) == key]
+    dated = [m for m in curated if _canon(m).startswith(key + "-") and _DATED.fullmatch(_canon(m)[len(key):])]
+    family = [m for m in curated if _canon(m).startswith(key + "-")]
+    if exact and not latest:
+        resolved = exact[0]
+    elif dated and not latest:
+        resolved = max(dated, key=lambda m: _canon(m)[-8:])  # newest snapshot
+    elif latest and (exact or family):
+        resolved = (exact or family)[0]  # the curated list is newest-first
+    else:
+        resolved = base
+        if alias or latest or fast or not _DATED.search(base):
+            logger.info("openrouter_exclude_native: %r has no unique match in the %s model list; using %r",
+                        raw, vendor, base)
+    if fast:
+        try:
+            from hermes_cli.models import resolve_fast_mode_overrides
+            overrides = resolve_fast_mode_overrides(resolved, provider=vendor) or {}
+        except Exception:
+            overrides = {}
+        if not overrides:
+            logger.warning("openrouter_exclude_native: %r asks for fast mode, which %r on %s does not offer; "
+                           "running at normal speed", raw, resolved, vendor)
+    return resolved, overrides
+
+
+def _looks_openrouter_id(raw: str) -> bool:
+    low = raw.lower()
+    return "/" in raw or raw.startswith("~") or ":" in raw or low.endswith("-fast") or low.endswith("-latest")
+
+
+def native_id_fixup(provider: Any, model: Any) -> Optional[tuple[str, dict[str, Any]]]:
+    """``(native id, overrides)`` when ``provider`` already IS an excluded vendor's native provider but
+    ``model`` is still an OpenRouter-style id of that vendor (``anthropic/claude-opus-5-fast``,
+    ``...:thinking``, ``~anthropic/...-latest``, undated ``claude-sonnet-4``); else None."""
+    raw = str(model or "").strip()
+    name = str(provider or "").strip().lower()
+    if not raw or not name:
+        return None
+    vendors = excluded_vendors()
+    if name not in vendors or model_vendor(raw) != name:
+        return None
+    resolved, overrides = native_model(name, raw)
+    if _looks_openrouter_id(raw):
+        return resolved, overrides
+    # A bare native-style id: only an undated short id that the curated list pins to a snapshot.
+    if resolved != raw and _DATED.search(resolved) and not _DATED.search(raw):
+        return resolved, overrides
+    return None
+
+
+def native_target(provider: Any, model: Any, base_url: Any = None) -> Optional[tuple[str, str]]:
+    """``(native_provider, native_model)`` when this OpenRouter request must go native instead, else None."""
+    full = native_target_full(provider, model, base_url)
+    return None if full is None else (full[0], full[1])
+
+
+def native_target_full(provider: Any, model: Any, base_url: Any = None) -> Optional[tuple[str, str, dict[str, Any]]]:
+    """:func:`native_target` plus the request overrides the id implies (``-fast`` -> speed fast)."""
+    if not str(model or "").strip():
+        return None
+    vendors = excluded_vendors()
+    if not vendors:
+        return None
+    vendor = model_vendor(model)
+    if not vendor or vendor not in vendors or not is_openrouter_route(provider, base_url):
+        return None
+    if not native_available(vendor):
+        return None
+    resolved, overrides = native_model(vendor, model)
+    return vendor, resolved, overrides
+
+
+def hidden_vendors() -> frozenset[str]:
+    """Excluded vendors whose native provider works here (their OpenRouter rows are hidden)."""
+    return frozenset(v for v in excluded_vendors() if native_available(v))
+
+
+def filter_catalog(rows: list) -> list:
+    """Drop OpenRouter catalog rows (ids or ``(id, desc)`` tuples) of hidden vendors."""
+    hidden = hidden_vendors()
+    if not hidden:
+        return rows
+    out = []
+    for row in rows:
+        mid = row[0] if isinstance(row, (tuple, list)) else row
+        if model_vendor(mid) in hidden:
+            continue
+        out.append(row)
+    return out
+
+
+def fingerprint_part() -> str:
+    """Cache-key part for provider_models_cache.json's OpenRouter row."""
+    return "openrouter_exclude_native=" + ",".join(sorted(hidden_vendors()))
+
+
+def native_runtime(vendor: str, model: str) -> dict[str, Any]:
+    """The native provider's resolved runtime for ``model`` (raises like resolve_runtime_provider)."""
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+    return resolve_runtime_provider(requested=vendor, target_model=model)
+
+
+def log_rewrite(where: str, model: Any, vendor: str, native_model: str) -> None:
+    logger.warning(
+        "openrouter_exclude_native: %s asked for %r via OpenRouter; running %r on the native %s provider "
+        "instead (model_catalog.openrouter_exclude_native)", where, model, native_model, vendor)
+
+
+def rewrite_fallback_entries(entries: Any) -> Any:
+    """Fallback chain (dict or list of dicts) with OpenRouter entries of hidden vendors made native."""
+    if isinstance(entries, dict):
+        return (rewrite_fallback_entries([entries]) or [None])[0]
+    if not isinstance(entries, list):
+        return entries
+    out = []
+    for entry in entries:
+        if isinstance(entry, dict):
+            target = native_target(entry.get("provider"), entry.get("model"), entry.get("base_url"))
+            if target is not None:
+                log_rewrite("fallback entry", entry.get("model"), *target)  # (a -fast id runs at normal speed)
+                entry = {k: v for k, v in entry.items() if k not in {"base_url", "api_key", "key_env", "api_key_env"}}
+                entry["provider"], entry["model"] = target
+            else:
+                fixed = native_id_fixup(entry.get("provider"), entry.get("model"))
+                if fixed is not None and fixed[0] != entry.get("model"):
+                    entry = {**entry, "model": fixed[0]}  # (a -fast id runs at normal speed)
+        out.append(entry)
+    return out
+
+
+def set_native_fast_route(agent: Any, model: Any, overrides: Optional[dict[str, Any]]) -> None:
+    """Replace the fast-mode keys a previous ``-fast`` mapping put into ``agent.request_overrides``
+    with ``overrides`` for ``model`` (none: just drop the old ones)."""
+    current = dict(getattr(agent, "request_overrides", None) or {})
+    previous = getattr(agent, "_native_fast_route", None)
+    if previous:
+        for key, value in (previous[1] or {}).items():
+            if current.get(key) == value:
+                current.pop(key, None)
+    if overrides:
+        current.update(overrides)
+        agent._native_fast_route = (str(model or ""), dict(overrides))
+    else:
+        agent._native_fast_route = None
+    agent.request_overrides = current
+
+
+def strip_foreign_native_fast(agent: Any, overrides: dict[str, Any]) -> None:
+    """In place: drop the ``-fast`` mapping's keys while ``agent`` runs a model other than the one
+    they were set for (a fallback or another model; restoring the primary brings them back)."""
+    route = getattr(agent, "_native_fast_route", None)
+    if route and getattr(agent, "model", None) != route[0]:
+        for key, value in (route[1] or {}).items():
+            if overrides.get(key) == value:
+                overrides.pop(key, None)
+    # Paths that carry the mapping only as request_overrides (gateway /model session overrides,
+    # delegate children) have no route record: ``speed`` never goes to a model or wire that has
+    # no Anthropic fast mode (a non-Claude fallback, chat_completions to OpenRouter).
+    if overrides.get("speed") == "fast" and excluded_vendors():
+        try:
+            from hermes_cli.models import _is_anthropic_fast_model
+            fast_ok = (getattr(agent, "api_mode", None) == "anthropic_messages"
+                       and _is_anthropic_fast_model(getattr(agent, "model", None)))
+        except Exception:
+            fast_ok = False
+        if not fast_ok:
+            overrides.pop("speed", None)
