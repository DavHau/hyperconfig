+"""browser_downloads on the Camofox backend: listing, saving, and its refusals.
+
+A fake camofox-browser answers GET /tabs and GET /tabs/<id>/downloads per userId the way
+the real server does (records appear once saved; includeData inlines base64 up to maxBytes).
+"""
+
+import base64
+import hashlib
+import json
+import os
+
+import pytest
+
+import tools.browser_camofox as bc
+
+
+class FakeCamofox:
+    def __init__(self):
+        self.tabs = {}  # userId -> {tabId: [record, ...]}
+        self.data = {}  # download id -> bytes
+        self.data_requests = []
+
+    def add(self, user, tab, rid, name, raw, created, failure=None):
+        self.tabs.setdefault(user, {}).setdefault(tab, []).append({
+            "id": rid, "url": f"https://example.com/{name}", "suggestedFilename": name,
+            "mimeType": "application/octet-stream", "bytes": None if failure else len(raw),
+            "createdAt": created, "failure": failure})
+        self.data[rid] = raw
+
+    def get(self, path, params=None, timeout=None):
+        user = params["userId"]
+        if path == "/tabs":
+            return {"running": True, "tabs": [{"tabId": t} for t in self.tabs.get(user, {})]}
+        tab = path.split("/")[2]
+        records = self.tabs.get(user, {}).get(tab)
+        if records is None:
+            raise AssertionError(f"{user} asked for foreign tab {tab}")
+        out = []
+        for r in records:
+            item = dict(r)
+            if params.get("includeData") == "true" and not r["failure"]:
+                self.data_requests.append((r["id"], int(params["maxBytes"])))
+                if r["bytes"] <= int(params["maxBytes"]):
+                    item["dataBase64"] = base64.b64encode(self.data[r["id"]]).decode()
+                else:
+                    item["dataSkipped"] = "max_bytes_exceeded"
+            out.append(item)
+        return {"tabId": tab, "downloads": out}
+
+
+@pytest.fixture
+def camofox(monkeypatch, tmp_path):
+    fake = FakeCamofox()
+    monkeypatch.setattr(bc, "_get", fake.get)
+    monkeypatch.setattr(bc, "_DOWNLOAD_WAIT_SECONDS", 0.2)
+    monkeypatch.setattr(bc, "_DOWNLOAD_POLL_SECONDS", 0.05)
+    workspace = tmp_path / "ws"
+    workspace.mkdir()
+    monkeypatch.setenv("TERMINAL_CWD", str(workspace))
+    monkeypatch.setenv("TERMINAL_ENV", "local")
+    with bc._sessions_lock:
+        bc._sessions.clear()
+        bc._sessions["a"] = {"user_id": "user-a", "tab_id": "tab-a", "session_key": "task_a",
+                             "managed": False, "adopt_existing_tab": False}
+        bc._sessions["b"] = {"user_id": "user-b", "tab_id": None, "session_key": "task_b",
+                             "managed": False, "adopt_existing_tab": False}
+    yield fake, workspace
+    with bc._sessions_lock:
+        bc._sessions.clear()
+
+
+def _call(**kw):
+    return json.loads(bc.camofox_downloads(**kw))
+
+
+def test_lists_downloads_of_every_tab_once_as_new(camofox):
+    fake, _ = camofox
+    fake.add("user-a", "tab-a", "d1", "a.bin", b"aaa", "2026-01-01T00:00:01Z")
+    fake.add("user-a", "popup", "d2", "b.bin", b"bb", "2026-01-01T00:00:02Z")
+    fake.add("user-a", "tab-a", "d3", "c.bin", b"", "2026-01-01T00:00:03Z", failure="canceled")
+
+    first = _call(task_id="a")
+    assert [(d["id"], d["filename"], d["size"], d["status"], d["new"]) for d in first["downloads"]] == [
+        ("d1", "a.bin", 3, "complete", True), ("d2", "b.bin", 2, "complete", True),
+        ("d3", "c.bin", None, "failed: canceled", True)]
+    again = _call(task_id="a")
+    assert not any(d["new"] for d in again["downloads"])
+    assert "No new download" in again["note"]
+
+
+def test_saves_into_workspace_with_sha256(camofox):
+    fake, ws = camofox
+    raw = os.urandom(4096)
+    fake.add("user-a", "popup", "d1", "file.apk", raw, "2026-01-01T00:00:01Z")
+    fake.add("user-a", "tab-a", "d0", "huge.bin", b"x" * 9000, "2026-01-01T00:00:00Z")
