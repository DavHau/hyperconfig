+
+
+def test_page_filename_cannot_traverse(camofox):
+    fake, ws = camofox
+    fake.add("user-a", "tab-a", "d1", "../../evil.bin", b"x", "2026-01-01T00:00:01Z")
+    out = _call(task_id="a", save="d1")
+    assert out["path"] == str(ws / "evil.bin")
+
+
+def test_refuses_oversize_without_fetching(camofox, monkeypatch):
+    fake, ws = camofox
+    monkeypatch.setattr(bc, "_DOWNLOAD_MAX_BYTES", 10)
+    fake.add("user-a", "tab-a", "d1", "big.bin", b"x" * 11, "2026-01-01T00:00:01Z")
+
+    out = _call(task_id="a", save="d1")
+    assert "over the 10-byte limit" in out["error"]
+    assert fake.data_requests == []
+    assert not (ws / "big.bin").exists()
+
+
+def test_other_session_sees_nothing(camofox):
+    fake, _ = camofox
+    fake.add("user-a", "tab-a", "d1", "f.bin", b"x", "2026-01-01T00:00:01Z")
+
+    assert "browser_navigate" in _call(task_id="b")["error"]
+    fake.tabs["user-b"] = {"tab-b": []}
+    assert _call(task_id="b")["downloads"] == []
+    assert "No download 'd1'" in _call(task_id="b", save="d1")["error"]
+
+
+def test_failed_download_is_not_saved(camofox):
+    fake, _ = camofox
+    fake.add("user-a", "tab-a", "d1", "f.bin", b"", "2026-01-01T00:00:01Z", failure="canceled")
+    assert "failed in the browser" in _call(task_id="a", save="d1")["error"]
