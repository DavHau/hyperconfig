         return True
+    # A subagent's own process carries its parent's session_key, so the parent's poller owns it: apply the same
+    # child-process policy as every other drain (delegation.surface_child_process_notifications, default off).
+    # Dropped, not requeued — children never drain. Handed-off processes are re-owned by the parent and pass.
+    from tools.process_registry_notifications import should_surface_notification
+    if not should_surface_notification(evt):
+        return True
