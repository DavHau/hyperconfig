     if not text:
         return True
diff --git a/tests/tui_gateway/test_subagent_process_notice_stays_out_of_parent.py b/tests/tui_gateway/test_subagent_process_notice_stays_out_of_parent.py
new file mode 100644
index 00000000..3e38a067
--- /dev/null
+++ b/tests/tui_gateway/test_subagent_process_notice_stays_out_of_parent.py
@@ -0,0 +1,57 @@
+"""A subagent's own background process never wakes the parent's TUI/Desktop/dashboard session.
+
+The child's process carries the parent's ``session_key`` (the conversation it runs under), so the parent's notification
+poller proves ownership of its completion. Every other drain (CLI, gateway watchers, the post-turn safety net) applies
+``should_surface_notification``; the poller must too, or the parent gets an unasked-for turn.
+"""
+
+from __future__ import annotations
+
+import queue
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from tui_gateway import server
+
+CHILD = {"type": "completion", "session_id": "proc_child", "session_key": "s", "task_id": "sa-0-abc",
+         "owner_task_id": "sa-0-abc", "command": "sleep 1", "exit_code": 0}
+PARENT = {"type": "completion", "session_id": "proc_parent", "session_key": "s", "task_id": "s",
+          "owner_task_id": "s", "command": "sleep 1", "exit_code": 0}
+# handoff re-owns the process to the parent (transfer_ownership): owner_task_id is the parent's from then on
+HANDED = dict(PARENT, session_id="proc_handed", handoff_note="watch CI")
+
+
+@pytest.fixture
+def surface(monkeypatch):
+    submits: list = []
+    monkeypatch.setattr("tools.async_delegation.claim_event_delivery", lambda evt, consumer: "claimed")
+    monkeypatch.setattr("tools.async_delegation.complete_event_delivery", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_run_prompt_submit", lambda rid, sid, session, text, **kw: submits.append(text))
+    monkeypatch.setattr(server, "_emit", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_notification_event_belongs_elsewhere", lambda sid, session, evt: False)
+    monkeypatch.setattr(server, "_session_owns_notification_event", lambda sid, session, evt: True)
+    monkeypatch.setattr(server, "_background_notifications_off", lambda session: False)
+    return submits
+
+
+def _run(events, monkeypatch, surface_child):
+    from tools.process_registry import ProcessRegistry
+    monkeypatch.setattr(ProcessRegistry, "_surface_child_process_notifications", staticmethod(lambda: surface_child))
+    session = {"history_lock": threading.RLock(), "running": False, "history": [], "agent": None}
+    registry = SimpleNamespace(completion_queue=queue.Queue(), is_completion_consumed=lambda session_id: False)
+    completions: list = []
+    for evt in events:
+        assert server._notif_handle_event("sid", session, dict(evt), set(), registry,
+                                          lambda e: e["session_id"], None, completions) is True
+    assert registry.completion_queue.empty(), "a dropped child notice is never requeued"
+    return [evt["session_id"] for evt, _text in completions]
+
+
+def test_child_process_completion_is_dropped_by_default(surface, monkeypatch):
+    assert _run([CHILD, PARENT, HANDED], monkeypatch, surface_child=False) == ["proc_parent", "proc_handed"]
+
+
+def test_opt_in_flag_still_surfaces_child_processes(surface, monkeypatch):
+    assert _run([CHILD, PARENT], monkeypatch, surface_child=True) == ["proc_child", "proc_parent"]
