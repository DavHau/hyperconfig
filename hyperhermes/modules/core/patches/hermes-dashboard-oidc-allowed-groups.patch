+# ---------------------------------------------------------------------------
+# allowed_groups: authorization on the verified ``groups`` claim
+# ---------------------------------------------------------------------------
+
+
+class TestAllowedGroups:
+    @pytest.fixture
+    def provider(self, rsa_keypair):
+        return _make_provider(rsa_keypair, allowed_groups=" hermes-alice, admins ,")
+
+    def _login(self, provider, id_token):
+        mock_resp = _mock_post(
+            200, {"id_token": id_token, "token_type": "Bearer", "refresh_token": "rt"}
+        )
+        with patch(
+            "plugins.dashboard_auth.self_hosted.httpx.post", return_value=mock_resp
+        ):
+            return provider.complete_login(
+                code="abc",
+                state="s",
+                code_verifier="vfy",
+                redirect_uri="https://hermes.example/auth/callback",
+            )
+
+    def test_member_logs_in(self, provider, rsa_keypair):
+        token = _mint_id_token(rsa_keypair, groups=["other", "hermes-alice"])
+        assert self._login(provider, token).user_id == "usr_abc"
+        assert provider.verify_session(access_token=token) is not None
+
+    @pytest.mark.parametrize("groups", [None, [], ["hermes-bob"], "hermes-alice"])
+    def test_non_member_login_refused(self, provider, rsa_keypair, groups):
+        token = _mint_id_token(rsa_keypair, groups=groups)
+        with pytest.raises(InvalidCodeError, match="allowed groups"):
+            self._login(provider, token)
+
+    def test_non_member_session_is_invalid(self, provider, rsa_keypair):
+        token = _mint_id_token(rsa_keypair, groups=["hermes-bob"])
+        assert provider.verify_session(access_token=token) is None
+
+    def test_non_member_refresh_expires_session(self, provider, rsa_keypair):
+        token = _mint_id_token(rsa_keypair, groups=["hermes-bob"])
+        mock_resp = _mock_post(
+            200, {"id_token": token, "token_type": "Bearer", "refresh_token": "rt2"}
+        )
+        with patch(
+            "plugins.dashboard_auth.self_hosted.httpx.post", return_value=mock_resp
+        ):
+            with pytest.raises(RefreshExpiredError, match="allowed groups"):
+                provider.refresh_session(refresh_token="rt_old")
+
+    def test_unset_admits_any_identity(self, rsa_keypair):
+        provider = _make_provider(rsa_keypair)
+        token = _mint_id_token(rsa_keypair)
+        assert self._login(provider, token).user_id == "usr_abc"
+
+
