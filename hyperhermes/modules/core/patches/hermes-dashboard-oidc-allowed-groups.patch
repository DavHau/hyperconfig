+    def _require_allowed_group(self, claims: dict[str, Any]) -> None:
+        """Admit only members of an allowed group (module docstring). Runs on verified claims
+        only, and on every path that turns a token into a Session."""
+        if not self._allowed_groups:
+            return
+        groups = claims.get("groups")
+        if isinstance(groups, list) and self._allowed_groups.intersection(str(g) for g in groups):
+            return
+        raise GroupNotAllowedError(
+            f"ID token of sub={claims.get('sub')!r} is in none of the allowed groups "
+            f"{sorted(self._allowed_groups)!r}")
 
