diff --git a/tests/hermes_cli/test_gateway_foreign_systemd_unit.py b/tests/hermes_cli/test_gateway_foreign_systemd_unit.py
new file mode 100644
index 0000000..604454f
--- /dev/null
+++ b/tests/hermes_cli/test_gateway_foreign_systemd_unit.py
@@ -0,0 +1,101 @@
+"""``hermes gateway restart``/``stop`` against a gateway that a systemd unit of another name supervises.
+
+A NixOS module runs the gateway as ``hermes-agent-<user>.service``. ``get_service_name()`` only knows
+``hermes-gateway*``, so the command found no installed unit, SIGTERMed the gateway and ran a new one
+inside the dashboard's own service. The real unit then failed on every start with "Gateway already
+running (PID …)". The unit owns the relaunch: the command must SIGUSR1 its main process and spawn nothing.
+"""
+import signal
+import subprocess
+from types import SimpleNamespace
+
+import pytest
+
+GATEWAY_PID = 4242
+REPLACEMENT_PID = 4343
+UNIT = "hermes-agent-alice.service"
+
+
+def _systemctl_answer(main_pid: int):
+    def _run(args, *, system=False, **kwargs):
+        assert system is True, "a /system.slice cgroup names a system unit"
+        assert args[:2] == ["show", UNIT], args
+        return subprocess.CompletedProcess(args, 0, stdout=f"{main_pid}\n", stderr="")
+
+    return _run
+
+
+@pytest.fixture
+def supervised_gateway(monkeypatch):
+    """A running gateway that is the main process of ``UNIT``; records every signal and spawn."""
+    from gateway import status
+    from hermes_cli import gateway as gw
+    from hermes_cli import main_dashboard
+
+    sent = []
+    monkeypatch.setattr(gw, "_refuse_from_inside_gateway", lambda *a, **k: None)
+    monkeypatch.setattr(gw, "_dispatch_via_service_manager_if_s6", lambda *a, **k: False)
+    monkeypatch.setattr(gw, "_guard_named_profile_under_multiplexer", lambda **k: None)
+    monkeypatch.setattr(gw, "named_profile_served_by_running_multiplexer", lambda: False)
+    monkeypatch.setattr(gw, "find_gateway_pids", lambda *a, **k: [GATEWAY_PID])
+    monkeypatch.setattr(gw, "_installed_service_kind_for", lambda windows: None)
+    monkeypatch.setattr(gw, "_get_restart_exit_wait_budget", lambda: 5.0)
+    monkeypatch.setattr(status, "get_running_pid", lambda *a, **k: GATEWAY_PID if not sent else None)
+    monkeypatch.setattr(status, "_pid_exists", lambda pid: not sent)
+    monkeypatch.setattr(gw.os, "kill", lambda pid, sig: sent.append((pid, sig)))
+    monkeypatch.setattr(
+        main_dashboard, "_pid_unified_cgroup_entries", lambda pid: iter([f"/system.slice/{UNIT}"])
+    )
+    main_pids = iter([GATEWAY_PID, REPLACEMENT_PID])
+    monkeypatch.setattr(
+        gw,
+        "_run_systemctl",
+        lambda args, **k: _systemctl_answer(next(main_pids, REPLACEMENT_PID))(args, **k),
+    )
+    spawned = []
+    monkeypatch.setattr(gw, "run_gateway", lambda **k: spawned.append(k))
+    monkeypatch.setattr(gw, "stop_profile_gateway", lambda: spawned.append("sigterm") or True)
+    monkeypatch.setattr(gw, "_service_call", lambda *a, **k: spawned.append(a))
+    return SimpleNamespace(sent=sent, spawned=spawned)
+
+
+@pytest.mark.linux_only
+def test_restart_hands_a_supervised_gateway_to_its_unit(supervised_gateway):
+    from hermes_cli import gateway as gw
+
+    gw._cmd_restart(SimpleNamespace(system=False, all=False, force=False))
+
+    assert supervised_gateway.sent == [(GATEWAY_PID, signal.SIGUSR1)]
+    assert supervised_gateway.spawned == []
+
+
+@pytest.mark.linux_only
+def test_stop_never_kills_or_spawns_beside_a_supervising_unit(supervised_gateway):
+    from hermes_cli import gateway as gw
+
+    with pytest.raises(SystemExit) as exc:
+        gw._cmd_stop(SimpleNamespace(system=False, all=False))
+
+    # The unit relaunches the gateway after any exit, so the stop cannot complete. It drains and
+    # restarts instead and says so with a non-zero exit.
+    assert exc.value.code == 1
+    assert supervised_gateway.sent == [(GATEWAY_PID, signal.SIGUSR1)]
+    assert supervised_gateway.spawned == []
+
+
+@pytest.mark.linux_only
+def test_a_gateway_that_only_shares_a_units_cgroup_is_not_supervised(monkeypatch):
+    """A gateway spawned inside the dashboard's service shares its cgroup and INVOCATION_ID, but
+    systemd does not relaunch it: it is not the unit's main process."""
+    from hermes_cli import gateway as gw
+    from hermes_cli import main_dashboard
+
+    monkeypatch.setattr(
+        main_dashboard, "_pid_unified_cgroup_entries", lambda pid: iter([f"/system.slice/{UNIT}"])
+    )
+    monkeypatch.setattr(gw, "_run_systemctl", _systemctl_answer(main_pid=1111))
+
+    assert gw._supervising_systemd_unit(GATEWAY_PID) is None
+
+    monkeypatch.setattr(gw, "_run_systemctl", _systemctl_answer(main_pid=GATEWAY_PID))
+    assert gw._supervising_systemd_unit(GATEWAY_PID) == (UNIT, True)
