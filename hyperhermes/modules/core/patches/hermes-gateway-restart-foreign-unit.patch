+def _supervising_systemd_unit(pid: int) -> tuple[str, bool] | None:
+    """``(unit, system_scope)`` when a systemd service runs ``pid`` as its main process, else None.
+
+    Any unit name counts. A distribution module names its own unit (a NixOS module may run
+    ``hermes-agent-<user>.service``), and ``get_service_name()`` knows only ``hermes-gateway*``.
+    The cgroup names the candidate unit, and the unit's MainPID must be ``pid``. A gateway started
+    inside another service (the dashboard's ``gateway restart`` child) shares that service's cgroup
+    and INVOCATION_ID, but systemd never relaunches it.
+    """
+    from hermes_cli.main_dashboard import _extract_scope_from_cgroup, _pid_unified_cgroup_entries
+
+    for cgroup in _pid_unified_cgroup_entries(pid):
+        unit = cgroup.rsplit("/", 1)[-1]
+        if not unit.endswith(".service"):
+            continue
+        system = _extract_scope_from_cgroup(cgroup) != "user"
+        if _unit_main_pid(unit, system) == pid:
+            return unit, system
+    return None
+
+
+def _unit_main_pid(unit: str, system: bool) -> int | None:
+    try:
+        result = _run_systemctl(
+            ["show", unit, "--no-pager", "--property", "MainPID", "--value"],
+            system=system, timeout=10, **_CAPTURE_TEXT,
+        )
+    except (RuntimeError, subprocess.TimeoutExpired, OSError):
+        return None
+    return _positive_pid(result.stdout.strip()) if result.returncode == 0 else None
+
+
+def _hand_to_supervising_unit(verb: str, *, all_profiles: bool = False) -> bool:
+    """Restart this profile's gateway through the systemd unit that supervises it; False when none does.
+
+    A unit that ``hermes gateway install`` wrote keeps the normal path. Any other unit owns the
+    gateway's lifecycle, and SIGUSR1 is the one safe action: the gateway drains, exits 75, and the
+    unit's restart policy relaunches it. A SIGTERM plus a gateway spawned here raced the unit: the
+    unit then failed on every start with "Gateway already running". So neither ``restart`` nor
+    ``stop`` spawns a gateway here, and ``stop`` cannot stop one that the unit relaunches.
+    """
+    # The PID file first, then a process scan: a gateway that is still starting has no PID file yet.
+    supervised = ((pid, _supervising_systemd_unit(pid)) for pid in find_gateway_pids())
+    pid, supervisor = next(((p, s) for p, s in supervised if s is not None), (None, None))
+    if supervisor is None:
+        return False
+    unit, system = supervisor
+    if _systemd_unit_installed() and unit == f"{get_service_name()}.service":
+        return False
+
+    stop_hint = f"{'sudo ' if system else ''}systemctl {'' if system else '--user '}stop {unit}"
+    if all_profiles:
+        print_error(f"{unit} supervises this profile's gateway (PID {pid}); --all would start a second one.")
+        print(f"  Restart it without --all, or stop it with: {stop_hint}")
+        sys.exit(1)
+    if verb == "stop":
+        print(f"⚠ {unit} supervises this gateway (PID {pid}) and relaunches it after every exit.")
+        print(f"  To stop it: {stop_hint}")
+        print("  Restarting it instead.")
+
+    wait_budget = _get_restart_exit_wait_budget()
+    print(f"⏳ Draining gateway PID {pid} for {unit} (up to {wait_budget:.0f}s)...")
+    if not _graceful_restart_via_sigusr1(pid, wait_budget):
+        print(f"⚠ Gateway PID {pid} still runs after {wait_budget:.0f}s. {unit} relaunches it once it exits.")
+        sys.exit(1)
+    deadline = time.monotonic() + 60.0
+    replacement = None
+    while replacement is None and time.monotonic() < deadline:
+        replacement = _unit_main_pid(unit, system)
+        if replacement == pid:
+            replacement = None
+        if replacement is None:
+            time.sleep(0.5)
+    if replacement is None:
+        print(f"⚠ Gateway PID {pid} exited, but {unit} has no new main process after 60s.")
+        print(f"  Check: systemctl {'' if system else '--user '}status {unit}")
+        sys.exit(1)
+    print(f"✓ {unit} relaunched the gateway (PID {replacement})")
+    if verb == "stop":
+        sys.exit(1)
+    return True
+
+
 def is_linux() -> bool:
     return sys.platform.startswith("linux")
 
