diff --git a/hermes_cli/gateway_supervised_restart.py b/hermes_cli/gateway_supervised_restart.py
index 1f92986208..32818cd668 100644
--- a/hermes_cli/gateway_supervised_restart.py
+++ b/hermes_cli/gateway_supervised_restart.py
@@ -137,6 +137,54 @@ def refuse_restart_of_service_managed_gateway(pid: int | None) -> None:
     sys.exit(1)
 
 
+def hand_back_to_foreign_systemd_unit(verb: str, *, all_profiles: bool = False) -> None:
+    """``gateway stop`` / ``--all`` verbs for a gateway that a systemd unit of another name runs.
+
+    A distribution module names its own unit (a NixOS module runs ``hermes-agent-<user>.service``)
+    and ``_systemd_unit_installed`` knows only the ``hermes-gateway*`` unit ``gateway install``
+    wrote. Such a unit relaunches its main process after every exit, so ``stop``'s SIGTERM only
+    restarted the gateway while reporting it stopped, and ``restart --all`` ran a second gateway in
+    the caller beside the unit's relaunch. ``stop`` drains (SIGUSR1, exit 75) and hands back like a
+    restart, names the systemctl command that does stop it, and exits 1; ``--all`` refuses. Returns
+    when no such unit runs the gateway (the installed ``hermes-gateway*`` unit keeps its own path).
+    Ownership is the unit's MainPID: a gateway spawned inside another service shares its cgroup only.
+    ``--all`` names the one host gateway, so only the live host owner is checked there.
+    """
+    from hermes_cli import gateway as gw
+    from hermes_cli import main_dashboard as _dash
+
+    if all_profiles:
+        host = gw._host_multiplexer_for_all_verb()
+        pids = [host.pid] if host is not None else []
+    else:
+        pids = gw.find_gateway_pids()
+    for pid in pids:
+        owner = _dash._systemd_owner_for_pid(pid)
+        if owner is not None and not (gw._systemd_unit_installed() and owner[0] == f"{gw.get_service_name()}.service"):
+            break
+    else:
+        return
+    unit, scope = owner
+    stop_cmds = [c.replace(" restart ", " stop ") for c in _dash._systemd_restart_commands(unit, scope)]
+    if all_profiles:
+        gw._print_lines(
+            "",
+            f"✗ Gateway (PID {pid}) is managed by systemd unit {unit}, which relaunches it after every exit.",
+            f"  `hermes gateway {verb} --all` would {'only restart it' if verb == 'stop' else 'start a second gateway beside it'}.",
+            "  Restart it without --all (hermes gateway restart), or stop it with:",
+            *(f"    {c}" for c in stop_cmds),
+        )
+        sys.exit(1)
+    gw._print_lines(
+        f"⚠ Gateway (PID {pid}) is managed by systemd unit {unit}, which relaunches it after every exit.",
+        "  To stop it:",
+        *(f"    {c}" for c in stop_cmds),
+        "  Restarting it instead.",
+    )
+    restart_externally_supervised_gateway(pid)
+    sys.exit(1)
+
+
 def start_restart_replacement(args, *, force: bool) -> None:
     """Start the manual fallback's replacement once the old owner is gone.
 
diff --git a/tests/hermes_cli/test_gateway_foreign_systemd_unit.py b/tests/hermes_cli/test_gateway_foreign_systemd_unit.py
new file mode 100644
index 0000000000..8ff59d17e9
--- /dev/null
+++ b/tests/hermes_cli/test_gateway_foreign_systemd_unit.py
@@ -0,0 +1,93 @@
+"""``hermes gateway stop`` / ``restart --all`` against a gateway that a systemd unit of another name runs.
+
+A NixOS module runs the gateway as ``hermes-agent-<user>.service`` with ``Restart=always``.
+``_systemd_unit_installed()`` only knows ``hermes-gateway*``, so ``stop`` SIGTERMed the gateway and
+reported it stopped while the unit relaunched it, and ``restart --all`` ran a second gateway inside the
+caller (the dashboard's own service) beside the unit's relaunch. The unit owns the lifecycle: the command
+must SIGUSR1 its main process (drain, exit 75) and spawn nothing.
+"""
+import signal
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import status as gateway_status
+from hermes_cli import gateway as gw
+from hermes_cli import gateway_supervised_restart as supervised
+from hermes_cli import main_dashboard
+
+GATEWAY_PID = 4242
+REPLACEMENT_PID = 4343
+UNIT = "hermes-agent-alice.service"
+
+
+@pytest.fixture
+def unit_gateway(monkeypatch):
+    """A running gateway that is the main process of ``UNIT``; records every signal and spawn."""
+    calls = SimpleNamespace(sent=[], spawned=[])
+
+    def _kill(pid, sig):
+        calls.sent.append((pid, sig))
+
+    monkeypatch.setattr(gw, "_refuse_from_inside_gateway", lambda *a, **k: None)
+    monkeypatch.setattr(gw, "_dispatch_via_service_manager_if_s6", lambda *a, **k: False)
+    monkeypatch.setattr(gw, "_dispatch_all_via_service_manager_if_s6", lambda *a, **k: False)
+    monkeypatch.setattr(gw, "_guard_named_profile_under_multiplexer", lambda **k: None)
+    monkeypatch.setattr("hermes_cli.gateway_profile_lifecycle.profile_lifecycle", lambda *a, **k: False)
+    monkeypatch.setattr("hermes_cli.gateway_lifecycle_guards.refuse_while_sessions_live", lambda *a, **k: None)
+    monkeypatch.setattr(gw, "find_gateway_pids", lambda *a, **k: [GATEWAY_PID] if not calls.sent else [REPLACEMENT_PID])
+    monkeypatch.setattr(gw, "_systemd_unit_installed", lambda: False)
+    monkeypatch.setattr(gw, "_host_multiplexer_for_all_verb", lambda: SimpleNamespace(pid=GATEWAY_PID))
+    monkeypatch.setattr(gw, "_get_restart_exit_wait_budget", lambda: 5.0)
+    monkeypatch.setattr(gateway_status, "get_running_pid", lambda *a, **k: REPLACEMENT_PID if calls.sent else GATEWAY_PID)
+    monkeypatch.setattr(gateway_status, "_pid_exists", lambda pid: not calls.sent)
+    monkeypatch.setattr(gw.os, "kill", _kill)
+    monkeypatch.setattr(supervised, "SUPERVISED_REPLACEMENT_VERIFY_TIMEOUT", 0.5)
+    monkeypatch.setattr(
+        main_dashboard, "_systemd_owner_for_pid", lambda pid: (UNIT, "system") if pid == GATEWAY_PID else None
+    )
+    monkeypatch.setattr(gw, "run_gateway", lambda **k: calls.spawned.append(("run_gateway", k)))
+    monkeypatch.setattr(gw, "_spawn_detached_gateway", lambda *a, **k: calls.spawned.append("detached") or True)
+    monkeypatch.setattr(gw, "stop_profile_gateway", lambda: calls.spawned.append("sigterm") or True)
+    monkeypatch.setattr(gw, "kill_gateway_processes", lambda *a, **k: calls.spawned.append("sigterm-all") or 1)
+    monkeypatch.setattr(gw, "terminate_pid", lambda *a, **k: calls.spawned.append("terminate"))
+    monkeypatch.setattr(gw, "_service_call", lambda *a, **k: calls.spawned.append(a))
+    return calls
+
+
+def test_stop_drains_and_hands_back_instead_of_sigterm(unit_gateway, capsys):
+    with pytest.raises(SystemExit) as exc:
+        gw._cmd_stop(SimpleNamespace(system=False, all=False))
+
+    # The unit relaunches the gateway after any exit, so the stop cannot complete: it drains and
+    # restarts instead, says how to stop it, and exits non-zero.
+    assert exc.value.code == 1
+    assert unit_gateway.sent == [(GATEWAY_PID, signal.SIGUSR1)]
+    assert unit_gateway.spawned == []
+    out = capsys.readouterr().out
+    assert f"sudo systemctl stop {UNIT}" in out
+    assert str(REPLACEMENT_PID) in out
+
+
+@pytest.mark.parametrize("verb", ["stop", "restart"])
+def test_all_refuses_beside_a_foreign_unit(unit_gateway, verb, capsys):
+    command = gw._cmd_stop if verb == "stop" else gw._cmd_restart
+
+    with pytest.raises(SystemExit) as exc:
+        command(SimpleNamespace(system=False, all=True, force=False, detach=False))
+
+    assert exc.value.code == 1
+    assert unit_gateway.sent == []
+    assert unit_gateway.spawned == []
+    assert f"sudo systemctl stop {UNIT}" in capsys.readouterr().out
+
+
+def test_installed_hermes_gateway_unit_keeps_its_stop_path(unit_gateway, monkeypatch):
+    monkeypatch.setattr(gw, "_systemd_unit_installed", lambda: True)
+    monkeypatch.setattr(gw, "get_service_name", lambda: UNIT.removesuffix(".service"))
+    monkeypatch.setattr(gw, "_installed_service_kind", lambda: "systemd")
+
+    gw._cmd_stop(SimpleNamespace(system=False, all=False))
+
+    assert unit_gateway.sent == []
+    assert unit_gateway.spawned == [("systemd", "stop", False)]
