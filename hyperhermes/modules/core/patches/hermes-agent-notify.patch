--- /dev/null
+++ b/tui_gateway/agent_notify.py
@@ -0,0 +1,262 @@
+"""Messages from another agent into one of this backend's chat sessions (hyperhermes).
+
+The dashboard (``hermes dashboard``) runs the desktop and web chat sessions. With
+``HERMES_AGENT_NOTIFY_SOCKET`` set it listens on that unix socket for root's ``hermes-notify``
+CLI: one JSON request line, one JSON answer line. Only uid 0 is served (SO_PEERCRED): the
+agent's own tools, which run as the socket's owner, are refused, so nothing the model runs can
+put words into a session under another agent's name.
+
+Request: ``{"sender": str, "text": str, "profile": str|null, "session_id": str|null}`` (no
+``session_id``: the profile's most recently active chat session). Delivery:
+
+- a turn is running: steered into it (``agent.steer``), as the user's own mid-turn messages are,
+  but framed as a message from another agent (``agent.prompt_builder.format_agent_notice``), kept
+  out of the user's steer marker;
+- idle: the session is reopened here if needed and a turn starts whose input is that frame, a
+  ``process_complete`` row (the apps show it as a system row, like a relayed agent reply);
+- the session's user pressed Stop (no automatic turn until their next message), or the agent is
+  still being built mid-turn or compressing: queued for the session's next turn.
+
+Answer: ``{"ok": true, "session_id", "profile", "delivery": "steered"|"started"|"queued"}`` or
+``{"ok": false, "error"}``. The text itself is never logged.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import logging
+import os
+import re
+import socket
+import sqlite3
+import struct
+import threading
+import time
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+SOCKET_ENV = "HERMES_AGENT_NOTIFY_SOCKET"
+MAX_REQUEST_BYTES = 128 * 1024
+MAX_TEXT_CHARS = 16000
+SENDER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
+# The chat surfaces this backend serves; subagent, cron and gateway rows are not conversations to talk into.
+CHAT_SOURCES = ("desktop", "tui", "webui")
+# Sender names a reader could take for the owner or the harness.
+RESERVED_SENDERS = frozenset({"user", "owner", "you", "me", "system", "hermes", "root", "admin", "dave"})
+_started = False
+
+
+def _peer_uid(conn: socket.socket) -> int | None:
+    with contextlib.suppress(OSError):
+        creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
+        return struct.unpack("3i", creds)[1]
+    return None
+
+
+def latest_session(home: Path) -> str | None:
+    """The most recently active chat session of the home (its compression tip is resolved later)."""
+    db = home / "state.db"
+    if not db.exists():
+        return None
+    marks = ",".join("?" * len(CHAT_SOURCES))
+    with contextlib.closing(sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)) as conn:
+        row = conn.execute(
+            f"SELECT id FROM sessions WHERE source IN ({marks}) AND coalesce(archived, 0) = 0 "
+            "AND coalesce(hidden, 0) = 0 ORDER BY coalesce(last_activity_at, started_at) DESC LIMIT 1",
+            CHAT_SOURCES).fetchone()
+    return row[0] if row else None
+
+
+def _session_source(home: Path, key: str) -> str | None:
+    with contextlib.closing(sqlite3.connect(f"file:{home / 'state.db'}?mode=ro", uri=True, timeout=5)) as conn:
+        row = conn.execute("SELECT source FROM sessions WHERE id = ?", (key,)).fetchone()
+    return (row[0] or "").strip().lower() if row else None
+
+
+def deliver(request: dict) -> dict:
+    """One request (already peer-checked) -> its answer. Runs on the listener's worker thread."""
+    from agent.prompt_builder import format_agent_notice
+    from tui_gateway import server as S
+
+    sender, text = request.get("sender"), request.get("text")
+    profile = request.get("profile") or None
+    wanted = request.get("session_id") or None
+    if not isinstance(sender, str) or not SENDER_RE.fullmatch(sender):
+        return {"ok": False, "error": "sender must be a plain name ([A-Za-z0-9._-], up to 64)"}
+    if sender.lower() in RESERVED_SENDERS:
+        return {"ok": False, "error": f"sender {sender!r} reads as the user; name the sending agent"}
+    if not isinstance(text, str) or not text.strip() or len(text) > MAX_TEXT_CHARS:
+        return {"ok": False, "error": f"text must be 1..{MAX_TEXT_CHARS} characters"}
+    if profile is not None and (not isinstance(profile, str) or not SENDER_RE.fullmatch(profile)):
+        return {"ok": False, "error": "invalid profile name"}
+    if wanted is not None and (not isinstance(wanted, str) or not re.fullmatch(r"[A-Za-z0-9._:-]{1,128}", wanted)):
+        return {"ok": False, "error": "invalid session id"}
+    try:
+        profile_home = S._profile_home(profile)
+    except Exception as exc:
+        return {"ok": False, "error": str(exc) or "unknown profile"}
+    home = Path(profile_home) if profile_home else Path(S._hermes_home)
+    key = wanted or latest_session(home)
+    if not key:
+        return {"ok": False, "error": "no chat session in this profile"}
+    db, owns = S._profile_session_db(profile_home)
+    try:
+        if db is None:
+            return {"ok": False, "error": "session store unavailable"}
+        if db.get_session(key) is None:
+            return {"ok": False, "error": f"no session {key} in this profile"}
+        key = db.get_compression_tip(key) or key
+    finally:
+        if owns:
+            S._release_db(db)
+    notice = format_agent_notice(sender, text)
+    answer = {"ok": True, "session_id": key, "profile": profile or "default"}
+
+    with S._session_resume_lock:
+        live = S._find_live_session_by_key(key, profile_home)
+    if live is None:
+        source = _session_source(home, key)
+        if source not in CHAT_SOURCES:
+            return {"ok": False, "error": f"session {key} is not a chat session (source {source!r})"}
+        params = {"session_id": key, "source": source, **({"profile": profile} if profile else {})}
+        token = S.bind_transport(S._detached_ws_transport)  # no client attached: emits are dropped
+        try:
+            resp = S.handle_request({"jsonrpc": "2.0", "id": f"agent-notify-resume-{key}",
+                                     "method": "session.resume", "params": params}) or {}
+        finally:
+            S.reset_transport(token)
+        result = resp.get("result") if isinstance(resp, dict) else None
+        sid = str((result or {}).get("session_id") or "")
+        if not sid or (session := S._sessions.get(sid)) is None:
+            return {"ok": False, "error": f"could not reopen session {key}: {(resp or {}).get('error')}"}
+        session["_server_resumed"] = True
+    else:
+        sid, session = live
+
+    def queue(reason: str) -> dict:
+        with session["history_lock"]:
+            # Authored: its own envelope, never merged into the owner's queued text.
+            S._enqueue_prompt(session, notice, session.get("transport") or S._detached_ws_transport,
+                              turn_author={"id": f"agent:{sender}", "name": sender})
+            session["last_active"] = time.time()
+        logger.info("agent notify: queued for session %s (%s)", key, reason)
+        return {**answer, "delivery": "queued", "note": reason}
+
+    def steer() -> dict | None:
+        agent = session.get("agent")
+        if agent is None or not hasattr(agent, "steer"):
+            return None
+        if S._session_compression_in_flight(session):
+            return queue("the session is compressing its context")
+        with session["history_lock"]:
+            if not session.get("running"):
+                return None
+        if not agent.steer(notice):
+            return None
+        with session["history_lock"]:
+            S._record_inflight_correction(session, notice)
+            session["last_active"] = time.time()
+        return {**answer, "delivery": "steered"}
+
+    for _attempt in range(3):
+        if session.get("running"):
+            if (done := steer()) is not None:
+                return done
+            if session.get("running"):
+                return queue("a turn is starting")
+        S._start_agent_build(sid, session)
+        if (err := S._wait_agent(session, "agent-notify", timeout=120.0)) is not None:
+            return {"ok": False, "error": f"agent of session {key} not ready: {err.get('error')}"}
+        if session.get("_turn_cancel_requested"):
+            return queue("its user stopped the last turn; it runs with their next message")
+        from hermes_cli.backend_retirement import retirement
+        with retirement.work() as admitted:
+            if not admitted:
+                return {"ok": False, "error": "the dashboard is shutting down; retry once it is back"}
+        if S._notif_claim_turn(session):
+            rid = f"__agent_notify__{int(time.time() * 1000)}"
+            try:
+                with S._session_profile_runtime_scope(session):
+                    ok = S._notif_submit(
+                        rid, sid, session, notice, "agent notify dispatch failed", report_ownership_refusal=False,
+                        display_kind="process_complete",
+                        display_metadata={"display_text": f"Message from agent {sender}",
+                                          "agent_notice": {"from": sender}})
+            except BaseException:
+                S._notif_release_turn(session)  # a failed scope bind must not leave the claim held
+                raise
+            if ok:
+                return {**answer, "delivery": "started"}
+            return {"ok": False, "error": f"session {key} refused the turn (another backend owns it?)"}
+        # Lost the claim to a turn that just started: steer into it on the next pass.
+    return queue("the session was busy")
+
+
+def _serve_one(conn: socket.socket) -> None:
+    with conn:
+        conn.settimeout(10)
+        uid = _peer_uid(conn)
+        if uid != 0:
+            logger.warning("agent notify: refused a caller with uid %s", uid)
+            with contextlib.suppress(OSError):
+                conn.sendall(b'{"ok": false, "error": "root only"}\n')
+            return
+        data, request = b"", None
+        with contextlib.suppress(OSError):
+            while b"\n" not in data and len(data) <= MAX_REQUEST_BYTES:
+                chunk = conn.recv(8192)
+                if not chunk:
+                    break
+                data += chunk
+        try:
+            if len(data) > MAX_REQUEST_BYTES:
+                raise ValueError("request too large")
+            request = json.loads(data.split(b"\n", 1)[0] or b"null")
+            if not isinstance(request, dict):
+                raise ValueError("request must be a JSON object")
+            conn.settimeout(300)  # a cold session's agent build takes a while
+            answer = deliver(request)
+        except Exception as exc:  # health: allow BLE001 -- one bad request must not end the listener
+            logger.warning("agent notify request failed", exc_info=True)
+            answer = {"ok": False, "error": f"{type(exc).__name__}: {exc}"}
+        req = request if isinstance(request, dict) else {}
+        text = req.get("text")
+        logger.info("agent notify: sender=%r profile=%s session=%s chars=%s -> %s", str(req.get("sender"))[:64],
+                    answer.get("profile"), answer.get("session_id"), len(text) if isinstance(text, str) else "-",
+                    answer.get("delivery") or str(answer.get("error"))[:200])
+        with contextlib.suppress(OSError):
+            conn.sendall(json.dumps(answer).encode() + b"\n")
+
+
+def start() -> bool:
+    """Listen on ``$HERMES_AGENT_NOTIFY_SOCKET`` (once per process); False when unset."""
+    global _started
+    path = os.environ.get(SOCKET_ENV, "").strip()
+    if not path or _started:
+        return False
+    sock_path = Path(path)
+    with contextlib.suppress(FileNotFoundError):
+        sock_path.unlink()
+    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    old = os.umask(0o177)
+    try:
+        srv.bind(str(sock_path))
+    finally:
+        os.umask(old)
+    srv.listen(8)
+    _started = True
+
+    def loop() -> None:
+        while True:
+            try:
+                conn, _ = srv.accept()
+            except OSError:
+                time.sleep(0.5)
+                continue
+            threading.Thread(target=_serve_one, args=(conn,), name="agent-notify", daemon=True).start()
+
+    threading.Thread(target=loop, name="agent-notify-listener", daemon=True).start()
+    logger.info("agent notify: listening on %s", sock_path)
+    return True
