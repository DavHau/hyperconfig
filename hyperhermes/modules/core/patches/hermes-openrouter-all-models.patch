diff --git a/tests/hermes_cli/test_openrouter_all_models.py b/tests/hermes_cli/test_openrouter_all_models.py
new file mode 100644
index 000000000..f97d17478
--- /dev/null
+++ b/tests/hermes_cli/test_openrouter_all_models.py
@@ -0,0 +1,73 @@
+"""``model_catalog.openrouter_all_models``: curated OpenRouter rows first, then every other live
+tool-capable chat model (sorted by id, ``free`` where free)."""
+
+import json
+
+import pytest
+
+import hermes_cli.models as _models_mod
+from hermes_cli.models import fetch_openrouter_models
+
+TOOLS = ["tools"]
+PAID = {"prompt": "0.000001", "completion": "0.000002"}
+FREE = {"prompt": "0", "completion": "0"}
+LIVE = [
+    {"id": "zeta/curated", "supported_parameters": TOOLS, "pricing": PAID},
+    {"id": "alpha/curated-free", "supported_parameters": TOOLS, "pricing": FREE},
+    {"id": "reflection/beam-1.0-501b-a23b", "supported_parameters": TOOLS, "pricing": PAID},
+    {"id": "aaa/extra:free", "supported_parameters": TOOLS, "pricing": FREE},
+    {"id": "mmm/no-tools", "supported_parameters": ["temperature"], "pricing": PAID},
+    {"id": "img/painter", "supported_parameters": TOOLS, "pricing": PAID,
+     "architecture": {"output_modalities": ["image"]}},
+]
+CURATED = [("zeta/curated", "recommended"), ("alpha/curated-free", "free")]
+FULL = CURATED + [("aaa/extra:free", "free"), ("reflection/beam-1.0-501b-a23b", "")]
+
+
+@pytest.fixture
+def catalog(monkeypatch):
+    calls = []
+
+    def fake_index(url, timeout, opener):
+        calls.append(url)
+        return list(LIVE), {i["id"]: i for i in LIVE}
+
+    monkeypatch.setattr(_models_mod, "_fetch_live_catalog_index", fake_index)
+    monkeypatch.setattr("hermes_cli.model_catalog.get_curated_openrouter_models",
+                        lambda: [("zeta/curated", ""), ("alpha/curated-free", ""), ("gone/x", "")])
+    monkeypatch.setattr(_models_mod, "get_preferred_silent_default_model", lambda provider="openrouter": "")
+    monkeypatch.setattr(_models_mod, "_openrouter_catalog_cache", None)
+    monkeypatch.setattr(_models_mod, "_openrouter_all_catalog_cache", None)
+    return calls
+
+
+def _option(monkeypatch, value):
+    monkeypatch.setattr("hermes_cli.model_catalog.openrouter_all_models_enabled", lambda: value)
+
+
+def test_off_keeps_the_curated_list(monkeypatch, catalog):
+    _option(monkeypatch, False)
+    assert fetch_openrouter_models(force_refresh=True) == CURATED
+
+
+def test_on_appends_every_other_tool_model_sorted(monkeypatch, catalog):
+    _option(monkeypatch, True)
+    assert fetch_openrouter_models(force_refresh=True) == FULL
+    assert json.loads(_models_mod._openrouter_catalog_disk_path().read_text())["all_models"] is True
+
+
+def test_flipping_the_option_does_not_serve_the_other_disk_copy(monkeypatch, catalog):
+    _option(monkeypatch, False)
+    fetch_openrouter_models(force_refresh=True)
+    _option(monkeypatch, True)
+    _models_mod._openrouter_catalog_cache = None
+    calls = len(catalog)
+    assert fetch_openrouter_models() == FULL
+    assert len(catalog) == calls + 1
+
+
+def test_option_is_part_of_the_provider_cache_fingerprint(monkeypatch):
+    _option(monkeypatch, False)
+    off = _models_mod._credential_fingerprint("openrouter")
+    _option(monkeypatch, True)
+    assert _models_mod._credential_fingerprint("openrouter") != off
