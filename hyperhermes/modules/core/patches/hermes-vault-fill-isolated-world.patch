diff --git a/tests/tools/test_vault_fill_hostile_page.py b/tests/tools/test_vault_fill_hostile_page.py
new file mode 100644
index 00000000..71056867
--- /dev/null
+++ b/tests/tools/test_vault_fill_hostile_page.py
@@ -0,0 +1,443 @@
+"""A page that hooks JavaScript built-ins must never see a vault secret (hyperhermes, for #136981).
+
+The vault's fill scripts carry the values. Run in the page's own JavaScript world and in sloppy mode,
+their first call into a page-replaceable function (``Array.from`` over ``location.ancestorOrigins``,
+``JSON.stringify`` on the refusal path) hands the page the calling function through ``hook.caller``, and
+its source holds the card. A script on the checkout can navigate the processor frame to its own site
+between the vault's check and its write, so the write would run in the attacker's document.
+
+The fix, pinned here:
+- every secret write and every frame read runs in a CDP isolated world (``evaluate_isolated``), never
+  ``Runtime.evaluate`` in the page's world;
+- the write is two-phase: a value-free check in the same world first, values only when it passes;
+- the scripts are strict and call nothing before their origin/ancestry check, so even run in a hostile
+  world (isolation lost) the hooks get nothing: exercised below in node with every hook in place.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import re
+import subprocess
+from unittest.mock import patch
+
+import pytest
+
+from agent import redact
+from agent.vault_login_classifier import build_fill_js
+from agent.vault_store import VaultStore
+from tools import browser_vault_tool as vault
+from tools.browser_supervisor import CDPSupervisor
+from tools.browser_supervisor_frames import FrameInfo
+
+PAGE = "https://shop.test"
+STRIPE = "https://js.stripe.com"
+EVIL = "https://evil.test"
+_CARD = {"card_number": "4111111111111111", "cardholder_name": "Canary Name", "exp_month": "7", "exp_year": "2029",
+         "cvc": "987", "billing_postal_code": "94110"}
+_SECRETS = ("4111111111111111", "987", "07/29", "Canary Name")
+CARD_CONTROLS = [
+    {"autocomplete": "cc-number", "name": "number", "index": 0, "type": "text"},
+    {"autocomplete": "cc-exp", "name": "expiry", "index": 1, "type": "text"},
+    {"autocomplete": "cc-csc", "name": "cvc", "index": 2, "type": "text"},
+]
+
+# A hostile document in node: every built-in a fill script could touch is replaced by a hook that walks
+# ``.caller`` (and Function.prototype.toString of each caller), records ``this`` and the arguments.
+# location/ancestorOrigins are what the navigated frame reports; the DOM is empty.
+_HOSTILE_PRELUDE = r"""
+const leaks = [];
+const realToString = Function.prototype.toString;
+const realStringify = JSON.stringify;
+const realApply = Reflect.apply;
+const realSlice = Array.prototype.slice;
+let busy = false;  // the hooks' own bookkeeping must not re-enter them
+function record(name, self, args, hook) {
+  if (busy) return;
+  busy = true;
+  try { recordInner(name, self, args, hook); } finally { busy = false; }
+}
+function recordInner(name, self, args, hook) {
+  let fn = null;
+  try { fn = hook.caller; } catch (e) { leaks.push(name + ': caller threw'); }
+  for (let depth = 0; fn && depth < 12; depth++) {
+    try { leaks.push(name + ' caller: ' + realToString.call(fn)); } catch (e) {}
+    try { fn = fn.caller; } catch (e) { break; }
+  }
+  try { leaks.push(name + ' this: ' + realStringify(self)); } catch (e) {}
+  try { leaks.push(name + ' args: ' + realStringify(realApply(realSlice, args, []))); } catch (e) {}
+}
+function hookMethod(owner, key, label) {
+  const real = owner[key];
+  if (typeof real !== 'function') return;
+  const hook = function hook() { record(label, this, arguments, hook); return realApply(real, this, arguments); };
+  Object.defineProperty(owner, key, { value: hook, writable: true, configurable: true });
+}
+for (const [owner, keys, label] of [
+  [Array, ['from', 'of', 'isArray'], 'Array.'],
+  [JSON, ['stringify', 'parse'], 'JSON.'],
+  [Object, ['keys', 'values', 'entries', 'assign', 'getOwnPropertyDescriptor', 'getPrototypeOf', 'defineProperty'], 'Object.'],
+  [Array.prototype, ['join', 'map', 'flatMap', 'forEach', 'filter', 'find', 'some', 'push', 'slice', 'indexOf', 'includes', Symbol.iterator], 'Array.prototype.'],
+  [String.prototype, ['startsWith', 'trim', 'toLowerCase', 'replace', 'split', 'concat', 'includes'], 'String.prototype.'],
+  [Function.prototype, ['call', 'apply', 'bind'], 'Function.prototype.'],
+  [Object.prototype, ['hasOwnProperty', 'toString'], 'Object.prototype.'],
+]) for (const k of keys) hookMethod(owner, k, label + String(k));
+// Getters a check could read: a hook on Object.prototype catches any unknown property read too.
+function hookGetter(owner, key, value) {
+  const getter = function getter() { record('get ' + String(key), this, [], getter); return value; };
+  Object.defineProperty(owner, key, { get: getter, configurable: true });
+}
+const ancestorList = Object.create(null);
+__ANCESTORS__.forEach((a, i) => { ancestorList[i] = a; });
+hookGetter(ancestorList, 'length', __ANCESTORS__.length);
+const location = Object.create(null);
+hookGetter(location, 'origin', __ORIGIN__);
+hookGetter(location, 'href', __ORIGIN__ + '/');
+hookGetter(location, 'ancestorOrigins', ancestorList);
+const document = { querySelectorAll() { record('document.querySelectorAll', this, arguments, document.querySelectorAll); return []; } };
+const window = globalThis;
+globalThis.location = location;
+globalThis.document = document;
+globalThis.getComputedStyle = function getComputedStyle() { record('getComputedStyle', this, arguments, getComputedStyle); return {}; };
+globalThis.InputEvent = globalThis.Event = function Event() { record('Event', this, arguments, Event); };
+globalThis.HTMLInputElement = function HTMLInputElement() {};
+"""
+
+_HOSTILE_RUN = r"""
+let result, threw = null;
+try { result = (0, eval)(__EXPRESSION__); } catch (e) { threw = String(e && e.message); }
+process.stdout.write(realStringify({ result, threw, leaks }));
+"""
+
+
+def _run_hostile(expression: str, origin: str, ancestors: list[str]) -> dict:
+    """Evaluate ``expression`` as sloppy global code in the hostile document above (node)."""
+    script = (_HOSTILE_PRELUDE.replace("__ANCESTORS__", json.dumps(ancestors)).replace("__ORIGIN__", json.dumps(origin))
+              + _HOSTILE_RUN.replace("__EXPRESSION__", json.dumps(expression)))
+    out = subprocess.run(["node"], input=script, text=True, capture_output=True, timeout=30)
+    assert out.returncode == 0, out.stderr
+    return json.loads(out.stdout)
+
+
+def _leaked(run: dict) -> list[str]:
+    text = "\n".join(run["leaks"])
+    return [s for s in _SECRETS if s in text]
+
+
+def _card_fills():
+    return [{"index": 0, "token": "cc-number", "value": _CARD["card_number"]},
+            {"index": 1, "token": "cc-exp", "value": "07/29"},
+            {"index": 2, "token": "cc-csc", "value": _CARD["cvc"]},
+            {"index": 3, "token": "cc-name", "value": _CARD["cardholder_name"]}]
+
+
+# The ancestry guard as #136981 shipped it (sloppy, Array.from first): the harness must catch its leak.
+_OLD_GUARD = ("(() => { const a = Array.from(location.ancestorOrigins || []); "
+              "if (a.length !== 1 || a[0] !== __PAGE__) "
+              "return JSON.stringify({refused: 'origin_changed', found: a.join(' < ')}); "
+              "return (() => { const fills = __FILLS__; return 1; })(); })()")
+
+
+def test_the_harness_catches_the_old_sloppy_guard():
+    old = _OLD_GUARD.replace("__PAGE__", json.dumps(PAGE)).replace("__FILLS__", json.dumps(_card_fills()))
+    run = _run_hostile(old, EVIL, [PAGE])
+    assert _CARD["card_number"] in "\n".join(run["leaks"])
+
+
+@pytest.mark.parametrize("origin, ancestors", [
+    (EVIL, [PAGE]),             # the processor frame navigated to the attacker between check and write
+    (STRIPE, [EVIL]),           # the processor frame now embedded by another page
+    (STRIPE, [EVIL, PAGE]),     # nested
+    (STRIPE, []),               # no ancestry (not a frame / masked)
+])
+def test_frame_write_refused_in_a_hostile_frame_leaks_nothing(origin, ancestors):
+    expression = vault._guard_frame_ancestry(build_fill_js(_card_fills(), expected_origin=STRIPE, nonce="n"), PAGE)
+    run = _run_hostile(expression, origin, ancestors)
+    assert run["threw"] is None
+    assert run["result"]["refused"] == "origin_changed"
+    assert _leaked(run) == []
+
+
+def test_frame_write_through_the_page_backend_wrapper_leaks_nothing():
+    expression = vault._strict_secret_wrapper(
+        vault._guard_frame_ancestry(build_fill_js(_card_fills(), expected_origin=STRIPE, nonce="n"), PAGE))
+    run = _run_hostile(expression, EVIL, [PAGE])
+    assert run["result"]["refused"] == "origin_changed" and _leaked(run) == []
+
+
+@pytest.mark.parametrize("wrap", [False, True])
+def test_top_level_write_refused_after_navigation_leaks_nothing(wrap):
+    """The same hole in upstream's top-level template (JSON.stringify on its refusal path): a password or a
+    card written into a page that navigated to the attacker after the vault's check."""
+    fills = [{"index": 0, "token": "current-password", "value": "pw-canary-4111111111111111"}]
+    expression = build_fill_js(fills, expected_origin=PAGE, nonce="n")
+    if wrap:
+        expression = vault._strict_secret_wrapper(expression)
+    run = _run_hostile(expression, EVIL, [])
+    assert run["result"] == {"refused": "origin_changed", "found": EVIL}
+    assert "pw-canary" not in "\n".join(run["leaks"])
+
+
+def test_scripts_are_strict_and_check_before_any_call():
+    js = build_fill_js(_card_fills(), expected_origin=STRIPE, nonce="n")
+    assert js.startswith('(() => {\n  "use strict";')
+    head = js.split("const fills", 1)[0].split('"use strict";', 1)[1]
+    calls = [m for m in re.findall(r"([\w.$\]]+)\s*\(", head) if m != "if"]
+    assert calls == [], calls  # no call of any kind before the origin check
+    guard = vault._guard_frame_ancestry("1", PAGE)
+    assert guard.startswith('(() => { "use strict";') and "Array.from" not in guard and "JSON.stringify" not in guard
+    assert vault._strict_secret_wrapper("1").startswith('(() => { "use strict";')
+    assert "Array.from" not in vault._FRAME_CONTEXT_JS
+
+
+# ── the vault: isolated world, two phases ────────────────────────────────────
+
+
+class _HostileSupervisor:
+    """A CDP supervisor over a checkout with one Stripe frame. ``navigate_after_check``: the frame (or, with
+    frame=None, the page) moves to the attacker right after the vault's phase-1 check, so the secret write
+    runs (worst case: isolation lost) in the hostile document."""
+
+    def __init__(self, *, navigate_after_check=None):
+        self.navigate_after_check = navigate_after_check
+        self.calls: list[tuple[str, str | None, str]] = []
+        self.checked: set = set()
+
+    def focus_page(self, origin, accept=None):
+        return {"ok": origin == PAGE, "url": PAGE + "/checkout"}
+
+    def page_child_oopifs(self):
+        return {"ok": True, "frames": [{"frame_id": "f", "url": STRIPE + "/v3/inner"}]}
+
+    def evaluate_runtime(self, expression, frame_id=None, **kw):
+        assert _CARD["card_number"] not in expression and "pw-canary" not in expression, \
+            "a secret went into the page's own world"
+        self.calls.append(("main", frame_id, expression))
+        if "location.href" in expression:
+            return {"ok": True, "result": PAGE + "/checkout"}
+        # the page's own inspection (value-free): a password field, no card fields
+        return {"ok": True, "result": json.dumps([{"autocomplete": "current-password", "index": 0, "type": "password"}])}
+
+    def evaluate_isolated(self, expression, frame_id=None, **kw):
+        self.calls.append(("isolated", frame_id, expression))
+        here = (STRIPE, [PAGE]) if frame_id else (PAGE, [])
+        if frame_id in self.checked or (frame_id is None and None in self.checked):
+            here = (EVIL, [PAGE] if frame_id else [])
+        if expression == vault._FRAME_CONTEXT_JS:
+            return {"ok": True, "result": json.dumps({"origin": here[0], "ancestors": here[1]})}
+        if "stamps" in expression and "data-hermes-vault-slot" in expression:  # phase 1
+            if self.navigate_after_check == (frame_id or "page"):
+                self.checked.add(frame_id)
+            return {"ok": True, "result": json.dumps({"origin": here[0], "ancestors": here[1], "stamps": 1})}
+        if "data-hermes-vault-slot" in expression and "expectedOrigin" not in expression:  # inspection
+            return {"ok": True, "result": json.dumps(CARD_CONTROLS if frame_id else
+                                                     [{"autocomplete": "current-password", "index": 0, "type": "password"}])}
+        run = _run_hostile(expression, *here)
+        self.leaks = getattr(self, "leaks", []) + _leaked(run) + (["pw-canary"] if "pw-canary" in "\n".join(run["leaks"]) else [])
+        if run["result"] is None:
+            return {"ok": True, "result": json.dumps({"filled": 0})}
+        return {"ok": True, "result": run["result"]}
+
+
+@pytest.fixture()
