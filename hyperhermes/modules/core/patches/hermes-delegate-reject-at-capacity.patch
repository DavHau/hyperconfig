+def _reject_at_capacity(batch: _Batch, max_async: int) -> str:
+    """Background pool full: refuse the call without running anything. Running it inline instead blocked the
+    parent's whole turn (new user messages, steers and finished background results) until the child finished."""
+    from tools.async_delegation import _RESUME_META
+    if _RESUME_META.get():  # the restart re-dispatch matches "at_capacity" and waits for a slot
+        return _run_sync_with_note(batch, "at_capacity")
+    from tools.registry import tool_error
+    error = (f"background delegation pool full ({max_async}/{max_async} running); nothing was started. Wait for a "
+             "running delegation to finish (its result re-enters the chat) and dispatch again, or tell the user.")
+    for _, _, child in batch.children:
+        _release_unstarted_child(batch, child)
+    # No child ran: settle its transcripts and manifest as rejected and close the call's metrics row.
+    entries = [{**_fabricated_entry(i, "rejected", error, c), "exit_reason": "at_capacity"} for i, _, c in batch.children]
+    for entry in entries:
+        writer = batch.live_writers[entry["task_index"]] if entry["task_index"] < len(batch.live_writers) else None
+        if writer is not None:
+            with _quiet("Live transcript finalize failed", exc_info=True):
+                writer.finalize(entry)
+    from tools.delegation_live_log import update_manifest_statuses
+    update_manifest_statuses(batch.live_deleg_id, entries, home=batch.live_home)
+    finish_delegation_unit(batch.task_list, entries, background=True)
+    return tool_error(error, status="rejected")
+
