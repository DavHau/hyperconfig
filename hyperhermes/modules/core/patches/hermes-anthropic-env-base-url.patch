+    def test_unconfigured_uses_env_gateway(self, gateway_env, monkeypatch):
+        assert _catalog_base_url(monkeypatch, {}) == GATEWAY
+
+    def test_custom_proxy_wins_over_env(self, gateway_env, monkeypatch):
+        assert _catalog_base_url(monkeypatch, {"provider": "anthropic", "base_url": PROXY}) == PROXY
+
+    def test_without_env_unchanged(self, monkeypatch):
+        monkeypatch.delenv("ANTHROPIC_BASE_URL", raising=False)
+        assert _catalog_base_url(monkeypatch, {}) is None
+
+
+def _doctor_url(monkeypatch):
+    import httpx
+    from hermes_cli import doctor_connectivity
+    seen = []
+    monkeypatch.setattr("hermes_cli.auth.get_anthropic_key", lambda: TOKEN)
