+def is_stock_anthropic_base_url(base_url: Any) -> bool:
+    """True for the stock endpoint the model picker writes as ``model.base_url``:
+    ``https://api.anthropic.com``, with or without ``/v1`` and a trailing slash."""
+    try:
+        parsed = urlparse(str(base_url or "").strip())
+        port = parsed.port
+    except ValueError:
+        return False
+    return (parsed.scheme.lower() == "https" and (parsed.hostname or "").rstrip(".") == "api.anthropic.com"
+            and port in (None, 443) and parsed.path.rstrip("/") in ("", "/v1")
+            and not (parsed.query or parsed.fragment or parsed.params))
+
+
+def anthropic_env_base_url() -> str:
+    """``ANTHROPIC_BASE_URL`` from the active secret scope (no trailing slash), or ``""``."""
+    return str(_get_secret("ANTHROPIC_BASE_URL", "") or "").strip().rstrip("/")
+
+
+def effective_anthropic_base_url(configured: Any) -> str:
+    """Endpoint for a configured Anthropic ``base_url``: a deliberate endpoint (another proxy)
+    wins; an empty one or the stock default yields to ``ANTHROPIC_BASE_URL`` when set, so a
+    gateway the environment points the Anthropic credentials at is not bypassed by the
+    ``https://api.anthropic.com`` the model picker persists."""
+    configured = str(configured or "").strip().rstrip("/")
+    if configured and not is_stock_anthropic_base_url(configured):
+        return configured
+    return anthropic_env_base_url() or configured
+
