+"""ANTHROPIC_BASE_URL vs the stock ``model.base_url: https://api.anthropic.com``.
+
+The model picker persists ``model.base_url = https://api.anthropic.com`` when anthropic is chosen.
+A profile whose environment points its Anthropic credential at a gateway (ANTHROPIC_TOKEN +
+ANTHROPIC_BASE_URL) must keep using the gateway: the stock default yields to the env on every
+native Anthropic runtime path (credential pool, env runtime, explicit --api-key). A deliberately
+configured non-default endpoint (another proxy) still wins over the env, and without the env
+the stock default is unchanged.
+"""
+import pytest
+
+from hermes_cli import runtime_provider as rp
+
+GATEWAY = "https://teamclaude.example.org"
+PROXY = "https://proxy.example.org/anthropic"
+TOKEN = "sk-ant-oat01-gateway-client-key"
+
+
+def _cfg(base_url=None):
+    cfg = {"provider": "anthropic", "default": "claude-sonnet-4-6"}
+    if base_url is not None:
+        cfg["base_url"] = base_url
+    return cfg
+
+
+@pytest.fixture
+def anthropic_profile(monkeypatch):
+    """provider=anthropic with ANTHROPIC_TOKEN in the env; returns a setter for config/env URL."""
+    monkeypatch.setenv("ANTHROPIC_TOKEN", TOKEN)
+    monkeypatch.delenv("ANTHROPIC_BASE_URL", raising=False)
+    monkeypatch.setattr(rp, "resolve_provider", lambda *a, **k: "anthropic")
+
+    def configure(*, cfg_base_url=None, env_base_url=None):
+        monkeypatch.setattr(rp, "_get_model_config", lambda: _cfg(cfg_base_url))
+        if env_base_url is not None:
+            monkeypatch.setenv("ANTHROPIC_BASE_URL", env_base_url)
+
+    return configure
+
+
+@pytest.mark.parametrize("url", [
+    "https://api.anthropic.com", "https://api.anthropic.com/", "https://api.anthropic.com/v1",
+    "https://api.anthropic.com/v1/", "HTTPS://API.ANTHROPIC.COM", "https://api.anthropic.com:443",
+])
+def test_stock_anthropic_base_url_variants(url):
+    from agent.anthropic_credentials import is_stock_anthropic_base_url
+    assert is_stock_anthropic_base_url(url)
+
+
+@pytest.mark.parametrize("url", [
+    "", "http://api.anthropic.com", "https://api.anthropic.com/anthropic", "https://api.anthropic.com:8443",
+    "https://api.anthropic.com.attacker.test", "https://proxy.test/api.anthropic.com/v1", PROXY,
+])
+def test_non_stock_anthropic_base_urls(url):
+    from agent.anthropic_credentials import is_stock_anthropic_base_url
+    assert not is_stock_anthropic_base_url(url)
