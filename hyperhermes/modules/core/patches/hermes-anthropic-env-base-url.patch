+"""Anthropic side call sites must not send an ANTHROPIC_BASE_URL-routed token to api.anthropic.com.
+
+Companion to tests/hermes_cli/test_runtime_provider_anthropic_env_base_url.py: the auxiliary
+client, the model-picker catalog, ``hermes doctor`` and the OAuth usage read follow the same
+rule as the main runtime — the stock ``model.base_url: https://api.anthropic.com`` yields to
+ANTHROPIC_BASE_URL, a deliberately configured proxy wins over it.
+"""
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+import hermes_yaml as yaml
+
+GATEWAY = "https://teamclaude.example.org"
+PROXY = "https://proxy.example.org/anthropic"
+TOKEN = "sk-ant-oat01-gateway-client-key"
+
+
+@pytest.fixture
+def gateway_env(monkeypatch):
+    monkeypatch.setenv("ANTHROPIC_TOKEN", TOKEN)
+    monkeypatch.setenv("ANTHROPIC_BASE_URL", GATEWAY)
+
+
+def _aux_base_url(tmp_path, monkeypatch, cfg_base_url, *, pool_entry=None):
+    from agent.auxiliary_client import _try_anthropic
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text(yaml.safe_dump({"model": {
+        "provider": "anthropic", "model": "claude-haiku-4-5-20251001", "base_url": cfg_base_url}}))
+    pool = (True, pool_entry) if pool_entry is not None else (False, None)
+    with (
+        patch("agent.auxiliary_client._select_pool_entry", return_value=pool),
+        patch("agent.auxiliary_client._pool_runtime_api_key", return_value=TOKEN),
+        patch("agent.anthropic_credentials.resolve_anthropic_token", return_value=TOKEN),
+        patch("agent.anthropic_adapter.build_anthropic_client", return_value=MagicMock()) as build,
+    ):
+        client, _model = _try_anthropic()
+    assert client is not None
+    return build.call_args.args[1]
+
+
+class TestAuxiliaryClient:
+    def test_stock_config_yields_to_env_gateway_without_pool(self, gateway_env, tmp_path, monkeypatch):
+        assert _aux_base_url(tmp_path, monkeypatch, "https://api.anthropic.com") == GATEWAY
+
+    def test_stock_config_yields_to_env_gateway_with_pool_entry(self, gateway_env, tmp_path, monkeypatch):
+        entry = SimpleNamespace(provider="anthropic", runtime_base_url=GATEWAY)
+        assert _aux_base_url(tmp_path, monkeypatch, "https://api.anthropic.com/v1", pool_entry=entry) == GATEWAY
+
+    def test_custom_proxy_wins_over_env(self, gateway_env, tmp_path, monkeypatch):
+        assert _aux_base_url(tmp_path, monkeypatch, PROXY) == PROXY
+
+    def test_without_env_stock_default_is_unchanged(self, tmp_path, monkeypatch):
+        monkeypatch.delenv("ANTHROPIC_BASE_URL", raising=False)
+        assert _aux_base_url(tmp_path, monkeypatch, "https://api.anthropic.com") == "https://api.anthropic.com"
+
+
+def _catalog_base_url(monkeypatch, model_cfg):
+    from hermes_cli import models as M
+    monkeypatch.setattr(M, "_get_model_config_dict", lambda: model_cfg)
+    with patch.object(M, "_fetch_anthropic_models", return_value=["claude-x"]) as fetch:
+        M._anthropic_catalog("anthropic", True)
