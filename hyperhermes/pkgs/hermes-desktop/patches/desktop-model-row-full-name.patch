+  getLocalModelsJobs: vi.fn().mockResolvedValue({ jobs: [] }),
+  getLocalModelsStatus: vi.fn().mockResolvedValue({ loading: {} }),
+  setApiRequestProfile: vi.fn()
+}))
+
+import { QueryClientProvider } from '@tanstack/react-query'
+import { cleanup, render, screen } from '@testing-library/react'
+import { afterEach, beforeAll, expect, it, vi } from 'vitest'
+
+import { DropdownMenu, DropdownMenuContent } from '@/components/ui/dropdown-menu'
+import { queryClient } from '@/lib/query-client'
+import { setShowModelPricing } from '@/store/model-pricing'
+
+import { ModelCatalogMenu, ModelMenuCloseContext, type ModelMenuController } from './model-catalog-menu'
+
+beforeAll(() => {
+  Element.prototype.scrollIntoView = vi.fn()
+  Element.prototype.hasPointerCapture = vi.fn(() => false)
+  Element.prototype.releasePointerCapture = vi.fn()
+})
+
+afterEach(() => {
+  cleanup()
+  queryClient.clear()
+  setShowModelPricing(false)
+})
+
+// hyperhermes desktop-model-row-full-name.patch: a long name is never cut by
+// the price column. It may wrap (no `truncate`), the price sits on its own line
+// below it, and the row's tooltip is the full model id.
+it('gives the model name its own line, the price a second one, and the id as tooltip', async () => {
+  const id = 'deepseek/deepseek-v4.1-flash-1017'
+
+  getGlobalModelOptions.mockResolvedValue({
+    providers: [
+      {
+        models: [id],
+        name: 'OpenRouter',
+        pricing: { [id]: { cache: '$0.003', input: '$0.15', output: '$0.60' } },
+        slug: 'openrouter'
+      }
+    ]
+  })
+  setShowModelPricing(true)
+
+  const controller: ModelMenuController = {
+    applyPreset: vi.fn(),
+    current: { effort: '', fast: false, model: '', provider: '' },
+    presetFor: () => ({}),
+    select: vi.fn(),
+    setOptions: vi.fn()
+  }
+
+  render(
+    <QueryClientProvider client={queryClient}>
+      <ModelMenuCloseContext.Provider value={vi.fn()}>
+        <DropdownMenu open>
+          <DropdownMenuContent>
+            <ModelCatalogMenu controller={controller} />
+          </DropdownMenuContent>
+        </DropdownMenu>
+      </ModelMenuCloseContext.Provider>
+    </QueryClientProvider>
+  )
+
+  const nameText = await screen.findByText('DeepSeek V4.1 Flash 1017')
+  const name = nameText.closest('[data-model-menu-row-name]')!
+
+  expect(name.className).not.toMatch(/\btruncate\b/)
+  expect(name.className).toMatch(/whitespace-normal/)
+
+  const row = name.closest('[role="menuitem"]')!
+  const details = row.querySelector('[data-model-menu-row-details]')!
+
+  expect(details.textContent).toContain('$0.15/$0.60')
+  // The price is not a sibling of the name's line: it is on the line below.
+  expect(name.parentElement!.contains(details)).toBe(false)
+  expect(row.querySelector(`[title="${id}"]`)).toBeTruthy()
+})
