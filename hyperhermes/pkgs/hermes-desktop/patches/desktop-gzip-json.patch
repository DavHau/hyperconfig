+import http from 'node:http'
+import type { AddressInfo } from 'node:net'
+import zlib from 'node:zlib'
+
+import { afterEach, describe, expect, it } from 'vitest'
+
+import { decodedResponseBody, withAcceptEncoding } from './api-transport'
+
+let server: http.Server | null = null
+
+afterEach(async () => {
+  await new Promise(resolve => (server ? server.close(resolve) : resolve(undefined)))
+  server = null
+})
+
+function serve(handler: http.RequestListener): Promise<string> {
+  server = http.createServer(handler)
+
+  return new Promise(resolve =>
+    server!.listen(0, '127.0.0.1', () => resolve(`http://127.0.0.1:${(server!.address() as AddressInfo).port}/`))
+  )
+}
+
+function read(url: string, headers: http.OutgoingHttpHeaders): Promise<{ text: string; seen: string }> {
+  return new Promise((resolve, reject) => {
+    const req = http.request(url, { headers: withAcceptEncoding(headers) }, res => {
+      const chunks: Buffer[] = []
+      const body = decodedResponseBody(res)
+      body.on('error', reject)
+      body.on('data', chunk => chunks.push(chunk))
+      body.on('end', () => resolve({ text: Buffer.concat(chunks).toString('utf8'), seen: String(res.headers['x-seen']) }))
+    })
+    req.on('error', reject)
+    req.end()
+  })
+}
+
+const payload = JSON.stringify({ messages: Array.from({ length: 200 }, (_, i) => ({ id: i, content: 'x'.repeat(50) })) })
+
+describe('compressed JSON transport', () => {
+  it('asks for gzip and decodes a gzipped body', async () => {
+    const url = await serve((req, res) => {
+      res.setHeader('x-seen', String(req.headers['accept-encoding']))
+      res.setHeader('content-encoding', 'gzip')
+      res.end(zlib.gzipSync(payload))
+    })
+
+    const { text, seen } = await read(url, {})
+
+    expect(seen).toBe('gzip')
+    expect(JSON.parse(text).messages).toHaveLength(200)
+  })
+
+  it('passes an uncompressed body through', async () => {
+    const url = await serve((_req, res) => res.end(payload))
+
+    expect((await read(url, {})).text).toBe(payload)
+  })
+
+  it("keeps a caller's own Accept-Encoding", async () => {
+    const url = await serve((req, res) => {
+      res.setHeader('x-seen', String(req.headers['accept-encoding']))
+      res.end(payload)
+    })
+
+    expect((await read(url, { 'accept-encoding': 'identity' })).seen).toBe('identity')
+  })
+
+  it('surfaces a corrupt gzip body as an error, not a hang', async () => {
+    const url = await serve((_req, res) => {
+      res.setHeader('content-encoding', 'gzip')
+      res.end(Buffer.from('not gzip at all'))
+    })
+
+    await expect(read(url, {})).rejects.toThrow()
+  })
+})
