+/**
+ * Compressed JSON over slow links. node:http neither asks for nor decodes a
+ * compressed body (Chromium's net does both), so the main process's REST
+ * reads came uncompressed even where the proxy gzips JSON: a long session's
+ * tail page is ~3x larger raw. Ask for gzip unless the caller set an
+ * encoding, and decode it here; any other encoding passes through as is.
+ */
+const JSON_ACCEPT_ENCODING = 'gzip'
+
+function withAcceptEncoding<T extends http.OutgoingHttpHeaders>(headers: T): T {
+  const named = Object.keys(headers).some(name => name.toLowerCase() === 'accept-encoding')
+
+  return named ? headers : { ...headers, 'Accept-Encoding': JSON_ACCEPT_ENCODING }
+}
+
+function decodedResponseBody(res: Readable & { headers?: Record<string, unknown> }): Readable {
+  const encoding = String(res.headers?.['content-encoding'] || '')
+    .trim()
+    .toLowerCase()
+
+  if (encoding !== 'gzip' && encoding !== 'x-gzip') {
+    return res
+  }
+
+  const gunzip = zlib.createGunzip()
+  // The caller listens on the stream it reads: forward the socket's errors.
+  res.on('error', error => gunzip.destroy(error))
+  // A corrupt body unpipes and leaves the response paused on a keep-alive
+  // socket: drop it instead of parking it until the request timeout.
+  gunzip.on('error', () => res.destroy())
+
+  return res.pipe(gunzip)
+}
+
 export {
+  decodedResponseBody,
+  withAcceptEncoding,
   destroyKeepaliveAgents,
   downloadAgentFor,
   htmlResponseError,
