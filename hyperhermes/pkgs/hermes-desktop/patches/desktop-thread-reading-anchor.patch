+  const settle = () => {
+    timer = undefined
+    held = false
+    onSettle()
+  }
+
+  const begin = () => {
+    held = true
+    clearTimeout(timer)
+    timer = setTimeout(settle, quietMs)
+  }
+
+  return {
+    get held() {
+      return held
+    },
+    begin,
+    noteScroll: () => {
+      if (held) {
+        begin()
+      }
+    },
+    end: () => {
+      if (held) {
+        clearTimeout(timer)
+        settle()
+      }
+    },
+    dispose: () => {
+      clearTimeout(timer)
+      held = false
+    }
+  }
+}
+
+export function useReadingAnchor(options: ReadingAnchorOptions): ReadingAnchorController {
+  const optionsRef = useRef(options)
+  optionsRef.current = options
+  const modeRef = useRef<FollowMode | null>(null)
+
+  const markFollowing = useCallback(() => {
+    modeRef.current = nextFollowMode(modeRef.current ?? 'following', {
+      type: 'jump'
+    })
+  }, [])
+
+  const markReading = useCallback(() => {
+    modeRef.current = nextFollowMode(modeRef.current ?? 'following', {
+      type: 'escape'
+    })
+  }, [])
+
+  const { contentRef, enabled, scrollRef } = options
+
+  useEffect(() => {
+    const el = scrollRef.current
+    const content = contentRef.current
+
+    if (!enabled || !el || !content) {
+      return
+    }
+
+    const opts = () => optionsRef.current
+    let inputUntil = 0
+    let pointerDown = false
+    let lastTop = el.scrollTop
+    let ownTop: number | null = null
+    let sample: AnchorSample | null = null
+    // scrollHeight when the sample was taken.
+    let sampleHeight = el.scrollHeight
+    let enforceTimer = 0
+    modeRef.current ??= opts().isLocked() ? 'following' : 'reading'
+    const measure = usableTop(content)
+
+    const gap = () => el.scrollHeight - el.scrollTop - el.clientHeight
+    const userActive = () => pointerDown || performance.now() < inputUntil
+
+    const markInput = () => {
+      inputUntil = performance.now() + USER_INPUT_WINDOW_MS
+    }
+
+    const reading = () => modeRef.current === 'reading'
+
+    // Native scroll anchoring would move content without a ResizeObserver
+    // callback for us to measure: off while our anchor is in charge
+    // (styles.css, data-reading-anchor; an inline edit keeps it on).
+    const setNativeAnchoring = (active: boolean) => {
+      if (el.hasAttribute('data-reading-anchor') !== active) {
+        el.toggleAttribute('data-reading-anchor', active)
+      }
+    }
+
+    const capture = () => {
+      const active = reading() && opts().canAnchor()
+      setNativeAnchoring(active)
+
+      if (!reading()) {
+        sample = null
+
+        return
+      }
+
+      sampleHeight = el.scrollHeight
+      const viewport = el.getBoundingClientRect()
+      const chain = anchorCandidates(pickAnchorChain(content, viewport.top + el.clientHeight * READING_LINE_FRACTION))
+      sample = chain.length
+        ? {
+            chain,
+            tops: chain.map(element => element.getBoundingClientRect().top)
+          }
+        : null
+    }
+
+    // Bring the library in line with our mode.
+    const enforce = () => {
+      const action = reconcileLock(modeRef.current ?? 'following', opts().isLocked())
+
+      if (action === 'unlock') {
+        opts().unlock()
+      } else if (action === 'lock') {
+        opts().lock()
+      }
+    }
+
+    const apply = (event: FollowEvent) => {
+      const before = modeRef.current ?? 'following'
+      modeRef.current = nextFollowMode(before, event)
+
+      if (modeRef.current !== before) {
+        enforce()
+
+        if (modeRef.current === 'reading') {
+          capture()
+        }
+      }
+    }
+
+    // A programmatic scroll in flight (rail jump, find-in-page reveal): no
+    // corrections until it settles, then read the new place as the anchor.
+    // The mode stays reading: the reader asked to see that place.
+    const hold = createProgrammaticScrollHold(() => {
+      lastTop = el.scrollTop
+      capture()
+    })
+
+    // Move scrollTop by however far the saved anchor moved on screen.
+    const correct = () => {
+      if (hold.held) {
+        return
+      }
+
+      const delta = anchorCorrection(sample, measure)
+
+      if (delta !== 0) {
+        el.scrollTop += delta
+        ownTop = el.scrollTop
+        opts().onAnchorWrite?.(el.scrollTop)
+      }
+    }
+
+    // Code paths outside this hook stop the lock on purpose (stopScroll for an
+    // inline edit, PageUp, a restored offset); adopt that as reading. Re-locks
+    // nobody asked for are undone by enforce().
+    const adoptEscapes = () => {
+      if (modeRef.current === 'following' && !opts().isLocked()) {
+        modeRef.current = 'reading'
+        capture()
+      }
+    }
+
+    const onWheel = (event: WheelEvent) => {
+      // The reader's own input ends a programmatic-scroll pause at once.
+      hold.end()
+      markInput()
+      adoptEscapes()
+      apply({ type: 'wheel', deltaY: event.deltaY })
+    }
+
+    const onPointerDown = (event: PointerEvent) => {
+      hold.end()
+      // Scrollbar drags and touch drags start here. Clicks on rows
+      // (expand/collapse) land here too, but only a scroll counts.
+      if (event.button === 0) {
+        pointerDown = true
+      }
+    }
+
+    const onPointerUp = () => {
+      if (pointerDown) {
+        pointerDown = false
+        markInput()
+      }
+    }
+
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (isScrollKey(event.key, event.target, el)) {
+        markInput()
+      }
+    }
+
+    const onScroll = () => {
+      const top = el.scrollTop
+      const ours = ownTop != null && Math.abs(top - ownTop) < 1
+      ownTop = null
+      adoptEscapes()
+
+      const user = !ours && userActive()
+
+      if (user && !isShrinkClamp(top - lastTop, gap())) {
+        apply({ type: 'user-scroll', deltaY: top - lastTop, gap: gap() })
+      } else if (hold.held && !ours) {
+        hold.noteScroll()
+
+        // Revealing something above while following (a find match): read
+        // there instead of being pulled back down by the next token.
+        if (top < lastTop && !isShrinkClamp(top - lastTop, gap())) {
+          apply({ type: 'escape' })
+        }
+      }
+
+      // A scroll that is neither the user's nor ours, in the frame where the
+      // content changed height (rows dropped off the front of the window, a
+      // layout effect re-applying an offset), reaches us before the
+      // ResizeObserver callback: re-sampling here would adopt the shifted
+      // position as the new anchor and the reader jumps by the difference
+      // (measured: 469-1506 px). Correct against the saved sample instead. A
+      // programmatic scroll with no layout change (scrollIntoView) is kept.
+      if (reading() && opts().canAnchor() && isLayoutScroll(user, ours, el.scrollHeight - sampleHeight)) {
+        correct()
+      }
+
+      lastTop = el.scrollTop
+      capture()
+      // The library decides its lock in a setTimeout after the scroll event.
+      window.clearTimeout(enforceTimer)
+      enforceTimer = window.setTimeout(enforce, 4)
+    }
+
+    const onResize = () => {
+      adoptEscapes()
+      apply({ type: 'content-resize' })
+      // The library's ResizeObserver ran first (it observes from commit) and
+      // may have re-locked on a shrink near the bottom; its follow scroll
+      // waits for the next frame and checks the lock then.
+      enforce()
+
+      if (!reading() || !opts().canAnchor()) {
+        setNativeAnchoring(false)
+        sample = null
+        lastTop = el.scrollTop
+
+        return
+      }
+
+      correct()
+      lastTop = el.scrollTop
+      capture()
+    }
+
+    // Rows are the content's direct children; observing them too catches a
+    // change that leaves the total height unchanged (one row grows while
+    // another shrinks).
+    const resizeObserver = new ResizeObserver(onResize)
+    resizeObserver.observe(content)
+
+    for (const row of content.children) {
+      resizeObserver.observe(row)
+    }
+
+    const rowObserver = new MutationObserver(records => {
+      for (const record of records) {
+        record.addedNodes.forEach(node => node instanceof Element && resizeObserver.observe(node))
+        record.removedNodes.forEach(node => node instanceof Element && resizeObserver.unobserve(node))
+      }
+    })
+
+    rowObserver.observe(content, { childList: true })
+
+    const onProgrammaticScroll = () => hold.begin()
+
+    el.addEventListener(PROGRAMMATIC_SCROLL_EVENT, onProgrammaticScroll)
+    el.addEventListener('wheel', onWheel, { passive: true })
+    el.addEventListener('touchmove', markInput, { passive: true })
+    el.addEventListener('pointerdown', onPointerDown, { passive: true })
+    el.addEventListener('scroll', onScroll, { passive: true })
+    window.addEventListener('pointerup', onPointerUp, { passive: true })
+    window.addEventListener('pointercancel', onPointerUp, { passive: true })
+    window.addEventListener('keydown', onKeyDown, {
+      capture: true,
+      passive: true
+    })
+
+    capture()
+
+    return () => {
+      window.clearTimeout(enforceTimer)
+      hold.dispose()
+      resizeObserver.disconnect()
+      rowObserver.disconnect()
+      el.removeEventListener(PROGRAMMATIC_SCROLL_EVENT, onProgrammaticScroll)
+      el.removeEventListener('wheel', onWheel)
+      el.removeEventListener('touchmove', markInput)
+      el.removeEventListener('pointerdown', onPointerDown)
+      el.removeEventListener('scroll', onScroll)
+      window.removeEventListener('pointerup', onPointerUp)
+      window.removeEventListener('pointercancel', onPointerUp)
+      window.removeEventListener('keydown', onKeyDown, { capture: true })
+      el.removeAttribute('data-reading-anchor')
+    }
+  }, [contentRef, enabled, scrollRef])
+
+  // Stable identity: callers put the controller in effect deps (the jump
+  // button's instant restore path is torn down whenever it changes).
+  return useMemo(() => ({ markFollowing, markReading }), [markFollowing, markReading])
+}
