+import { describe, expect, it } from 'vitest'
+
+import { createRowKeyMemory, type RowKeyInput, stableRowKeys } from './stable-row-keys'
+
+// Nix patch desktop-thread-reading-anchor: a turn keeps its React key while
+// its live message is persisted and the history is re-read, so the rows the
+// reader is looking at are not remounted under them.
+
+const row = (id: string, role: string, rowId?: number): RowKeyInput => ({
+  key: rowId == null ? id : `row:${rowId}`,
+  id,
+  role
+})
+
+describe('stableRowKeys', () => {
+  it('keeps the live key when the stream row gets its stored rowId', () => {
+    const memory = createRowKeyMemory()
+    const live = stableRowKeys(
+      [row('u1', 'user', 1), row('user-live', 'user'), row('assistant-stream-1', 'assistant')],
+      memory
+    )
+    const persisted = stableRowKeys(
+      [row('u1', 'user', 1), row('user-live', 'user', 7), row('assistant-stream-1', 'assistant', 12)],
+      memory
+    )
+
+    expect(persisted).toEqual(live)
+  })
+
+  it('keeps keys when a history re-read renames every message and moves its rowId', () => {
+    const memory = createRowKeyMemory()
+
+    const live = stableRowKeys(
+      [
+        row('a-0', 'user', 1),
+        row('a-1', 'assistant', 2),
+        row('user-live', 'user', 7),
+        row('assistant-stream-1', 'assistant', 12)
+      ],
+      memory
+    )
+
+    // Renderer ids re-derived from the new page; the stored assistant is the
+    // turn's FIRST row (8), not the last one the stream was stamped with.
+    const reread = stableRowKeys(
+      [row('b-0', 'user', 1), row('b-1', 'assistant', 2), row('b-2', 'user', 7), row('b-3', 'assistant', 8)],
+      memory
+    )
+
+    expect(reread).toEqual(live)
+  })
+
+  it('gives new messages their own key and never reuses one', () => {
+    const memory = createRowKeyMemory()
+    stableRowKeys([row('u1', 'user', 1), row('a1', 'assistant', 2)], memory)
+    const next = stableRowKeys(
+      [row('u1', 'user', 1), row('a1', 'assistant', 2), row('u2', 'user'), row('a2', 'assistant')],
+      memory
+    )
+
+    expect(next).toEqual(['row:1', 'row:2', 'u2', 'a2'])
+    expect(new Set(next).size).toBe(next.length)
+  })
+
+  it('does not hand a removed message key to a different role', () => {
+    const memory = createRowKeyMemory()
+    stableRowKeys([row('u1', 'user', 1), row('s1', 'system')], memory)
+
+    expect(stableRowKeys([row('u1', 'user', 1), row('a9', 'assistant')], memory)).toEqual(['row:1', 'a9'])
+  })
+
+  it('never duplicates a key when older rows drop off and the shared live id returns', () => {
+    const memory = createRowKeyMemory()
+    const live = 'assistant-stream-S'
+
+    const first = stableRowKeys(
+      [
+        row('u1', 'user', 1),
+        row(live, 'assistant'),
+        row('u2', 'user'),
+        row(live, 'assistant'),
+        row('u3', 'user'),
+        row(live, 'assistant')
+      ],
+      memory
+    )
+
+    // The first row is re-read under another rowId; the live id is still
+    // shared by three assistant rows. A suffix fallback must not collide with
+    // a key a later row holds from memory.
+    const next = stableRowKeys(
+      [
+        row('u1b', 'user', 3),
+        row(live, 'assistant'),
+        row('u2', 'user'),
+        row(live, 'assistant'),
+        row('u3', 'user'),
+        row(live, 'assistant')
+      ],
+      memory
+    )
+
+    expect(new Set(first).size).toBe(first.length)
+    expect(new Set(next).size).toBe(next.length)
+    expect(next).toEqual(first)
+
+    const trimmed = stableRowKeys(
+      [row('u2', 'user'), row(live, 'assistant'), row('u3', 'user'), row(live, 'assistant')],
+      memory
+    )
+    expect(new Set(trimmed).size).toBe(trimmed.length)
+    expect(trimmed[0]).toBe(first[2])
+    expect(trimmed[2]).toBe(first[4])
+  })
+
+  it('stays unique over random re-reads', () => {
+    let seed = 7
+    const rnd = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648
+
+    for (let trial = 0; trial < 500; trial++) {
+      const memory = createRowKeyMemory()
+
+      for (let step = 0; step < 8; step++) {
+        const rows = Array.from({ length: 1 + Math.floor(rnd() * 7) }, (_, index) =>
+          row(
+            rnd() < 0.3 ? 'assistant-stream-S' : `m${Math.floor(rnd() * 6)}`,
+            index % 2 ? 'assistant' : 'user',
+            rnd() < 0.5 ? Math.floor(rnd() * 6) : undefined
+          )
+        )
+
+        const keys = stableRowKeys(rows, memory)
+        expect(new Set(keys).size).toBe(keys.length)
+      }
+    }
+  })
+
+  it('keeps split rows (two messages, one stored row) unique', () => {
+    const memory = createRowKeyMemory()
+    const keys = stableRowKeys([row('a-1', 'assistant', 5), row('a-1b', 'assistant', 5)], memory)
+
+    expect(keys).toEqual(['row:5', 'a-1b'])
+  })
+})
