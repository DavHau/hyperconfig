+import { type RefObject, useCallback, useEffect, useMemo, useRef } from 'react'
+
+/**
+ * Reading-position anchor for the transcript viewport (Nix patch
+ * desktop-thread-reading-anchor). Two jobs:
+ *
+ * 1. Follow state from USER input only. use-stick-to-bottom escapes on an
+ *    upward wheel synchronously, but every other scroll (scrollbar drag,
+ *    keyboard, PageUp) goes through its scroll handler, which drops the event
+ *    whenever a content resize is in flight: during a stream that is almost
+ *    every frame, so the reader stayed locked and the next resize yanked them
+ *    back to the bottom. It also re-locks on any downward scroll that ends
+ *    near the bottom, including the browser's own scroll anchoring when rows
+ *    above grow, and on a shrink near the bottom. Here the mode changes only
+ *    on user input (upward = reading, reaching the bottom = following) or an
+ *    explicit jump (markFollowing); any other lock is undone.
+ *
+ * 2. While reading, keep what the reader is looking at pinned. The element at
+ *    the reading line is remembered with its on-screen top; after every layout
+ *    change of the transcript (ResizeObserver, before paint) scrollTop is
+ *    corrected by however far that element moved. Native overflow-anchor
+ *    alone moved the reader when rows inside the live turn re-rendered above
+ *    them (it anchored a node inside the changing block).
+ */
+
+export type FollowMode = 'following' | 'reading'
+
+export type FollowEvent =
+  /** Wheel/trackpad input over the viewport. */
+  | { type: 'wheel'; deltaY: number }
+  /** A scroll the user caused (inside an input window): signed movement and the gap to the bottom after it. */
+  | { type: 'user-scroll'; deltaY: number; gap: number }
+  /** "Jump to latest", a new run started at the bottom, a session load parking at the bottom. */
+  | { type: 'jump' }
+  /** Code escaped the lock on purpose (inline edit, PageUp, a restored reading offset). */
+  | { type: 'escape' }
+  /** Content changed size (streaming, rows expanding, images) or the browser moved scrollTop. */
+  | { type: 'content-resize' }
+
+/** Within this many px of the bottom a user scroll re-enables follow (use-stick-to-bottom's own band). */
+export const FOLLOW_REARM_GAP_PX = 70
+
+/** How long after a wheel/key/touch/pointer input a scroll still counts as the user's. */
+export const USER_INPUT_WINDOW_MS = 400
+
+/** The reading line, as a fraction of the viewport height from its top. */
+export const READING_LINE_FRACTION = 0.3
+
+/** Smallest correction worth a scrollTop write (subpixel noise otherwise). */
+export const ANCHOR_EPSILON_PX = 0.5
+
+export function nextFollowMode(mode: FollowMode, event: FollowEvent, rearmGapPx = FOLLOW_REARM_GAP_PX): FollowMode {
+  switch (event.type) {
+    case 'wheel':
+      return event.deltaY < 0 ? 'reading' : mode
+
+    case 'user-scroll':
+      if (event.deltaY < 0) {
+        return 'reading'
+      }
+
+      return event.deltaY > 0 && event.gap <= rearmGapPx ? 'following' : mode
+
+    case 'jump':
+      return 'following'
+
+    case 'escape':
+      return 'reading'
+
+    case 'content-resize':
+      return mode
+  }
+}
+
+/**
+ * What to do with the library's lock given our mode: `lock`/`unlock` it, or
+ * leave it. Only `following` may hold the lock; a lock taken while reading
+ * (a re-lock nobody asked for) is released.
+ */
+export function reconcileLock(mode: FollowMode, libraryLocked: boolean): 'lock' | 'unlock' | null {
+  if (mode === 'reading' && libraryLocked) {
+    return 'unlock'
+  }
+
+  if (mode === 'following' && !libraryLocked) {
+    return 'lock'
+  }
+
+  return null
+}
+
+export interface AnchorSample {
+  /** Anchor candidates, innermost first; the first still usable one is measured. */
+  chain: Element[]
+  tops: number[]
+}
+
+/** Correction for a saved anchor: how far its first usable element moved on screen, or 0. */
+export function anchorCorrection(sample: AnchorSample | null, measure: (element: Element) => number | null): number {
+  if (!sample) {
+    return 0
+  }
+
+  for (let index = 0; index < sample.chain.length; index++) {
+    const top = measure(sample.chain[index]!)
+
+    if (top == null) {
+      continue
+    }
+
+    const delta = top - sample.tops[index]!
+
+    return Math.abs(delta) >= ANCHOR_EPSILON_PX ? delta : 0
+  }
