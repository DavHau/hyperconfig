+/** Below this many children a linear scan is as cheap as the search. */
+const LINEAR_SCAN_CHILDREN = 16
+
+/**
+ * Index to start the scan for the first child whose box reaches past lineY.
+ * In-flow children are in layout order, so their bottoms only grow: binary
+ * search over them (a long transcript has hundreds of rows), stepping over
+ * empty and pinned boxes. The result never passes the first in-flow child
+ * reaching past the line; the caller's linear scan from there makes the pick.
+ */
+function firstReachingPast(children: HTMLCollection, lineY: number): number {
+  if (children.length <= LINEAR_SCAN_CHILDREN) {
+    return 0
+  }
+
+  let lo = 0
+  let hi = children.length - 1
+
+  // Invariant: no child before lo reaches past the line.
+  while (lo < hi) {
+    const mid = (lo + hi) >> 1
+    let probe = mid
+
+    // Empty and pinned boxes carry no flow position: compare the next real one.
+    while (probe < hi && !inFlow(children[probe]!)) {
+      probe++
+    }
+
+    const rect = children[probe]!.getBoundingClientRect()
+
+    if (inFlow(children[probe]!) && rect.bottom <= lineY) {
+      lo = probe + 1
+    } else {
+      hi = mid
+    }
+  }
+
+  return lo
+}
