diff --git a/apps/desktop/src/lib/find-in-page-scope.test.ts b/apps/desktop/src/lib/find-in-page-scope.test.ts
new file mode 100644
index 0000000..7346a08
--- /dev/null
+++ b/apps/desktop/src/lib/find-in-page-scope.test.ts
@@ -0,0 +1,71 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { PROGRAMMATIC_SCROLL_EVENT } from '@/components/assistant-ui/thread/reading-anchor'
+
+import { captureFindScope, performScopedFind, releaseFindScope } from './find-in-page-scope'
+
+// Nix patch desktop-thread-reading-anchor: only a find / step the user asked
+// for reveals the match and announces a programmatic scroll; re-wrapping the
+// marks after a streaming re-render does neither, or the transcript's reading
+// anchor would stay paused for the whole stream while the bar is open.
+
+describe('find-in-page re-apply during a stream', () => {
+  let surface: HTMLElement
+  let message: HTMLElement
+  let announced: number
+  let revealed: number
+  const onAnnounce = () => {
+    announced += 1
+  }
+
+  beforeEach(() => {
+    announced = 0
+    revealed = 0
+    Element.prototype.scrollIntoView = vi.fn(() => {
+      revealed += 1
+    })
+    surface = document.createElement('div')
+    surface.setAttribute('data-chat-surface', '')
+    message = document.createElement('p')
+    message.textContent = 'the agent streams a token, then another token'
+    surface.append(message)
+    document.body.append(surface)
+    document.addEventListener(PROGRAMMATIC_SCROLL_EVENT, onAnnounce)
+  })
+
+  afterEach(() => {
+    releaseFindScope()
+    document.removeEventListener(PROGRAMMATIC_SCROLL_EVENT, onAnnounce)
+    surface.remove()
+    delete (Element.prototype as Partial<Element>).scrollIntoView
+  })
+
+  it('announces a user find and step, not the re-wrap after a re-render', async () => {
+    const root = captureFindScope()!
+    expect(root).toBe(surface)
+
+    expect(performScopedFind(root, 'token', { forward: true, findNext: false })).toEqual({
+      count: 2,
+      activeOrdinal: 1
+    })
+    expect(announced).toBe(1)
+    expect(revealed).toBe(1)
+
+    expect(performScopedFind(root, 'token', { forward: true, findNext: true }).activeOrdinal).toBe(2)
+    expect(announced).toBe(2)
+    expect(revealed).toBe(2)
+
+    // A streaming re-render replaces the message's text, detaching the marks.
+    for (let i = 1; i <= 5; i += 1) {
+      message.textContent = `the agent streams a token, then another token${' more'.repeat(i)}`
+      await new Promise(resolve => setTimeout(resolve, 0))
+      // Re-wrapped, still on the ordinal the user stood on.
+      expect(surface.querySelectorAll('mark.find-hit')).toHaveLength(2)
+      expect(surface.querySelectorAll('mark[data-find-active]')[0]?.textContent).toBe('token')
+      expect([...surface.querySelectorAll('mark.find-hit')].indexOf(surface.querySelector('mark[data-find-active]')!)).toBe(1)
+    }
+
+    expect(announced).toBe(2)
+    expect(revealed).toBe(2)
+  })
+})
