index 0000000..bc8fc36
--- /dev/null
+++ b/apps/desktop/src/components/assistant-ui/thread/reading-anchor.test.ts
@@ -0,0 +1,460 @@
+import { renderHook } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import {
+  anchorCandidates,
+  anchorCorrection,
+  announceProgrammaticScroll,
+  createProgrammaticScrollHold,
+  type FollowEvent,
+  type FollowMode,
+  isLayoutScroll,
+  isScrollKey,
+  isShrinkClamp,
+  nextFollowMode,
+  pickAnchorChain,
+  PROGRAMMATIC_SCROLL_QUIET_MS,
+  reconcileLock,
+  useReadingAnchor
+} from './reading-anchor'
+
+// Nix patch desktop-thread-reading-anchor: the transcript follows new output
+// only while the reader is at the bottom; any user scroll away from it stops
+// the follow until they scroll back down or press "Jump to latest", and the
+// content they read stays put while the agent's output changes around it.
+
+const run = (events: FollowEvent[], start: FollowMode = 'following') =>
+  events.reduce<FollowMode>((mode, event) => nextFollowMode(mode, event), start)
+
+describe('nextFollowMode', () => {
+  it('stops following on any upward user scroll, wheel or not', () => {
+    expect(nextFollowMode('following', { type: 'wheel', deltaY: -3 })).toBe('reading')
+    // Scrollbar drag / keyboard / PageUp: only a scroll event, no wheel.
+    expect(
+      nextFollowMode('following', {
+        type: 'user-scroll',
+        deltaY: -40,
+        gap: 40
+      })
+    ).toBe('reading')
+    // Even a tiny nudge inside the library's near-bottom band.
+    expect(nextFollowMode('following', { type: 'user-scroll', deltaY: -1, gap: 1 })).toBe('reading')
+  })
+
+  it('keeps reading while the agent works (content resizes never change the mode)', () => {
+    expect(run([{ type: 'wheel', deltaY: -120 }, ...Array(50).fill({ type: 'content-resize' })])).toBe('reading')
+    expect(run(Array(50).fill({ type: 'content-resize' }))).toBe('following')
+  })
+
+  it('resumes following only when the user scrolls back down to the bottom', () => {
+    const up: FollowEvent = { type: 'wheel', deltaY: -120 }
+    // Part-way down: still reading, nothing yanks.
+    expect(run([up, { type: 'user-scroll', deltaY: 200, gap: 600 }])).toBe('reading')
+    // Down a wheel without reaching the bottom does not re-arm either.
+    expect(run([up, { type: 'wheel', deltaY: 120 }])).toBe('reading')
+    // Reaching the bottom by user input re-arms.
+    expect(run([up, { type: 'user-scroll', deltaY: 200, gap: 0 }])).toBe('following')
+    // A non-moving event at the bottom (deltaY 0) is not a return.
+    expect(run([up, { type: 'user-scroll', deltaY: 0, gap: 0 }])).toBe('reading')
+  })
+
+  it('jump to latest re-enables follow, an explicit escape disables it', () => {
+    expect(run([{ type: 'wheel', deltaY: -120 }, { type: 'jump' }])).toBe('following')
+    expect(nextFollowMode('following', { type: 'escape' })).toBe('reading')
+  })
+})
+
+describe('reconcileLock', () => {
+  it('undoes a library re-lock while reading and re-takes a lock it lost while following', () => {
+    expect(reconcileLock('reading', true)).toBe('unlock')
+    expect(reconcileLock('following', false)).toBe('lock')
+    expect(reconcileLock('reading', false)).toBeNull()
+    expect(reconcileLock('following', true)).toBeNull()
+  })
+})
+
+describe('anchorCorrection', () => {
+  const a = { id: 'a' } as unknown as Element
+  const b = { id: 'b' } as unknown as Element
+
+  it('returns how far the anchored element moved on screen', () => {
+    const sample = { chain: [a, b], tops: [100, 80] }
+    // A row above the reader grew by 240 px: the anchor moved down 240.
+    expect(anchorCorrection(sample, el => (el === a ? 340 : 320))).toBe(240)
+    // A tool row above collapsed by 90 px.
+    expect(anchorCorrection(sample, el => (el === a ? 10 : -10))).toBe(-90)
+  })
+
+  it('falls back to an outer anchor when the inner one re-rendered away', () => {
+    const sample = { chain: [a, b], tops: [100, 80] }
+    expect(anchorCorrection(sample, el => (el === a ? null : 130))).toBe(50)
+  })
+
+  it('ignores subpixel noise and missing anchors', () => {
+    expect(anchorCorrection({ chain: [a], tops: [100] }, () => 100.2)).toBe(0)
+    expect(anchorCorrection({ chain: [a], tops: [100] }, () => null)).toBe(0)
+    expect(anchorCorrection(null, () => 5)).toBe(0)
+  })
+})
+
+describe('pickAnchorChain', () => {
+  const box = (top: number, height: number, children: HTMLElement[] = [], position = 'static') => {
+    const el = document.createElement('div')
+    el.style.position = position
+    el.getBoundingClientRect = () =>
+      ({
+        top,
+        bottom: top + height,
+        height,
+        left: 0,
+        right: 100,
+        width: 100,
+        x: 0,
+        y: top,
+        toJSON() {}
+      }) as DOMRect
+    children.forEach(child => el.appendChild(child))
+
+    return el
+  }
+
+  it('picks the innermost in-flow element under the reading line', () => {
+    const para = box(210, 40)
+    const row = box(150, 400, [box(150, 50), para, box(260, 100)])
+    const content = box(0, 2000, [box(0, 150), row, box(550, 300)])
+    expect(pickAnchorChain(content, 230)).toEqual([para, row])
+  })
+
+  it('skips sticky overlays (the pinned human bubble) and uses the content under them', () => {
+    const sticky = box(200, 80, [], 'sticky')
+    const answer = box(180, 300)
+    const row = box(100, 500, [sticky, answer])
+    const content = box(0, 2000, [row])
+    expect(pickAnchorChain(content, 230)).toEqual([answer, row])
+  })
+
+  it('anchors the next block when the line falls in a gap', () => {
+    const below = box(260, 100)
+    const content = box(0, 2000, [box(100, 100), below])
+    expect(pickAnchorChain(content, 230)).toEqual([below])
+  })
+})
+
+describe('pickAnchorChain on a long transcript', () => {
+  it('finds the row under the line by binary search, skipping empty and pinned rows', () => {
+    const make = (top: number, height: number, position = 'static') => {
+      const el = document.createElement('div')
+      el.style.position = position
+      el.getBoundingClientRect = () =>
+        ({
+          top,
+          bottom: top + height,
+          height,
+          left: 0,
+          right: 100,
+          width: 100,
+          x: 0,
+          y: top,
+          toJSON() {}
+        }) as DOMRect
+
+      return el
+    }
+
+    const rows: HTMLElement[] = []
+
+    for (let index = 0; index < 300; index++) {
+      rows.push(index % 7 === 3 ? make(0, 0) : index % 11 === 5 ? make(0, 900, 'sticky') : make(index * 100, 100))
+    }
+
+    const content = document.createElement('div')
+    rows.forEach(child => content.appendChild(child))
+
+    for (const lineY of [0, 50, 99, 100, 350, 12_345, 29_950]) {
+      const expected = rows.find(
+        r =>
+          r.getBoundingClientRect().height > 0 &&
+          r.style.position !== 'sticky' &&
+          r.getBoundingClientRect().bottom > lineY
+      )
+      expect(pickAnchorChain(content, lineY)).toEqual(expected ? [expected] : [])
+    }
+
+    expect(pickAnchorChain(content, 40_000)).toEqual([])
+  })
+})
+
+describe('user input vs. browser scrolls', () => {
+  const viewport = document.createElement('div')
+  const row = document.createElement('div')
+  const editor = document.createElement('textarea')
