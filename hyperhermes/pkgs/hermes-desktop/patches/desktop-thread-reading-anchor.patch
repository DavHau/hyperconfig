+
+    if (!next) {
+      break
+    }
+
+    chain.unshift(next)
+    parent = next
+  }
+
+  return chain
+}
+
+/**
+ * Anchor candidates for a chain from pickAnchorChain: each element under the
+ * line followed by the first box after it that starts below the line. When
+ * the block being read collapses (a tool/thought row folded above or around
+ * the reading line) the element under the line is hidden or clipped away;
+ * the next usable candidate is then what came right after it, which keeps
+ * its place instead of the row around it.
+ */
+export function anchorCandidates(chain: readonly Element[]): Element[] {
+  const out: Element[] = []
+
+  for (const element of chain) {
+    out.push(element)
+    let next = element.nextElementSibling
+
+    while (next && next.getBoundingClientRect().height <= 0) {
+      next = next.nextElementSibling
+    }
+
+    if (next) {
+      out.push(next)
+    }
+  }
+
+  return out
