+++ b/apps/desktop/src/components/assistant-ui/thread/stable-row-keys.ts
@@ -0,0 +1,137 @@
+/**
+ * Row keys that survive a live message being persisted (Nix patch
+ * desktop-thread-reading-anchor). A streamed message is keyed by its renderer
+ * id until the turn completes; then it gets a stored rowId (upstream's key
+ * becomes `row:<id>`), and the history re-read that follows replaces it with
+ * a stored message that has another id and often another rowId (the turn's
+ * first row instead of its last). Each new key remounts the whole turn: every
+ * node the reader was looking at is replaced, the fresh subtree lays out at a
+ * different height, and the viewport jumps (measured: 83-166 px at every turn
+ * end while scrolled up, 916 px when an auto-continued turn started).
+ *
+ * The first key a message was rendered under is kept while its renderer id
+ * or its stored rowId is seen again, and a message with neither known takes
+ * over the key of the message it replaced in place: same role, right after
+ * the same predecessor, and gone from the new list.
+ */
+export interface RowKeyMemory {
+  /** Renderer id -> key, with the render it was last seen in. */
+  byId: Map<string, { key: string; at: number }>
+  /** Upstream `row:<rowId>` key -> key, with the render it was last seen in. */
+  byRow: Map<string, { key: string; at: number }>
+  previous: { key: string; role: string }[]
+  /** Render counter, for pruning entries of messages long gone. */
+  renders: number
+}
+
+export const createRowKeyMemory = (): RowKeyMemory => ({
+  byId: new Map(),
+  byRow: new Map(),
+  previous: [],
+  renders: 0
+})
+
+/** Entries unseen for this many renders are dropped (renamed ids never come back). */
+export const ROW_KEY_MEMORY_RENDERS = 200
+
+export interface RowKeyInput {
+  /** Upstream's key: `row:<rowId>` or the renderer id. */
+  key: string
+  /** Renderer id. */
+  id: string
+  role: string
+}
+
+const prune = (map: RowKeyMemory['byId'], oldest: number) => {
+  for (const [entry, { at }] of map) {
+    if (at < oldest) {
+      map.delete(entry)
+    }
+  }
+}
+
+/** Unique React keys, stable across persistence and history re-reads; updates `memory`. */
+export function stableRowKeys(rows: readonly RowKeyInput[], memory: RowKeyMemory): string[] {
+  const at = ++memory.renders
+
+  const remembered = rows.map(
+    ({ key, id }) => (key.startsWith('row:') ? memory.byRow.get(key)?.key : undefined) ?? memory.byId.get(id)?.key
+  )
+
+  // Every remembered key is reserved up front for the first row holding it,
+  // so no row before it (a fallback or an in-place takeover) can take it. A
+  // later row resolving to the same key (the live stream id shared by turns
+  // that came back after older rows dropped off) is treated as new.
+  const known: (string | undefined)[] = []
+  const reserved = new Set<string>()
+
+  remembered.forEach(key => {
+    known.push(key != null && !reserved.has(key) ? key : undefined)
+
+    if (key != null) {
+      reserved.add(key)
+    }
+  })
+
+  const previousIndex = new Map(memory.previous.map((row, index) => [row.key, index]))
+  const taken = new Set(reserved)
+  const keys: string[] = []
+  const idsSeen = new Set<string>()
+
+  rows.forEach(({ key: upstream, id, role }, index) => {
+    let key = known[index]
+
+    if (key == null) {
+      // Replaced in place: the old message that followed our predecessor.
+      const before = index > 0 ? previousIndex.get(keys[index - 1]!) : -1
+      const candidate = before != null ? memory.previous[before + 1] : undefined
+
+      if (candidate && candidate.role === role && !taken.has(candidate.key)) {
+        key = candidate.key
+      } else if (!taken.has(upstream)) {
+        key = upstream
+      } else if (!taken.has(id)) {
+        // Two rendered messages can carry one stored row (hydration splits a
+        // row it renders in parts): the later copy keeps its own id, as
+        // upstream does.
+        key = id
+      } else {
+        let suffix = index
+
+        while (taken.has(`${id}#${suffix}`)) {
+          suffix++
+        }
+
+        key = `${id}#${suffix}`
+      }
+
+      taken.add(key)
+    }
+
+    keys.push(key)
+
+    // A renderer id shared by several rows (the live stream id) remembers its
+    // first row, so that row keeps its key on the next render.
+    if (!idsSeen.has(id)) {
+      idsSeen.add(id)
+      memory.byId.set(id, { key, at })
+    }
+
+    if (upstream.startsWith('row:')) {
+      const stored = memory.byRow.get(upstream)
+      memory.byRow.set(upstream, { key: stored?.key ?? key, at })
+    }
+  })
+
+  memory.previous = rows.map(({ role }, index) => ({
+    key: keys[index]!,
+    role
+  }))
+
+  if (at % 50 === 0) {
+    prune(memory.byId, at - ROW_KEY_MEMORY_RENDERS)
+    prune(memory.byRow, at - ROW_KEY_MEMORY_RENDERS)
+  }
+
+  return keys
+}
