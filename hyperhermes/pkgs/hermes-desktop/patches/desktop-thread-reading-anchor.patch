+  for (let depth = 0; depth < maxDepth; depth++) {
+    let next: Element | null = null
+    const { children } = parent
+
+    for (let index = firstReachingPast(children, lineY); index < children.length; index++) {
+      const child = children[index]!
+      const rect = child.getBoundingClientRect()
+
+      if (rect.height <= 0 || rect.bottom <= lineY || isPinnedPosition(child)) {
+        continue
+      }
+
+      // In flow order the first box reaching past the line is the one under it
+      // (or, in a gap between blocks, the next one below).
+      next = child
+
+      break
