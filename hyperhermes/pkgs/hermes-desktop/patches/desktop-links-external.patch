diff --git a/apps/desktop/electron/preview-guest-links-external.test.ts b/apps/desktop/electron/preview-guest-links-external.test.ts
new file mode 100644
index 0000000..29247ef
--- /dev/null
+++ b/apps/desktop/electron/preview-guest-links-external.test.ts
@@ -0,0 +1,75 @@
+// Nix: a preview guest's web link reaches the system browser only on the
+// user's click (hyperhermes/pkgs/hermes-desktop patch
+// desktop-links-external.patch). main blocks every other http(s) navigation
+// of the guest; this is the click half, in the guest preload.
+import assert from 'node:assert/strict'
+
+import { describe, test } from 'vitest'
+
+import { GUEST_EXTERNAL_CHANNEL, type GuestClickEvent, installGuestExternalHandoff } from './preview-guest-preload'
+
+function rig() {
+  const sent: { channel: string; args: unknown[] }[] = []
+  const listeners: { type: string; listener: (event: GuestClickEvent) => void; capture?: boolean }[] = []
+
+  installGuestExternalHandoff({
+    addEventListener: (type, listener, capture) => listeners.push({ capture, listener, type }),
+    sendToHost: (channel, ...args) => sent.push({ args, channel })
+  })
+
+  const fire = (type: string) => (event: GuestClickEvent) =>
+    listeners.filter(entry => entry.type === type).forEach(entry => entry.listener(event))
+
+  return { auxclick: fire('auxclick'), click: fire('click'), listeners, sent }
+}
+
+const anchor = (href: string, target = '') => ({
+  closest: (selector: string) => (selector === 'a[href]' ? { href, target } : null)
+})
+
+describe('preview guest links', () => {
+  test('listens to primary and middle clicks in the capture phase', () => {
+    const { listeners } = rig()
+
+    assert.deepEqual(
+      listeners.map(entry => [entry.type, entry.capture]),
+      [
+        ['click', true],
+        ['auxclick', true]
+      ]
+    )
+  })
+
+  test('a trusted click on any web link is forwarded and its in-pane navigation cancelled', () => {
+    const { auxclick, click, sent } = rig()
+    let cancelled = 0
+    const preventDefault = () => void cancelled++
+
+    click({ button: 0, isTrusted: true, preventDefault, target: anchor('https://example.org/a') })
+    auxclick({ button: 1, isTrusted: true, preventDefault, target: anchor('http://example.org/b') })
+    click({ button: 0, isTrusted: true, preventDefault, target: anchor('https://example.org/c', '_blank') })
+
+    assert.deepEqual(
+      sent.map(entry => [entry.channel, entry.args[0]]),
+      [
+        [GUEST_EXTERNAL_CHANNEL, 'https://example.org/a'],
+        [GUEST_EXTERNAL_CHANNEL, 'http://example.org/b'],
+        [GUEST_EXTERNAL_CHANNEL, 'https://example.org/c']
+      ]
+    )
+    assert.equal(cancelled, 3)
+  })
+
+  test('script clicks, wrong buttons and local same-tab links open nothing', () => {
+    const { auxclick, click, sent } = rig()
+
+    click({ button: 0, isTrusted: false, target: anchor('https://evil.example/') })
+    click({ button: 2, isTrusted: true, target: anchor('https://example.org/') })
+    auxclick({ button: 2, isTrusted: true, target: anchor('https://example.org/') })
+    click({ button: 0, isTrusted: true, target: anchor('file:///tmp/sibling.html') })
+    click({ button: 0, isTrusted: true, target: { closest: () => null } })
+    click({ button: 0, isTrusted: true, target: null })
+
+    assert.deepEqual(sent, [])
+  })
+})
