+export const AGENT_INPUT_SETTLE_MS = 1_500
+
+let agentActs = 0
+let agentQuietAt = 0
+
+/** Mark one agent action as running; the returned end is idempotent. */
+export function beginAgentPreviewAction(): () => void {
+  agentActs += 1
