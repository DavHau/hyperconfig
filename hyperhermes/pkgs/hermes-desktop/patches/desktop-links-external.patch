diff --git a/apps/desktop/src/store/preview-links-external.test.ts b/apps/desktop/src/store/preview-links-external.test.ts
new file mode 100644
index 0000000..ca99d9b
--- /dev/null
+++ b/apps/desktop/src/store/preview-links-external.test.ts
@@ -0,0 +1,130 @@
+// Nix: web pages never open inside the app, and reach the system browser
+// only on the user's click (hyperhermes/pkgs/hermes-desktop patch
+// desktop-links-external.patch). openPreview is the one entry every in-app
+// web view goes through; the agent's preview.open events land there.
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { createElement } from 'react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import {
+  agentDrivingPreview,
+  AGENT_INPUT_SETTLE_MS,
+  beginAgentPreviewAction,
+  noteAgentPreviewInput
+} from '@/app/chat/right-rail/preview-input'
+import { ExternalLink, openLink } from '@/lib/external-link'
+
+import { $notifications, clearNotifications } from './notifications'
+import {
+  $previewTabs,
+  closeRightRail,
+  decodePreviewTabs,
+  openBrowserTab,
+  openPreview,
+  openPreviewFromClick
+} from './preview'
+
+const desktopWindow = window as unknown as { hermesDesktop?: Window['hermesDesktop'] }
+
+function installBridge() {
+  const openExternal = vi.fn().mockResolvedValue(undefined)
+  desktopWindow.hermesDesktop = { openExternal } as unknown as Window['hermesDesktop']
+
+  return openExternal
+}
+
+afterEach(() => {
+  cleanup()
+  closeRightRail()
+  clearNotifications()
+  delete desktopWindow.hermesDesktop
+})
+
+describe('web pages open in the system browser', () => {
+  it('a plain click on a link opens it externally, no in-app tab', () => {
+    const openExternal = installBridge()
+
+    render(createElement(ExternalLink, { href: 'https://example.com/path' }, 'Example link'))
+    fireEvent.click(screen.getByRole('link', { name: 'Example link' }))
+
+    expect(openExternal).toHaveBeenCalledExactlyOnceWith('https://example.com/path')
+    expect($previewTabs.get()).toHaveLength(0)
+  })
+
+  it('openLink (terminal, directives) opens externally', () => {
+    const openExternal = installBridge()
+
+    openLink('example.org/x')
+
+    expect(openExternal).toHaveBeenCalledExactlyOnceWith('https://example.org/x')
+    expect($previewTabs.get()).toHaveLength(0)
+  })
+
+  it.each(['https://example.org/a?b=1', 'http://localhost:5173/'])(
+    'an agent preview.open of %s (openPreview) opens nothing: it offers a link',
+    url => {
+      const openExternal = installBridge()
+
+      openPreview({ kind: 'url', label: 'x', source: url, url })
+
+      expect(openExternal).not.toHaveBeenCalled()
+      expect($previewTabs.get()).toHaveLength(0)
+
+      const offer = $notifications.get().find(item => item.message === url)
+
+      expect(offer?.action).toBeDefined()
+
+      // Only the user's click on the offer opens it.
+      offer?.action?.onClick()
+
+      expect(openExternal).toHaveBeenCalledExactlyOnceWith(url)
+    }
+  )
+
+  it('a user click that previews a web page (openPreviewFromClick) opens it externally', () => {
+    const openExternal = installBridge()
+
+    openPreviewFromClick({ kind: 'url', label: 'x', source: 'http://localhost:5173/', url: 'http://localhost:5173/' })
+
+    expect(openExternal).toHaveBeenCalledExactlyOnceWith('http://localhost:5173/')
+    expect($previewTabs.get()).toHaveLength(0)
+  })
+
+  it('keeps the blank Browser the user opens and file previews in the pane', () => {
+    const openExternal = installBridge()
+
+    openBrowserTab()
+    openPreview({ kind: 'file', label: 'a.txt', previewKind: 'text', source: '/tmp/a.txt', url: 'file:///tmp/a.txt' })
+
+    expect(openExternal).not.toHaveBeenCalled()
+    expect($previewTabs.get().map(tab => tab.target.url)).toEqual(['about:blank', 'file:///tmp/a.txt'])
+  })
+
+  it('drops web-page tabs persisted by an older build', () => {
+    const tabs = decodePreviewTabs(
+      JSON.stringify([
+        { id: 'url:1', pinned: true, target: { kind: 'url', label: 'x', source: 'https://a.example', url: 'https://a.example' } },
+        { id: 'file:2', pinned: true, target: { kind: 'file', label: 'b', source: '/b', url: 'file:///b' } }
+      ])
+    )
+
+    expect(tabs.map(tab => tab.id)).toEqual(['file:2'])
+  })
+
+  it("counts the agent's preview input as its own for a settle window", () => {
+    const start = Date.now()
+    expect(agentDrivingPreview(start)).toBe(false)
+
+    const end = beginAgentPreviewAction()
+    expect(agentDrivingPreview(start + 60_000)).toBe(true)
+    end()
+    end()
+    const after = Date.now()
+    expect(agentDrivingPreview(after + AGENT_INPUT_SETTLE_MS - 50)).toBe(true)
+    expect(agentDrivingPreview(after + AGENT_INPUT_SETTLE_MS + 50)).toBe(false)
+
+    noteAgentPreviewInput()
+    expect(agentDrivingPreview()).toBe(true)
+    expect(agentDrivingPreview(Date.now() + AGENT_INPUT_SETTLE_MS + 50)).toBe(false)
+  })
+})
