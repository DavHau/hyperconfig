+import { createHash } from 'node:crypto'
+import { EventEmitter } from 'node:events'
+import http from 'node:http'
+import type { AddressInfo } from 'node:net'
+
+import { afterEach, describe, expect, it } from 'vitest'
+
+import { decodedResponseBody } from './api-transport'
+import { JsonRevalidationCache } from './json-revalidation'
+import { wireOauthSessionResponse } from './oauth-session-response'
+
+// A history endpoint that behaves like the patched dashboard: the ETag is the
+// hash of the body it would send now, and If-None-Match on it gets a 304.
+function historyServer(state: { messages: unknown[]; failNext?: number }) {
+  const log: { status: number; bytes: number; inm: string }[] = []
+
+  const server = http.createServer((req, res) => {
+    const inm = String(req.headers['if-none-match'] || '')
+
+    if (state.failNext) {
+      res.statusCode = state.failNext
+      state.failNext = 0
+      res.end('{"detail":"boom"}')
+      log.push({ status: res.statusCode, bytes: 17, inm })
+
+      return
+    }
+
+    const body = JSON.stringify({ session_id: 's1', messages: state.messages })
+    const etag = `W/"${createHash('sha256').update(body).digest('hex').slice(0, 32)}"`
+    res.setHeader('ETag', etag)
+
+    if (inm.split(',').map(t => t.trim()).includes(etag)) {
+      res.statusCode = 304
+      res.end()
+      log.push({ status: 304, bytes: 0, inm })
+
+      return
+    }
+
+    res.setHeader('Content-Type', 'application/json')
+    res.end(body)
+    log.push({ status: 200, bytes: body.length, inm })
+  })
+
+  return { server, log }
+}
+
+let open: http.Server | null = null
+
+afterEach(async () => {
+  await new Promise(resolve => (open ? open.close(resolve) : resolve(undefined)))
+  open = null
+})
+
+function listen(server: http.Server): Promise<string> {
+  open = server
+
+  return new Promise(resolve =>
+    server.listen(0, '127.0.0.1', () => resolve(`http://127.0.0.1:${(server.address() as AddressInfo).port}/m`))
+  )
+}
+
+// The same steps fetchJson takes: tag -> If-None-Match -> settle -> parse,
+// with the unconditional re-read when a 304 can't be answered.
+function read(cache: JsonRevalidationCache, url: string, opts: { revalidate?: boolean } = {}): Promise<any> {
+  const sentTag = opts.revalidate === false ? '' : cache.tagFor('GET', url)
+
+  return new Promise((resolve, reject) => {
+    const req = http.request(url, { headers: sentTag ? { 'If-None-Match': sentTag } : {} }, res => {
+      const chunks: Buffer[] = []
+      const body = decodedResponseBody(res)
+      body.on('data', chunk => chunks.push(chunk))
+      body.on('error', reject)
+      body.on('end', () => {
+        const settled = cache.settle('GET', url, res.statusCode || 500, res.headers as any, Buffer.concat(chunks).toString('utf8'), sentTag)
+
+        if (!settled) {
+          resolve(read(cache, url, { revalidate: false }))
+
+          return
+        }
+
+        if (settled.statusCode >= 300) {
+          reject(new Error(`${settled.statusCode}: ${settled.text}`))
+
+          return
+        }
+
+        try {
+          resolve(JSON.parse(settled.text))
+        } catch (error) {
+          cache.forget(url)
+          reject(error)
+        }
+      })
+    })
+    req.on('error', reject)
+    req.end()
+  })
+}
+
+describe('conditional history reads', () => {
+  it('an unchanged page costs a bodiless 304 and returns the same page', async () => {
+    const state = { messages: [{ id: 1, role: 'user', content: 'hi' }] }
+    const { server, log } = historyServer(state)
+    const url = await listen(server)
+    const cache = new JsonRevalidationCache()
+
+    const first = await read(cache, url)
+    const second = await read(cache, url)
+    const third = await read(cache, url)
+
+    expect(second).toEqual(first)
+    expect(third).toEqual(first)
+    expect(log.map(r => r.status)).toEqual([200, 304, 304])
+    expect(log[1].inm).toMatch(/^W\/"/)
+    expect(log.slice(1).every(r => r.bytes === 0)).toBe(true)
+  })
+
+  it('never misses a change: appends, tool-only rows, edits, deletions, a rewritten history', async () => {
+    const state: { messages: any[] } = { messages: [{ id: 1, role: 'user', content: 'hi' }] }
+    const { server, log } = historyServer(state)
+    const url = await listen(server)
+    const cache = new JsonRevalidationCache()
+    await read(cache, url)
+
+    const changes: [string, () => void][] = [
+      ['append', () => state.messages.push({ id: 2, role: 'assistant', content: 'hello' })],
+      ['tool call only', () => state.messages.push({ id: 3, role: 'assistant', content: null, tool_calls: [{ id: 'c' }] })],
+      ['tool result', () => state.messages.push({ id: 4, role: 'tool', content: 'ok' })],
+      ['in-place edit, same ids and count', () => (state.messages[0] = { ...state.messages[0], content: 'hi (edited)' })],
+      ['deletion', () => state.messages.splice(1, 1)],
+      ['compaction rewrites everything', () => (state.messages = [{ id: 9, role: 'user', content: 'summary' }])]
+    ]
+
+    for (const [what, change] of changes) {
+      change()
+      const page = await read(cache, url)
+      expect(page.messages, what).toEqual(state.messages)
+      expect(log.at(-1)!.status, what).toBe(200)
+      // And while nothing changes again, the next tick is a 304 of the new page.
+      expect((await read(cache, url)).messages, what).toEqual(state.messages)
+      expect(log.at(-1)!.status, what).toBe(304)
+    }
+  })
+
+  it('an error drops the held page, so the next read is a full one', async () => {
+    const state: { messages: any[]; failNext?: number } = { messages: [{ id: 1 }] }
+    const { server, log } = historyServer(state)
+    const url = await listen(server)
+    const cache = new JsonRevalidationCache()
+    await read(cache, url)
+
+    state.failNext = 503
+    await expect(read(cache, url)).rejects.toThrow('503')
+    expect(cache.size).toBe(0)
+
+    await read(cache, url)
+    expect(log.at(-1)).toMatchObject({ status: 200, inm: '' })
+  })
+
+  it('a 304 for a page no longer held reads it again in full', async () => {
+    const state = { messages: [{ id: 1 }] }
+    const { server, log } = historyServer(state)
+    const url = await listen(server)
+    const cache = new JsonRevalidationCache()
+    await read(cache, url)
+    const tag = cache.tagFor('GET', url)
+
+    // Gone between the request and its answer (evicted, forgotten).
+    expect(cache.settle('GET', url, 304, {}, '', tag)).not.toBeNull()
+    cache.forget(url)
+    expect(cache.settle('GET', url, 304, {}, '', tag)).toBeNull()
+
+    // A 304 nobody asked for (a proxy answering on its own) is not answered
+    // from the cache: it passes through as the 3xx it is.
+    expect(cache.settle('GET', url, 304, {}, '', '')).toEqual({ statusCode: 304, text: '' })
+
+    expect((await read(cache, url)).messages).toEqual(state.messages)
+    expect(log.at(-1)).toMatchObject({ status: 200, inm: '' })
+  })
+})
+
+describe('a server that always answers 304', () => {
+  it('rejects after at most one extra request, never loops', async () => {
+    const cache = new JsonRevalidationCache()
+    let requests = 0
+    let url = ''
+    const server = http.createServer((_req, res) => {
+      requests += 1
+      res.setHeader('ETag', 'W/"same"')
+
+      if (requests === 1) {
+        res.end('{"messages":[]}')
+
+        return
+      }
+
+      // The held body disappears while the conditional request is in flight.
+      cache.forget(url)
+      res.statusCode = 304
+      res.end()
+    })
+    url = await listen(server)
+    await read(cache, url)
+
+    // Our tag's 304 with nothing held: one unconditional re-read, which this
+    // server also answers 304: a 3xx rejection, not another request.
+    await expect(read(cache, url)).rejects.toThrow('304')
+    expect(requests).toBe(3)
+
+    // A plain read answered 304 (a caller's own validator, a proxy): one request.
+    await expect(read(cache, url)).rejects.toThrow('304')
+    expect(requests).toBe(4)
+  })
+})
+
+describe('JsonRevalidationCache', () => {
+  it('only conditions GETs and only holds tagged 2xx bodies', () => {
+    const cache = new JsonRevalidationCache()
+    cache.settle('GET', 'u', 200, { ETag: 'W/"a"' }, '{}', '')
+    expect(cache.tagFor('GET', 'u')).toBe('W/"a"')
+    expect(cache.tagFor('POST', 'u')).toBe('')
+    expect(cache.settle('POST', 'u', 304, {}, '', '')).toEqual({ statusCode: 304, text: '' })
+
+    cache.settle('GET', 'u', 200, {}, '{"new":1}', 'W/"a"')
+    expect(cache.tagFor('GET', 'u')).toBe('')
+
+    cache.settle('GET', 'v', 200, { etag: 'W/"b"' }, '{}', '')
+    cache.settle('GET', 'v', 404, { etag: 'W/"b"' }, 'nope', 'W/"b"')
+    expect(cache.tagFor('GET', 'v')).toBe('')
+  })
+
+  it('a 304 to a stale tag (the body changed since it was sent) is not answered from the old body', () => {
+    const cache = new JsonRevalidationCache()
+    cache.settle('GET', 'u', 200, { etag: 'W/"new"' }, '{"v":2}', '')
+    expect(cache.settle('GET', 'u', 304, {}, '', 'W/"old"')).toBeNull()
+  })
+
+  it('bounds what it holds, oldest first', () => {
+    const cache = new JsonRevalidationCache(10, 25)
+    cache.settle('GET', 'big', 200, { etag: 'W/"x"' }, 'x'.repeat(11), '')
+    expect(cache.size).toBe(0)
+    cache.settle('GET', 'a', 200, { etag: 'W/"a"' }, 'a'.repeat(10), '')
+    cache.settle('GET', 'b', 200, { etag: 'W/"b"' }, 'b'.repeat(10), '')
+    cache.settle('GET', 'a', 304, {}, '', 'W/"a"') // a used last
+    cache.settle('GET', 'c', 200, { etag: 'W/"c"' }, 'c'.repeat(10), '')
+    expect(cache.tagFor('GET', 'b')).toBe('')
+    expect(cache.tagFor('GET', 'a')).toBe('W/"a"')
+    expect(cache.tagFor('GET', 'c')).toBe('W/"c"')
+  })
+})
+
