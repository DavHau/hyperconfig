@@ -0,0 +1,166 @@
+/**
+ * Conditional GETs for the main process's JSON reads.
+ *
+ * The renderer re-reads an open chat's history page on every sessions.changed
+ * tick, and that tick fires for any write to the profile's state.db (other
+ * chats, cron, subagents). For a long chat that was the same ~380 KB again
+ * every ~10 s. A backend that tags a response (`ETag`, e.g. the dashboard's
+ * /api/sessions/{id}/messages) is asked `If-None-Match` with the tag of the
+ * body held here; its bodiless 304 is answered from that body, so the caller
+ * sees the same 200 it would have read, minus the transfer.
+ *
+ * Correct by construction: the server decides, from the body it would send
+ * now, whether the held one is still it. Nothing here guesses whether
+ * something changed. A tag-less response, any error status or an unparsable
+ * body drops the entry. A 304 to a tag we sent whose body is no longer held is
+ * read again once, unconditionally, by the caller (see `settle`); a 304 to a
+ * request without our tag passes through as the 3xx it is (callers reject it),
+ * so a server or proxy that always answers 304 costs one extra read at most.
+ *
+ * Sizes count UTF-16 code units (JS string length), not bytes.
+ */
+
+const MAX_ENTRY_CHARS = 8 * 1024 * 1024
+const MAX_TOTAL_CHARS = 32 * 1024 * 1024
+
+type HeaderBag = Record<string, string | string[] | undefined>
+
+interface Entry {
+  etag: string
+  text: string
+}
+
+export interface Settled {
+  statusCode: number
+  text: string
+}
+
+function headerValue(headers: HeaderBag | undefined, name: string): string {
+  if (!headers) {
+    return ''
+  }
+
+  for (const [key, value] of Object.entries(headers)) {
+    if (key.toLowerCase() === name) {
+      return String(Array.isArray(value) ? value[0] : (value ?? '')).trim()
+    }
+  }
+
+  return ''
+}
+
+export function hasHeader(headers: Record<string, unknown> | undefined, name: string): boolean {
+  return Object.keys(headers || {}).some(key => key.toLowerCase() === name.toLowerCase())
+}
+
+export class JsonRevalidationCache {
+  private entries = new Map<string, Entry>()
+  private totalChars = 0
+
+  constructor(
+    private readonly maxEntryChars = MAX_ENTRY_CHARS,
+    private readonly maxTotalChars = MAX_TOTAL_CHARS
+  ) {}
+
+  /** The tag to send as If-None-Match for this read, or '' (not a GET, nothing held). */
+  tagFor(method: string | undefined, url: string): string {
+    if ((method || 'GET').toUpperCase() !== 'GET') {
+      return ''
+    }
+
+    return this.entries.get(url)?.etag || ''
+  }
+
+  /**
+   * The response the caller should go on with. A 304 to the tag sent becomes
+   * a 200 with the held body; `null` means we sent a tag but no longer hold
+   * its body: read again once without one. A 304 without our tag is returned
+   * as is (a 3xx the caller rejects), never re-read.
+   */
+  settle(
+    method: string | undefined,
+    url: string,
+    statusCode: number,
+    headers: HeaderBag | undefined,
+    text: string,
+    sentTag: string
+  ): null | Settled {
+    if ((method || 'GET').toUpperCase() !== 'GET') {
+      return { statusCode, text }
+    }
+
+    if (statusCode === 304) {
+      if (!sentTag) {
+        this.forget(url)
+
+        return { statusCode, text }
+      }
+
+      const entry = this.entries.get(url)
+
+      if (!entry || entry.etag !== sentTag) {
+        this.forget(url)
+
+        return null
+      }
+
+      // Most recently used last: eviction takes the oldest first.
+      this.entries.delete(url)
+      this.entries.set(url, entry)
+
+      return { statusCode: 200, text: entry.text }
+    }
+
+    const etag = headerValue(headers, 'etag')
+
+    if (statusCode >= 200 && statusCode < 300 && etag && text) {
+      this.remember(url, etag, text)
+    } else {
+      this.forget(url)
+    }
+
+    return { statusCode, text }
+  }
+
+  /** Drop what is held for `url` (its body did not parse, the read failed). */
+  forget(url: string): void {
+    const entry = this.entries.get(url)
+
+    if (entry) {
+      this.totalChars -= entry.text.length
+      this.entries.delete(url)
+    }
+  }
+
+  clear(): void {
+    this.entries.clear()
+    this.totalChars = 0
+  }
+
+  get size(): number {
+    return this.entries.size
+  }
+
+  private remember(url: string, etag: string, text: string): void {
+    this.forget(url)
+
+    if (text.length > this.maxEntryChars) {
+      return
+    }
+
+    this.entries.set(url, { etag, text })
+    this.totalChars += text.length
+
+    for (const [key, entry] of this.entries) {
+      if (this.totalChars <= this.maxTotalChars) {
+        break
+      }
+
+      this.totalChars -= entry.text.length
+      this.entries.delete(key)
+    }
+  }
+}
+
+/** The process-wide cache fetchJson and the OAuth-session reads share. */
+export const jsonRevalidation = new JsonRevalidationCache()
