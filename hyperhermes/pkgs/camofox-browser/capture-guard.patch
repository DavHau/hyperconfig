@@ -106,6 +106,51 @@ reporter.startWatchdog(30_000, () => {
 // --- Plugin event bus ---
 const pluginEvents = createPluginEvents();
 
+// hyperhermes: capture guards. Every screenshot (page.screenshot, any route) and every accessibility
+// snapshot / page structure text this server returns goes through them, so a plugin can keep what it
+// knows must not leave the browser out of all of them: the vault-frames plugin masks the fields a
+// vault fill wrote (plugins/vault-frames). A guard that throws refuses the capture (fail closed):
+// the route answers 409 code capture_refused, never the unguarded image or text.
+const captureGuards = [];
+class CaptureRefusedError extends Error {
+  constructor(message) { super(message); this.statusCode = 409; this.code = 'capture_refused'; }
+}
+function registerCaptureGuard(guard) { captureGuards.push(guard); }
+async function captureScreenshot(page, options = {}) {
+  // Never to a file: Playwright would write the unguarded image before a guard could cover it.
+  const { path: _path, ...rest } = options || {};
+  options = rest;
+  let take = (opts) => page.screenshot(opts);
+  for (const guard of captureGuards) {
+    if (!guard.screenshot) continue;
+    const inner = take;
+    take = async (opts) => {
+      try { return await guard.screenshot(page, opts, inner); } catch (err) {
+        if (err instanceof CaptureRefusedError) throw err;
+        throw new CaptureRefusedError(`screenshot refused: ${err.message}`);
+      }
+    };
+  }
+  return take(options);
+}
+async function captureText(page, text) {
+  let out = text;
+  for (const guard of captureGuards) {
+    if (!guard.text || typeof out !== 'string' || !out) continue;
+    try { out = await guard.text(page, out); } catch (err) {
+      throw new CaptureRefusedError(`snapshot refused: ${err.message}`);
+    }
+  }
+  return out;
+}
+async function captureStructure(page, structure) {
+  if (!structure || !captureGuards.some((g) => g.text)) return structure;
+  const text = await captureText(page, JSON.stringify(structure));
+  try { return JSON.parse(text); } catch {
+    throw new CaptureRefusedError('snapshot refused: the page structure could not be masked');
+  }
+}
+
 // --- Shared auth middleware ---
 const authMiddleware = () => requireAuth(CONFIG);
 
