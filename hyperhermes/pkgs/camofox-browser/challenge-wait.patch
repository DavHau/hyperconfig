+
+// Every step of the wait is a Juggler call, and Juggler may be slow to
+// answer one or not answer at all: it waits for the renderer to ack each
+// mouse event (Camoufox before 156 waited for good on one dropped at the
+// content's edge, 156 gives up after 5 s). So each step gets a few
+// seconds, never past the wait's deadline; one that runs out counts as
+// not known.
+const CHALLENGE_PROBE_TIMEOUT_MS = 3000;
+const PROBE_TIMED_OUT = Symbol('challenge probe timed out');
+
+// The step's value, null when it fails, PROBE_TIMED_OUT when it runs out.
+function challengeProbe(promise, deadline) {
+  let timer;
+  const ms = Math.max(0, Math.min(CHALLENGE_PROBE_TIMEOUT_MS, deadline - Date.now()));
+  const timedOut = new Promise((resolve) => { timer = setTimeout(resolve, ms, PROBE_TIMED_OUT); });
+  return Promise.race([promise.catch(() => null), timedOut]).finally(() => clearTimeout(timer));
+}
+
+function sleepUntil(ms, deadline) {
+  return new Promise((resolve) => setTimeout(resolve, Math.max(0, Math.min(ms, deadline - Date.now()))));
+}
+
+// Cloudflare's "Just a moment" and similar non-interactive checks run a
+// script, set a clearance cookie and reload into the real page. Camoufox
+// evaluates in an isolated world, so page globals (_cf_chl_opt) are read
+// from the script text. null when the document cannot be read in time
+// (mid-navigation).
+async function isChallengePage(page, deadline) {
+  const verdict = await challengeProbe(page.evaluate(() => {
+    const title = (document.title || '').toLowerCase();
+    return /^(just a moment|checking your browser|one moment, please|vercel security checkpoint)/.test(title)
+      || [...document.scripts].some((s) => s.textContent.includes('_cf_chl_opt'));
+  }), deadline);
+  return typeof verdict === 'boolean' ? verdict : null;
+}
+
+// Cloudflare's managed challenge can ask for a click on its Turnstile box.
+// The box is in a cross-origin frame attached inside a closed shadow root,
+// out of reach of any selector; the frame tree still lists the frame, and
+// its host element's box says where on screen the checkbox is (16 px margin
+// plus half the 24 px box from the frame's left edge, vertically centred).
+const TURNSTILE_HOST = 'challenges.cloudflare.com';
+const TURNSTILE_MAX_CLICKS = 3;
+const TURNSTILE_CLICK_GAP_MS = 8000;
+// A click is begun only with this much of the wait left, so that the
+// deadline does not cut it between press and release.
+const TURNSTILE_CLICK_MIN_MS = 4000;
+
+async function turnstileBox(page, deadline) {
+  for (const frame of page.frames()) {
+    if (!frame.url().includes(TURNSTILE_HOST)) continue;
+    const el = await challengeProbe(frame.frameElement(), deadline);
+    if (!el || el === PROBE_TIMED_OUT) continue;
+    const box = await challengeProbe(el.boundingBox(), deadline);
+    if (box && box !== PROBE_TIMED_OUT && box.width >= 150 && box.height >= 40) return box;
+  }
+  return null;
+}
+
+// false when a mouse step went unanswered. Juggler sends a page's input
+// one event at a time for the whole browser, so that step holds every
+// later mouse event, on any page, for as long as it waits; after a move
+// that went unanswered nothing more is sent, and a press is always
+// followed by its release.
+async function clickTurnstile(page, box, deadline) {
+  const answered = async (step, by) => (await challengeProbe(step, by)) !== PROBE_TIMED_OUT;
+  const jitter = () => (Math.random() - 0.5) * 10;
+  if (!(await answered(page.mouse.move(box.x + 28 + jitter(), box.y + box.height / 2 + jitter()), deadline))) return false;
+  await sleepUntil(150 + Math.random() * 300, deadline);
+  const pressed = await answered(page.mouse.down(), deadline);
+  await sleepUntil(60 + Math.random() * 100, deadline);
+  const released = await answered(page.mouse.up(), Math.max(deadline, Date.now() + 1000));
+  return pressed && released;
+}
+
+// Waits while the page is a challenge interstitial, up to CHALLENGE_WAIT_MS,
+// ticking a Turnstile checkbox when one is drawn; a cleared page then gets
+// at most a second more for its DOM. Returns the response of the document
+// it reloaded into, or null.
+async function waitForChallengeClear(page) {
+  if (CHALLENGE_WAIT_MS <= 0) return null;
+  const started = Date.now();
+  const deadline = started + CHALLENGE_WAIT_MS;
+  if (!(await isChallengePage(page, deadline))) return null;
+  let latest = null;
+  const onResponse = (resp) => {
+    if (resp.request().isNavigationRequest() && resp.frame() === page.mainFrame()) latest = resp;
+  };
+  page.on('response', onResponse);
+  let cleared = false;
+  let clicks = 0;
+  let lastClick = 0;
+  let mouseStuck = false;
+  try {
+    while (!cleared && Date.now() < deadline && !page.isClosed()) {
+      await sleepUntil(1000, deadline);
+      cleared = (await isChallengePage(page, deadline)) === false;
+      if (cleared || mouseStuck || clicks >= TURNSTILE_MAX_CLICKS || Date.now() - lastClick < TURNSTILE_CLICK_GAP_MS) continue;
+      if (!(await turnstileBox(page, deadline))) continue;
+      // A person reads the box before ticking it.
+      await sleepUntil(800 + Math.random() * 1200, deadline);
+      if (deadline - Date.now() < TURNSTILE_CLICK_MIN_MS) continue;
+      const box = await turnstileBox(page, deadline);
+      if (!box) continue;
+      clicks += 1;
+      lastClick = Date.now();
+      mouseStuck = !(await clickTurnstile(page, box, deadline));
+    }
+    if (cleared) {
+      await page.waitForLoadState('domcontentloaded', { timeout: Math.max(1000, deadline - Date.now()) }).catch(() => {});
+    }
+  } finally {
+    page.off('response', onResponse);
+  }
+  log(mouseStuck ? 'warn' : 'info', 'challenge wait', {
+    cleared, turnstileClicks: clicks, mouseStuck, waitedMs: Date.now() - started, url: page.isClosed() ? null : page.url(),
+  });
+  return latest;
 }
 
 
