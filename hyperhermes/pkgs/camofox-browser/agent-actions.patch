+// hyperhermes (agent-actions.patch): click by visible text, for controls no ref reaches (a div with a
+// click handler has no role, so no ref). The smallest visible elements showing `text` (Playwright's
+// getByText; `exact` for the whole text), in the page first, then in its frames; with more than one
+// match `nth` (0-based) picks one, else the error lists them so the caller can.
+class TextMatchError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'TextMatchError';
+    this.code = 'text_not_matched';
+    this.statusCode = 422;
+  }
+}
+
+async function locateByText(page, text, { exact = false, nth } = {}) {
+  const needle = String(text).trim().slice(0, 500);
+  for (const frame of [page.mainFrame(), ...page.frames().filter(f => f !== page.mainFrame())]) {
+    if (frame.isDetached()) continue;
+    const all = frame.getByText(needle, { exact: Boolean(exact) }).filter({ visible: true });
+    const count = await all.count().catch(() => 0);
+    if (count === 0) continue;
+    if (nth !== undefined && nth !== null) {
+      const i = Number(nth);
+      if (!Number.isInteger(i) || i < -count || i >= count) {
+        throw new TextMatchError(`nth ${nth} is out of range: ${count} visible elements show ${JSON.stringify(needle)} (nth 0..${count - 1}, -1 the last).`);
+      }
+      return all.nth(i);
+    }
+    if (count === 1) return all.first();
+    const shown = [];
+    for (let i = 0; i < Math.min(count, 6); i++) {
+      const el = all.nth(i);
+      const tag = await el.evaluate(e => e.tagName.toLowerCase() + (e.getAttribute('role') ? `[role=${e.getAttribute('role')}]` : '')).catch(() => '?');
+      const label = ((await el.innerText({ timeout: 500 }).catch(() => '')) || '').replace(/\s+/g, ' ').slice(0, 60);
+      const box = await el.boundingBox({ timeout: 500 }).catch(() => null);
+      shown.push(`nth ${i}: ${tag} ${JSON.stringify(label)}${box ? ` at y ${Math.round(box.y)}` : ''}`);
+    }
+    throw new TextMatchError(`${count} visible elements show ${JSON.stringify(needle)}; pass nth (0-based, -1 the last) or exact text. ${shown.join('; ')}${count > 6 ? '; ...' : ''}`);
+  }
+  throw new TextMatchError(`No visible element shows ${JSON.stringify(needle)}${exact ? ' exactly' : ''}. Check the snapshot's wording, or scroll it into view.`);
+}
