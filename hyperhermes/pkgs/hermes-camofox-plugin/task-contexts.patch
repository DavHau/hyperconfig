+# hyperhermes (task-contexts.patch): a Camofox userId is one browser context (cookies, storage,
+# logins). The managed identity above is one per profile, so every delegate_task child and cron run
+# of an agent shared it with the agent's own sessions: they logged each other in and out and filled
+# each other's carts. Those tasks now get a context of their own, ``<profile userId>-task-<digest>``,
+# deleted with its persisted state when the task ends (the server's task-contexts plugin also drops
+# it if the task never says so); ``browser_context(context="shared")`` is the explicit opt-in to the
+# profile's persistent context (its logins), ``"own"`` the opt-out for any task.
+# ``browser.camofox.task_contexts: shared`` restores the old sharing for the whole profile.
+TASK_CONTEXT_MARK = "-task-"
+
+
+def task_contexts_enabled(camofox_cfg: Optional[dict[str, Any]] = None) -> bool:
+    cfg = get_camofox_config() if camofox_cfg is None else camofox_cfg
+    return str(cfg.get("task_contexts") or "isolated").strip().lower() != "shared"
+
+
+def _isolated_by_default() -> bool:
+    """A delegate_task child or a cron run: work that runs beside the agent's own sessions."""
+    try:
+        from agent.delegation_context import is_delegated_child_context
+        if is_delegated_child_context():
+            return True
+    except Exception:
+        pass
+    try:
+        from gateway.session_context import get_session_env
+        return str(get_session_env("HERMES_CRON_SESSION", "") or "").strip().lower() in {"1", "true", "yes"}
+    except Exception:
+        return False
+
+
+def task_user_id(profile_user_id: str, task_id: Optional[str]) -> str:
+    digest = uuid.uuid5(uuid.NAMESPACE_URL, f"camofox-task:{profile_user_id}:{task_id or 'default'}").hex[:12]
+    return f"{profile_user_id}{TASK_CONTEXT_MARK}{digest}"
+
+
+_OWNED = re.compile(r"-task-[0-9a-f]{12}(-residential-[a-z]{2})?$|-residential-[a-z]{2}$")
+
+
+def owned_context(user_id: str) -> bool:
+    """A context this task owns (its own or a residential one): deleted, never kept, at task end."""
+    return bool(_OWNED.search(user_id))
+
