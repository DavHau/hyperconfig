+def delete_context(user_id: str) -> None:
+    """Close a context this task owns and remove its persisted storage (the persistence plugin's
+    storage_state route); a server without that route gets the plain session delete."""
+    try:
+        delete(f"/sessions/{user_id}/storage_state")
+    except requests.HTTPError as exc:
+        if exc.response is None or exc.response.status_code != 404:
+            raise
+        delete(f"/sessions/{user_id}")
+
+
+def close_owned_contexts(session: dict[str, Any]) -> Optional[str]:
+    """Delete every context the session owns (its task context, a residential one); returns a
+    warning string on failure."""
+    warning = None
+    for uid in dict.fromkeys((session.get("user_id"), session.get("direct_user_id"))):
+        if uid and owned_context(uid):
+            try:
+                delete_context(uid)
+            except Exception as exc:
+                warning = str(exc)
+    return warning
+
