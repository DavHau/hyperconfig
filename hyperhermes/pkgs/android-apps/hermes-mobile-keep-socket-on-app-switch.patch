             fixture.transport.connectedForTest.set(true)
@@ -625,4 +627,70 @@ class WsTransportTest {
             scope.cancel()
         }
     }
+
+    @Test
+    fun quickAppSwitchKeepsIdleSocketThroughTheGrace() =
+        runTest {
+            val fixture = Fixture(this, testJson)
+            val socket = mockk<WebSocket>(relaxed = true)
+            fixture.transport.connectedForTest.set(true)
+            fixture.transport.webSocketForTest = socket
+            fixture.transport.setConnectionStatusForTest(ConnectionStatus.CONNECTED)
+
+            // Two seconds in another app: the idle socket and its status survive.
+            fixture.transport.setAppForeground(false)
+            advanceTimeBy(2_000)
+            assertTrue(fixture.transport.isConnected)
+            assertEquals(ConnectionStatus.CONNECTED, fixture.transport.connectionStatus.value)
+            // A lease release inside the grace does not close it early either.
+            fixture.transport.disconnectIfIdleInBackground()
+            assertTrue(fixture.transport.isConnected)
+
+            fixture.transport.setAppForeground(true)
+            advanceTimeBy(WsTransport.BACKGROUND_IDLE_GRACE_MS * 2)
+            assertTrue(fixture.transport.isConnected)
+            verify(exactly = 0) { socket.cancel() }
+            verify(exactly = 0) { socket.close(any(), any()) }
+        }
+
+    @Test
+    fun idleSocketIsReleasedOnceTheBackgroundGraceRunsOut() =
+        runTest {
+            val fixture = Fixture(this, testJson)
+            val socket = mockk<WebSocket>(relaxed = true)
+            fixture.transport.connectedForTest.set(true)
+            fixture.transport.webSocketForTest = socket
+            fixture.transport.setConnectionStatusForTest(ConnectionStatus.CONNECTED)
+
+            fixture.transport.setAppForeground(false)
+            advanceTimeBy(WsTransport.BACKGROUND_IDLE_GRACE_MS - 1)
+            assertTrue(fixture.transport.isConnected)
+            advanceTimeBy(2)
+            assertFalse(fixture.transport.isConnected)
+            assertEquals(ConnectionStatus.DISCONNECTED, fixture.transport.connectionStatus.value)
+        }
+
+    @Test
+    fun returningToTheAppDialsAtOnceWhenTheSocketDroppedMeanwhile() =
+        runTest {
+            val fixture = Fixture(this, testJson)
+            fixture.transport.intentionalCloseForTest.set(false)
+            fixture.transport.connectedForTest.set(false)
+            // The OS cut the socket while backgrounded; a backoff redial is pending.
+            fixture.transport.setConnectionStatusForTest(ConnectionStatus.RECONNECTING)
+            every { AuthManager.isAutoReconnect() } returns true
+            fixture.transport.setReconnectBackoffForTest(30_000)
+            fixture.transport.scheduleReconnectForTest()
+
+            var opens = 0
+            assertTrue(fixture.transport.reconnectNowOnForeground { opens++ })
+            assertEquals(1, opens)
+            // No second dial from the cancelled backoff.
+            advanceTimeBy(60_000)
+            assertEquals(1, opens)
+            // Nothing to skip while connected.
+            fixture.transport.connectedForTest.set(true)
+            assertFalse(fixture.transport.reconnectNowOnForeground { opens++ })
+            assertEquals(1, opens)
+        }
 }
