@@ -484,6 +485,7 @@ class WsTransportTest {
     fun observeEventMarksPendingReplyStartAndCompleteRespectingIdlePolicy() =
         runTest {
             val fixture = Fixture(this, testJson)
+            fixture.transport.setBackgroundIdleGraceForTest(0L)
