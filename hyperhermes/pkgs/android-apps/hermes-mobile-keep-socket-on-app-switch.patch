@@ -58,8 +58,14 @@ internal class WsTransport(
         private const val OPEN_SOCKET_IDLE_TIMEOUT_MS = 10_000L
         private const val MAX_OUTBOUND_MESSAGE_BYTES = 16 * 1024 * 1024
         private const val OUTBOUND_DRAIN_TIMEOUT_MS = 60_000L
+
+        /** How long an idle socket outlives the app leaving the foreground. */
+        internal const val BACKGROUND_IDLE_GRACE_MS = 60_000L
     }
 
+    @Volatile
+    private var backgroundIdleGraceMs = BACKGROUND_IDLE_GRACE_MS
+
     private val connectionGeneration = AtomicInteger(0)
 
     internal val currentGeneration: Int get() = connectionGeneration.get()
@@ -100,15 +106,65 @@ internal class WsTransport(
 
     val isConnected: Boolean get() = connected.get()
 
+    /**
+     * A short trip to another app must not cost the connection: the idle
+     * socket is kept for [BACKGROUND_IDLE_GRACE_MS] and only then released.
+     * Coming back reuses a live socket (liveness probe) or, when the OS
+     * dropped it meanwhile (Android cuts a backgrounded app's network about
+     * 5 s after it leaves the foreground), dials at once instead of waiting
+     * out the reconnect backoff.
+     */
     fun setAppForeground(foreground: Boolean) {
         appInForeground.set(foreground)
         if (!foreground) {
-            disconnectIfIdleInBackground()
+            scheduleBackgroundIdleDisconnect()
             return
         }
+        backgroundIdleJob?.cancel()
+        backgroundIdleJob = null
+        if (reconnectNowOnForeground()) return
         connectionHealth.probeLivenessOnWake()
     }
 
+    @Volatile
+    private var backgroundIdleJob: Job? = null
+
+    private fun scheduleBackgroundIdleDisconnect() {
+        backgroundIdleJob?.cancel()
+        backgroundIdleJob = null
+        if (backgroundIdleGraceMs <= 0L) {
+            disconnectIfIdleInBackground(graceElapsed = true)
+            return
+        }
+        backgroundIdleJob =
+            scope.launch {
+                delay(backgroundIdleGraceMs)
+                disconnectIfIdleInBackground(graceElapsed = true)
+            }
+    }
+
+    /** Skips a pending backoff when the user returns; true when a dial was started. */
+    @VisibleForTesting
+    internal fun reconnectNowOnForeground(openReplacement: () -> Unit = ::openSocket): Boolean {
+        val shouldOpen =
+            synchronized(outboundLock) {
+                if (connected.get() ||
+                    intentionalClose.get() ||
+                    _connectionStatus.value != ConnectionStatus.RECONNECTING ||
+                    reconnectJob?.isActive != true ||
+                    !NetworkMonitor.isConnected.value
+                ) {
+                    return@synchronized false
+                }
+                reconnectJob?.cancel()
+                reconnectJob = null
+                reconnectPolicy.reset()
+                true
+            }
+        if (shouldOpen) openReplacement()
+        return shouldOpen
+    }
+
     fun acquireExternalActivityConnectionLease() {
         externalActivityConnectionLease.set(true)
     }
@@ -129,8 +185,15 @@ internal class WsTransport(
 
     internal fun hasBackgroundConnectionLease(): Boolean = backgroundConnectionLease.get()
 
-    fun disconnectIfIdleInBackground() {
+    fun disconnectIfIdleInBackground() = disconnectIfIdleInBackground(graceElapsed = false)
+
+    /**
+     * Releases an idle socket while backgrounded. Before the background grace
+     * has run out (a quick app switch) only the grace timer may close it.
+     */
+    private fun disconnectIfIdleInBackground(graceElapsed: Boolean) {
         synchronized(outboundLock) {
+            if (!graceElapsed && backgroundIdleJob?.isActive == true) return
             if (!appInForeground.get() &&
                 !externalActivityConnectionLease.get() &&
                 !backgroundConnectionLease.get() &&
@@ -896,6 +959,11 @@ internal class WsTransport(
     @VisibleForTesting
     internal fun createListenerForTest(generation: Int): WebSocketListener = WsListenerImpl(generation)
 
+    @VisibleForTesting
+    internal fun setBackgroundIdleGraceForTest(graceMs: Long) {
+        backgroundIdleGraceMs = graceMs
+    }
+
     @VisibleForTesting
     internal fun setConnectionStatusForTest(status: ConnectionStatus) {
         _connectionStatus.value = status
