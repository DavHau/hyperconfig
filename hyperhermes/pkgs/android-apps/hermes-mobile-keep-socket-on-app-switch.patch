 .../m57/hermescontrol/data/ws/WsTransport.kt  | 72 ++++++++++++++++++-
 .../ui/chat/components/ChatComposer.kt        |  5 +-
 .../ws/HermesWsClientCharacterizationTest.kt  |  4 ++
