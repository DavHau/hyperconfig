--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -4,7 +4,155 @@
 #include "llama-memory-recurrent.h"
 
 #include <algorithm>
+#include <cerrno>
 #include <cinttypes>
+#include <cstring>
+#include <exception>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+#include <vector>
+
