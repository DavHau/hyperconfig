     const llama_model_qwen4exp & pmodel;
 
@@ -1043,6 +1230,7 @@ public:
 
     // scratch, reused across set_input() calls
     std::vector<llama_token> prev;
+    std::vector<uint8_t> staging; // direct mode: host side of `data`
 };
 
