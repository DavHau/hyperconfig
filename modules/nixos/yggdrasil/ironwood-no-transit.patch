 		c.pathThrottle = duration
 	}
 }
+
+// WithNoTransit makes this node refuse to carry other nodes' traffic: a
+// traffic packet received from a peer and not addressed to this node is
+// dropped instead of forwarded. Protocol messages (tree
+// announcements, sig requests/responses, bloom filters, path
+// lookups/notifies/broken) are still handled and forwarded, so the node
+// keeps its place in the tree and discovery through it keeps working.
+// (hyperconfig patch, modules/nixos/yggdrasil)
+func WithNoTransit(noTransit bool) Option {
+	return func(c *config) {
+		c.noTransit = noTransit
+	}
+}
