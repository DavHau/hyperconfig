From 6671d89bede8c9fc108b17bb98916170f5657650 Mon Sep 17 00:00:00 2001
From: "Guillaume P." <81244551+gputier@users.noreply.github.com>
Date: Wed, 7 Oct 2026 11:18:19 +0200
Subject: [PATCH] [fix] engines: wikidata, no list as content when an entity
 has no description (#6824)

itemDescription defaulted to [] in get_results. With "list" in
display_type, that empty list was sent as the content of a list result and
ResultContainer.extend raised a TypeError, so the whole wikidata answer of
the query was lost. Default to an empty string instead.

(Upstream commit, tests/ hunk dropped.)
---
 searx/engines/wikidata.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/searx/engines/wikidata.py b/searx/engines/wikidata.py
index 5662dc6dbf54..32a7c0b670d6 100644
--- a/searx/engines/wikidata.py
+++ b/searx/engines/wikidata.py
@@ -167,7 +167,7 @@ def get_results(
     infobox_id_lang: str | None = None
     infobox_urls: list[dict[str, str]] = []
     infobox_attributes: list[dict[str, str]] = []
-    infobox_content = attribute_result.get("itemDescription", [])
+    infobox_content: str = attribute_result.get("itemDescription", "")
     img_src: str | None = None
     img_src_priority = 0
 
