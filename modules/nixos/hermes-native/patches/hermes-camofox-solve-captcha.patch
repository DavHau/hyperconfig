+"""browser_solve_captcha on the Camofox backend: the outcome the server reports, and its refusals.
+
+A fake _post answers POST /tabs/<id>/solve-captcha the way camofox-browser's captcha plugin does.
+"""
+
+import json
+
+import pytest
+import requests
+
+import tools.browser_camofox as bc
+
+
+def _http_error(status, body=None, text="<html>Cannot POST</html>"):
+    resp = requests.Response()
+    resp.status_code = status
+    resp._content = (json.dumps(body) if body is not None else text).encode()
+    return requests.HTTPError(f"{status} error", response=resp)
+
+
+@pytest.fixture
+def camofox(monkeypatch):
+    calls = []
+    answers = []
+
+    def post(path, body, timeout=None):
+        calls.append((path, body, timeout))
+        answer = answers.pop(0)
+        if isinstance(answer, Exception):
+            raise answer
+        return answer
+
+    monkeypatch.setattr(bc, "_post", post)
+    monkeypatch.setattr(bc, "_camofox_private_page_block", lambda *a: None)
+    with bc._sessions_lock:
+        bc._sessions.clear()
+        bc._sessions["a"] = {"user_id": "user-a", "tab_id": "tab-a", "session_key": "task_a",
+                             "managed": False, "adopt_existing_tab": False}
+        bc._sessions["b"] = {"user_id": "user-b", "tab_id": None, "session_key": "task_b",
+                             "managed": False, "adopt_existing_tab": False}
+    yield calls, answers
+    with bc._sessions_lock:
+        bc._sessions.clear()
+
+
+def _call(task):
+    return json.loads(bc.camofox_solve_captcha(task_id=task))
+
+
+def test_reports_a_solve(camofox):
+    calls, answers = camofox
+    answers.append({"ok": True, "status": "solved", "vendor": "recaptcha", "rounds": 3,
+                    "durationMs": 41234, "url": "https://example.com/form"})
+    out = _call("a")
+    assert calls == [("/tabs/tab-a/solve-captcha", {"userId": "user-a"}, bc._CAPTCHA_SOLVE_TIMEOUT_SECONDS)]
+    assert out["success"] is True
+    assert (out["status"], out["vendor"], out["rounds"], out["seconds"]) == ("solved", "recaptcha", 3, 41.2)
+    assert "Submit" in out["next"]
+
+
+@pytest.mark.parametrize("status", ["no_captcha", "failed"])
+def test_reports_no_captcha_and_failure_with_reason(camofox, status):
+    _, answers = camofox
+    answers.append({"ok": True, "status": status, "vendor": None, "rounds": 0, "durationMs": 10500,
+                    "reason": "why", "url": "https://example.com/"})
+    out = _call("a")
+    assert out["success"] is False
+    assert (out["status"], out["reason"]) == (status, "why")
+    assert out["next"] == bc._CAPTCHA_NEXT[status]
+
+
+def test_needs_a_tab(camofox):
+    calls, _ = camofox
+    assert "browser_navigate" in _call("b")["error"]
+    assert calls == []
+
+
+def test_server_without_the_plugin(camofox):
+    _, answers = camofox
+    answers.append(_http_error(404))
+    assert "no captcha solver" in _call("a")["error"]
+
+
+def test_tab_closed_by_timeout_is_forgotten(camofox):
+    _, answers = camofox
+    answers.append(_http_error(410, {"error": "Tab tab-a not found"}))
+    out = _call("a")
+    assert "browser_navigate" in out["error"]
+    assert bc._sessions["a"]["tab_id"] is None
+
+
+def test_unconfigured_server(camofox):
+    _, answers = camofox
+    answers.append(_http_error(503, {"error": "No captcha model is configured"}))
+    assert "No captcha model is configured" in _call("a")["error"]
