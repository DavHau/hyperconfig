+            session["tab_id"] = None
+            return {"success": False, "error": "The browser tab is gone. Call browser_navigate to open the page again."}
+        return {"success": False, "error": f"Camofox evaluate failed: {exc}"}
+    except Exception as exc:
+        return {"success": False, "error": f"Camofox evaluate failed: {exc}"}
