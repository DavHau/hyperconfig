+def _camofox_eval(task_id: str, expression: str) -> Dict[str, Any]:
+    """Evaluate on the task's Camofox tab (POST /tabs/<id>/evaluate, the route browser_console uses).
+
+    The expression rides in the JSON body of an authenticated request to the agent's own server, never in
+    argv, and camofox-browser logs only the result's type, so this path carries secrets as well. It never
