+        yield fake, store
+    with bc._sessions_lock:
+        bc._sessions.clear()
+
+
+def _add(store, origin="https://example.com"):
+    return store.add_item(kind="login", label="Example", origin=origin,
+                          secret={"identifier_type": "email", "identifier": "user@example.com", "password": PASSWORD})
+
+
+def test_origin_is_read_from_the_camofox_tab(camofox):
+    assert bv._current_page_origin("a") == "https://example.com"
