+            raise AssertionError(f"unexpected camofox call {path}")
+        if self.gone:
+            resp = bc.requests.Response()
+            resp.status_code = 404
+            raise bc.requests.HTTPError("404 Client Error: Not Found", response=resp)
+        expr = body["expression"]
+        if expr == "window.location.href":
+            return {"ok": True, "result": self.href}
+        if "const fills" in expr:
+            return {"ok": True, "result": json.dumps({"filled": 1})}
+        if "data-hermes-vault-slot" in expr:
+            return {"ok": True, "result": json.dumps(CONTROLS)}
