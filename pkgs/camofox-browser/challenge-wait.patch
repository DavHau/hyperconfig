+
+// Cloudflare's "Just a moment" and similar non-interactive checks run a
+// script, set a clearance cookie and reload into the real page. Camoufox
+// evaluates in an isolated world, so page globals (_cf_chl_opt) are read
+// from the script text. null when the document cannot be read
+// (mid-navigation).
+async function isChallengePage(page) {
+  return page.evaluate(() => {
+    const title = (document.title || '').toLowerCase();
+    return /^(just a moment|checking your browser|one moment, please|vercel security checkpoint)/.test(title)
+      || [...document.scripts].some((s) => s.textContent.includes('_cf_chl_opt'));
+  }).catch(() => null);
+}
+
+// Cloudflare's managed challenge can ask for a click on its Turnstile box.
+// The box is in a cross-origin frame attached inside a closed shadow root,
+// out of reach of any selector; the frame tree still lists the frame, and
+// its host element's box says where on screen the checkbox is (16 px margin
+// plus half the 24 px box from the frame's left edge, vertically centred).
+const TURNSTILE_HOST = 'challenges.cloudflare.com';
+const TURNSTILE_MAX_CLICKS = 3;
+const TURNSTILE_CLICK_GAP_MS = 8000;
+
+async function turnstileBox(page) {
+  for (const frame of page.frames()) {
+    if (!frame.url().includes(TURNSTILE_HOST)) continue;
+    const box = await frame.frameElement().then((el) => el.boundingBox()).catch(() => null);
+    if (box && box.width >= 150 && box.height >= 40) return box;
+  }
+  return null;
+}
+
+async function clickTurnstile(page, box) {
+  const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+  const jitter = () => (Math.random() - 0.5) * 10;
+  await page.mouse.move(box.x + 28 + jitter(), box.y + box.height / 2 + jitter());
+  await sleep(150 + Math.random() * 300);
+  await page.mouse.down();
+  await sleep(60 + Math.random() * 100);
+  await page.mouse.up();
+}
+
+// Waits while the page is a challenge interstitial, up to CHALLENGE_WAIT_MS,
+// ticking a Turnstile checkbox when one is drawn. Returns the response of
+// the document it reloaded into, or null.
+async function waitForChallengeClear(page) {
+  if (CHALLENGE_WAIT_MS <= 0 || !(await isChallengePage(page))) return null;
+  const started = Date.now();
+  const deadline = started + CHALLENGE_WAIT_MS;
+  let latest = null;
+  const onResponse = (resp) => {
+    if (resp.request().isNavigationRequest() && resp.frame() === page.mainFrame()) latest = resp;
+  };
+  page.on('response', onResponse);
+  let cleared = false;
+  let clicks = 0;
+  let lastClick = 0;
+  try {
+    while (!cleared && Date.now() < deadline && !page.isClosed()) {
+      await new Promise((resolve) => setTimeout(resolve, 1000));
+      cleared = (await isChallengePage(page)) === false;
+      if (cleared || clicks >= TURNSTILE_MAX_CLICKS || Date.now() - lastClick < TURNSTILE_CLICK_GAP_MS) continue;
+      if (!(await turnstileBox(page))) continue;
+      // A person reads the box before ticking it.
+      await new Promise((resolve) => setTimeout(resolve, 800 + Math.random() * 1200));
+      const box = await turnstileBox(page);
+      if (!box) continue;
+      await clickTurnstile(page, box).catch(() => {});
+      clicks += 1;
+      lastClick = Date.now();
+    }
+    if (cleared) {
+      await page.waitForLoadState('domcontentloaded', { timeout: Math.max(1000, deadline - Date.now()) }).catch(() => {});
+    }
+  } finally {
+    page.off('response', onResponse);
+  }
+  log('info', 'challenge wait', { cleared, turnstileClicks: clicks, waitedMs: Date.now() - started, url: page.isClosed() ? null : page.url() });
+  return latest;
 }
 
 
