+
+// Cloudflare's "Just a moment" and similar non-interactive checks run a
+// script, set a clearance cookie and reload into the real page. Camoufox
+// evaluates in an isolated world, so page globals (_cf_chl_opt) are read
+// from the script text. null when the document cannot be read
+// (mid-navigation).
+async function isChallengePage(page) {
+  return page.evaluate(() => {
+    const title = (document.title || '').toLowerCase();
+    return /^(just a moment|checking your browser|one moment, please|vercel security checkpoint)/.test(title)
+      || [...document.scripts].some((s) => s.textContent.includes('_cf_chl_opt'));
+  }).catch(() => null);
+}
+
+// Waits while the page is a challenge interstitial, up to CHALLENGE_WAIT_MS.
+// Returns the response of the document it reloaded into, or null.
+async function waitForChallengeClear(page) {
+  if (CHALLENGE_WAIT_MS <= 0 || !(await isChallengePage(page))) return null;
+  const started = Date.now();
+  const deadline = started + CHALLENGE_WAIT_MS;
+  let latest = null;
+  const onResponse = (resp) => {
+    if (resp.request().isNavigationRequest() && resp.frame() === page.mainFrame()) latest = resp;
+  };
+  page.on('response', onResponse);
+  let cleared = false;
+  try {
+    while (!cleared && Date.now() < deadline && !page.isClosed()) {
+      await new Promise((resolve) => setTimeout(resolve, 1000));
+      cleared = (await isChallengePage(page)) === false;
+    }
+    if (cleared) {
+      await page.waitForLoadState('domcontentloaded', { timeout: Math.max(1000, deadline - Date.now()) }).catch(() => {});
+    }
+  } finally {
+    page.off('response', onResponse);
+  }
+  log('info', 'challenge wait', { cleared, waitedMs: Date.now() - started, url: page.isClosed() ? null : page.url() });
+  return latest;
 }
 
 
