+++ b/src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.busy-steer.test.tsx
@@ -0,0 +1,303 @@
+// Nix, busy-input-steer.patch: a message sent while the agent works goes into
+// the running turn (the agent's display.busy_input_mode), the way the official
+// Hermes Desktop delivers it, instead of waiting in the local queue.
+import { act, render } from "@testing-library/react";
+import { useEffect, useRef, useState, type MutableRefObject } from "react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { DashboardRpcEvent } from "../dashboardGatewayClient";
+import { routeBusyMessage } from "../busySubmit";
+import { dbItemsToChatMessages } from "../sessionHistory";
+import { useDashboardChatTransport } from "./useDashboardChatTransport";
+import { useTranscriptState } from "./useTranscriptState";
+import type { ActiveTurn, ChatMessage } from "../types";
+
+const mock = vi.hoisted(() => ({
+  onEvent: null as ((event: DashboardRpcEvent) => void) | null,
+  onClose: null as (() => void) | null,
+  request: vi.fn(),
+}));
+
+vi.mock("../dashboardGatewayClient", () => ({
+  DashboardGatewayClient: class {
+    activateServerRequests = vi.fn();
+    close = vi.fn();
+    connect = vi.fn(async () => undefined);
+    connected = true;
+    request = mock.request;
+    constructor(
+      options: {
+        onEvent?: (event: DashboardRpcEvent) => void;
+        onClose?: () => void;
+      } = {},
+    ) {
+      mock.onEvent = options.onEvent ?? null;
+      mock.onClose = options.onClose ?? null;
+    }
+  },
+}));
+
+interface Api {
+  isLoading?: boolean;
+  messages?: ChatMessage[];
+  activeTurnRef?: MutableRefObject<ActiveTurn | null>;
+  send?: (text: string) => Promise<boolean>;
+  steer?: (text: string) => Promise<"delivered" | "rejected">;
+}
+
+function Harness({ api }: { api: Api }): null {
+  const { messages, setMessages, messagesRef } = useTranscriptState([
+    { id: "u-1", role: "user", content: "long task", turnId: "turn-1" },
+  ]);
+  const [isLoading, setIsLoading] = useState(false);
+  const activeTurnRef = useRef<ActiveTurn | null>(null);
+  const transport = useDashboardChatTransport({
+    activeTurnRef,
+    contextFolder: null,
+    connectionMode: "remote",
+    enabled: true,
+    fallbackOnUnavailable: false,
+    hermesSessionId: null,
+    messagesRef,
+    model: "m",
+    provider: "p",
+    setHermesSessionId: vi.fn(),
+    setIsLoading,
+    setMessages,
+    setToolProgress: vi.fn(),
+    setUsage: vi.fn(),
+  });
+  useEffect(() => {
+    Object.assign(api, {
+      isLoading,
+      messages,
+      activeTurnRef,
+      send: transport.sendMessage,
+      steer: transport.steerMessage,
+    });
+  });
+  return null;
+}
+
+let busyMode = "steer";
+let steerReply: unknown = { status: "queued" };
+
+async function busyTurn(): Promise<Api> {
+  const api: Api = {};
+  render(<Harness api={api} />);
+  await act(async () => {
+    api.activeTurnRef!.current = {
+      turnId: "turn-1",
+      userId: "u-1",
+      startIndex: 1,
+      status: "running",
+    };
+    expect(await api.send?.("long task")).toBe(true);
+  });
+  return api;
+}
+
+const calls = (method: string): unknown[][] =>
+  mock.request.mock.calls.filter(([m]) => m === method);
+
+describe("busy input steers the running dashboard turn", () => {
+  beforeEach(() => {
+    busyMode = "steer";
+    steerReply = { status: "queued" };
+    mock.request.mockReset();
+    mock.request.mockImplementation(async (method: string) => {
+      if (method === "session.create")
+        return { session_id: "live-1", stored_session_id: "stored-1" };
+      if (method === "model.options")
+        return { model: "m", provider: "p", providers: [] };
+      if (method === "config.get") return { value: busyMode };
+      if (method === "session.steer" || method === "session.redirect") {
+        if (steerReply instanceof Error) throw steerReply;
+        return steerReply;
+      }
+      if (method === "prompt.submit") return { status: "streaming" };
+      if (method === "session.resume")
+        return { session_id: "live-2", stored_session_id: "stored-1" };
+      return {};
+    });
+    Object.defineProperty(window, "hermesAPI", {
+      configurable: true,
+      value: {
+        recordSessionContinuation: vi.fn(async () => true),
+        recordSessionLocalError: vi.fn(async () => true),
+        startDashboard: vi.fn(async () => ({
+          connection: { wsUrl: "ws://127.0.0.1:1" },
+          running: true,
+        })),
+      },
+    });
+  });
+
+  it("delivers via session.steer and shows the message in the transcript", async () => {
+    const api = await busyTurn();
+    await act(async () => {
+      expect(await api.steer?.("  also check the logs ")).toBe("delivered");
+    });
+    expect(calls("config.get")).toEqual([
+      ["config.get", { key: "busy", session_id: "live-1" }],
+    ]);
+    expect(calls("session.steer")).toEqual([
+      ["session.steer", { session_id: "live-1", text: "also check the logs" }],
+    ]);
+    // Never a second prompt.submit: that would start a new turn after this one.
+    expect(calls("prompt.submit")).toHaveLength(1);
+    expect(api.messages?.at(-1)).toMatchObject({
+      role: "user",
+      content: "also check the logs",
+      turnId: "turn-1",
+    });
+  });
+
+  it("uses session.redirect when the agent's busy mode is interrupt", async () => {
+    busyMode = "interrupt";
+    steerReply = { status: "redirected" };
+    const api = await busyTurn();
+    await act(async () => {
+      expect(await api.steer?.("stop, do Y")).toBe("delivered");
+    });
+    expect(calls("session.redirect")).toEqual([
+      ["session.redirect", { session_id: "live-1", text: "stop, do Y" }],
+    ]);
+    expect(calls("session.steer")).toHaveLength(0);
+  });
+
+  it("leaves the message to the local queue in queue mode", async () => {
+    busyMode = "queue";
+    const api = await busyTurn();
+    const before = api.messages?.length;
+    await act(async () => {
+      expect(await api.steer?.("later")).toBe("rejected");
+    });
+    expect(calls("session.steer")).toHaveLength(0);
+    expect(calls("session.redirect")).toHaveLength(0);
+    expect(api.messages?.length).toBe(before);
+  });
+
+  it("reports a refused or failed steer as rejected without a bubble", async () => {
+    const api = await busyTurn();
+    const before = api.messages?.length;
+    steerReply = { status: "rejected" }; // the turn ended meanwhile
+    await act(async () => {
+      expect(await api.steer?.("x")).toBe("rejected");
+    });
+    steerReply = new Error("Hermes dashboard WebSocket closed");
+    await act(async () => {
+      expect(await api.steer?.("y")).toBe("rejected");
+    });
+    expect(api.messages?.length).toBe(before);
+  });
+
+  it("does not steer when no turn of this chat is running", async () => {
+    const api = await busyTurn();
+    await act(async () => {
+      api.activeTurnRef!.current = null;
+      expect(await api.steer?.("hi")).toBe("rejected");
+    });
+    expect(calls("config.get")).toHaveLength(0);
+  });
+
+  it("queues while an approval prompt is pending (the turn is parked on the user)", async () => {
+    const api = await busyTurn();
+    await act(async () => {
+      mock.onEvent?.({
+        type: "approval.request",
+        session_id: "live-1",
+        payload: {
+          request_id: "approval-1",
+          command: "echo synthetic",
+          description: "synthetic approval",
+          choices: ["once", "deny"],
+        },
+      } as DashboardRpcEvent);
+    });
+    await act(async () => {
+      expect(await api.steer?.("after the prompt")).toBe("rejected");
+    });
+    expect(calls("config.get")).toHaveLength(0);
+    expect(calls("session.steer")).toHaveLength(0);
+  });
+
+  it("marks the delivered bubble as sent while working", async () => {
+    const api = await busyTurn();
+    await act(async () => {
+      expect(await api.steer?.("note")).toBe("delivered");
+    });
+    expect(api.messages?.at(-1)).toMatchObject({
+      content: "note",
+      steered: true,
+    });
