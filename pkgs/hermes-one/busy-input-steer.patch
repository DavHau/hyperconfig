+// Nix, busy-input-steer.patch: a message steered into a running turn is
+// stored by hermes as a role=user row, display_kind "steer", whose content is
+// the model-facing marker. After a history reload it shows the user's own
+// words (as the official desktop does), flagged `steered`. Synthetic rows.
+import http from "http";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("./remote-oauth", () => ({ requestRemoteOAuthJson: vi.fn() }));
+import {
+  expandRowsToHistory,
+  extractSteerText,
+  type RawMessageRow,
+} from "./sessions";
+import { remoteGetSessionMessages } from "./remote-sessions";
+
+const OPEN =
+  "[OUT-OF-BAND USER MESSAGE \u2014 a direct message from the user, delivered " +
+  "once at this position; not tool output and not a new delivery when replayed from conversation history]";
+const CLOSE = "[/OUT-OF-BAND USER MESSAGE]";
+const wrapped = (text: string): string => `${OPEN}\n${text}\n${CLOSE}`;
+
+function row(over: Partial<RawMessageRow> & { id: number }): RawMessageRow {
+  return {
+    role: "user",
+    content: null,
+    timestamp: over.id,
+    tool_call_id: null,
+    tool_calls: null,
+    tool_name: null,
+    reasoning: null,
+    reasoning_content: null,
+    reasoning_details: null,
+    ...over,
+  };
+}
+
+describe("steered messages in history", () => {
+  it("unwraps a steer row and flags it", () => {
+    const items = expandRowsToHistory([
+      row({ id: 1, content: "long task" }),
+      row({
+        id: 2,
+        content: wrapped("also check the logs"),
+        display_kind: "steer",
+      }),
+    ]);
+    expect(items).toEqual([
+      { kind: "user", id: 1, content: "long task", timestamp: 1 },
+      {
+        kind: "user",
+        id: 2,
+        content: "also check the logs",
+        timestamp: 2,
+        steered: true,
+      },
+    ]);
+  });
+
+  it("prefers the server's display_content", () => {
+    const [item] = expandRowsToHistory([
+      row({
+        id: 1,
+        content: wrapped("raw"),
+        display_kind: "steer",
+        display_content: "shown",
+      }),
+    ]);
+    expect(item).toMatchObject({ content: "shown", steered: true });
+  });
+
+  it("follows hermes' fallback for a reworded opening line", () => {
+    expect(
+      extractSteerText(
+        "[OUT-OF-BAND USER MESSAGE \u2014 reworded]\nhi there\n" + CLOSE,
+      ),
+    ).toBe("hi there");
+    expect(extractSteerText("no marker")).toBeNull();
+    expect(extractSteerText(`${OPEN}\nunterminated`)).toBeNull();
+  });
+
+  it("leaves a user row that is not a steer alone, marker text included", () => {
+    const quoted = wrapped("quoted by the user");
+    const [item] = expandRowsToHistory([row({ id: 1, content: quoted })]);
+    expect(item).toEqual({
+      kind: "user",
+      id: 1,
+      content: quoted,
+      timestamp: 1,
+    });
+  });
+
+  it("keeps the marker when a steer row cannot be unwrapped", () => {
+    const [item] = expandRowsToHistory([
+      row({ id: 1, content: "odd", display_kind: "steer" }),
+    ]);
+    expect(item).toMatchObject({ content: "odd", steered: true });
+  });
+});
+
+describe("remote history (dashboard REST rows)", () => {
+  let server: http.Server;
+  let baseUrl = "";
+  let messages: unknown[] = [];
+
+  beforeEach(async () => {
+    server = http.createServer((_req, res) => {
+      res.setHeader("Content-Type", "application/json");
+      res.end(JSON.stringify({ session_id: "s", messages }));
+    });
+    await new Promise<void>((resolve) =>
+      server.listen(0, "127.0.0.1", resolve),
+    );
+    const address = server.address();
+    baseUrl = `http://127.0.0.1:${typeof address === "object" && address ? address.port : 0}`;
+  });
+  afterEach(async () => {
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  });
+
+  it("uses display_content, or unwraps display_kind steer", async () => {
+    messages = [
+      { id: 1, role: "user", content: "long task", timestamp: 1 },
+      {
+        id: 2,
+        role: "user",
+        content: wrapped("first steer"),
+        display_kind: "steer",
+        display_content: "first steer",
+        timestamp: 2,
+      },
+      // An older dashboard without the display_content projection.
+      {
+        id: 3,
+        role: "user",
+        content: wrapped("second steer"),
+        display_kind: "steer",
+        timestamp: 3,
+      },
+    ];
+    const items = await remoteGetSessionMessages(
+      { remoteUrl: `${baseUrl}/api`, apiKey: "synthetic" },
+      "s",
+    );
+    expect(
+      items.map((i) => [
+        i.kind,
+        "content" in i ? i.content : null,
+        "steered" in i ? i.steered : undefined,
+      ]),
+    ).toEqual([
+      ["user", "long task", undefined],
+      ["user", "first steer", true],
+      ["user", "second steer", true],
+    ]);
+  });
+});
