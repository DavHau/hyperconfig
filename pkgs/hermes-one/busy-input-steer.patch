+  await waitFor(() => expect(screen.queryByText("saved history")).toBeNull());
+  await act(async () => refuse());
+  expect(document.querySelector(".chat-queue-single")).toBeNull();
+  expect(gateway.request).not.toHaveBeenCalledWith(
+    "prompt.submit",
+    expect.objectContaining({ text: "before the clear" }),
+  );
+  await screen.findByText("chat.steerNotDelivered");
+});
