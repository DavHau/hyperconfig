+      "prompt.submit",
+      expect.anything(),
+    ),
+  );
+}
+async function complete(text = "native completed"): Promise<void> {
+  await act(async () =>
+    gateway.clients.at(-1)?.onEvent?.({
+      type: "message.complete",
+      session_id: "runtime-saved",
+      payload: {
+        text,
+        status: "ok",
+        usage: {
+          input: 1300,
+          output: 250,
+          total: 1550,
+          context_used: 400,
+          context_max: 200000,
+        },
+      },
+    }),
+  );
+}
+
+function busyReplies(mode: string, steerStatus: string): void {
+  const base = gateway.request.getMockImplementation()!;
+  gateway.request.mockImplementation(async (method: string, params) => {
+    if (method === "config.get") return { value: mode };
+    if (method === "session.steer" || method === "session.redirect")
+      return { status: steerStatus, text: params?.text };
+    return base(method, params);
+  });
+}
+
+async function typeWhileBusy(text: string): Promise<void> {
+  const box = screen.getByPlaceholderText("chat.typeMessage");
+  fireEvent.change(box, { target: { value: text } });
+  fireEvent.keyDown(box, { key: "Enter" });
+}
