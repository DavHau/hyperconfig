diff --git a/src/renderer/src/screens/Chat/busySubmit.ts b/src/renderer/src/screens/Chat/busySubmit.ts
new file mode 100644
index 0000000..a7c15b3
--- /dev/null
+++ b/src/renderer/src/screens/Chat/busySubmit.ts
@@ -0,0 +1,31 @@
+import type { Attachment } from "./types";
+
+/**
+ * What to do with a message the user sends while the agent is busy (Nix,
+ * busy-input-steer.patch). Text goes to the running turn first (the
+ * dashboard transport's `steerMessage`, which honours the agent's
+ * `display.busy_input_mode`); only a refusal lands in the local queue. A
+ * message behind an already-queued one, or one with attachments, queues so
+ * the order and the attachments are kept.
+ */
+export async function routeBusyMessage(
+  text: string,
+  attachments: Attachment[],
+  options: {
+    queuedAhead: number;
+    steer?: (text: string) => Promise<"delivered" | "rejected">;
+  },
+): Promise<"delivered" | "queue"> {
+  if (
+    !options.steer ||
+    attachments.length > 0 ||
+    options.queuedAhead > 0 ||
+    !text.trim()
+  )
+    return "queue";
+  try {
+    return (await options.steer(text)) === "delivered" ? "delivered" : "queue";
+  } catch {
+    return "queue";
+  }
+}
