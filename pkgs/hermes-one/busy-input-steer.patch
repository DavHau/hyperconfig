+// Nix, busy-input-steer.patch: hermes stores a mid-turn steer as a role=user
+// row with display_kind "steer" whose content is the model-facing marker
+// (agent/prompt_builder.py STEER_MARKER_OPEN/CLOSE). The official desktop
+// shows the user's own words (hermes_cli/web_routers/sessions.py
+// `display_content`, tui_gateway/session_history.py); so do we. Same
+// extraction as agent/conversation_compression.py
+// _extract_steer_text_from_message, including its fallback for a reworded
+// opening line.
+const STEER_MARKER_OPEN =
+  "[OUT-OF-BAND USER MESSAGE \u2014 a direct message from the user, delivered " +
+  "once at this position; not tool output and not a new delivery when replayed from conversation history]";
+const STEER_FALLBACK_OPEN = "[OUT-OF-BAND USER MESSAGE";
+const STEER_MARKER_CLOSE = "[/OUT-OF-BAND USER MESSAGE]";
+
+export function extractSteerText(text: string): string | null {
+  let start = text.indexOf(STEER_MARKER_OPEN);
+  if (start === -1) {
+    start = text.indexOf(STEER_FALLBACK_OPEN);
+    if (start === -1) return null;
+    const nl = text.indexOf("\n", start);
+    start = nl !== -1 ? nl + 1 : start + STEER_FALLBACK_OPEN.length;
+  } else {
+    start += STEER_MARKER_OPEN.length;
+  }
+  const end = text.indexOf(STEER_MARKER_CLOSE, start);
+  if (end === -1) return null;
+  return text.slice(start, end).trim() || null;
+}
+
+/** The text a user row shows: `display_content` when the server sent one,
+ *  else a steer's own words unwrapped from the marker, else `text`. */
+function userDisplayText(r: RawMessageRow, text: string): string {
+  if (typeof r.display_content === "string" && r.display_content.trim())
+    return r.display_content;
+  if (r.display_kind === "steer") return extractSteerText(text) ?? text;
+  return text;
 }
 
