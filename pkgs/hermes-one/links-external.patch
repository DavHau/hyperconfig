diff --git a/src/renderer/src/components/AgentMarkdown.links-external.test.tsx b/src/renderer/src/components/AgentMarkdown.links-external.test.tsx
new file mode 100644
index 0000000..e178cb2
--- /dev/null
+++ b/src/renderer/src/components/AgentMarkdown.links-external.test.tsx
@@ -0,0 +1,65 @@
+// Nix: every link opens in the system browser, never in an in-app pane.
+// @ts-expect-error Node built-ins are available to Vitest, but not in the
+// renderer's type environment (as in AppearancePane.test.tsx).
+import { readFileSync } from "node:fs";
+// @ts-expect-error See above.
+import { join } from "node:path";
+import { fireEvent, render } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { AgentMarkdown } from "./AgentMarkdown";
+
+vi.mock("./useI18n", () => ({
+  useI18n: () => ({ t: (key: string) => key }),
+}));
+
+vi.mock("./MediaImage", () => ({
+  MediaImage: () => null,
+  DownloadChip: () => null,
+}));
+
+afterEach(() => {
+  Reflect.deleteProperty(window, "hermesAPI");
+});
+
+declare const __dirname: string;
+const root = join(__dirname, "../../../..");
+
+describe("links open externally", () => {
+  it.each(["https://example.org/a?b=1", "http://example.org/", "mailto:x@example.org"])(
+    "a markdown link to %s goes to openExternal, not the web preview",
+    (href: string) => {
+      const openExternal = vi.fn().mockResolvedValue(undefined);
+      Object.defineProperty(window, "hermesAPI", {
+        configurable: true,
+        value: { openExternal },
+      });
+      const preview = vi.fn();
+      document.addEventListener("web-preview:navigate", preview);
+      const { getByText } = render(
+        <AgentMarkdown>{`[the link](${href})`}</AgentMarkdown>,
+      );
+      fireEvent.click(getByText("the link"));
+      document.removeEventListener("web-preview:navigate", preview);
+      expect(openExternal).toHaveBeenCalledWith(href);
+      expect(preview).not.toHaveBeenCalled();
+    },
+  );
+
+  it("the main window has no <webview> and nothing auto-opens a preview", () => {
+    const start = readFileSync(join(root, "src/main/app/start.ts"), "utf8");
+    expect(start).toContain("webviewTag: false");
+    expect(start).not.toContain("webviewTag: true");
+    const ipc = readFileSync(
+      join(root, "src/renderer/src/screens/Chat/hooks/useChatIPC.ts"),
+      "utf8",
+    );
+    expect(ipc).not.toContain("web-preview:navigate");
+    const chat = readFileSync(
+      join(root, "src/renderer/src/screens/Chat/Chat.tsx"),
+      "utf8",
+    );
+    expect(chat).not.toContain("<WebPreviewPanel");
+    // Only a click opens the system browser: no event listener does it.
+    expect(chat).not.toContain("web-preview:navigate");
+  });
+});
