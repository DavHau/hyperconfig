+import { memo, useEffect, useMemo, useRef, useState } from "react";
+import { ChevronRight, Wrench } from "../../assets/icons";
+import { OrbLoader } from "../../components/OrbLoader";
+import { HermesAvatar, AvatarSpacer } from "./MessageRow";
+import type { AgentAvatarInfo } from "./MessageRow";
+import { ReasoningRow, ToolActivityGroup } from "./HistoryRow";
+import { useI18n } from "../../components/useI18n";
+import {
+  activityHeadline,
+  failedText,
+  formatToolBreakdown,
+  summarizeActivity,
+  type ActivityItem,
+} from "./activityRuns";
+import type { ToolCallMessage, ToolResultMessage } from "./types";
+
+type ToolItem = ToolCallMessage | ToolResultMessage;
+
+/** Sub-blocks of a run for the expanded view: each reasoning row alone, each
+ *  stretch of tool rows as one tool group (the pre-compact rendering). */
+export function activityBlocks(
+  items: ReadonlyArray<ActivityItem>,
+): (
+  | { kind: "reasoning"; item: Extract<ActivityItem, { kind: "reasoning" }> }
+  | { kind: "tools"; items: ToolItem[] }
+)[] {
+  const blocks: ReturnType<typeof activityBlocks> = [];
+  for (const it of items) {
+    if (it.kind === "reasoning") {
+      blocks.push({ kind: "reasoning", item: it });
+      continue;
+    }
+    const last = blocks[blocks.length - 1];
+    if (last?.kind === "tools") last.items.push(it);
+    else blocks.push({ kind: "tools", items: [it] });
+  }
+  return blocks;
+}
+
+/**
+ * One compact row for a whole run of thoughts and tool calls ("Worked for
+ * 2m 14s · 14 thoughts · 18 tool calls  Terminal ×7, Write File …"),
+ * collapsed by default. Expanding shows the detailed list, where every
+ * thought and tool step still expands on its own. While the turn is running
+ * the row shows a live timer and the current activity instead of a growing
+ * list.
+ */
+export const ActivityRun = memo(function ActivityRun({
+  items,
+  active = false,
+  showAvatar = true,
+  agent,
+  durationMs,
+  startedAtMs,
+}: {
+  items: ActivityItem[];
+  active?: boolean;
+  showAvatar?: boolean;
+  agent?: AgentAvatarInfo;
+  /** Recorded duration (from message timestamps), if known. */
+  durationMs?: number;
+  /** When the run started (epoch ms, from the rows' timestamps), so the live
+   *  timer shows the real elapsed time even when the chat is reopened
+   *  mid-turn. Without it the timer counts from first render. */
+  startedAtMs?: number;
+}): React.JSX.Element {
+  const { t } = useI18n();
+  const summary = useMemo(() => summarizeActivity(items), [items]);
+  // A run with a failed tool call starts expanded, so the failure is seen.
+  const [open, setOpen] = useState(() => summary.failed > 0);
+  const hadFailure = useRef(summary.failed > 0);
+  useEffect(() => {
+    // A failure arriving while the run streams opens it once; the user can
+    // collapse it again.
+    if (summary.failed > 0 && !hadFailure.current) {
+      hadFailure.current = true;
+      setOpen(true);
+    }
+  }, [summary.failed]);
+
+  // Live timer: from the run's start (its rows' timestamps), else from when
+  // this run first rendered while active; it freezes when the run ends
+  // (until a recorded duration replaces it).
+  const renderedAt = useRef<number | null>(active ? Date.now() : null);
+  const [now, setNow] = useState(() => Date.now());
+  useEffect(() => {
+    if (!active) return;
+    if (renderedAt.current === null) renderedAt.current = Date.now();
+    setNow(Date.now());
+    const timer = setInterval(() => setNow(Date.now()), 1000);
+    return () => {
+      clearInterval(timer);
+      setNow(Date.now());
+    };
+  }, [active]);
+  const startMs = startedAtMs ?? renderedAt.current;
+  const liveMs = startMs === null ? undefined : Math.max(0, now - startMs);
+
+  const headline = activityHeadline(
+    summary,
+    { active, durationMs: durationMs ?? liveMs },
+    t,
+  );
+  const failed = failedText(summary, t);
+  const breakdown = useMemo(
+    () => formatToolBreakdown(summary.tools),
+    [summary.tools],
+  );
+  const blocks = useMemo(
+    () => (open ? activityBlocks(items) : []),
+    [open, items],
+  );
+
+  return (
+    <div
+      className={`chat-message chat-message-agent chat-message-history${
+        showAvatar ? "" : " chat-message--grouped"
+      }`}
+    >
+      {showAvatar ? (
+        <HermesAvatar active={active} agent={agent} />
+      ) : (
+        <AvatarSpacer />
+      )}
+      <div
+        className={`chat-tool-group chat-activity-run${
+          active ? " chat-tool-group--active" : ""
+        }`}
+        data-testid="activity-run"
+      >
+        <button
+          type="button"
+          className="chat-tool-group-summary"
+          aria-expanded={open}
+          onClick={() => setOpen((o) => !o)}
+        >
+          {active ? (
+            <OrbLoader
+              state="working"
+              size={20}
+              aria-label="activity-loading"
+              className="chat-tool-group-spinner"
+            />
+          ) : (
+            <Wrench size={13} className="chat-tool-group-icon" />
+          )}
+          <span className="chat-tool-group-name chat-activity-run-headline">
+            {headline}
+          </span>
+          {failed && (
+            <span
+              className="chat-activity-run-failed"
+              data-testid="activity-run-failed"
+            >
+              · {failed}
+            </span>
+          )}
+          {breakdown && (
+            <span className="chat-tool-group-detail">{breakdown}</span>
+          )}
+          <ChevronRight
+            size={14}
+            className={`chat-tool-group-chevron${
+              open ? " chat-tool-group-chevron--open" : ""
+            }`}
+          />
+        </button>
+        <div
+          className={`chat-tool-collapse${open ? " chat-tool-collapse--open" : ""}`}
+        >
+          <div className="chat-tool-collapse-inner">
+            <div className="chat-activity-run-items">
+              {blocks.map((b, index) =>
+                b.kind === "reasoning" ? (
+                  <ReasoningRow
+                    key={`${b.item.id}-${index}`}
+                    msg={b.item}
+                    active={active && index === blocks.length - 1}
+                    embedded
+                  />
+                ) : (
+                  <ToolActivityGroup
+                    key={`${b.items[0].id}-${index}`}
+                    items={b.items}
+                    active={active && index === blocks.length - 1}
+                    embedded
+                  />
+                ),
+              )}
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+});
