+      // The activity row's own strings in English; other keys stay keys.
+      t: (key: string, vars?: Record<string, unknown>) =>
+        key.startsWith("chat.activity.") ? englishActivityT(key, vars) : key,
+      locale: "en",
+      setLocale: vi.fn(),
+    }),
+  };
+});
+
+import {
+  activityHeadline,
+  formatToolBreakdown,
+  isCompactableRun,
