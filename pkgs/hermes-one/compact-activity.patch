+/* Activity runs: the compact view of an agent turn's work.
+ *
+ * A turn streams as reasoning ("Thought") rows interleaved with tool
+ * calls/results. Rendered one-to-one that is a long ladder of one-line rows
+ * before the answer. Instead, every run of consecutive reasoning/tool rows
+ * folds into a single summary ("Worked for 2m 14s · 14 thoughts · 18 tool
+ * calls (Terminal ×7, …)"), expandable to the detailed list. Any other row
+ * (answer text, user message, approval/clarify card) ends the run.
+ */
+import chatEn from "../../../../shared/i18n/locales/en/chat";
+import { humanizeToolName } from "../../components/toolMeta";
+import type {
+  ChatMessage,
+  ReasoningMessage,
+  ToolCallMessage,
+  ToolResultMessage,
+} from "./types";
+
+export type ActivityItem = ReasoningMessage | ToolCallMessage | ToolResultMessage;
+
+export function isActivityRow(m: ChatMessage | undefined): m is ActivityItem {
+  const k = (m as { kind?: string } | undefined)?.kind;
+  return k === "reasoning" || k === "tool_call" || k === "tool_result";
+}
+
+/** Did a tool result report a failure? Hermes stores tool output as JSON:
+ *  `error` set, `is_error`/`success: false`, `status: "failed"|"error"`, or a
+ *  non-zero `exit_code` (unless the tool says it is not an error, e.g. grep's
+ *  "No matches found"). Non-JSON output is never judged failed. */
+export function toolResultFailed(content: string | undefined): boolean {
+  const text = content?.trim();
+  if (!text || text[0] !== "{") return false;
+  let v: unknown;
+  try {
+    v = JSON.parse(text);
+  } catch {
+    return false;
+  }
+  if (!v || typeof v !== "object" || Array.isArray(v)) return false;
+  const o = v as Record<string, unknown>;
+  if (o.is_error === true || o.isError === true || o.success === false) {
+    return true;
+  }
+  const status = typeof o.status === "string" ? o.status.toLowerCase() : "";
+  if (status === "failed" || status === "error") return true;
+  const err = o.error;
+  if (err && (typeof err !== "string" || err.trim() !== "")) return true;
+  const exit = o.exit_code ?? o.exitCode;
+  if (typeof exit === "number" && exit !== 0) {
+    const meaning = typeof o.exit_code_meaning === "string" ? o.exit_code_meaning : "";
+    return !/not an error/i.test(meaning);
+  }
+  return false;
+}
+
+/** A tool item that failed: a live call marked `failed`, or a result (live or
+ *  from history) flagged/judged failed. */
+export function isFailedToolItem(it: ActivityItem): boolean {
+  if (it.kind === "tool_call") return it.status === "failed";
+  if (it.kind === "tool_result") return it.failed ?? toolResultFailed(it.content);
+  return false;
+}
+
+export type ActivityCurrent =
+  | { kind: "thinking" }
+  | { kind: "running"; tool: string }
+  | { kind: "working" };
+
+export interface ActivitySummary {
+  thoughts: number;
+  toolCalls: number;
+  /** Tool calls that failed (a call and its result count once). */
+  failed: number;
+  /** Tool names by call count, most used first (ties: first use first). */
+  tools: { name: string; count: number }[];
+  /** What the run is doing right now (only meaningful while active). */
+  current: ActivityCurrent;
+}
+
+export function summarizeActivity(items: ReadonlyArray<ActivityItem>): ActivitySummary {
+  let thoughts = 0;
+  const callIds = new Set<string>();
+  for (const it of items) {
+    if (it.kind === "tool_call" && it.callId) callIds.add(it.callId);
+  }
+  const resultIds = new Set<string>();
+  const counts = new Map<string, number>();
+  let toolCalls = 0;
+  const failedIds = new Set<string>();
+  let failedOrphans = 0;
+  const countTool = (name: string): void => {
+    const label = humanizeToolName(name || "tool");
+    counts.set(label, (counts.get(label) ?? 0) + 1);
+    toolCalls++;
+  };
+  for (const it of items) {
+    if (it.kind === "reasoning") {
+      thoughts++;
+      continue;
+    }
+    if (it.kind === "tool_call") {
+      countTool(it.name);
+    } else {
+      if (it.callId) resultIds.add(it.callId);
+      // A result whose call is not in this run still stands for one call.
+      if (!it.callId || !callIds.has(it.callId)) countTool(it.name);
+    }
+    if (isFailedToolItem(it)) {
+      if (it.callId) failedIds.add(it.callId);
+      else failedOrphans++;
+    }
+  }
+  const tools = [...counts.entries()]
+    .map(([name, count], order) => ({ name, count, order }))
+    .sort((a, b) => b.count - a.count || a.order - b.order)
+    .map(({ name, count }) => ({ name, count }));
+
+  let current: ActivityCurrent = { kind: "working" };
+  const last = items[items.length - 1];
+  if (last?.kind === "reasoning") {
+    current = { kind: "thinking" };
+  } else {
+    for (let i = items.length - 1; i >= 0; i--) {
+      const it = items[i];
+      if (
+        it.kind === "tool_call" &&
+        it.status !== "completed" &&
+        it.status !== "failed" &&
+        !resultIds.has(it.callId)
+      ) {
+        current = { kind: "running", tool: humanizeToolName(it.name || "tool") };
+        break;
+      }
+    }
+  }
+  return {
+    thoughts,
+    toolCalls,
+    failed: failedIds.size + failedOrphans,
+    tools,
+    current,
+  };
+}
+
+/** A run worth folding: more than one step (a call and its result = one).
+ *  Cheap: stops at the second step instead of summarising the run. */
+export function isCompactableRun(items: ReadonlyArray<ActivityItem>): boolean {
+  let steps = 0;
+  let callId: string | undefined;
+  for (const it of items) {
+    // A result right after its own call is the same step.
+    if (it.kind === "tool_result" && it.callId && it.callId === callId) {
+      continue;
+    }
+    callId = it.kind === "tool_call" ? it.callId : undefined;
+    if (++steps > 1) return true;
+  }
+  return false;
+}
+
+export function formatDuration(ms: number): string {
+  const total = Math.max(0, Math.round(ms / 1000));
+  const h = Math.floor(total / 3600);
+  const m = Math.floor((total % 3600) / 60);
+  const s = total % 60;
+  if (h > 0) return `${h}h ${m}m`;
+  if (m > 0) return `${m}m ${s}s`;
+  return `${s}s`;
+}
+
+/** "Terminal ×7, Write File, Vision Analyze …" (at most `max` names). */
+export function formatToolBreakdown(
+  tools: ActivitySummary["tools"],
+  max = 3,
+): string {
+  const shown = tools
+    .slice(0, max)
+    .map((t) => (t.count > 1 ? `${t.name} ×${t.count}` : t.name));
+  return shown.join(", ") + (tools.length > max ? " …" : "");
+}
+
+export type Translate = (key: string, options?: Record<string, unknown>) => string;
+
+/** English `chat.activity.*` strings, for callers without the i18n hook. */
+export const englishActivityT: Translate = (key, options) =>
+  Object.entries(options ?? {}).reduce(
+    (msg, [name, value]) => msg.replaceAll(`{{${name}}}`, String(value)),
+    (key.startsWith("chat.activity.")
+      ? (chatEn.activity as Record<string, string>)[key.slice(14)]
+      : undefined) ?? key,
+  );
+
+export function activityCurrentText(current: ActivityCurrent, t: Translate): string {
+  if (current.kind === "thinking") return t("chat.activity.thinking");
+  if (current.kind === "running") {
+    return t("chat.activity.running", { tool: current.tool });
+  }
+  return t("chat.activity.workingStep");
+}
+
+/** The summary row's headline (the failure count is rendered on its own,
+ *  in the danger colour; see `failedText`). */
+export function activityHeadline(
+  summary: ActivitySummary,
+  opts: { active: boolean; durationMs?: number },
+  t: Translate = englishActivityT,
+): string {
+  const parts: string[] = [];
+  const duration =
+    opts.durationMs !== undefined && opts.durationMs >= 0
+      ? formatDuration(opts.durationMs)
+      : null;
+  if (opts.active) {
+    parts.push(
+      duration
+        ? t("chat.activity.workingFor", { duration })
+        : t("chat.activity.working"),
+    );
+    parts.push(activityCurrentText(summary.current, t));
+  } else {
+    parts.push(
+      duration
+        ? t("chat.activity.workedFor", { duration })
+        : t("chat.activity.worked"),
+    );
+  }
+  const n = (count: number, one: string, many: string): string =>
+    count === 1 ? t(one) : t(many, { count });
+  if (summary.thoughts > 0) {
+    parts.push(n(summary.thoughts, "chat.activity.thought", "chat.activity.thoughts"));
+  }
+  if (summary.toolCalls > 0) {
+    parts.push(n(summary.toolCalls, "chat.activity.toolCall", "chat.activity.toolCalls"));
+  }
+  return parts.join(" · ");
+}
+
+/** "N failed", or "" when nothing failed. */
+export function failedText(summary: ActivitySummary, t: Translate = englishActivityT): string {
+  return summary.failed > 0 ? t("chat.activity.failed", { count: summary.failed }) : "";
+}
+
+/** Epoch ms from a DB/stream timestamp (seconds, ms, or ISO). */
+export function toEpochMs(raw: unknown): number | undefined {
+  if (typeof raw === "string") {
+    const n = Number(raw);
+    raw = Number.isFinite(n) ? n : new Date(raw).getTime();
+  }
+  if (typeof raw !== "number" || !Number.isFinite(raw) || raw <= 0) {
+    return undefined;
+  }
+  return raw < 1e12 ? raw * 1000 : raw;
+}
+
+/** When a run started, for the live timer: the row before it (the user's
+ *  message), else the run's own first timestamp. Undefined for live rows
+ *  that carry none (the timer then counts from first render). */
+export function runStartMs(
+  items: ReadonlyArray<ActivityItem>,
+  before: ChatMessage | undefined,
+): number | undefined {
+  const ts = (m: ChatMessage | undefined): number | undefined =>
+    toEpochMs((m as { timestamp?: unknown } | undefined)?.timestamp);
+  const fromBefore = ts(before);
+  if (fromBefore !== undefined) return fromBefore;
+  for (const it of items) {
+    const t = ts(it);
+    if (t !== undefined) return t;
+  }
+  return undefined;
+}
+
+/** Recorded duration of a finished run: from the row before it (the user's
+ *  message, or earlier answer text) to the row after it (the answer), falling
+ *  back to the run's own first/last timestamps. */
+export function recordedDurationMs(
+  items: ReadonlyArray<ActivityItem>,
+  before: ChatMessage | undefined,
+  after: ChatMessage | undefined,
+): number | undefined {
+  const ts = (m: ChatMessage | undefined): number | undefined =>
+    toEpochMs((m as { timestamp?: unknown } | undefined)?.timestamp);
+  const own = items.map(ts).filter((t): t is number => t !== undefined);
+  const start = ts(before) ?? own[0];
+  const end = ts(after) ?? own[own.length - 1];
+  if (start === undefined || end === undefined || end < start) return undefined;
+  return end - start;
+}
