+import { dbItemsToChatMessages } from "./sessionHistory";
+import type { ChatMessage } from "./types";
+
+afterEach(cleanup);
+
+const user = (id: string, timestamp?: number): ChatMessage =>
+  ({ id, role: "user", content: `ask ${id}`, timestamp }) as ChatMessage;
+const answer = (id: string, timestamp?: number): ChatMessage =>
+  ({ id, role: "agent", content: `answer ${id}`, timestamp }) as ChatMessage;
+const thought = (id: string): ChatMessage =>
+  ({ id, kind: "reasoning", role: "agent", text: `thinking ${id}` }) as ChatMessage;
+const call = (
+  id: string,
+  name = "terminal",
+  status?: "running" | "completed" | "failed",
+): ChatMessage =>
+  ({
+    id,
+    kind: "tool_call",
+    role: "agent",
+    callId: `c-${id}`,
+    name,
+    args: `{"cmd":"${id}"}`,
+    ...(status ? { status } : {}),
+  }) as ChatMessage;
+const result = (
+  id: string,
+  name = "terminal",
+  content = `out ${id}`,
+): ChatMessage =>
+  ({
+    id: `r-${id}`,
+    kind: "tool_result",
+    role: "agent",
+    callId: `c-${id}`,
+    name,
+    content,
+  }) as ChatMessage;
+
+/** A failed call as the live stream delivers it: status "failed". */
+const liveFailedTurn = (): ChatMessage[] => [
+  thought("a"),
