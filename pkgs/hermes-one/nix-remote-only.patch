diff --git a/src/main/remote-oauth-native.ts b/src/main/remote-oauth-native.ts
new file mode 100644
index 0000000..5591fcc
--- /dev/null
+++ b/src/main/remote-oauth-native.ts
@@ -0,0 +1,271 @@
+// hyperconfig: RFC 8252 native sign-in for remote dashboards that advertise
+// `native_pkce` in /api/status `auth_flows`.
+//
+// Upstream signs in inside an embedded Electron window that loads the
+// dashboard's /login. Behind an identity provider that wants a passkey
+// (pocket-id) that window is a dead end: Electron on Linux has no WebAuthn
+// UI for roaming/hybrid authenticators, and a confined container has no
+// hidraw either. Hermes' dashboards broker a native-app login instead:
+// /auth/native/authorize -> the IdP in the user's own browser -> a one-time
+// code on this app's loopback -> /auth/native/token (PKCE-bound) -> tokens.
+// The tokens are then written into the same OAuth cookie partition, under
+// the names the dashboard itself would set, so every other code path
+// (REST through Electron net, WebSocket tickets, refresh via the RT cookie)
+// is upstream's unchanged.
+import http from "http";
+import { createHash, randomBytes } from "crypto";
+import type { CookiesSetDetails } from "electron";
+
+export const NATIVE_LOGIN_TIMEOUT_MS = 5 * 60_000;
+const RT_MAX_AGE_SECONDS = 30 * 24 * 60 * 60;
+
+export interface NativeLoginTokens {
+  access_token: string;
+  refresh_token?: string;
+  expires_at?: number;
+  provider?: string;
+}
+
+export interface NativeLoginDeps {
+  openExternal: (url: string) => Promise<void>;
+  fetchImpl: typeof fetch;
+  setCookie: (details: CookiesSetDetails) => Promise<void>;
+  timeoutMs?: number;
+  now?: () => number;
+}
+
+export class NativeLoginError extends Error {
+  constructor(
+    message: string,
+    readonly code: "oauth_cancelled" | "oauth_request_failed",
+  ) {
+    super(message);
+    this.name = "NativeLoginError";
+  }
+}
+
+function b64url(buf: Buffer): string {
+  return buf
+    .toString("base64")
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+}
+
+export function pkcePair(): { verifier: string; challenge: string } {
+  const verifier = b64url(randomBytes(32));
+  const challenge = b64url(createHash("sha256").update(verifier).digest());
+  return { verifier, challenge };
+}
+
+function gatewayOrigin(baseUrl: string): URL {
+  const url = new URL(baseUrl);
+  if (url.protocol !== "http:" && url.protocol !== "https:") {
+    throw new Error("Remote gateway URL must use HTTP(S).");
+  }
+  if (url.username || url.password) {
+    throw new Error("Native sign-in does not support URL credentials.");
+  }
+  return new URL(url.origin);
+}
+
+/** Whether the gateway offers the native PKCE sign-in. Never throws. */
+export async function remoteSupportsNativeLogin(
+  baseUrl: string,
+  fetchImpl: typeof fetch = fetch,
+): Promise<boolean> {
+  try {
+    const origin = gatewayOrigin(baseUrl);
+    const response = await fetchImpl(new URL("/api/status", origin), {
+      method: "GET",
+      signal: AbortSignal.timeout(8_000),
+    });
+    if (!response.ok) return false;
+    const status = (await response.json()) as { auth_flows?: unknown };
+    return (
+      Array.isArray(status.auth_flows) &&
+      status.auth_flows.includes("native_pkce")
+    );
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * The session cookies the dashboard sets after a cookie login
+ * (hermes_cli/dashboard_auth/cookies.py): `__Host-` names over HTTPS (Path=/,
+ * Secure, host-only), bare names over plain HTTP; HttpOnly, SameSite=Lax.
+ */
+export function sessionCookiesForTokens(
+  baseUrl: string,
+  tokens: NativeLoginTokens,
+  nowSeconds: number,
+): CookiesSetDetails[] {
+  const origin = gatewayOrigin(baseUrl);
+  const https = origin.protocol === "https:";
+  const name = (bare: string): string => (https ? `__Host-${bare}` : bare);
+  const base = {
+    url: `${origin.origin}/`,
+    path: "/",
+    secure: https,
+    httpOnly: true,
+    sameSite: "lax" as const,
+  };
+  const atExpiry =
+    typeof tokens.expires_at === "number" && tokens.expires_at > nowSeconds
+      ? Math.max(nowSeconds + 60, tokens.expires_at)
+      : nowSeconds + 60;
+  const cookies: CookiesSetDetails[] = [
+    {
+      ...base,
+      name: name("hermes_session_at"),
+      value: tokens.access_token,
+      expirationDate: atExpiry,
+    },
+  ];
+  if (tokens.refresh_token) {
+    cookies.push({
+      ...base,
+      name: name("hermes_session_rt"),
+      value: tokens.refresh_token,
+      expirationDate: nowSeconds + RT_MAX_AGE_SECONDS,
+    });
+  }
+  if (tokens.provider) {
+    cookies.push({
+      ...base,
+      name: name("hermes_session_provider"),
+      value: tokens.provider,
+      expirationDate: nowSeconds + RT_MAX_AGE_SECONDS,
+    });
+  }
+  return cookies;
+}
+
+const DONE_PAGE = (host: string): string =>
+  `<!doctype html><meta charset="utf-8"><meta name="color-scheme" content="dark light"><title>Signed in</title>` +
+  `<body style="font-family:sans-serif;padding:2rem">Signed in to ${host.replace(/[^A-Za-z0-9.:-]/g, "")}. You can close this tab and return to Hermes One.</body>`;
+
+/**
+ * Run the native sign-in for `baseUrl`: open the authorize URL in the
+ * user's browser, wait for the loopback redirect, redeem the code, store
+ * the session cookies. Resolves once signed in; rejects on IdP error,
+ * redemption failure or timeout.
+ */
+export function runNativeRemoteLogin(
+  baseUrl: string,
+  deps: NativeLoginDeps,
+): Promise<{ signedIn: true }> {
+  const origin = gatewayOrigin(baseUrl);
+  const { verifier, challenge } = pkcePair();
+  const state = b64url(randomBytes(16));
+  const timeoutMs = deps.timeoutMs ?? NATIVE_LOGIN_TIMEOUT_MS;
+  const now = deps.now ?? (() => Math.floor(Date.now() / 1000));
+
+  return new Promise((resolve, reject) => {
+    let settled = false;
+    const server = http.createServer();
+    const finish = (error?: Error): void => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      server.close();
+      server.closeAllConnections?.();
+      if (error) reject(error);
+      else resolve({ signedIn: true });
+    };
+    const timer = setTimeout(
+      () =>
+        finish(
+          new NativeLoginError(
+            "Remote gateway sign-in timed out.",
+            "oauth_cancelled",
+          ),
+        ),
+      timeoutMs,
+    );
+    timer.unref?.();
+
+    server.on("request", (req, res) => {
+      const url = new URL(req.url ?? "/", "http://127.0.0.1");
+      if (req.method !== "GET" || url.pathname !== "/callback") {
+        res.writeHead(404).end();
+        return;
+      }
+      if (url.searchParams.get("state") !== state) {
+        // Not this sign-in's redirect: ignore it and keep waiting.
+        res.writeHead(400, { "Content-Type": "text/plain" }).end("Unknown sign-in.\n");
+        return;
+      }
+      const error = url.searchParams.get("error");
+      const code = url.searchParams.get("code");
+      if (error || !code) {
+        res.writeHead(400, { "Content-Type": "text/plain" }).end("Sign-in failed.\n");
+        finish(
+          new NativeLoginError(
+            `Remote gateway sign-in failed${error ? `: ${error.slice(0, 80)}` : "."}`,
+            "oauth_request_failed",
+          ),
+        );
+        return;
+      }
+      void (async () => {
+        try {
+          const response = await deps.fetchImpl(
+            new URL("/auth/native/token", origin),
+            {
+              method: "POST",
+              headers: { "Content-Type": "application/json" },
+              body: JSON.stringify({ code, code_verifier: verifier }),
+              signal: AbortSignal.timeout(15_000),
+            },
+          );
+          if (!response.ok) {
+            throw new Error(`token exchange failed (${response.status})`);
+          }
+          const tokens = (await response.json()) as NativeLoginTokens;
+          if (!tokens || typeof tokens.access_token !== "string" || !tokens.access_token) {
+            throw new Error("token exchange returned no access token");
+          }
+          for (const cookie of sessionCookiesForTokens(origin.toString(), tokens, now())) {
+            await deps.setCookie(cookie);
+          }
+          res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" }).end(DONE_PAGE(origin.host));
+          finish();
+        } catch (err) {
+          res.writeHead(400, { "Content-Type": "text/plain" }).end("Sign-in failed.\n");
+          finish(
+            new NativeLoginError(
+              `Remote gateway sign-in failed: ${err instanceof Error ? err.message : String(err)}`,
+              "oauth_request_failed",
+            ),
+          );
+        }
+      })();
+    });
+
+    server.on("error", (err) =>
+      finish(new NativeLoginError(`Sign-in listener failed: ${err.message}`, "oauth_request_failed")),
+    );
+    server.listen(0, "127.0.0.1", () => {
+      const address = server.address();
+      if (!address || typeof address === "string") {
+        finish(new NativeLoginError("Sign-in listener has no port.", "oauth_request_failed"));
+        return;
+      }
+      const authorize = new URL("/auth/native/authorize", origin);
+      authorize.searchParams.set("code_challenge", challenge);
+      authorize.searchParams.set("code_challenge_method", "S256");
+      authorize.searchParams.set("redirect_uri", `http://127.0.0.1:${address.port}/callback`);
+      authorize.searchParams.set("state", state);
+      deps.openExternal(authorize.toString()).catch((err: unknown) =>
+        finish(
+          new NativeLoginError(
+            `Could not open the browser for sign-in: ${err instanceof Error ? err.message : String(err)}`,
+            "oauth_request_failed",
+          ),
+        ),
+      );
+    });
+  });
+}
