diff --git a/tests/remote-oauth-native.test.ts b/tests/remote-oauth-native.test.ts
new file mode 100644
index 0000000..cbfbc44
--- /dev/null
+++ b/tests/remote-oauth-native.test.ts
@@ -0,0 +1,137 @@
+// @vitest-environment node
+// hyperconfig: the native PKCE sign-in (src/main/remote-oauth-native.ts)
+// against a fake dashboard: the authorize URL it opens, the loopback
+// redirect, the code redemption and the cookies it stores.
+import { describe, expect, it, vi } from "vitest";
+import { createHash } from "crypto";
+import http from "http";
+import {
+  remoteSupportsNativeLogin,
+  runNativeRemoteLogin,
+  sessionCookiesForTokens,
+} from "../src/main/remote-oauth-native";
+
+function get(url: string): Promise<{ status: number; body: string }> {
+  return new Promise((resolve, reject) => {
+    http
+      .get(url, (res) => {
+        let body = "";
+        res.on("data", (c) => (body += c));
+        res.on("end", () => resolve({ status: res.statusCode ?? 0, body }));
+      })
+      .on("error", reject);
+  });
+}
+
+function b64urlSha256(value: string): string {
+  return createHash("sha256")
+    .update(value)
+    .digest("base64")
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+}
+
+describe("native remote sign-in", () => {
+  it("detects native_pkce in /api/status", async () => {
+    const yes = vi.fn(async () =>
+      new Response(JSON.stringify({ auth_required: true, auth_flows: ["cookie", "native_pkce"] })),
+    );
+    const no = vi.fn(async () => new Response(JSON.stringify({ auth_required: true, auth_flows: ["cookie"] })));
+    const down = vi.fn(async () => {
+      throw new Error("offline");
+    });
+    expect(await remoteSupportsNativeLogin("https://a.example/v1", yes as unknown as typeof fetch)).toBe(true);
+    expect(String((yes.mock.calls[0] as unknown[])[0])).toBe("https://a.example/api/status");
+    expect(await remoteSupportsNativeLogin("https://a.example", no as unknown as typeof fetch)).toBe(false);
+    expect(await remoteSupportsNativeLogin("https://a.example", down as unknown as typeof fetch)).toBe(false);
+  });
+
+  it("writes the dashboard's own __Host- session cookies over https", () => {
+    const cookies = sessionCookiesForTokens(
+      "https://a.example/",
+      { access_token: "AT", refresh_token: "RT", expires_at: 2000, provider: "self-hosted" },
+      1000,
+    );
+    expect(cookies.map((c) => c.name)).toEqual([
+      "__Host-hermes_session_at",
+      "__Host-hermes_session_rt",
+      "__Host-hermes_session_provider",
+    ]);
+    for (const c of cookies) {
+      expect(c).toMatchObject({ url: "https://a.example/", path: "/", secure: true, httpOnly: true, sameSite: "lax" });
+      expect(c).not.toHaveProperty("domain");
+    }
+    expect(cookies[0].expirationDate).toBe(2000);
+  });
+
+  it("runs authorize -> loopback -> token and stores the session", async () => {
+    let verifierSeen = "";
+    const fetchImpl = vi.fn(async (url: URL | string, init?: RequestInit) => {
+      expect(String(url)).toBe("https://a.example/auth/native/token");
+      const body = JSON.parse(String(init?.body));
+      expect(body.code).toBe("GWCODE");
+      verifierSeen = body.code_verifier;
+      return new Response(
+        JSON.stringify({ access_token: "AT", refresh_token: "RT", expires_at: 5000, provider: "self-hosted" }),
+      );
+    });
+    const setCookie = vi.fn(async () => {});
+    let challenge = "";
+    const openExternal = vi.fn(async (raw: string) => {
+      const u = new URL(raw);
+      expect(u.origin + u.pathname).toBe("https://a.example/auth/native/authorize");
+      expect(u.searchParams.get("code_challenge_method")).toBe("S256");
+      challenge = u.searchParams.get("code_challenge") ?? "";
+      const redirect = new URL(u.searchParams.get("redirect_uri") ?? "");
+      expect(redirect.hostname).toBe("127.0.0.1");
+      expect(redirect.pathname).toBe("/callback");
+      // A redirect with someone else's state is ignored.
+      redirect.searchParams.set("code", "OTHER");
+      redirect.searchParams.set("state", "forged");
+      expect((await get(redirect.toString())).status).toBe(400);
+      redirect.searchParams.set("code", "GWCODE");
+      redirect.searchParams.set("state", u.searchParams.get("state") ?? "");
+      queueMicrotask(() => void get(redirect.toString()));
+    });
+
+    await expect(
+      runNativeRemoteLogin("https://a.example/", { openExternal, fetchImpl: fetchImpl as unknown as typeof fetch, setCookie, now: () => 1000 }),
+    ).resolves.toEqual({ signedIn: true });
+    expect(fetchImpl).toHaveBeenCalledTimes(1);
+    expect(b64urlSha256(verifierSeen)).toBe(challenge);
+    expect(setCookie.mock.calls.map((c) => (c as unknown as [{ name: string; value: string }])[0].name)).toEqual([
+      "__Host-hermes_session_at",
+      "__Host-hermes_session_rt",
+      "__Host-hermes_session_provider",
+    ]);
+  });
+
+  it("fails on an IdP error and stores nothing", async () => {
+    const setCookie = vi.fn(async () => {});
+    const fetchImpl = vi.fn();
+    const openExternal = vi.fn(async (raw: string) => {
+      const u = new URL(raw);
+      const redirect = new URL(u.searchParams.get("redirect_uri") ?? "");
+      redirect.searchParams.set("error", "access_denied");
+      redirect.searchParams.set("state", u.searchParams.get("state") ?? "");
+      queueMicrotask(() => void get(redirect.toString()));
+    });
+    await expect(
+      runNativeRemoteLogin("https://a.example/", { openExternal, fetchImpl: fetchImpl as unknown as typeof fetch, setCookie }),
+    ).rejects.toThrow(/access_denied/);
+    expect(fetchImpl).not.toHaveBeenCalled();
+    expect(setCookie).not.toHaveBeenCalled();
+  });
+
+  it("times out when the browser never comes back", async () => {
+    await expect(
+      runNativeRemoteLogin("https://a.example/", {
+        openExternal: async () => {},
+        fetchImpl: vi.fn() as unknown as typeof fetch,
+        setCookie: vi.fn(),
+        timeoutMs: 50,
+      }),
+    ).rejects.toThrow(/timed out/);
+  });
+});
