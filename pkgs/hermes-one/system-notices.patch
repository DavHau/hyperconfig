diff --git a/src/renderer/src/screens/Chat/systemNotices.test.tsx b/src/renderer/src/screens/Chat/systemNotices.test.tsx
new file mode 100644
index 0000000..c0d41f4
--- /dev/null
+++ b/src/renderer/src/screens/Chat/systemNotices.test.tsx
@@ -0,0 +1,398 @@
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { classifyUserRow, describeSkillInvocation } from "./systemNotices";
+import { applyDashboardStreamEvent } from "./dashboardEventAdapter";
+import {
+  dbItemsToChatMessages,
+  reconcileAfterDbRefresh,
+} from "./sessionHistory";
+import { NoticeRow } from "./NoticeRow";
+import { MessageList } from "./MessageList";
+import type { ChatMessage, NoticeMessage } from "./types";
+
+vi.mock("../../components/useI18n", () => ({
+  useI18n: () => ({
+    t: (key: string) => key,
+    locale: "en",
+    setLocale: vi.fn(),
+  }),
+}));
+
+// Synthetic examples in hermes' formats (no real transcript content).
+const BATCH =
+  "[ASYNC DELEGATION BATCH COMPLETE — deleg_6605942c]\n" +
+  "A background fan-out unit you dispatched earlier — 1 subagent(s) — has finished.\n" +
+  "--- ✓ TASK 1/1: write a haiku  (status=completed) ---\nan example result";
+const TASK_FAILED =
+  "[ASYNC DELEGATION TASK FAILED — deleg_0badc0de, task 2/3]\n" +
+  "One subagent in a background fan-out you dispatched has failed.\nError: example";
+const INTERRUPTED =
+  "[System note: Your previous turn was interrupted mid-run — the app or its backend " +
+  "process stopped before the turn could finish. The interrupted request was:]\n\nhello";
+const PROCESS =
+  "[IMPORTANT: Background process proc_1a2b exited (exit code 0).\n" +
+  "Command: echo example\nOutput:\nexample]";
+const COMPACTION =
+  "[CONTEXT COMPACTION — REFERENCE ONLY] Earlier turns were compacted into the summary below.\n" +
+  "## Summary\nexample summary";
+
+afterEach(cleanup);
+
+describe("classifyUserRow: server metadata", () => {
+  it("labels a delegation result from display_metadata", () => {
+    const view = classifyUserRow({
+      content: BATCH,
+      displayKind: "async_delegation_complete",
+      displayMetadata: JSON.stringify({
+        delegation_id: "deleg_6605942c",
+        task_count: 1,
+        completed_count: 1,
+        failed_count: 0,
+        display_text: "Subagent Task Completed: write a haiku",
+      }),
+    });
+    expect(view).toEqual({
+      type: "notice",
+      notice: "subagent",
+      label: "Subagent result · deleg_6605942c",
+      detail: "Subagent Task Completed: write a haiku",
+      text: BATCH,
+    });
+  });
+
+  it("marks an early task failure as failed and respects suppression", () => {
+    const meta = {
+      delegation_id: "deleg_0badc0de",
+      delivery_notice: "task_failure:1",
+      failed_count: 1,
+      completed_count: 0,
+    };
+    const view = classifyUserRow({
+      content: TASK_FAILED,
+      displayKind: "async_delegation_complete",
+      displayMetadata: meta,
+    });
+    expect(view).toMatchObject({
+      type: "notice",
+      notice: "subagent_failed",
+      label: "Subagent failed · deleg_0badc0de",
+    });
+    expect(
+      classifyUserRow({
+        content: TASK_FAILED,
+        displayKind: "async_delegation_complete",
+        displayMetadata: { ...meta, presentation_suppressed: true },
+      }),
+    ).toEqual({ type: "hidden" });
+  });
+
+  it("uses process_complete's display_text", () => {
+    expect(
+      classifyUserRow({
+        content: PROCESS,
+        displayKind: "process_complete",
+        displayMetadata: {
+          display_text: "Background Process Finished: echo example",
+        },
+      }),
+    ).toMatchObject({
+      notice: "process",
+      label: "Background process finished",
+      detail: "Background Process Finished: echo example",
+    });
+  });
+
+  it("maps auto_continue and hides hidden rows", () => {
+    expect(
+      classifyUserRow({ content: INTERRUPTED, displayKind: "auto_continue" }),
+    ).toMatchObject({ notice: "resumed", label: "Resumed after restart" });
+    expect(
+      classifyUserRow({
+        content: "[System: example nudge]",
+        displayKind: "hidden",
+      }),
+    ).toEqual({ type: "hidden" });
+  });
+
+  it("keeps a pure compaction handoff visible as a notice", () => {
+    expect(
+      classifyUserRow({ content: COMPACTION, displayKind: "hidden" }),
+    ).toMatchObject({
+      notice: "compaction",
+      label: "Earlier conversation summarised",
+      text: COMPACTION,
+    });
+  });
+
+  it("leaves a steer (already unwrapped by the history loader) a bubble", () => {
+    expect(
+      classifyUserRow({
+        content: "please also check the tests",
+        displayKind: "steer",
+      }),
+    ).toEqual({
+      type: "bubble",
+      content: "please also check the tests",
+      steered: true,
+    });
+  });
+
+  it("maps personality_switch to a notice", () => {
+    expect(
+      classifyUserRow({
+        content: "[System: personality changed to concise]",
+        displayKind: "personality_switch",
+      }),
+    ).toMatchObject({
+      type: "notice",
+      notice: "personality_switch",
+      label: "Personality changed",
+    });
+  });
+
+  it("an unknown display_kind stays a bubble (no prefix fallback)", () => {
+    expect(
+      classifyUserRow({ content: BATCH, displayKind: "some_future_kind" }),
+    ).toEqual({ type: "bubble", content: BATCH });
+  });
+});
+
+describe("classifyUserRow: prefix fallback for untyped rows", () => {
+  it.each([
+    [BATCH, "subagent", "Subagent result · deleg_6605942c"],
+    [TASK_FAILED, "subagent_failed", "Subagent failed · deleg_0badc0de"],
+    [INTERRUPTED, "resumed", "Resumed after restart"],
+    [PROCESS, "process", "Background process finished"],
+    [COMPACTION, "compaction", "Earlier conversation summarised"],
+  ])("%#", (content, notice, label) => {
+    const view = classifyUserRow({ content });
+    expect(view).toMatchObject({
+      type: "notice",
+      notice,
+      label,
+      text: content,
+    });
+  });
+
+  it("adds the process id and exit code as detail", () => {
+    expect(classifyUserRow({ content: PROCESS })).toMatchObject({
+      detail: "proc_1a2b · exit 0",
+    });
+  });
+
+  it("shows only the invocation of an untyped skill row", () => {
+    const single =
+      '[IMPORTANT: The user has invoked the "work" skill, indicating they want you to ' +
+      "follow its instructions. The full skill content is loaded below.]\n\n" +
+      "# Work\nexample skill body\n\n" +
+      "The user has provided the following instruction alongside the skill invocation: " +
+      "fix the  title";
+    expect(classifyUserRow({ content: single })).toEqual({
+      type: "bubble",
+      content: "/work — fix the title",
+    });
+    const bare =
+      '[IMPORTANT: The user has invoked the "work" skill, indicating they want you to ' +
+      "follow its instructions. The full skill content is loaded below.]\n\nbody";
+    expect(describeSkillInvocation(bare)).toBe("/work");
+    expect(describeSkillInvocation("plain")).toBeNull();
+  });
+
+  it("hides a legacy process heartbeat", () => {
+    expect(
+      classifyUserRow({
+        content:
+          "[Background process proc_1a2b heartbeat #3 — still running after 90s]",
+      }),
+    ).toEqual({ type: "hidden" });
+  });
+
+  it("leaves ordinary prompts alone", () => {
+    expect(classifyUserRow({ content: "[draft] fix the build" })).toEqual({
+      type: "bubble",
+      content: "[draft] fix the build",
+    });
+  });
+});
+
+describe("history mapping", () => {
+  it("a refresh keeps one copy of a notice and of a steered message", () => {
+    const db = dbItemsToChatMessages([
+      { kind: "user", id: 1, content: "write a haiku" },
+      { kind: "user", id: 2, content: BATCH },
+      {
+        kind: "user",
+        id: 3,
+        content: "please also check the tests",
+        displayKind: "steer",
+        steered: true,
+      },
+    ]);
+    expect(db[2]).toEqual({
+      id: "db-3",
+      role: "user",
+      content: "please also check the tests",
+      steered: true,
+    });
+    const current: ChatMessage[] = [
+      ...db.slice(0, 2),
+      {
+        id: "live-1",
+        role: "user",
+        content: "please also check the tests",
+        steered: true,
+      },
+    ];
+    const merged = reconcileAfterDbRefresh(current, db);
+    expect(merged.map((m) => m.id)).toEqual(["db-1", "db-n-2", "live-1"]);
+  });
+
+  it("a failed_turn assistant row becomes an error card", () => {
