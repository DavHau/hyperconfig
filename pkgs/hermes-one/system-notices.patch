+/** A `status.update {kind: "process", text}` as a live notice row; null for
+ *  other status kinds (heartbeats, model/busy states) and empty text. */
+export function liveNoticeFromStatus(
+  payload: unknown,
+  now: number,
+  index: number,
+): NoticeMessage | null {
+  if (!payload || typeof payload !== "object") return null;
+  const p = payload as { kind?: unknown; text?: unknown };
+  if (p.kind !== "process" || typeof p.text !== "string") return null;
+  const text = p.text.trim();
+  if (!text) return null;
+  const subagent = /^Subagent Tasks? /.exec(text);
+  const failed = /^Subagent Tasks? (Failed|Cancelled|Interrupted|Timed Out|Stalled|Finished with Issues)/.test(text);
+  const process = text.startsWith("Background Process");
+  return {
+    id: `notice-live-${now}-${index}`,
+    kind: "notice",
+    role: "user",
+    notice: subagent
+      ? failed
+        ? "subagent_failed"
+        : "subagent"
+      : process
+        ? "process"
+        : "system",
+    label: subagent
+      ? failed
+        ? "Subagent failed"
+        : "Subagent result"
+      : process
+        ? "Background process finished"
+        : "System notice",
+    detail: text,
+    text,
+    timestamp: now,
+  };
+}
