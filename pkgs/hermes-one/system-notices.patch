index 0000000..11325f0
--- /dev/null
+++ b/src/renderer/src/screens/Chat/systemNotices.ts
@@ -0,0 +1,240 @@
+/**
+ * Hermes stores its own agent-facing messages (subagent results, background
+ * process completions, crash-recovery notes, compaction handoffs) as
+ * `role=user` rows. This module decides how such a row is shown: as the
+ * user's own bubble, as one compact system notice, or not at all.
+ *
+ * The dashboard's `GET /api/sessions/{id}/messages` types most of them with
+ * `display_kind` (+ `display_metadata`); the text prefixes below are only
+ * the fallback for rows hermes left untyped (older rows, a turn killed
+ * before its kind was stamped).
+ *
+ * Steers and `display_content` are not handled here: the history loaders
+ * (busy-input-steer.patch, main/sessions.ts expandRowsToHistory) already
+ * replaced the row's content with the user's own words and flagged a steer
+ * `steered`, which MessageRow labels "sent while working".
+ */
+
+export type SystemNoticeKind =
+  | "subagent"
+  | "subagent_failed"
+  | "process"
+  | "resumed"
+  | "compaction"
+  | "model_switch"
+  | "personality_switch"
+  | "system";
+
+export interface UserRowInput {
+  content: string;
+  displayKind?: string | null;
+  displayMetadata?: unknown;
+}
+
+export type UserRowView =
+  | { type: "bubble"; content: string; steered?: boolean }
+  | {
+      type: "notice";
+      notice: SystemNoticeKind;
+      /** One-line row label, e.g. "Subagent result · deleg_6605942c". */
+      label: string;
+      /** Optional muted detail after the label (hermes' own display text). */
+      detail?: string;
+      /** The full message, shown when the row is expanded. */
+      text: string;
+    }
+  | { type: "hidden" };
+
+function parseMetadata(raw: unknown): Record<string, unknown> {
+  let parsed = raw;
+  if (typeof parsed === "string") {
+    try {
+      parsed = JSON.parse(parsed);
+    } catch {
+      return {};
+    }
+  }
+  return parsed && typeof parsed === "object" && !Array.isArray(parsed)
+    ? (parsed as Record<string, unknown>)
+    : {};
+}
+
+function str(v: unknown): string | undefined {
+  return typeof v === "string" && v.trim() ? v.trim() : undefined;
+}
+
+function num(v: unknown): number | undefined {
+  return typeof v === "number" && Number.isFinite(v) ? v : undefined;
+}
+
+const DELEG_RE =
+  /^\s*\[ASYNC DELEGATION (BATCH COMPLETE|COMPLETE|TASK FAILED) — ([^,\]\s]+)/;
+const COMPACTION_RE = /^\s*\[(?:CONTEXT COMPACTION|CONTEXT SUMMARY\]:)/;
+const PROCESS_RE = /\[IMPORTANT: Background process (\S+) ([^\n]*)/;
+const EXIT_RE = /\(exit code (-?\d+)/;
+const HEARTBEAT_RE = /^\[Background process \S+ heartbeat #/;
+const SKILL_PREFIX = "[IMPORTANT: The user has invoked the ";
+const SKILL_NAME_RE = /^\[IMPORTANT: The user has invoked the "([^"]*)"/;
+const SKILL_INSTRUCTION =
+  "The user has provided the following instruction alongside the skill invocation: ";
+
+function delegationLabel(id: string | undefined, failed: boolean): string {
+  const base = failed ? "Subagent failed" : "Subagent result";
+  return id ? `${base} · ${id}` : base;
+}
+
+/** "proc_1a2b · exit 0" from the first `[IMPORTANT: Background process …]`. */
+function processDetail(text: string): string | undefined {
+  const m = PROCESS_RE.exec(text);
+  if (!m) return undefined;
+  if (/matched/.test(m[2])) return `${m[1]} · matched watch pattern`;
+  const exit = EXIT_RE.exec(m[2]);
+  return exit ? `${m[1]} · exit ${exit[1]}` : m[1];
+}
+
+function notice(
+  kind: SystemNoticeKind,
+  label: string,
+  text: string,
+  detail?: string,
+): UserRowView {
+  return {
+    type: "notice",
+    notice: kind,
+    label,
+    text,
+    ...(detail ? { detail } : {}),
+  };
+}
+
+/** From hermes' `display_kind` (+ metadata). */
+function fromDisplayKind(row: UserRowInput, text: string): UserRowView {
+  const meta = parseMetadata(row.displayMetadata);
+  const displayText = str(meta.display_text);
+  switch (row.displayKind) {
+    case "hidden":
+      // The server hides a pure compaction handoff too; that one still
+      // gets its row, so the jump in the conversation is explained.
+      return COMPACTION_RE.test(text)
+        ? notice("compaction", "Earlier conversation summarised", text)
+        : { type: "hidden" };
+    case "steer":
+      // Already the user's words: busy-input-steer.patch's history loaders
+      // unwrapped them and set the one `steered` flag MessageRow labels.
+      return { type: "bubble", content: text, steered: true };
+    case "async_delegation_complete": {
+      if (meta.presentation_suppressed === true) return { type: "hidden" };
+      const id = str(meta.delegation_id) ?? DELEG_RE.exec(text)?.[2];
+      const failedCount = num(meta.failed_count) ?? 0;
+      const completed = num(meta.completed_count);
+      const failed =
+        String(meta.delivery_notice ?? "").startsWith("task_failure") ||
+        (failedCount > 0 && completed === 0) ||
+        DELEG_RE.exec(text)?.[1] === "TASK FAILED";
+      return notice(
+        failed ? "subagent_failed" : "subagent",
+        delegationLabel(id, failed),
+        text,
+        displayText,
+      );
+    }
+    case "process_complete":
+      return notice(
+        "process",
+        "Background process finished",
+        text,
+        displayText ?? processDetail(text),
+      );
+    case "auto_continue":
+      return notice("resumed", "Resumed after restart", text);
+    case "model_switch":
+      return notice("model_switch", "Model changed", text);
+    case "personality_switch":
+      return notice("personality_switch", "Personality changed", text);
+    case "internal_notification":
+      return notice("system", "System notice", text, displayText);
+    default:
+      // A kind this build does not know: the user's bubble as stored (the
+      // prefix fallback is only for rows hermes left untyped).
+      return { type: "bubble", content: text };
+  }
+}
+
+/** `/work — fix the title` for a skill invocation (hermes'
+ *  agent/skill_commands.py describe_skill_invocation, single skill and
+ *  bundle); null when the row is no skill scaffold. */
+export function describeSkillInvocation(text: string): string | null {
+  if (!text.startsWith(SKILL_PREFIX)) return null;
+  const name = (SKILL_NAME_RE.exec(text)?.[1] ?? "").trim();
+  const label = name.startsWith("/") ? name : `/${name}`;
+  let instruction: string | undefined;
+  if (text.includes(" skill bundle,")) {
+    instruction = cutAfter(text, "\nUser instruction: ", "\n\n[Loaded as part of the ", false);
+  } else if (text.includes("The full skill content is loaded below.]")) {
+    instruction = cutAfter(text, SKILL_INSTRUCTION, "\n\n[Runtime note:", true);
+  }
+  const words = instruction ? instruction.split(/\s+/).join(" ").trim() : "";
+  if (words) return name ? `${label} — ${words}` : words;
+  return name ? label : null;
+}
+
+function cutAfter(
+  text: string,
+  marker: string,
+  end: string,
+  last: boolean,
+): string | undefined {
+  const at = last ? text.lastIndexOf(marker) : text.indexOf(marker);
+  if (at === -1) return undefined;
+  const rest = text.slice(at + marker.length);
+  const stop = rest.indexOf(end);
+  return stop === -1 ? rest : rest.slice(0, stop);
+}
+
+/** Untyped rows: hermes' own control-frame openers. */
+function fromPrefix(text: string): UserRowView | undefined {
+  const head = text.trimStart();
+  // A skill invocation: only what the user typed, not the skill body.
+  const skill = describeSkillInvocation(head);
+  if (skill !== null) return { type: "bubble", content: skill };
+  // A legacy process heartbeat (newer hermes types it hidden): a wake, not
+  // a message.
+  if (HEARTBEAT_RE.test(head)) return { type: "hidden" };
+  const deleg = DELEG_RE.exec(head);
+  if (deleg) {
+    const failed = deleg[1] === "TASK FAILED";
+    return notice(
+      failed ? "subagent_failed" : "subagent",
+      delegationLabel(deleg[2], failed),
+      text,
+    );
+  }
+  if (head.startsWith("[ASYNC DELEGATION")) {
+    return notice("subagent", "Subagent result", text);
+  }
+  if (head.startsWith("[IMPORTANT: Background process ")) {
+    return notice(
+      "process",
+      "Background process finished",
+      text,
+      processDetail(head),
+    );
+  }
+  if (head.startsWith("[System note: Your previous turn was interrupted")) {
+    return notice("resumed", "Resumed after restart", text);
+  }
+  if (COMPACTION_RE.test(head)) {
+    return notice("compaction", "Earlier conversation summarised", text);
+  }
+  if (head.startsWith("[System:") || head.startsWith("[System note:")) {
+    return notice("system", "System notice", text);
+  }
+  return undefined;
+}
+
+/** How a stored `role=user` row is shown. */
+export function classifyUserRow(row: UserRowInput): UserRowView {
+  const text = row.content || "";
+  if (row.displayKind) return fromDisplayKind(row, text);
+  return fromPrefix(text) ?? { type: "bubble", content: text };
+}
