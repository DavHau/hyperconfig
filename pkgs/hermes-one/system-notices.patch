+/** One of hermes' own agent-facing messages (stored as role=user): a
+ *  compact, muted row that expands to the full text (./systemNotices.ts). */
+export interface NoticeMessage {
+  id: string;
+  kind: "notice";
+  /** "user": it stands where hermes stored it, opening the agent's turn, so
+   *  turn-boundary and avatar logic treat it like the bubble it replaces. */
