+
+  it("ignores other status kinds", () => {
+    const state = { messages: [] as ChatMessage[], reasoningSegmentClosed: false };
+    for (const payload of [
+      { kind: "heartbeat", text: "♥ heartbeat #2 firing…" },
+      { kind: "process", text: "  " },
+      null,
