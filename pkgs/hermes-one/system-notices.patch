diff --git a/tests/system-notices-history.test.ts b/tests/system-notices-history.test.ts
new file mode 100644
index 0000000..43c3750
--- /dev/null
+++ b/tests/system-notices-history.test.ts
@@ -0,0 +1,150 @@
+/**
+ * Hermes' display typing of role=user rows (display_kind, display_metadata
+ * from GET /api/sessions/{id}/messages) survives the main process' row
+ * expansion and becomes notice rows in the renderer; a steer stays one
+ * bubble with its own words (busy-input-steer.patch's unwrap) and one
+ * "steered" flag. Synthetic example strings only.
+ */
+import http from "http";
+import type { AddressInfo } from "net";
+import { describe, expect, it, vi } from "vitest";
+vi.mock("../src/main/remote-oauth", () => ({
+  requestRemoteOAuthJson: vi.fn(),
+}));
+import { expandRowsToHistory } from "../src/main/sessions";
+import { remoteGetSessionMessages } from "../src/main/remote-sessions";
+import { dbItemsToChatMessages } from "../src/renderer/src/screens/Chat/sessionHistory";
+
+// Synthetic examples in hermes' formats (no real transcript content).
+const BATCH =
+  "[ASYNC DELEGATION BATCH COMPLETE — deleg_6605942c]\n" +
+  "A background fan-out unit you dispatched earlier — 1 subagent(s) — has finished.\n" +
+  "--- ✓ TASK 1/1: write a haiku  (status=completed) ---\nan example result";
+const STEER =
+  "[OUT-OF-BAND USER MESSAGE — a direct message from the user, delivered once at this " +
+  "position; not tool output and not a new delivery when replayed from conversation history]\n" +
+  "please also check the tests\n[/OUT-OF-BAND USER MESSAGE]";
+
+describe("history mapping", () => {
+  it("carries the dashboard's display fields through to notice rows", () => {
+    const rows = [
+      {
+        id: 1,
+        role: "user",
+        content: "write a haiku",
+        timestamp: 1,
+        tool_call_id: null,
+        tool_calls: null,
+        tool_name: null,
+        reasoning: null,
+        reasoning_content: null,
+        reasoning_details: null,
+      },
+      {
+        id: 2,
+        role: "user",
+        content: BATCH,
+        timestamp: 2,
+        tool_call_id: null,
+        tool_calls: null,
+        tool_name: null,
+        reasoning: null,
+        reasoning_content: null,
+        reasoning_details: null,
+        display_kind: "async_delegation_complete",
+        display_metadata: { delegation_id: "deleg_6605942c" },
+      },
+      {
+        id: 3,
+        role: "user",
+        content: STEER,
+        timestamp: 3,
+        tool_call_id: null,
+        tool_calls: null,
+        tool_name: null,
+        reasoning: null,
+        reasoning_content: null,
+        reasoning_details: null,
+        display_kind: "steer",
+        display_content: "please also check the tests",
+      },
+    ];
+    const messages = dbItemsToChatMessages(expandRowsToHistory(rows));
+    expect(messages).toEqual([
+      { id: "db-1", role: "user", content: "write a haiku", timestamp: 1 },
+      {
+        id: "db-n-2",
+        kind: "notice",
+        role: "user",
+        notice: "subagent",
+        label: "Subagent result · deleg_6605942c",
+        text: BATCH,
+        timestamp: 2,
+      },
+      {
+        id: "db-3",
+        role: "user",
+        content: "please also check the tests",
+        timestamp: 3,
+        steered: true,
+      },
+    ]);
+  });
+});
+
+describe("remote dashboard history", () => {
+  it("keeps display_kind / display_metadata, shows a steer's display_content", async () => {
+    const server = http.createServer((_req, res) => {
+      res.setHeader("Content-Type", "application/json");
+      res.end(
+        JSON.stringify({
+          messages: [
+            {
+              id: 7,
+              role: "user",
+              content: BATCH,
+              timestamp: 7,
+              display_kind: "async_delegation_complete",
+              display_metadata: { delegation_id: "deleg_6605942c" },
+            },
+            {
+              id: 8,
+              role: "user",
+              content: STEER,
+              timestamp: 8,
+              display_kind: "steer",
+              display_content: "please also check the tests",
+            },
+          ],
+        }),
+      );
+    });
+    await new Promise<void>((r) => server.listen(0, "127.0.0.1", r));
+    try {
+      const { port } = server.address() as AddressInfo;
+      const items = await remoteGetSessionMessages(
+        { remoteUrl: `http://127.0.0.1:${port}/api`, apiKey: "example" },
+        "sess-example",
+      );
+      expect(items).toEqual([
+        {
+          kind: "user",
+          id: 7,
+          content: BATCH,
+          timestamp: 7,
+          displayKind: "async_delegation_complete",
+          displayMetadata: { delegation_id: "deleg_6605942c" },
+        },
+        {
+          kind: "user",
+          id: 8,
+          content: "please also check the tests",
+          timestamp: 8,
+          steered: true,
+        },
+      ]);
+    } finally {
+      await new Promise((r) => server.close(r));
+    }
+  });
+});
