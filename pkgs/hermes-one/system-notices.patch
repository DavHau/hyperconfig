+        messages={messages}
+        isLoading={false}
+        toolProgress={null}
+        onApprove={vi.fn()}
+        onDeny={vi.fn()}
+        onClarifyResolved={vi.fn()}
+        onApprovalRespond={vi.fn().mockResolvedValue(true)}
+        onApprovalResolved={vi.fn()}
+      />,
+    );
+    expect(screen.getAllByTestId("notice-row")).toHaveLength(1);
+    expect(container.querySelectorAll(".chat-bubble-user")).toHaveLength(2);
+    expect(container.textContent).not.toContain("ASYNC DELEGATION");
+    // One label, from busy-input-steer.patch's MessageRow.
+    const labels = container.querySelectorAll(".chat-bubble-steered");
+    expect(labels).toHaveLength(1);
+    expect(labels[0].textContent).toBe("chat.sentWhileWorking");
+  });
+});
+
+describe("live dashboard stream", () => {
+  it("status.update kind=process becomes a notice row at once", () => {
+    const state = { messages: [] as ChatMessage[], reasoningSegmentClosed: false };
+    const next = applyDashboardStreamEvent(
+      state,
+      {
+        type: "status.update",
+        payload: {
+          kind: "process",
+          text: "Subagent Task Completed: write a haiku",
+        },
+      },
+      { now: 1000 },
+    );
+    expect(next.messages).toEqual([
+      {
+        id: "notice-live-1000-0",
+        kind: "notice",
+        role: "user",
+        notice: "subagent",
+        label: "Subagent result",
+        detail: "Subagent Task Completed: write a haiku",
+        text: "Subagent Task Completed: write a haiku",
+        timestamp: 1000,
+      },
+    ]);
+    const failed = applyDashboardStreamEvent(
+      state,
+      {
+        type: "status.update",
+        payload: { kind: "process", text: "Subagent Task Failed: lint" },
+      },
+      { now: 1 },
+    );
+    expect(failed.messages[0]).toMatchObject({ notice: "subagent_failed" });
+    const proc = applyDashboardStreamEvent(
+      state,
+      {
+        type: "status.update",
+        payload: {
+          kind: "process",
+          text: "Background Process Finished: echo example",
+        },
+      },
+      { now: 1 },
+    );
+    expect(proc.messages[0]).toMatchObject({
