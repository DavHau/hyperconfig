@@ -0,0 +1,43 @@
+import { memo, useState } from "react";
+import { ChevronRight, Info } from "lucide-react";
+import type { NoticeMessage } from "./types";
+
+/**
+ * One of hermes' own agent-facing messages (a subagent result, a finished
+ * background process, a crash-recovery note, a compaction summary): one
+ * compact, muted row instead of a user bubble. A click shows the full text.
+ */
+export const NoticeRow = memo(function NoticeRow({
+  msg,
+}: {
+  msg: NoticeMessage;
+}): React.JSX.Element {
+  const [open, setOpen] = useState(false);
+  return (
+    <div
+      className={`chat-notice chat-notice--${msg.notice}`}
+      data-testid="notice-row"
+      data-notice={msg.notice}
+    >
+      <button
+        type="button"
+        className="chat-notice-summary"
+        aria-expanded={open}
+        onClick={() => setOpen((o) => !o)}
+      >
+        <Info size={12} className="chat-notice-icon" />
+        <span className="chat-notice-label">{msg.label}</span>
+        {msg.detail && <span className="chat-notice-detail">{msg.detail}</span>}
+        <ChevronRight
+          size={12}
+          className={`chat-notice-chevron${open ? " chat-notice-chevron--open" : ""}`}
+        />
+      </button>
+      {open && (
+        <pre className="chat-notice-text" data-testid="notice-text">
+          {msg.text}
+        </pre>
+      )}
+    </div>
+  );
+});
