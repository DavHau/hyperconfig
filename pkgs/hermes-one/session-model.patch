diff --git a/src/main/remote-session-usage.ts b/src/main/remote-session-usage.ts
index e3037ca..7b2c86d 100644
--- a/src/main/remote-session-usage.ts
+++ b/src/main/remote-session-usage.ts
@@ -56,3 +56,57 @@ export async function remoteGetSessionUsage(
     return null;
   }
 }
+
+/** The model and provider a stored session runs: what Hermes resumes it on.
+ *  Same order as hermes (tui_gateway/agent_factory.py, SessionDB
+ *  .session_gateway_runtime): the row's `model` before `model_config.model`;
+ *  the provider from `model_config.gateway_runtime`, then its top-level
+ *  `provider`, then a routable `billing_provider`. Null when unknown. */
+export async function remoteGetSessionRuntimeModel(
+  conn: ConnectionConfig,
+  sessionId: string,
+  profile?: string,
+): Promise<{ model: string; provider: string } | null> {
+  if (!sessionId) return null;
+  try {
+    const captured = structuredClone(conn);
+    const revision = providerTargetRevision(captured);
+    const row = await remoteDashboardRequestJson<Record<string, unknown>>(
+      captured,
+      `/api/sessions/${encodeURIComponent(sessionId)}`,
+      {},
+      profile,
+    );
+    if (providerTargetRevision(captured) !== revision) return null;
+    let config: unknown = row?.model_config;
+    if (typeof config === "string") {
+      try {
+        config = JSON.parse(config);
+      } catch {
+        config = null;
+      }
+    }
+    const record =
+      config && typeof config === "object"
+        ? (config as Record<string, unknown>)
+        : {};
+    const text = (value: unknown): string =>
+      typeof value === "string" ? value.trim() : "";
+    const model = text(row?.model) || text(record.model);
+    if (!model) return null;
+    const runtime =
+      record.gateway_runtime && typeof record.gateway_runtime === "object"
+        ? (record.gateway_runtime as Record<string, unknown>)
+        : {};
+    const billing = text(row?.billing_provider);
+    const provider =
+      text(runtime.provider) ||
+      text(record.provider) ||
+      (billing && !["auto", "custom"].includes(billing.toLowerCase())
+        ? billing
+        : "");
+    return { model, provider };
+  } catch {
+    return null;
+  }
+}
