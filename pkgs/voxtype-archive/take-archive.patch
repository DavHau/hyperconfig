diff --git a/src/take_archive.rs b/src/take_archive.rs
new file mode 100644
index 0000000..80457bd
--- /dev/null
+++ b/src/take_archive.rs
@@ -0,0 +1,361 @@
+//! Take archive: keep every push-to-talk take for later replay.
+//!
+//! Enabled by the `VOXTYPE_ARCHIVE_DIR` environment variable (not by
+//! config.toml, so a user override file can't switch it off by accident).
+//! For each take the daemon writes the 16 kHz mono audio it handed
+//! to the transcriber as a 24-bit PCM WAV plus a JSON sidecar (time,
+//! host, duration, engine settings, initial prompt, VAD result, raw and
+//! output text) into `<dir>/.partial/<id>/`, then renames that directory
+//! to `<dir>/incoming/<id>` in one step. An external job (hyperconfig's
+//! voxtype-archive ingest) compresses the WAV to FLAC and files it away.
+//! Writing happens on a plain thread, off the dictation path.
+//!
+//! Only takes the daemon transcribes in one piece are archived; eager
+//! processing (`eager_processing`, chunks transcribed while recording) is
+//! not. Secrets are kept out of the sidecar: whisper's API key, userinfo in
+//! the remote endpoint URL, and post-processing commands beyond their
+//! program name.
+
+use crate::config::Config;
+use crate::vad::VadResult;
+use serde_json::{json, Value};
+use std::fs;
+use std::io::{self, Write};
+use std::os::unix::fs::{DirBuilderExt, OpenOptionsExt};
+use std::path::{Path, PathBuf};
+
+/// Sample rate of everything voxtype feeds its transcribers.
+pub const SAMPLE_RATE: u32 = 16_000;
+/// Bits per sample of the archived PCM. The daemon's samples are f32 after
+/// mixing/resampling; 24 bits keep each within 2^-24 of the float sample
+/// (clipped to ±1), far below any microphone's noise floor (-144 dBFS),
+/// and FLAC stores the 24-bit stream losslessly.
+pub const BITS: u16 = 24;
+const SCALE: f32 = 8_388_608.0; // 2^23, the divisor `voxtype transcribe` uses
+
+/// Where archived takes go; `None` when archiving is off.
+#[derive(Debug, Clone)]
+pub struct TakeArchive {
+    dir: PathBuf,
+    hostname: String,
+}
+
+/// What happened to a take.
+#[derive(Debug, Default)]
+pub struct TakeOutcome {
+    /// "ok", "empty", "vad_rejected", "error"
+    pub status: &'static str,
+    /// Transcriber output before replacements/post-processing
+    pub raw_text: Option<String>,
+    /// Text voxtype output (typed/pasted) after text processing
+    pub final_text: Option<String>,
+    pub error: Option<String>,
+    pub detected_language: Option<String>,
+    pub vad: Option<VadResult>,
+    /// Model chosen by the hotkey (`--model`/modifier) for this take
+    pub model_override: Option<String>,
+    /// Profile (`--profile`/modifier) used for post-processing
+    pub profile: Option<String>,
+}
+
+/// A take between recording stop and transcription result.
+#[derive(Debug)]
+pub struct PendingTake {
+    pub samples: Vec<f32>,
+    pub vad: Option<VadResult>,
+    pub model_override: Option<String>,
+}
+
+impl TakeArchive {
+    /// Archive from `VOXTYPE_ARCHIVE_DIR`, if set and non-empty.
+    pub fn from_env() -> Option<Self> {
+        let dir = std::env::var_os("VOXTYPE_ARCHIVE_DIR")?;
+        if dir.is_empty() {
+            return None;
+        }
+        let archive = Self::new(PathBuf::from(dir));
+        tracing::info!("Take archive enabled: {:?}", archive.dir);
+        Some(archive)
+    }
+
+    pub fn new(dir: PathBuf) -> Self {
+        let hostname = fs::read_to_string("/proc/sys/kernel/hostname")
+            .map(|s| s.trim().to_string())
+            .unwrap_or_default();
+        Self { dir, hostname }
+    }
+
+    /// Archive one take in the background. Never blocks or fails dictation.
+    pub fn save(
+        &self,
+        samples: Vec<f32>,
+        config: &Config,
+        config_path: Option<&Path>,
+        outcome: TakeOutcome,
+    ) {
+        if samples.is_empty() {
+            return;
+        }
+        let now = chrono::Local::now();
+        let id = now.format("%Y%m%dT%H%M%S%.3f").to_string().replace('.', "-");
+        let sidecar = sidecar(&self.hostname, &now, &samples, config, config_path, &outcome);
+        let dir = self.dir.clone();
+        let thread_id = id.clone();
+        let spawned = std::thread::Builder::new()
+            .name("take-archive".into())
+            .spawn(move || match write_take(&dir, &thread_id, &samples, &sidecar) {
+                Ok(path) => tracing::debug!("Archived take to {:?}", path),
+                Err(e) => tracing::warn!("Failed to archive take {}: {}", thread_id, e),
+            });
+        if let Err(e) = spawned {
+            tracing::warn!("Failed to archive take {}: no thread: {}", id, e);
+        }
+    }
+}
+
+/// Program name of a shell command line (its first word, no arguments).
+fn program_only(cmd: &str) -> String {
+    let first = cmd.split_whitespace().next().unwrap_or("");
+    if first.len() == cmd.trim().len() {
+        first.to_string()
+    } else {
+        format!("{first} <args redacted>")
+    }
+}
+
+/// `scheme://user:pass@host/...` -> `scheme://host/...`
+fn strip_userinfo(url: &str) -> String {
+    let (scheme, rest) = match url.find("://") {
+        Some(i) => (&url[..i + 3], &url[i + 3..]),
+        None => ("", url),
+    };
+    let auth_end = rest.find(['/', '?', '#']).unwrap_or(rest.len());
+    match rest[..auth_end].rfind('@') {
+        Some(at) => format!("{scheme}{}", &rest[at + 1..]),
+        None => url.to_string(),
+    }
+}
+
+/// Apply `f` to the string at `obj[key]`, if there is one.
+fn map_str(v: &mut Value, key: &str, f: impl Fn(&str) -> String) {
+    if let Some(x) = v.get_mut(key) {
+        if let Some(s) = x.as_str() {
+            *x = Value::String(f(s));
+        }
+    }
+}
+
+fn redact(mut v: Value, keys: &[&str]) -> Value {
+    if let Some(obj) = v.as_object_mut() {
+        for k in keys {
+            if obj.get(*k).is_some_and(|x| !x.is_null()) {
+                obj.insert((*k).to_string(), json!("<redacted>"));
+            }
+        }
+    }
+    v
+}
+
+/// The JSON sidecar for one take.
+pub fn sidecar(
+    hostname: &str,
+    now: &chrono::DateTime<chrono::Local>,
+    samples: &[f32],
+    config: &Config,
+    config_path: Option<&Path>,
+    outcome: &TakeOutcome,
+) -> Value {
+    let to = |v: Result<Value, serde_json::Error>| v.unwrap_or(Value::Null);
+    let mut whisper = redact(to(serde_json::to_value(&config.whisper)), &["remote_api_key"]);
+    map_str(&mut whisper, "remote_endpoint", strip_userinfo);
+    let mut post_process = to(serde_json::to_value(&config.output.post_process));
+    map_str(&mut post_process, "command", program_only);
+    json!({
+        "format": 1,
+        "time": now.to_rfc3339(),
+        "time_utc": now.with_timezone(&chrono::Utc).to_rfc3339(),
+        "host": hostname,
+        "voxtype_version": env!("CARGO_PKG_VERSION"),
+        "audio": {
+            "sample_rate": SAMPLE_RATE,
+            "channels": 1,
+            "bits": BITS,
+            "samples": samples.len(),
+            "duration_secs": samples.len() as f64 / SAMPLE_RATE as f64,
+        },
+        "status": outcome.status,
+        "raw_text": outcome.raw_text,
+        "text": outcome.final_text,
+        "error": outcome.error,
+        "detected_language": outcome.detected_language,
+        "vad_result": outcome.vad.as_ref().map(|r| json!({
+            "has_speech": r.has_speech,
+            "speech_duration_secs": r.speech_duration_secs,
+            "speech_ratio": r.speech_ratio,
+            "rms_energy": r.rms_energy,
+        })),
+        "config_file": config_path.map(|p| p.display().to_string()),
+        "engine": config.engine.to_string(),
+        "model_override": outcome.model_override,
+        "profile": outcome.profile,
+        "whisper": whisper,
+        "parakeet": to(serde_json::to_value(&config.parakeet)),
+        "nemotron": to(serde_json::to_value(&config.nemotron)),
+        "vad": to(serde_json::to_value(&config.vad)),
+        "text_processing": to(serde_json::to_value(&config.text)),
+        "post_process": post_process,
+        "profiles": profile_commands(config),
+    })
+}
+
+/// Profiles' post-processing commands, redacted to their program names.
+fn profile_commands(config: &Config) -> Value {
+    let mut v = to_value_or_null(&config.profiles);
+    if let Some(obj) = v.as_object_mut() {
+        for p in obj.values_mut() {
+            map_str(p, "post_process_command", program_only);
+        }
+    }
+    v
+}
+
+fn to_value_or_null<T: serde::Serialize>(t: &T) -> Value {
+    serde_json::to_value(t).unwrap_or(Value::Null)
+}
+
+fn create_dir_private(path: &Path) -> io::Result<()> {
+    fs::DirBuilder::new().recursive(true).mode(0o700).create(path)
+}
+
+fn create_private(path: &Path) -> io::Result<fs::File> {
+    fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(path)
+}
+
+/// Quantise one sample the way the archive stores it.
+pub fn to_pcm24(s: f32) -> i32 {
+    (s * SCALE).round().clamp(-SCALE, SCALE - 1.0) as i32
+}
+
+/// Write `<dir>/.partial/<id>/{take.wav,take.json}`, then move the
+/// directory to `<dir>/incoming/<id>`. Returns the final directory.
+pub fn write_take(dir: &Path, id: &str, samples: &[f32], sidecar: &Value) -> io::Result<PathBuf> {
+    let partial = dir.join(".partial").join(id);
+    let incoming = dir.join("incoming");
+    create_dir_private(dir)?;
+    create_dir_private(&partial)?;
+    create_dir_private(&incoming)?;
+
+    let spec = hound::WavSpec {
+        channels: 1,
+        sample_rate: SAMPLE_RATE,
+        bits_per_sample: BITS,
+        sample_format: hound::SampleFormat::Int,
+    };
+    let wav = io::BufWriter::new(create_private(&partial.join("take.wav"))?);
+    let mut writer = hound::WavWriter::new(wav, spec).map_err(io::Error::other)?;
+    for &s in samples {
+        writer.write_sample(to_pcm24(s)).map_err(io::Error::other)?;
+    }
+    writer.finalize().map_err(io::Error::other)?;
+    fs::File::open(partial.join("take.wav"))?.sync_all()?;
+
+    let mut js = create_private(&partial.join("take.json"))?;
+    js.write_all(serde_json::to_string_pretty(sidecar)?.as_bytes())?;
+    js.write_all(b"\n")?;
+    js.sync_all()?;
+
+    let dest = incoming.join(id);
+    fs::rename(&partial, &dest)?;
+    Ok(dest)
+}
