+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+
+    #[test]
+    fn writes_take_with_private_modes() {
+        let tmp = tempfile::tempdir().unwrap();
+        let dir = tmp.path().join("archive");
+        let samples: Vec<f32> = (0..16_000)
+            .map(|i| (i as f32 * 0.05).sin() * 0.5)
+            .collect();
+        let config = Config::default();
+        let outcome = TakeOutcome {
+            status: "ok",
+            raw_text: Some("hello world".into()),
+            final_text: Some("Hello world.".into()),
+            ..Default::default()
+        };
+        let now = chrono::Local::now();
+        let sc = sidecar("testhost", &now, &samples, &config, None, &outcome);
+        let dest = write_take(&dir, "20261115T000000-000", &samples, &sc).unwrap();
+
+        assert_eq!(dest, dir.join("incoming/20261115T000000-000"));
+        assert!(!dir.join(".partial/20261115T000000-000").exists());
+        for d in [&dir, &dir.join("incoming"), &dest] {
+            assert_eq!(fs::metadata(d).unwrap().permissions().mode() & 0o777, 0o700);
+        }
+        for f in ["take.wav", "take.json"] {
+            let m = fs::metadata(dest.join(f)).unwrap().permissions().mode();
+            assert_eq!(m & 0o777, 0o600);
+        }
+
+        let mut r = hound::WavReader::open(dest.join("take.wav")).unwrap();
+        let spec = r.spec();
+        assert_eq!((spec.channels, spec.sample_rate, spec.bits_per_sample), (1, 16_000, 24));
+        let read: Vec<i32> = r.samples::<i32>().map(|s| s.unwrap()).collect();
+        let want: Vec<i32> = samples.iter().map(|&s| to_pcm24(s)).collect();
+        assert_eq!(read, want);
+
+        let js: Value =
+            serde_json::from_str(&fs::read_to_string(dest.join("take.json")).unwrap()).unwrap();
+        assert_eq!(js["status"], "ok");
+        assert_eq!(js["text"], "Hello world.");
+        assert_eq!(js["raw_text"], "hello world");
+        assert_eq!(js["host"], "testhost");
+        assert_eq!(js["audio"]["samples"], 16_000);
+        assert_eq!(js["engine"], "whisper");
+        assert!(js["whisper"]["model"].is_string());
+    }
+
+    #[test]
+    fn quantisation_clamps_and_inverts() {
+        assert_eq!(to_pcm24(1.0), 8_388_607);
+        assert_eq!(to_pcm24(-1.0), -8_388_608);
+        assert_eq!(to_pcm24(2.0), 8_388_607);
+        let s = 0.123_456_78_f32;
+        assert!((to_pcm24(s) as f32 / SCALE - s).abs() <= 1.0 / SCALE);
+    }
