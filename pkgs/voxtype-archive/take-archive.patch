+        assert_eq!(program_only("ollama-fix --key sk-x"), "ollama-fix <args redacted>");
+        assert_eq!(program_only("fix"), "fix");
+        assert_eq!(
+            strip_userinfo("https://u:p@host:8080/v1?x=a@b"),
+            "https://host:8080/v1?x=a@b"
+        );
+        assert_eq!(strip_userinfo("http://host/a@b"), "http://host/a@b");
+        let mut config = Config::default();
+        config.whisper.remote_endpoint = Some("https://me:secret@stt.example/v1".into());
+        config.whisper.remote_api_key = Some("sk-x".into());
+        let js = sidecar("h", &chrono::Local::now(), &[0.0], &config, None, &TakeOutcome::default());
+        let s = js.to_string();
+        assert!(!s.contains("secret") && !s.contains("sk-x"), "{s}");
+        assert_eq!(js["whisper"]["remote_endpoint"], "https://stt.example/v1");
